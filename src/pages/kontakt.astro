---
import Layout from '@/layouts/Layout.astro';
---

<Layout title="Kontakt">
  <div class="container mx-auto max-w-6xl px-6 py-16 md:py-28">

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">

      <!-- Linke Seite: Text + Foto -->
      <div class="space-y-8 text-center lg:text-left">
        <h1 class="text-h1">Lass uns gemeinsam ein Projekt starten!</h1>
        
        <p class="text-body-lg text-muted-foreground max-w-md mx-auto lg:mx-0">
          Ich freue mich darauf, mit dir zusammenzuarbeiten. Erzähl mir von deinem Vorhaben – ob Innenarchitektur oder UX/UI Design.
        </p>

        <div class="flex flex-col items-center lg:items-start gap-6">
          <img 
            src="/images/anika-foto.jpg" 
            alt="Anika Warncke" 
            class="w-28 h-28 md:w-32 md:h-32 rounded-3xl object-cover shadow-md"
          />
          <div>
            <p class="font-semibold text-lg">Anika Warncke</p>
            <p class="text-sm text-muted-foreground">Lüneburg • Remote/Hybrid möglich</p>
            <a href="https://linkedin.com/in/anika-warncke" target="_blank" class="text-primary hover:underline text-sm">LinkedIn</a>
          </div>
        </div>
      </div>

      <!-- Rechte Seite: Formular -->
      <div class="bg-card rounded-3xl p-8 md:p-12 shadow-sm">
        <form class="space-y-8">
          <div>
            <label class="block text-sm font-medium mb-3">Dein Name *</label>
            <input type="text" class="w-full p-4 md:p-5 rounded-2xl border border-border focus:border-primary" placeholder="Dein Name" required />
          </div>

          <div>
            <label class="block text-sm font-medium mb-3">Deine E-Mail-Adresse *</label>
            <input type="email" class="w-full p-4 md:p-5 rounded-2xl border border-border focus:border-primary" placeholder="deine@email.de" required />
          </div>

          <div>
            <label class="block text-sm font-medium mb-3">Deine Nachricht / dein Projekt *</label>
            <textarea rows="7" class="w-full p-4 md:p-5 rounded-2xl border border-border focus:border-primary resize-y" placeholder="Beschreibe dein Projekt..."></textarea>
          </div>

          <button type="submit" class="w-full bg-primary text-primary-foreground py-5 rounded-2xl font-medium text-lg hover:bg-accent transition-colors">
            Nachricht senden
          </button>

          <p class="text-xs text-muted-foreground text-center">
            Deine Daten werden vertraulich behandelt und nicht an Dritte weitergegeben.
          </p>
        </form>
      </div>
    </div>
  </div>
</Layout>
