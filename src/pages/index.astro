---
import Layout from '@/layouts/Layout.astro';
import SimpleTest from '@/components/SimpleTest';
import AutoCard from '@/components/AutoCard';
import { hero_title, hero_subtitle, nav_projects } from '@/paraglide/messages.js';

const locale = 'de';
const loc = { locale } as const;
---

<Layout title={hero_title({}, loc)} locale={locale}>
  <!-- Mobile-first: full-width, responsive padding, max-width cap on larger screens -->
  <div class="w-full max-w-4xl mx-auto px-4 sm:px-6 py-12 sm:py-16 text-center">
    <h1 class="text-5xl font-bold tracking-tight mb-6">
      {hero_title({}, loc)}
    </h1>
    <p class="text-xl text-muted-foreground mb-12">
      {hero_subtitle({}, loc)}
    </p>
    <SimpleTest locale={locale} client:load />

    <!-- Projekt-Grid: mobile-first, grid-cols-1 → sm:2 → lg:3 -->
    <div class="mt-16 text-left w-full">
      <h2 class="text-2xl font-bold mb-6">{nav_projects({}, loc)}</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 auto-rows-fr">
        <AutoCard title="Projekt 1" hug={false} fill={true} client:load>
          <p class="text-muted-foreground">Folgt in Kürze…</p>
        </AutoCard>
        <AutoCard title="Projekt 2" hug={false} fill={true} client:load>
          <p class="text-muted-foreground">Folgt in Kürze…</p>
        </AutoCard>
        <AutoCard title="Projekt 3" hug={false} fill={true} client:load>
          <p class="text-muted-foreground">Folgt in Kürze…</p>
        </AutoCard>
      </div>
    </div>
  </div>
</Layout>