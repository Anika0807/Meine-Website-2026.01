---
import Layout from '@/layouts/Layout.astro';
import ScrollReveal from '@/components/ScrollReveal';
import { Heading2 } from '@/components/design-system/headings';
import { heroImageHover, heroPanelClass } from '@/components/design-system/hero-image-hover';
import { Image } from 'astro:assets';
import anikaPortraitWarm from '@/assets/anika-portrait-warm.jpg';
---

<Layout title="Anika Warncke - Innenarchitektur & UX/UI Design">

  <!-- SPLIT HERO – Zwei Bilder nebeneinander mit Hover -->
  <section class="relative h-screen flex overflow-hidden">

    <!-- LINKS: Innenarchitektur -->
    <div class={`${heroPanelClass} hero-left`}>
      <img 
        src="/images/hero-interior.jpg" 
        alt="Innenarchitektur Projekt"
        class={heroImageHover}
      />
      <div class="absolute inset-0 bg-gradient-to-r from-black/60 to-transparent"></div>
    </div>

    <!-- RECHTS: UX/UI -->
    <div class={`${heroPanelClass} hero-right`}>
      <img 
        src="/images/hero-uxui.jpg" 
        alt="UX/UI Projekt"
        class={heroImageHover}
      />
      <div class="absolute inset-0 bg-gradient-to-l from-black/60 to-transparent"></div>
    </div>

    <!-- NUR DIESEN CONTAINER ERSETZEN -->
    <div class="pointer-events-none absolute inset-0 flex flex-col items-center justify-center z-10 px-6">
      <div class="pointer-events-auto bg-black/75 backdrop-blur-2xl px-16 py-16 rounded-3xl text-center max-w-[960px] border border-white/10">

        <ScrollReveal client:load>
          <h1 class="text-[5.4rem] md:text-[6.4rem] leading-none tracking-[-0.04em] text-white mb-6 drop-shadow-2xl">
            Anika Warncke
          </h1>
        </ScrollReveal>

        <ScrollReveal delay={0.1} client:load>
          <p class="text-[2.85rem] md:text-[3.2rem] font-light text-white mb-12 drop-shadow-xl">
            Innenarchitektur &amp; UX/UI Design
          </p>
        </ScrollReveal>

        <ScrollReveal delay={0.2} client:load>
          <p class="text-body-lg text-white/95 max-w-lg mx-auto drop-shadow-lg">
            Ich gestalte Räume und digitale Erlebnisse mit dem gleichen Prozess – strategisch, datenbasiert und emotional.
          </p>
        </ScrollReveal>

        <div class="flex flex-col sm:flex-row gap-6 mt-14 justify-center">
          <a href="/projekte" class="flex-1 bg-primary text-primary-foreground py-6 rounded-2xl font-medium text-lg transition-all duration-300 hover:bg-[hsl(var(--accent))] hover:text-[hsl(var(--accent-foreground))] hover:-translate-y-0.5 hover:shadow-xl">
            Projekte ansehen
          </a>
          <a href="/kontakt" class="flex-1 border-2 border-white text-white py-6 rounded-2xl font-medium text-lg hover:bg-white hover:text-primary transition-all">
            Lass uns sprechen
          </a>
        </div>

      </div>

      <!-- Scroll-Indikator – außerhalb des Kastens -->
      <div class="pointer-events-none mt-20 flex flex-col items-center gap-3 text-white">
        <span class="text-xs tracking-[3px] font-medium opacity-70">SCROLLEN</span>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="w-8 h-8 text-white drop-shadow-[0_3px_10px_rgba(0,0,0,0.7)] animate-bounce-slow"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2.5"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
        </svg>
      </div>
    </div>
  </section>

  <!-- PERSÖNLICHE AUSSAGE – mit größerem, elegantem Einstein-Zitat -->
  <section class="py-28 bg-background">
    <div class="container mx-auto max-w-3xl px-6 text-center">
      
      <ScrollReveal client:load>
        <p class="text-[2.1rem] md:text-[2.55rem] leading-tight text-foreground font-light max-w-3xl mx-auto">
          Ich liebe es, coole Dinge zu entwickeln
        </p>
      </ScrollReveal>

      <ScrollReveal delay={0.15} client:load>
        <p class="text-[2.1rem] md:text-[2.55rem] leading-tight text-foreground font-light max-w-3xl mx-auto">
          und zeitgleich komplexe Probleme für Menschen wie dich zu lösen.
        </p>
      </ScrollReveal>

      <ScrollReveal delay={0.45} client:load>
        <p class="text-base md:text-lg text-muted-foreground mt-14 italic">
          „Das Wichtigste ist, dass man nicht aufhört zu fragen.“<br />
          <span class="not-italic text-xs">– Albert Einstein</span>
        </p>
      </ScrollReveal>

    </div>
  </section>

  <!-- === AUSGEWÄHLTE PROJEKTE – Stacking + Button am Ende === -->
  <section class="relative py-20 bg-background">
    <div class="w-full">

      <ScrollReveal client:load>
        <Heading2 className="text-center mb-16">Ausgewählte Projekte</Heading2>
      </ScrollReveal>

      <div class="relative">

      <!-- Projekt 1 -->
      <div class="project-card sticky top-0 h-screen w-full overflow-hidden group cursor-none z-10" onclick="window.location='/projekte'">
        <img src="/images/my-mind-studio.jpg" alt="My Mind Studio" class="absolute inset-0 w-full h-full object-cover" />
        <div class="absolute inset-0 bg-gradient-to-b from-black/30 via-black/60 to-black/80"></div>
        <div class="absolute inset-0 flex flex-col items-center justify-center text-center text-white z-20 px-6">
          <h3 class="text-[3.2rem] md:text-[3.8rem] leading-none tracking-tight mb-4">My Mind Studio</h3>
          <p class="text-lg md:text-xl opacity-90">Meditations- und Yogastudio mit Café • Innenarchitektur</p>
        </div>
      </div>

      <!-- Projekt 2 -->
      <div class="project-card sticky top-0 h-screen w-full overflow-hidden group cursor-none z-20" onclick="window.location='/projekte'">
        <img src="/images/naturkompass.jpg" alt="NaturKompass" class="absolute inset-0 w-full h-full object-cover" />
        <div class="absolute inset-0 bg-gradient-to-b from-black/30 via-black/60 to-black/80"></div>
        <div class="absolute inset-0 flex flex-col items-center justify-center text-center text-white z-20 px-6">
          <h3 class="text-[3.2rem] md:text-[3.8rem] leading-none tracking-tight mb-4">NaturKompass</h3>
          <p class="text-lg md:text-xl opacity-90">Digitaler Begleiter zur Flora & Fauna • UX/UI Design</p>
        </div>
      </div>

      <!-- Projekt 3 -->
      <div class="project-card sticky top-0 h-screen w-full overflow-hidden group cursor-none z-30" onclick="window.location='/projekte'">
        <img src="/images/festsaal-klostergasthof.jpg" alt="Festsaal im Klostergasthof" class="absolute inset-0 w-full h-full object-cover" />
        <div class="absolute inset-0 bg-gradient-to-b from-black/30 via-black/60 to-black/80"></div>
        <div class="absolute inset-0 flex flex-col items-center justify-center text-center text-white z-20 px-6">
          <h3 class="text-[3.2rem] md:text-[3.8rem] leading-none tracking-tight mb-4">Festsaal im Klostergasthof</h3>
          <p class="text-lg md:text-xl opacity-90">Veranstaltungsgastronomie • Innenarchitektur</p>
        </div>
      </div>

      <!-- Projekt 4 -->
      <div class="project-card sticky top-0 h-screen w-full overflow-hidden group cursor-none z-40" onclick="window.location='/projekte'">
        <img src="/images/flavorfusion.jpg" alt="FlavorFusion" class="absolute inset-0 w-full h-full object-cover" />
        <div class="absolute inset-0 bg-gradient-to-b from-black/30 via-black/60 to-black/80"></div>
        <div class="absolute inset-0 flex flex-col items-center justify-center text-center text-white z-20 px-6">
          <h3 class="text-[3.2rem] md:text-[3.8rem] leading-none tracking-tight mb-4">FlavorFusion</h3>
          <p class="text-lg md:text-xl opacity-90">Landing Page für mobile Rezepte App • UX/UI Design</p>
        </div>
      </div>

      </div>

      <!-- Button "Alle Projekte ansehen" – jetzt richtig am Ende -->
      <div class="relative z-50 bg-background py-16 text-center">
        <a href="/projekte" class="text-primary hover:text-accent transition-colors text-lg font-medium">
          Alle Projekte ansehen →
        </a>
      </div>

    </div>
  </section>

  <!-- === WARUM ICH – mit drei großen Bildern (normaler Mauszeiger) === -->
  <section class="py-28 bg-background">
    <div class="container mx-auto max-w-5xl px-6">

      <ScrollReveal client:load>
        <Heading2 className="text-center mb-20">Warum ich</Heading2>
      </ScrollReveal>

      <div class="grid grid-cols-1 gap-12 md:grid-cols-3">

        <!-- Spalte 1: Raum verstehen -->
        <div class="group">
          <div class="relative mb-6 aspect-[4/3] overflow-hidden rounded-3xl">
            <img src="/images/warum-raum.jpg" alt="Raum verstehen" class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105" />
          </div>
          <h3 class="mb-3 text-h3">Raum verstehen</h3>
          <p class="text-body-sm text-muted-foreground">
            Ob physisch oder digital – ich beginne immer mit dem Menschen und seinem Kontext.
          </p>
        </div>

        <!-- Spalte 2: Ein Prozess -->
        <div class="group">
          <div class="relative mb-6 aspect-[4/3] overflow-hidden rounded-3xl">
            <img src="/images/warum-prozess.jpg" alt="Ein Prozess" class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105" />
          </div>
          <h3 class="mb-3 text-h3">Ein Prozess</h3>
          <p class="text-body-sm text-muted-foreground">
            Strategie, Konzeption, Design und Umsetzung – alles aus einer Hand mit dem gleichen roten Faden.
          </p>
        </div>

        <!-- Spalte 3: Emotion & Funktion -->
        <div class="group">
          <div class="relative mb-6 aspect-[4/3] overflow-hidden rounded-3xl">
            <img src="/images/warum-emotion.jpg" alt="Emotion &amp; Funktion" class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105" />
          </div>
          <h3 class="mb-3 text-h3">Emotion &amp; Funktion</h3>
          <p class="text-body-sm text-muted-foreground">
            Ich verbinde Ästhetik mit echter Nutzbarkeit – für Räume und Erlebnisse, die berühren.
          </p>
        </div>

      </div>

    </div>
  </section>

  <!-- === FINALER CALL-TO-ACTION – maximale Bildschärfe === -->
  <section class="relative py-32 bg-gradient-to-b from-background via-[#fdfaf5] to-background overflow-hidden">
    <div class="container mx-auto max-w-3xl px-6 text-center relative z-10">

      <ScrollReveal client:load>
        <div class="mb-12">
          <Image
            src={anikaPortraitWarm}
            alt="Anika Warncke"
            width={1200}
            height={1200}
            quality={95}
            format="webp"
            densities={[1, 2]}
            sizes="(max-width: 768px) 256px, 384px"
            class="mx-auto w-64 h-64 md:w-72 md:h-72 rounded-full object-cover shadow-2xl border-8 border-white/50"
          />
        </div>
      </ScrollReveal>

      <ScrollReveal client:load>
        <h2 class="text-h2 mb-8 leading-tight">
          Lass uns gemeinsam<br />etwas Schönes schaffen
        </h2>
      </ScrollReveal>

      <ScrollReveal delay={0.1} client:load>
        <p class="text-body-lg text-muted-foreground max-w-md mx-auto mb-14">
          Ich freue mich darauf, mit dir zusammenzuarbeiten.
          Ob Innenarchitektur oder UX/UI Design – erzähl mir einfach von deinem Vorhaben.
        </p>
      </ScrollReveal>

      <ScrollReveal delay={0.2} client:load>
        <a href="/kontakt"
           class="inline-block bg-primary text-primary-foreground px-16 py-7 rounded-3xl font-medium text-xl hover:bg-accent transition-all">
          Mit mir sprechen
        </a>
      </ScrollReveal>

      <ScrollReveal delay={0.3} client:load>
        <a href="/ueber-mich"
           class="mt-10 inline-block text-primary hover:text-accent transition-colors text-base font-medium">
          Mehr über mich erfahren →
        </a>
      </ScrollReveal>

      <ScrollReveal delay={0.4} client:load>
        <p class="text-xs text-muted-foreground mt-12">
          Deine Nachricht wird vertraulich behandelt.
        </p>
      </ScrollReveal>

    </div>
  </section>

  <!-- === CUSTOM CURSOR (größer) === -->
  <div id="custom-cursor" 
       class="fixed pointer-events-none hidden w-40 h-40 rounded-full bg-white/40 backdrop-blur-2xl flex flex-col items-center justify-center text-zinc-900 text-sm font-medium z-[9999] shadow-2xl gap-px">
    <span class="tracking-widest text-[14px]">PROJEKT</span>
    <span class="text-[18px]">ansehen</span>
  </div>

  <script>
    const cursor = document.getElementById('custom-cursor');
    const projects = document.querySelectorAll('.project-card');

    if (cursor instanceof HTMLElement) {
      projects.forEach(project => {
        project.addEventListener('mousemove', (e) => {
          const mouseEvent = e as MouseEvent;
          cursor.style.left = `${mouseEvent.clientX - 80}px`;
          cursor.style.top = `${mouseEvent.clientY - 80}px`;
          cursor.classList.remove('hidden');
        });

        project.addEventListener('mouseleave', () => {
          cursor.classList.add('hidden');
        });
      });
    }
  </script>

</Layout>