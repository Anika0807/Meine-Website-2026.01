---
import Layout from '@/layouts/Layout.astro';
import Button from '@/components/ui/astro-button.astro';
---

<Layout title="OmNomZen - Anika Warncke">
  <!-- 1. HERO -->
  <section class="relative min-h-[100svh] flex items-center justify-center overflow-hidden" data-reveal-group>
    <img src="/images/projekte/omnomzen-hero.webp" alt="OmNomZen Hero" class="absolute inset-0 w-full h-full object-cover" loading="eager" fetchpriority="high">
    <div class="absolute inset-0 bg-gradient-to-b from-black/40 via-black/20 to-black/70"></div>
    <div class="relative z-10 text-center text-white px-4 sm:px-6 max-w-4xl">
      <p class="reveal-item text-base md:text-lg font-semibold tracking-[0.16em] uppercase mb-3 opacity-95">UX/UI DESIGN • MOBILE APP</p>
      <h1 class="reveal-item text-[clamp(2.05rem,9.6vw,2.9rem)] md:text-[4.1rem] max-w-[16ch] mx-auto font-semibold tracking-tight leading-[0.92]">OmNomZen</h1>
      <p class="reveal-item mt-4 text-lg md:text-xl max-w-lg mx-auto opacity-90">Stressabbau mit Bio-Ashwagandha-Gummibärchen</p>
    </div>
  </section>

  <!-- Content Rail – alle weiteren Sections -->
  <div class="max-w-6xl mx-auto px-4 sm:px-6">

    <!-- === METADATA – Überschriften größer & fetter (nur OmNomZen) === -->
    <section class="pt-12 pb-20 md:pb-28 bg-background border-t border-border" data-reveal-group>
      <div class="max-w-7xl mx-auto px-0 md:px-12">
        
        <!-- Metadata Zeile – Mobile: vertikal gestapelt -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-y-10 md:gap-y-0 gap-x-8 mb-16 text-sm">
          <div class="reveal-item">
            <p class="uppercase tracking-widest text-sm font-medium text-foreground mb-3">Rolle & Team</p>
            <p class="text-foreground">
              <span class="text-primary font-medium">UX/UI-Designerin</span> im 3-Personen-Team mit Sten Rüdrich und Michael Jakob
            </p>
          </div>
          <div class="reveal-item">
            <p class="uppercase tracking-widest text-sm font-medium text-foreground mb-3">Aufgabe</p>
            <p class="text-foreground">
              <span class="text-primary font-medium">End-to-End Design</span> einer mobilen <span class="text-primary font-medium">E-Commerce-App</span> für Stressabbau mit Bio-Gummibärchen (Fokus: UI-Design & Prototyping)
            </p>
          </div>
          <div class="reveal-item">
            <p class="uppercase tracking-widest text-sm font-medium text-foreground mb-3">Zeitraum & Rahmen</p>
            <p class="text-foreground">
              Mai 2025: <br>
              <span class="text-primary font-medium">2-wöchiger Design-Sprint</span> im UX/UI-Bootcamp bei neuefische
            </p>
          </div>
          <div class="reveal-item">
            <p class="uppercase tracking-widest text-sm font-medium text-foreground mb-3">Tools</p>
            <p class="text-foreground">
              <span class="text-primary font-medium">Figma</span>, FigJam, Notion,<br>ChatGPT, Gemini
            </p>
          </div>
        </div>

      </div>
    </section>

    <!-- The Challenge – optimiert -->
    <section class="py-16 md:py-28 bg-background border-t border-border" data-reveal-group>
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="reveal-item text-h2 mb-8 md:mb-14">Die Herausforderung</h2>

          <p class="reveal-item text-base sm:text-lg md:text-xl text-muted-foreground leading-relaxed text-left md:text-center">
            Viele Menschen, die <span class="text-primary font-medium">Stress abbauen und achtsamer leben</span> wollen, fühlen sich im digitalen Handel von der Produktvielfalt <span class="text-primary font-medium">überfordert</span>.
            Sie suchen natürliche Lösungen wie Ashwagandha, finden aber meist nur funktionale Shops ohne <span class="text-primary font-medium">emotionale Ansprache oder echte Unterstützung</span>.
          </p>
      </div>
    </section>

    <!-- === RESEARCH HIGHLIGHTS – final optimiert === -->
    <section id="research" class="py-20 md:py-32 bg-muted/40 border-t border-border" data-reveal-group>
      <div class="max-w-7xl mx-auto px-6 md:px-12">

        <h2 class="reveal-item text-h2 text-center mb-12 md:mb-16">
          Research-Erkenntnisse
        </h2>

        <!-- Drei Insights -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-12 mb-16">
          <div class="text-center reveal-item">
            <div class="inline-flex h-14 w-14 items-center justify-center rounded-full border-2 border-emerald-700 text-3xl font-semibold text-primary mb-6">01</div>
            <p class="text-xl font-medium">Natürliche Orientierung</p>
            <p class="text-muted-foreground mt-3">Nutzer:innen suchen bei Stressabbau-Produkten vor allem nach <span class="text-primary font-medium">klaren, natürlichen Inhaltsstoffen</span> und <span class="text-primary font-medium">spürbarer Wirkung.</span></p>
          </div>
          <div class="text-center reveal-item">
            <div class="inline-flex h-14 w-14 items-center justify-center rounded-full border-2 border-emerald-700 text-3xl font-semibold text-primary mb-6">02</div>
            <p class="text-xl font-medium">Spielerische Motivation</p>
            <p class="text-muted-foreground mt-3">Sie wünschen sich eine <span class="text-primary font-medium">leichte, motivierende Erfahrung</span>, die Entspannung nicht wie eine Pflicht, sondern wie etwas <span class="text-primary font-medium">Angenehmes</span> wirken lässt.</p>
          </div>
          <div class="text-center reveal-item">
            <div class="inline-flex h-14 w-14 items-center justify-center rounded-full border-2 border-emerald-700 text-3xl font-semibold text-primary mb-6">03</div>
            <p class="text-xl font-medium">Nachhaltige Verantwortung</p>
            <p class="text-muted-foreground mt-3">Vertrauen entsteht durch <span class="text-primary font-medium">transparente Herkunft</span> und <span class="text-primary font-medium">faire Produktion.</span> Nutzer:innen wollen wissen, dass ihre Wahl gut für sich und die Umwelt ist.</p>
          </div>
        </div>

        <!-- Prozente -->
        <!-- ...existing code... -->

        <!-- Quotes + How might we -->
        <div class="reveal-item max-w-3xl mx-auto text-center">
          <div class="italic text-foreground text-xl md:text-2xl font-semibold mb-12">
            „Ich will genau wissen, was drin ist und dass es fair und nachhaltig produziert wurde.“<br>
            „Es soll Spaß machen und mich wirklich motivieren.“
          </div>

          <p class="text-2xl md:text-4xl font-semibold tracking-tight leading-tight text-foreground">
            Wie können <span class="text-primary font-medium">gestresste Menschen</span> schnell und <span class="text-primary font-medium">unkompliziert</span> eine <span class="text-primary font-medium">vertrauenswürdige</span> und <span class="text-primary font-medium">spielerische</span> Möglichkeit finden, <span class="text-primary font-medium">Stress zu reduzieren</span> und sich dabei <span class="text-primary font-medium">gut informiert</span> zu fühlen?
          </p>
        </div>
      </div>
    </section>

    <!-- === PROCESS – komplett mit UI-Foundation + Moodboard === -->
    <section id="process" class="py-24 md:py-32 bg-background border-t border-border">
      <div class="max-w-7xl mx-auto px-6 md:px-12">

        <h2 class="text-h2 text-center mb-12 md:mb-16 reveal">
          Process
        </h2>

        <!-- User Flow -->
        <div class="mb-20 reveal" style="transition-delay: 80ms">
          <img src="/images/projekte/omnomzen-user-flow.webp"
            alt="FlavorFusion User Flow"
               class="w-full rounded-3xl shadow-2xl" loading="lazy">
        </div>

        <!-- Designprinzipien -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-10 mb-20" style="transition-delay: 160ms">
          <div class="bg-background border border-border p-8 md:p-10 rounded-3xl reveal">
            <div class="text-primary text-5xl font-semibold mb-6">01</div>
            <h3 class="text-2xl font-medium mb-4">Natürlich</h3>
            <p class="text-body text-muted-foreground">
              Unsere Bio-Ashwagandha-Gummibärchen stammen aus der Natur und fördern ein <span class="text-primary font-medium">spürbares Wohlbefinden</span>.
            </p>
          </div>
          <div class="bg-background border border-border p-8 md:p-10 rounded-3xl reveal">
            <div class="text-primary text-5xl font-semibold mb-6">02</div>
            <h3 class="text-2xl font-medium mb-4">Spielerisch</h3>
            <p class="text-body text-muted-foreground">
              Die Umsetzung in farbenfrohe Gummibärchen mit Punkte-System macht Entspannung <span class="text-primary font-medium">leicht und genussvoll</span>.
            </p>
          </div>
          <div class="bg-background border border-border p-8 md:p-10 rounded-3xl reveal">
            <div class="text-primary text-5xl font-semibold mb-6">03</div>
            <h3 class="text-2xl font-medium mb-4">Nachhaltig</h3>
            <p class="text-body text-muted-foreground">
              Transparente, faire Herstellung und Lieferung spiegeln unsere <span class="text-primary font-medium">Verantwortung gegenüber Mensch und Umwelt</span> wider.
            </p>
          </div>
        </div>

        <!-- UI-Foundation + Moodboard -->
        <div class="grid grid-cols-1 md:grid-cols-1 gap-8 md:gap-12" style="transition-delay: 240ms">
          <div class="reveal">
            <h4 class="uppercase tracking-widest text-sm text-muted-foreground mb-6">UI-Foundation</h4>
            <!-- Hier deine UI-Foundation Bilder / Grid einfügen -->
            <img src="/images/projekte/omnomzen-ui-foundation.webp" alt="OmNomZen UI Foundation" class="w-full rounded-3xl shadow-xl" loading="lazy">
          </div>
        </div>
      </div>
    </section>

    <script>
      // @ts-nocheck
      // Staggered Reveal (gleiche Animation wie Challenge + Research)
      function initProcessReveal() {
        const reveals = /** @type {NodeListOf<HTMLElement>} */ (document.querySelectorAll('#process .reveal'));
        reveals.forEach((el, i) => {
          el.style.opacity = '0';
          el.style.transform = 'translateY(30px)';
          el.style.transition = 'all 1s cubic-bezier(0.25, 0.1, 0.25, 1)';

          const observer = new IntersectionObserver((entries) => {
            if (!entries[0].isIntersecting) return;
            setTimeout(() => {
              el.style.opacity = '1';
              el.style.transform = 'translateY(0)';
            }, i * 140);
            observer.disconnect();
          }, { threshold: 0.12, rootMargin: '0px 0px -10% 0px' });

          observer.observe(el);
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initProcessReveal, { once: true });
      } else {
        initProcessReveal();
      }
    </script>

    <section id="final-design" class="py-24 md:py-32 bg-muted/40 border-t border-border">
      <div class="max-w-7xl mx-auto px-6 md:px-12">
        <h2 class="reveal text-h2 text-center mb-12 md:mb-16">Finales Design</h2>

        <!-- ...existing code... -->

        <!-- Haupt- & Nebenfunktionen -->
        <div class="reveal mb-20" style="transition-delay: 220ms">
          <h3 class="uppercase tracking-widest text-sm text-muted-foreground mb-8 text-center">EINBLICKE IN DIE APP</h3>
          <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-8">
            <img src="/images/projekte/omnomzen-feature-01.webp" alt="OmNomZen Feature 01" class="w-full rounded-3xl shadow-xl" loading="lazy">
            <img src="/images/projekte/omnomzen-feature-02.webp" alt="OmNomZen Feature 02" class="w-full rounded-3xl shadow-xl" loading="lazy">
            <img src="/images/projekte/omnomzen-feature-03.webp" alt="OmNomZen Feature 03" class="w-full rounded-3xl shadow-xl" loading="lazy">
            <img src="/images/projekte/omnomzen-feature-04.webp" alt="OmNomZen Feature 04" class="w-full rounded-3xl shadow-xl" loading="lazy">
          </div>
        </div>

        <!-- Live Preview -->
        <div class="reveal text-center" style="transition-delay: 360ms">
          <h3 class="uppercase tracking-widest text-sm text-muted-foreground mb-8">LIVE PREVIEW</h3>
          <div class="max-w-2xl mx-auto rounded-3xl overflow-hidden shadow-2xl bg-black aspect-video">
            <iframe class="w-full h-full"
                    src="https://www.youtube.com/embed/pWxjAKkdBLk"
                    title="OmNomZen Live Preview"
                    frameborder="0"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                    allowfullscreen></iframe>
          </div>
          <p class="mt-8 text-muted-foreground max-w-md mx-auto text-sm md:text-base">
            Das Ergebnis ist eine ruhige, <span class="text-primary font-medium">intuitive und spielerische</span> App,
            die das <span class="text-primary font-medium">Wohlbefinden</span> unterstützt – <span class="text-primary font-medium">ohne zu überfordern.</span>
          </p>
        </div>
      </div>
    </section>

    <script>
      // @ts-nocheck
      // Gleiche sanfte Reveal-Animation wie bei Challenge, Research und Process
      function initFinalReveal() {
        const reveals = /** @type {NodeListOf<HTMLElement>} */ (document.querySelectorAll('#final-design .reveal'));
        reveals.forEach((el, i) => {
          el.style.opacity = '0';
          el.style.transform = 'translateY(30px)';
          el.style.transition = 'all 1s cubic-bezier(0.25, 0.1, 0.25, 1)';

          const observer = new IntersectionObserver((entries) => {
            if (!entries[0].isIntersecting) return;
            setTimeout(() => {
              el.style.opacity = '1';
              el.style.transform = 'translateY(0)';
            }, i * 140);
            observer.disconnect();
          }, { threshold: 0.12, rootMargin: '0px 0px -10% 0px' });

          observer.observe(el);
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initFinalReveal, { once: true });
      } else {
        initFinalReveal();
      }
    </script>

    <!-- === RESULTS & LEARNINGS – final optimiert mit grünen Highlights === -->
    <section id="results" class="py-20 md:py-32 bg-background border-t border-border">
      <div class="max-w-7xl mx-auto px-6 md:px-12">

        <h2 class="text-h2 text-center mb-12 md:mb-20 reveal">
          Results & Learnings
        </h2>

        <p class="max-w-3xl mx-auto text-lg md:text-xl text-muted-foreground text-left md:text-center mb-16 md:mb-20 reveal" style="transition-delay: 80ms">
             OmNomZen ist ein Prototyp einer intuitiven mobilen E-Commerce-Plattform für Bio-Ashwagandha-Gummibärchen.
             Die Arbeit daran war eine erfüllende Erfahrung, ein <span class="text-primary font-medium">sinnstiftendes Produkt</span> zu gestalten, das Menschen zu <span class="text-primary font-medium">mehr Wohlbefinden und weniger Stress</span> verhilft.
        </p>

        <!-- Drei Karten mit gezielten grünen Highlights -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8 mb-16" style="transition-delay: 160ms">

          <div class="bg-background border border-border p-8 md:p-10 rounded-3xl shadow-sm reveal">
            <div class="text-primary text-5xl font-semibold mb-6">01</div>
            <h3 class="text-2xl font-medium mb-4">Kommunikation als Problemlöser</h3>
            <p class="text-muted-foreground text-base md:text-base leading-relaxed">
              Die Kommunikation und das Arbeiten in einer Datei kann als dynamische kreative Gruppe eine Herausforderung sein. <span class="text-primary font-medium">Klare und flüssige Kommunikation</span> ist der Schlüssel, um Probleme schnell zu beheben und Lösungen zu finden.
            </p>
          </div>

          <div class="bg-background border border-border p-8 md:p-10 rounded-3xl shadow-sm reveal">
            <div class="text-primary text-5xl font-semibold mb-6">02</div>
            <h3 class="text-2xl font-medium mb-4">Die Kraft früher Iteration</h3>
            <p class="text-muted-foreground text-base md:text-base leading-relaxed">
              <span class="text-primary font-medium">Frühzeitiges und ausgiebiges Testen</span> hebt die Produktqualität auf ein neues Level und führt zu wirklich intuitivem Design. <span class="text-primary font-medium">Nutzerfeedback</span> ist dabei der wichtigste Maßstab für Markenwerte.
            </p>
          </div>

          <div class="bg-background border border-border p-8 md:p-10 rounded-3xl shadow-sm reveal">
            <div class="text-primary text-5xl font-semibold mb-6">03</div>
            <h3 class="text-2xl font-medium mb-4">Mut zur Entscheidung</h3>
            <p class="text-muted-foreground text-base md:text-base leading-relaxed">
              Der enge Zeitrahmen hat gezeigt, wie entscheidend der <span class="text-primary font-medium">Mut zur schnellen Entscheidung</span> ist. Anstatt auf eine perfekte Datenlage zu warten, ist es effektiver, auf Basis fundierter Hypothesen zügig zu handeln.
            </p>
          </div>
        </div>

        <!-- Nächste Schritte -->
        <div class="max-w-2xl mx-auto mb-16 reveal" style="transition-delay: 240ms">
          <h3 class="uppercase tracking-widest text-sm text-muted-foreground mb-6 text-center">NÄCHSTE SCHRITTE</h3>
          <ul class="space-y-6 text-base md:text-base text-muted-foreground">
              <li class="flex gap-4">→ Ausbau der Gamification: Detaillierte Konzeption von Punktesystemen und Belohnungen</li>
              <li class="flex gap-4">→ Social Media: Entwicklung einer Content-Strategie für Instagram und TikTok</li>
              <li class="flex gap-4">→ Produkterweiterung: Evaluierung neuer Geschmacksrichtungen und Merchandise-Artikel</li>
              <li class="flex gap-4">→ Usability-Tests: Durchführung weiterer Tests mit einer breiteren Nutzerbasis</li>
          </ul>
        </div>

        <!-- Zurück-Button -->
        <div class="flex justify-center">
          <Button href="/projekte" variant="primary" size="lg" class="w-full sm:w-auto">Zurück zu allen Projekten →</Button>
        </div>

        <!-- Projekt-Navigation -->
        <div class="mt-14 md:mt-20 pt-8 md:pt-12 border-t border-border flex flex-col md:flex-row gap-4 md:gap-6 justify-between">
          <Button href="/projekte/flavorfusion" variant="primary" size="lg" class="w-full md:w-auto">← Letztes Projekt</Button>
          <Button href="/projekte/planora" variant="primary" size="lg" class="w-full md:w-auto">Nächstes Projekt →</Button>
        </div>

      </div>
    </section>

    <script>
      // @ts-nocheck
      // Sanfte Reveal-Animation (wie bei allen anderen Blöcken)
      function initResultsReveal() {
        const reveals = /** @type {NodeListOf<HTMLElement>} */ (document.querySelectorAll('#results .reveal'));
        reveals.forEach((el, i) => {
          el.style.opacity = '0';
          el.style.transform = 'translateY(30px)';
          el.style.transition = 'all 1s cubic-bezier(0.25, 0.1, 0.25, 1)';

          const observer = new IntersectionObserver((entries) => {
            if (!entries[0].isIntersecting) return;
            setTimeout(() => {
              el.style.opacity = '1';
              el.style.transform = 'translateY(0)';
            }, i * 140);
            observer.disconnect();
          }, { threshold: 0.12, rootMargin: '0px 0px -10% 0px' });

          observer.observe(el);
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initResultsReveal, { once: true });
      } else {
        initResultsReveal();
      }
    </script>

    <script>
      // @ts-nocheck
      function animateCounter(id, target, duration = 1600) {
        const counter = document.getElementById(id);
        if (!(counter instanceof HTMLElement)) return;
        const startTime = performance.now();

        function update(now) {
          const progress = Math.min((now - startTime) / duration, 1);
          counter.textContent = String(Math.floor(progress * target));
          if (progress < 1) requestAnimationFrame(update);
        }

        requestAnimationFrame(update);
      }

      function initSequentialReveals() {
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const groups = /** @type {NodeListOf<HTMLElement>} */ (document.querySelectorAll('[data-reveal-group]'));

        groups.forEach((group) => {
          const items = /** @type {NodeListOf<HTMLElement>} */ (group.querySelectorAll('.reveal-item'));
          if (!items.length) return;

          if (reduceMotion) {
            items.forEach((item) => {
              item.style.opacity = '1';
              item.style.transform = 'none';
            });
            if (group.id === 'research') {
              animateCounter('count-60', 60);
              animateCounter('count-88', 88);
              animateCounter('count-56', 56);
              animateCounter('count-42', 42);
            }
            return;
          }

          items.forEach((item) => {
            item.style.opacity = '0';
            item.style.transform = 'translateY(28px)';
            item.style.transition = 'all 1s cubic-bezier(0.25, 0.1, 0.25, 1)';
            item.style.willChange = 'opacity, transform';
          });

          const observer = new IntersectionObserver((entries) => {
            if (!entries[0].isIntersecting) return;

            items.forEach((item, index) => {
              setTimeout(() => {
                item.style.opacity = '1';
                item.style.transform = 'translateY(0)';

                if (group.id === 'research' && group.dataset.countAnimated !== 'true' && item.querySelector('#count-60')) {
                  animateCounter('count-60', 60);
                  animateCounter('count-88', 88);
                  animateCounter('count-56', 56);
                  animateCounter('count-42', 42);
                  group.dataset.countAnimated = 'true';
                }
              }, index * 160);
            });
            group.dataset.revealed = 'true';

            observer.disconnect();
          }, { threshold: 0.2, rootMargin: '0px 0px -8% 0px' });

          observer.observe(group);
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initSequentialReveals, { once: true });
      } else {
        initSequentialReveals();
      }
    </script>

  </div>

</Layout>
