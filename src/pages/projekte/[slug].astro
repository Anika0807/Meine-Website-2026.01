---
import Button from '@/components/ui/astro-button.astro';
import Layout from '@/layouts/Layout.astro';

const projects = {
  'my-mind-studio': {
    title: 'My Mind Studio',
    category: 'Innenarchitektur',
    subtitle: 'Meditations- und Yogastudio mit Café',
    image: '/images/my-mind-studio.jpg',
  },
  naturkompass: {
    title: 'NaturKompass',
    category: 'UX/UI Design',
    subtitle: 'Ihr digitaler Begleiter zur Identifikation von Flora & Fauna',
    image: '/images/naturkompass.jpg',
  },
  'festsaal-im-klostergasthof': {
    title: 'Festsaal im Klostergasthof',
    category: 'Innenarchitektur',
    subtitle: 'Veranstaltungsgastronomie für Hochzeiten und Events',
    image: '/images/festsaal.jpg',
  },
  flavorfusion: {
    title: 'FlavorFusion',
    category: 'UX/UI Design',
    subtitle: 'Landing Page für eine mobile Rezepte App',
    image: '/images/flavorfusion.jpg',
  },
  schlaf: {
    title: 'SCHLAF',
    category: 'Innenarchitektur',
    subtitle: 'Eine Erlebnisausstellung in die Tiefen des Schlafes',
    image: '/images/schlaf.jpg',
  },
  omnomzen: {
    title: 'OmNomZen',
    category: 'UX/UI Design',
    subtitle: 'Stressabbau mit Bio-Ashwagandha-Gummibärchen',
    image: '/images/omnomzen.jpg',
  },
  weserkoje: {
    title: 'weserkoje',
    category: 'Innenarchitektur',
    subtitle: 'Multifunktionale Herberge mit integriertem Tagungszentrum',
    image: '/images/weserkoje.jpg',
  },
  planora: {
    title: 'Planora',
    category: 'UX/UI Design',
    subtitle: 'Reiseplanung, die sich dir anpasst',
    image: '/images/planora.jpg',
  },
} as const;

export function getStaticPaths() {
  return [];
}

const { slug } = Astro.params;
const project = projects[slug as keyof typeof projects];

if (!project) {
  return Astro.redirect('/projekte');
}
---

<Layout title={`${project.title} | Projekte`}>
  <section class="relative h-[70svh] min-h-[520px] w-full overflow-hidden">
    <img src={project.image} alt={project.title} class="absolute inset-0 h-full w-full object-cover" loading="eager" fetchpriority="high" />
    <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/45 to-black/20"></div>

    <div class="absolute inset-0 flex items-end">
      <div class="mx-auto w-full max-w-6xl px-6 pb-16 text-white">
        <p class="mb-3 text-xs uppercase tracking-[0.2em] text-white/80">{project.category}</p>
        <h1 class="text-[2.2rem] sm:text-[2.9rem] md:text-[4.1rem] max-w-[16ch] font-semibold tracking-tight leading-[0.92]">{project.title}</h1>
        <p class="mt-4 max-w-2xl text-base text-white/90 md:text-lg">{project.subtitle}</p>
      </div>
    </div>
  </section>

  <section class="bg-background py-20">
    <div class="mx-auto max-w-3xl px-6 text-center">
      <h2 class="text-h3 md:text-h2 font-semibold tracking-tight">Projektübersicht</h2>
      <p class="mt-6 text-base text-muted-foreground md:text-lg">
        Diese Unterseite ist die Detailansicht für {project.title}. Inhalte wie Prozess, Ziele und Ergebnisse
        können hier jederzeit ergänzt werden.
      </p>
      <Button href="/projekte" variant="primary" size="lg" class="mt-10">
        Zurück zu den Projekten
      </Button>
    </div>
  </section>
</Layout>
