---
import Layout from '@/layouts/Layout.astro';
---

<Layout title="Projects">
  <section class="py-32 bg-background">
    <div class="w-full px-6">
      <div class="mb-40">
        <div class="relative z-50 bg-background pb-6">
          <h2 class="text-5xl md:text-6xl font-semibold tracking-tight leading-[0.95] mb-12 text-center">Selected Projects</h2>
        </div>
        <div class="w-screen relative left-1/2 right-1/2 -mx-[50vw]">
          <!-- 1. My Mind Studio -->
          <div class="project-card group relative overflow-hidden h-[88svh] sm:h-[92svh] md:h-screen w-full sticky top-0 z-10 md:cursor-none cursor-pointer" onclick="window.location='/en/projects/my-mind-studio'">
            <img src="/images/my-mind-studio.jpg" alt="My Mind Studio" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/50 to-transparent md:from-black/65"></div>
            <div class="absolute inset-0 flex flex-col items-center justify-center text-center text-white px-6">
              <p class="text-xs tracking-widest uppercase text-white/80 mb-2">Interior Architecture</p>
              <h3 class="text-3xl md:text-5xl font-semibold tracking-tighter">My Mind Studio</h3>
              <p class="text-sm md:text-base mt-3 opacity-90">Meditation and yoga studio with café</p>
            </div>
          </div>
          <!-- 2. NaturKompass -->
          <div class="project-card group relative overflow-hidden h-[88svh] sm:h-[92svh] md:h-screen w-full sticky top-0 z-20 mt-[-3svh] md:mt-0 md:cursor-none cursor-pointer" onclick="window.location='/en/projects/naturkompass'">
            <img src="/images/naturkompass.jpg" alt="NaturKompass" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/50 to-transparent md:from-black/65"></div>
            <div class="absolute inset-0 flex flex-col items-center justify-center text-center text-white px-6">
              <p class="text-xs tracking-widest uppercase text-white/80 mb-2">UX/UI Design</p>
              <h3 class="text-3xl md:text-5xl font-semibold tracking-tighter">NaturKompass</h3>
              <p class="text-sm md:text-base mt-3 opacity-90">Your digital companion for identifying flora & fauna</p>
            </div>
          </div>
          <!-- ...other project cards... -->
        </div>
      </div>
    </div>
  </section>
</Layout>
