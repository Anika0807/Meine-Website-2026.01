---
import Layout from '@/layouts/Layout.astro';
---

<Layout title="NaturKompass – Anika Warncke">
  <!-- 1. HERO -->
  <section class="relative min-h-[100svh] flex items-center justify-center overflow-hidden" data-reveal-group>
    <img src="/images/projekte/naturkompass-hero.jpg" alt="NaturKompass" class="absolute inset-0 w-full h-full object-cover" loading="eager" fetchpriority="high">
    <div class="absolute inset-0 bg-gradient-to-b from-black/40 via-black/20 to-black/70"></div>
    <div class="relative z-10 text-center text-white px-4 sm:px-6 max-w-4xl">
      <p class="reveal-item text-sm tracking-[4px] uppercase font-medium mb-4 opacity-90">UX/UI DESIGN • MOBILE APP</p>
      <h1 class="reveal-item text-5xl sm:text-6xl md:text-7xl font-semibold tracking-tighter leading-none">NaturKompass</h1>
      <p class="reveal-item mt-5 text-base sm:text-xl md:text-2xl max-w-lg mx-auto opacity-90">Your digital companion for identifying flora & fauna</p>
    </div>
  </section>

  <!-- Content Rail – all further sections -->
  <div class="max-w-6xl mx-auto px-4 sm:px-6">

    <!-- === METADATA – with subtle green highlights (NaturKompass only) === -->
    <section class="pt-12 pb-20 md:pb-28 bg-background border-t border-border" data-reveal-group>
      <div class="max-w-7xl mx-auto px-0 md:px-12">
        
        <!-- Metadata row – Mobile: vertically stacked -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-y-10 md:gap-y-0 gap-x-8 mb-16 text-sm">
          <div class="reveal-item">
            <p class="uppercase tracking-widest text-sm font-medium text-foreground mb-3">Role & Team</p>
            <p class="text-foreground">
              <span class="text-primary font-medium">UX/UI Designer</span> in a 2-person team<br>with Michael Jakob
            </p>
          </div>
          <div class="reveal-item">
            <p class="uppercase tracking-widest text-sm font-medium text-foreground mb-3">Task</p>
            <p class="text-foreground">
              <span class="text-primary font-medium">End-to-End</span> design process:<br>Research, UI design, prototyping & testing
            </p>
          </div>
          <div class="reveal-item">
            <p class="uppercase tracking-widest text-sm font-medium text-foreground mb-3">Timeline & Scope</p>
            <p class="text-foreground">
              June – July 2025<br>
              <span class="text-primary font-medium">4-week design sprint</span> at the neuefische UX/UI Bootcamp
            </p>
          </div>
          <div class="reveal-item">
            <p class="uppercase tracking-widest text-sm font-medium text-foreground mb-3">Tools</p>
            <p class="text-foreground">
              <span class="text-primary font-medium">Figma</span>, FigJam, Notion,<br>ChatGPT, Gemini, DaVinci Resolve
            </p>
          </div>
        </div>

      </div>
    </section>

    <!-- The Challenge – optimized -->
    <section class="py-16 md:py-28 bg-background border-t border-border" data-reveal-group>
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="reveal-item text-h2 mb-8 md:mb-14">The Challenge</h2>

        <p class="reveal-item text-base sm:text-lg md:text-xl text-muted-foreground leading-relaxed">
          Nature lovers face a frustrating choice: they can use overloaded apps,
          or skip valuable information completely. What is missing is an
          <span class="text-primary font-medium">intuitive, offline-capable tool</span>
          that helps identify flora and fauna without disrupting the real nature experience.
        </p>
      </div>
    </section>

    <!-- === RESEARCH HIGHLIGHTS – final optimized === -->
    <section id="research" class="py-20 md:py-32 bg-muted/40 border-t border-border" data-reveal-group>
      <div class="max-w-7xl mx-auto px-6 md:px-12">

        <h2 class="reveal-item text-h2 text-center mb-12 md:mb-16">
          Research Highlights
        </h2>

        <!-- Three insights -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-12 mb-16">
          <div class="text-center reveal-item">
            <div class="inline-flex h-14 w-14 items-center justify-center rounded-full border-2 border-emerald-700 text-3xl font-semibold text-primary mb-6">1</div>
            <p class="text-xl font-medium">A Strong Desire to Learn</p>
            <p class="text-muted-foreground mt-3">Users want to experience nature and truly <span class="text-primary font-medium">understand</span> it.</p>
          </div>
          <div class="text-center reveal-item">
            <div class="inline-flex h-14 w-14 items-center justify-center rounded-full border-2 border-emerald-700 text-3xl font-semibold text-primary mb-6">2</div>
            <p class="text-xl font-medium">Less Is More</p>
            <p class="text-muted-foreground mt-3">Information should be available on demand, but remain <span class="text-primary font-medium">unobtrusive</span>.</p>
          </div>
          <div class="text-center reveal-item">
            <div class="inline-flex h-14 w-14 items-center justify-center rounded-full border-2 border-emerald-700 text-3xl font-semibold text-primary mb-6">3</div>
            <p class="text-xl font-medium">Balanced Gamification</p>
            <p class="text-muted-foreground mt-3">Not for everyone.</p>
          </div>
        </div>

        <!-- Percentages -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8 md:gap-12 mb-16">
          <div class="text-center reveal-item"><div class="text-4xl sm:text-5xl md:text-6xl font-bold text-primary"><span id="count-60">0</span>%</div><p class="text-xs sm:text-sm mt-2">IN NATURE DAILY</p></div>
          <div class="text-center reveal-item"><div class="text-4xl sm:text-5xl md:text-6xl font-bold text-primary"><span id="count-88">0</span>%</div><p class="text-xs sm:text-sm mt-2">FOR RELAXATION</p></div>
          <div class="text-center reveal-item"><div class="text-4xl sm:text-5xl md:text-6xl font-bold text-primary"><span id="count-56">0</span>%</div><p class="text-xs sm:text-sm mt-2">WANT TO EXPLORE ACTIVELY</p></div>
          <div class="text-center reveal-item"><div class="text-4xl sm:text-5xl md:text-6xl font-bold text-primary"><span id="count-42">0</span>%</div><p class="text-xs sm:text-sm mt-2">POLLEN TRACKING INTEREST</p></div>
        </div>

        <!-- Quotes + How might we -->
        <div class="reveal-item max-w-3xl mx-auto text-center">
          <div class="italic text-foreground text-xl md:text-2xl font-semibold mb-12">
            "Small info cards are great, but please don't clutter the screen."<br>
            "I want to know exactly what it is, not 33 suggestions."
          </div>

          <p class="text-2xl md:text-4xl font-semibold tracking-tight leading-tight text-foreground">
            How might we help people explore nature with curiosity and awareness,
            supported by a <span class="text-primary">calm, offline-capable digital companion</span>?
          </p>
        </div>
      </div>
    </section>

    <!-- === PROCESS – complete with UI-Foundation + Moodboard === -->
    <section id="process" class="py-24 md:py-32 bg-background border-t border-border">
      <div class="max-w-7xl mx-auto px-6 md:px-12">

        <h2 class="text-h2 text-center mb-12 md:mb-16 reveal">
          Process
        </h2>

        <!-- User Flow -->
        <div class="mb-20 reveal" style="transition-delay: 80ms">
          <img src="/images/projekte/naturkompass-user-flow.png"
               alt="User Flow"
               class="w-full rounded-3xl shadow-2xl" loading="lazy">
        </div>

        <!-- Design principles -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-10 mb-20">
          <div class="bg-background border border-border p-8 md:p-10 rounded-3xl reveal">
            <div class="text-primary text-5xl font-semibold mb-6">01</div>
            <h3 class="text-2xl font-medium mb-4">Subtle Guidance</h3>
            <p class="text-body text-muted-foreground">
              Frosted glass + minimal elements keep the focus on the <span class="text-primary font-medium">nature experience</span>.
            </p>
          </div>
          <div class="bg-background border border-border p-8 md:p-10 rounded-3xl reveal">
            <div class="text-primary text-5xl font-semibold mb-6">02</div>
            <h3 class="text-2xl font-medium mb-4">Accessible Design</h3>
            <p class="text-body text-muted-foreground">
              Clear navigation and high readability for <span class="text-primary font-medium">easy use</span>.
            </p>
          </div>
          <div class="bg-background border border-border p-8 md:p-10 rounded-3xl reveal">
            <div class="text-primary text-5xl font-semibold mb-6">03</div>
            <h3 class="text-2xl font-medium mb-4">Inspiring Knowledge Delivery</h3>
            <p class="text-body text-muted-foreground">
              Knowledge is shared in precise, engaging micro-moments and clearly <span class="text-primary font-medium">communicated</span>.
            </p>
          </div>
        </div>

        <!-- UI-Foundation + Moodboard -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12">
          <div class="reveal">
            <h4 class="uppercase tracking-widest text-sm text-muted-foreground mb-6">UI-Foundation</h4>
            <img src="/images/projekte/naturkompass-ui-foundation.png" alt="UI-Foundation" class="w-full rounded-3xl shadow-xl" loading="lazy">
          </div>
          <div class="reveal">
            <h4 class="uppercase tracking-widest text-sm text-muted-foreground mb-6">Moodboard</h4>
            <img src="/images/projekte/naturkompass-moodboard.png" alt="Moodboard" class="w-full rounded-3xl shadow-xl" loading="lazy">
          </div>
        </div>
      </div>
    </section>

    <script>
      // Staggered reveal (same animation as Challenge + Research)
      function initProcessReveal() {
        const reveals = document.querySelectorAll<HTMLElement>('#process .reveal');
        reveals.forEach((el, i) => {
          el.style.opacity = '0';
          el.style.transform = 'translateY(30px)';
          el.style.transition = 'all 1s cubic-bezier(0.25, 0.1, 0.25, 1)';

          const observer = new IntersectionObserver((entries) => {
            if (!entries[0].isIntersecting) return;
            setTimeout(() => {
              el.style.opacity = '1';
              el.style.transform = 'translateY(0)';
            }, i * 140);
            observer.disconnect();
          }, { threshold: 0.12, rootMargin: '0px 0px -10% 0px' });

          observer.observe(el);
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initProcessReveal, { once: true });
      } else {
        initProcessReveal();
      }
    </script>

    <section id="final-design" class="py-24 md:py-32 bg-muted/40 border-t border-border">
      <div class="max-w-7xl mx-auto px-6 md:px-12">
        <h2 class="reveal text-h2 text-center mb-12 md:mb-16">Final Design</h2>

        <!-- Onboarding Before / After -->
        <div class="reveal mb-20" style="transition-delay: 80ms">
          <h3 class="uppercase tracking-widest text-sm text-muted-foreground mb-8 text-center">ONBOARDING BEFORE / AFTER</h3>
          <img src="/images/projekte/naturkompass-onboarding-before-after.png" alt="Onboarding Before / After" class="w-full rounded-3xl shadow-2xl" loading="lazy">
        </div>

        <!-- Core & Secondary Features -->
        <div class="reveal mb-20" style="transition-delay: 220ms">
          <h3 class="uppercase tracking-widest text-sm text-muted-foreground mb-8 text-center">CORE & SECONDARY FEATURES</h3>
          <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-8">
            <img src="/images/projekte/Hauptfunktion 01.png" alt="Camera Forest" class="w-full rounded-3xl shadow-xl" loading="lazy">
            <img src="/images/projekte/Hauptfunktion 02.png" alt="Camera Flowers" class="w-full rounded-3xl shadow-xl" loading="lazy">
            <img src="/images/projekte/Hauptfunktion 03.png" alt="Filled feverfew" class="w-full rounded-3xl shadow-xl" loading="lazy">
            <img src="/images/projekte/Hauptfunktion 04.png" alt="Keep collecting?" class="w-full rounded-3xl shadow-xl" loading="lazy">
            <img src="/images/projekte/Nebenfunktionen 01.png" alt="Explore" class="w-full rounded-3xl shadow-xl" loading="lazy">
            <img src="/images/projekte/Nebenfunktionen 02.png" alt="Learn" class="w-full rounded-3xl shadow-xl" loading="lazy">
            <img src="/images/projekte/Nebenfunktionen 03.png" alt="My profile" class="w-full rounded-3xl shadow-xl" loading="lazy">
            <img src="/images/projekte/Nebenfunktionen 04.png" alt="Litter reporter" class="w-full rounded-3xl shadow-xl" loading="lazy">
          </div>
        </div>

        <!-- Live Preview -->
        <div class="reveal text-center" style="transition-delay: 360ms">
          <h3 class="uppercase tracking-widest text-sm text-muted-foreground mb-8">LIVE PREVIEW</h3>
          <div class="max-w-2xl mx-auto rounded-3xl overflow-hidden shadow-2xl bg-black aspect-video">
            <iframe class="w-full h-full"
                    src="https://www.youtube.com/embed/_Weccn01Gi8"
                    title="NaturKompass Live Preview"
                    frameborder="0"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                    allowfullscreen></iframe>
          </div>
          <p class="mt-8 text-muted-foreground max-w-md mx-auto text-sm md:text-base">
            The result is a calm, <span class="text-primary font-medium">intuitive and offline-capable</span> app
            that supports the nature experience without overwhelming users.
          </p>
        </div>
      </div>
    </section>

    <script>
      // Same gentle reveal animation as in Challenge, Research, and Process
      function initFinalReveal() {
        const reveals = document.querySelectorAll<HTMLElement>('#final-design .reveal');
        reveals.forEach((el, i) => {
          el.style.opacity = '0';
          el.style.transform = 'translateY(30px)';
          el.style.transition = 'all 1s cubic-bezier(0.25, 0.1, 0.25, 1)';

          const observer = new IntersectionObserver((entries) => {
            if (!entries[0].isIntersecting) return;
            setTimeout(() => {
              el.style.opacity = '1';
              el.style.transform = 'translateY(0)';
            }, i * 140);
            observer.disconnect();
          }, { threshold: 0.12, rootMargin: '0px 0px -10% 0px' });

          observer.observe(el);
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initFinalReveal, { once: true });
      } else {
        initFinalReveal();
      }
    </script>

    <!-- === RESULTS & LEARNINGS – final optimized with green highlights === -->
    <section id="results" class="py-20 md:py-32 bg-background border-t border-border">
      <div class="max-w-7xl mx-auto px-6 md:px-12">

        <h2 class="text-h2 text-center mb-12 md:mb-20 reveal">
          Results & Learnings
        </h2>

        <p class="max-w-3xl mx-auto text-lg md:text-xl text-muted-foreground text-center mb-16 md:mb-20 reveal" style="transition-delay: 80ms">
          In just 4 weeks, we designed a calm, intuitive, offline-capable app.
          Test participants described it as "<span class="text-primary font-medium">relaxing and genuinely helpful</span>."
        </p>

        <!-- Three cards with focused green highlights -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8 mb-16" style="transition-delay: 160ms">

          <div class="bg-background border border-border p-8 md:p-10 rounded-3xl shadow-sm reveal">
            <div class="text-primary text-5xl font-semibold mb-6">01</div>
            <h3 class="text-2xl font-medium mb-4">Less Is More</h3>
            <p class="text-muted-foreground text-[15px] md:text-base leading-relaxed">
              The biggest challenge was not adding features, but deliberately
              <span class="text-primary font-medium">removing</span> them so the joy of discovery stays front and center.
            </p>
          </div>

          <div class="bg-background border border-border p-8 md:p-10 rounded-3xl shadow-sm reveal">
            <div class="text-primary text-5xl font-semibold mb-6">02</div>
            <h3 class="text-2xl font-medium mb-4">Research as the Foundation</h3>
            <p class="text-muted-foreground text-[15px] md:text-base leading-relaxed">
              Deep user research and continuous iteration are the fastest path
              to truly <span class="text-primary font-medium">intuitive design</span>.
            </p>
          </div>

          <div class="bg-background border border-border p-8 md:p-10 rounded-3xl shadow-sm reveal">
            <div class="text-primary text-5xl font-semibold mb-6">03</div>
            <h3 class="text-2xl font-medium mb-4">Agency Builds Engagement</h3>
            <p class="text-muted-foreground text-[15px] md:text-base leading-relaxed">
              Features like the litter reporter give users a genuine sense of contribution and
              <span class="text-primary font-medium">increase long-term engagement</span>.
            </p>
          </div>
        </div>

        <div class="max-w-2xl mx-auto mb-16 reveal" style="transition-delay: 240ms">
          <h3 class="uppercase tracking-widest text-sm text-muted-foreground mb-6 text-center">NEXT STEPS</h3>
          <ul class="space-y-6 text-[15px] md:text-base text-muted-foreground">
            <li class="flex gap-4">→ Expand the MVP: complete missing screens and finalize the litter reporter feature</li>
            <li class="flex gap-4">→ Run field tests: validate the prototype with real users in real-world settings</li>
            <li class="flex gap-4">→ Developer collaboration: plan the implementation of the mobile app</li>
          </ul>
        </div>

        <div class="flex justify-center">
          <a href="/en/projects"
             class="w-full sm:w-auto bg-primary hover:bg-primary/90 text-primary-foreground text-base sm:text-lg font-medium px-6 sm:px-10 py-4 sm:py-6 rounded-btn text-center transition-all">
            Back to All Projects →
          </a>
        </div>

        <div class="mt-14 md:mt-20 pt-8 md:pt-12 border-t border-border flex flex-col md:flex-row gap-4 md:gap-6 justify-between">
          <a href="/projekte/en/[previous-project]"
             class="w-full md:w-auto bg-primary hover:bg-primary/90 text-primary-foreground text-base sm:text-lg font-medium px-6 sm:px-10 py-4 sm:py-6 rounded-btn text-center transition-all">
            ← Previous Project
          </a>
          <a href="/projekte/en/[next-project]"
             class="w-full md:w-auto bg-primary hover:bg-primary/90 text-primary-foreground text-base sm:text-lg font-medium px-6 sm:px-10 py-4 sm:py-6 rounded-btn text-center transition-all">
            Next Project →
          </a>
        </div>

      </div>
    </section>

    <script>
      // Gentle reveal animation (same behavior as the other sections)
      function initResultsReveal() {
        const reveals = document.querySelectorAll<HTMLElement>('#results .reveal');
        reveals.forEach((el, i) => {
          el.style.opacity = '0';
          el.style.transform = 'translateY(30px)';
          el.style.transition = 'all 1s cubic-bezier(0.25, 0.1, 0.25, 1)';

          const observer = new IntersectionObserver((entries) => {
            if (!entries[0].isIntersecting) return;
            setTimeout(() => {
              el.style.opacity = '1';
              el.style.transform = 'translateY(0)';
            }, i * 140);
            observer.disconnect();
          }, { threshold: 0.12, rootMargin: '0px 0px -10% 0px' });

          observer.observe(el);
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initResultsReveal, { once: true });
      } else {
        initResultsReveal();
      }
    </script>

    <script>
      function animateCounter(id: string, target: number, duration = 1600) {
        const el = document.getElementById(id);
        if (!el) return;
        const startTime = performance.now();

        function update(now: number) {
          const progress = Math.min((now - startTime) / duration, 1);
          el!.textContent = String(Math.floor(progress * target));
          if (progress < 1) requestAnimationFrame(update);
        }

        requestAnimationFrame(update);
      }

      function initSequentialReveals() {
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const groups = document.querySelectorAll<HTMLElement>('[data-reveal-group]');

        groups.forEach((group) => {
          const items = group.querySelectorAll<HTMLElement>('.reveal-item');
          if (!items.length) return;

          if (reduceMotion) {
            items.forEach((item) => {
              item.style.opacity = '1';
              item.style.transform = 'none';
            });
            if (group.id === 'research') {
              animateCounter('count-60', 60);
              animateCounter('count-88', 88);
              animateCounter('count-56', 56);
              animateCounter('count-42', 42);
            }
            return;
          }

          items.forEach((item) => {
            item.style.opacity = '0';
            item.style.transform = 'translateY(28px)';
            item.style.transition = 'all 1s cubic-bezier(0.25, 0.1, 0.25, 1)';
            item.style.willChange = 'opacity, transform';
          });

          const observer = new IntersectionObserver((entries) => {
            if (!entries[0].isIntersecting) return;

            items.forEach((item, index) => {
              setTimeout(() => {
                item.style.opacity = '1';
                item.style.transform = 'translateY(0)';
                if (group.id === 'research' && group.dataset.countAnimated !== 'true' && item.querySelector('#count-60')) {
                  animateCounter('count-60', 60);
                  animateCounter('count-88', 88);
                  animateCounter('count-56', 56);
                  animateCounter('count-42', 42);
                  group.dataset.countAnimated = 'true';
                }
              }, index * 160);
            });
            group.dataset.revealed = 'true';

            observer.disconnect();
          }, { threshold: 0.2, rootMargin: '0px 0px -8% 0px' });

          observer.observe(group);
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initSequentialReveals, { once: true });
      } else {
        initSequentialReveals();
      }
    </script>

  </div>

</Layout>
