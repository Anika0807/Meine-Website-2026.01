---
import Layout from '@/layouts/Layout.astro';
import Button from '@/components/ui/astro-button.astro';
---

<Layout title="Planora - Anika Warncke">
  <!-- 1. HERO -->
  <section class="relative min-h-[100svh] flex items-center justify-center overflow-hidden" data-reveal-group>
    <img src="/images/projekte/planora-hero.jpg" alt="Planora Hero" class="absolute inset-0 w-full h-full object-cover" loading="eager" fetchpriority="high">
    <div class="absolute inset-0 bg-gradient-to-b from-black/40 via-black/20 to-black/70"></div>
    <div class="relative z-10 text-center text-white px-4 sm:px-6 max-w-4xl">
      <p class="reveal-item text-base md:text-lg font-semibold tracking-[0.16em] uppercase mb-3 opacity-95">UX/UI DESIGN • MOBILE APP</p>
      <h1 class="reveal-item text-[2.9rem] md:text-[4.1rem] max-w-[16ch] mx-auto font-semibold tracking-tight leading-[0.92]">Planora</h1>
      <p class="reveal-item mt-4 text-lg md:text-xl max-w-lg mx-auto opacity-90">Reiseplanung, die sich dir anpasst</p>
    </div>
  </section>

  <!-- Content Rail – alle weiteren Sections -->
  <div class="max-w-6xl mx-auto px-4 sm:px-6">

    <!-- === METADATA – Überschriften größer & fetter (nur Planora) === -->
    <section class="pt-12 pb-20 md:pb-28 bg-background border-t border-border" data-reveal-group>
      <div class="max-w-7xl mx-auto px-0 md:px-12">
        
        <!-- Metadata Zeile – Mobile: vertikal gestapelt -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-y-10 md:gap-y-0 gap-x-8 mb-16 text-sm">
          <div class="reveal-item">
            <p class="uppercase tracking-widest text-sm font-medium text-foreground mb-3">Rolle & Team</p>
            <p class="text-foreground">
              <span class="text-primary font-medium">UX/UI-Designerin</span> im 3-Personen-Team mit Lars Heckmann und Julian Wegner
            </p>
          </div>
          <div class="reveal-item">
            <p class="uppercase tracking-widest text-sm font-medium text-foreground mb-3">Aufgabe</p>
            <p class="text-foreground">
              Von der Aufgabe bis zum Mid-Fidelity-Wireframes einer mobiler App ( <span class="text-primary font-medium">Fokus auf den UX-Research</span> mit Anfängen des UI-Design inklusive Prototyping)
            </p>
          </div>
          <div class="reveal-item">
            <p class="uppercase tracking-widest text-sm font-medium text-foreground mb-3">Zeitraum & Rahmen</p>
            <p class="text-foreground">
              April - Mai 2025:<br>
              <span class="text-primary font-medium">einwöchiger Design-Sprint</span> im UX/UI-Bootcamp bei neuefische
            </p>
          </div>
          <div class="reveal-item">
            <p class="uppercase tracking-widest text-sm font-medium text-foreground mb-3">Tools</p>
            <p class="text-foreground">
              <span class="text-primary font-medium">Figma</span>, FigJam, Notion, ChatGPT, Gemini
            </p>
          </div>
        </div>

      </div>
    </section>

    <!-- The Challenge – optimiert -->
    <section class="py-16 md:py-28 bg-background border-t border-border" data-reveal-group>
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="reveal-item text-h2 mb-8 md:mb-14">Die Herausforderung</h2>

        <p class="reveal-item text-base sm:text-lg md:text-xl text-muted-foreground leading-relaxed">
          Reisende stehen vor einer <span class="text-primary font-medium">frustrierenden Wahl</span>: Entweder jonglieren sie mit vielen verschiedenen Apps und Webseiten für Flüge, Hotels, Packlisten und Aktivitäten – oder die Planung bleibt unvollständig. Es fehlt eine <span class="text-primary font-medium">intuitive, zentrale Lösung</span>, die die gesamte Reiseplanung <span class="text-primary font-medium">übersichtlich, zeitsparend</span> und <span class="text-primary font-medium">stressfrei</span> macht.
        </p>
      </div>
    </section>

    <!-- === RESEARCH HIGHLIGHTS – final optimiert === -->
    <section id="research" class="py-20 md:py-32 bg-muted/40 border-t border-border" data-reveal-group>
      <div class="max-w-7xl mx-auto px-6 md:px-12">

        <h2 class="reveal-item text-h2 text-center mb-12 md:mb-16">
          Research-Erkenntnisse
        </h2>

        <!-- Drei neue Insights -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-12 mb-16">
          <div class="text-center reveal-item">
            <div class="inline-flex h-14 w-14 items-center justify-center rounded-full border-2 border-emerald-700 text-3xl font-semibold text-primary mb-6">01</div>
            <p class="text-xl font-medium"><span class="text-primary font-medium">All-in-One-Lösung</span></p>
            <p class="text-muted-foreground mt-3">Reiseplanung soll <span class="text-primary font-medium">stressfreier</span> werden.</p>
          </div>
          <div class="text-center reveal-item">
            <div class="inline-flex h-14 w-14 items-center justify-center rounded-full border-2 border-emerald-700 text-3xl font-semibold text-primary mb-6">02</div>
            <p class="text-xl font-medium"><span class="text-primary font-medium">Offline Nutzung</span></p>
            <p class="text-muted-foreground mt-3">Möglichst viele Informationen offline verfügbar machen.</p>
          </div>
          <div class="text-center reveal-item">
            <div class="inline-flex h-14 w-14 items-center justify-center rounded-full border-2 border-emerald-700 text-3xl font-semibold text-primary mb-6">03</div>
            <p class="text-xl font-medium"><span class="text-primary font-medium">Immer Up-to-date</span></p>
            <p class="text-muted-foreground mt-3">Bei Änderungen sind Benachrichtigungen erwünscht.</p>
          </div>
        </div>

        <!-- Neue Prozente -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8 md:gap-12 mb-16">
          <div class="text-center reveal-item"><div class="text-4xl sm:text-5xl md:text-6xl font-bold text-primary">81%</div><p class="text-xs sm:text-sm mt-2">SIND ÜBERFORDERT DURCH DIE NUTZUNG VERSCHIEDENER APPS</p></div>
          <div class="text-center reveal-item"><div class="text-4xl sm:text-5xl md:text-6xl font-bold text-primary">93%</div><p class="text-xs sm:text-sm mt-2">GEMEINSAME PLANUNG MIT FAMILIE/FREUNDE</p></div>
          <div class="text-center reveal-item"><div class="text-4xl sm:text-5xl md:text-6xl font-bold text-primary">73%</div><p class="text-xs sm:text-sm mt-2">NUTZEN MEHRERE APPS FÜR IHRE PLANUNG</p></div>
          <div class="text-center reveal-item"><div class="text-4xl sm:text-5xl md:text-6xl font-bold text-primary">93%</div><p class="text-xs sm:text-sm mt-2">WOLLEN OFFLINENUTZUNG VON INHALTEN</p></div>
        </div>

        <!-- Neue Quotes + How might we -->
        <div class="reveal-item max-w-3xl mx-auto text-center">
          <div class="italic text-foreground text-xl md:text-2xl font-semibold mb-12">
            „Alle Reiseinfos wie Flüge, Hotels, Aktivitäten an einem Ort wäre sehr hilfreich.“<br>
            „Planung mit vielen Beteiligten ist anstrengend, weil man sich sehr häufig alles durchschauen muss.“
          </div>
          <p class="text-2xl md:text-4xl font-semibold tracking-tight leading-tight text-foreground">
            Wie können wir Reisenden helfen, alle wichtigen Reiseinformationen <span class="text-primary font-medium">intuitiv an einem Ort</span> zu finden, sodass <span class="text-primary font-medium">spontane Reisen ohne Frust</span> und <span class="text-primary font-medium">Überforderung</span> möglich werden?
          </p>
        </div>
      </div>
    </section>

    <!-- === PROCESS – komplett mit UI-Foundation + Moodboard === -->
    <section id="process" class="py-24 md:py-32 bg-background border-t border-border">
      <div class="max-w-7xl mx-auto px-6 md:px-12">

        <h2 class="text-h2 text-center mb-12 md:mb-16 reveal">
          Process
        </h2>

        <!-- User Flow -->
        <div class="mb-20 reveal" style="transition-delay: 80ms">
          <img src="/images/projekte/planora-user-flow.png"
            alt="FlavorFusion User Flow"
               class="w-full rounded-3xl shadow-2xl" loading="lazy">
        </div>

        <!-- Designprinzipien -->
        <!-- ...Designprinzipien entfernt... -->

        <!-- ...UI-Foundation und Moodboard entfernt... -->
      </div>
    </section>

    <script>
      // @ts-nocheck
      // Staggered Reveal (gleiche Animation wie Challenge + Research)
      function initProcessReveal() {
        const reveals = /** @type {NodeListOf<HTMLElement>} */ (document.querySelectorAll('#process .reveal'));
        reveals.forEach((el, i) => {
          el.style.opacity = '0';
          el.style.transform = 'translateY(30px)';
          el.style.transition = 'all 1s cubic-bezier(0.25, 0.1, 0.25, 1)';

          const observer = new IntersectionObserver((entries) => {
            if (!entries[0].isIntersecting) return;
            setTimeout(() => {
              el.style.opacity = '1';
              el.style.transform = 'translateY(0)';
            }, i * 140);
            observer.disconnect();
          }, { threshold: 0.12, rootMargin: '0px 0px -10% 0px' });

          observer.observe(el);
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initProcessReveal, { once: true });
      } else {
        initProcessReveal();
      }
    </script>

    <section id="final-design" class="py-24 md:py-32 bg-muted/40 border-t border-border">
      <div class="max-w-7xl mx-auto px-6 md:px-12">
        <h2 class="reveal text-h2 text-center mb-12 md:mb-16">Mid-fidelity Wireframes</h2>

        <!-- ...Onboarding vorher/nachher entfernt... -->

        <!-- Einblicke in die App -->
        <div class="reveal mb-20" style="transition-delay: 220ms">
          <h3 class="uppercase tracking-widest text-sm text-muted-foreground mb-8 text-center">EINBLICKE IN DIE APP</h3>
          <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-8">
            <img src="/images/projekte/planora-feature-01.png" alt="Planora Feature 01" class="w-full rounded-3xl shadow-xl" loading="lazy">
            <img src="/images/projekte/planora-feature-02.png" alt="Planora Feature 02" class="w-full rounded-3xl shadow-xl" loading="lazy">
            <img src="/images/projekte/planora-feature-03.png" alt="Planora Feature 03" class="w-full rounded-3xl shadow-xl" loading="lazy">
            <img src="/images/projekte/planora-feature-04.png" alt="Planora Feature 04" class="w-full rounded-3xl shadow-xl" loading="lazy">
            <img src="/images/projekte/planora-feature-05.png" alt="Planora Feature 05" class="w-full rounded-3xl shadow-xl" loading="lazy">
            <img src="/images/projekte/planora-feature-06.png" alt="Planora Feature 06" class="w-full rounded-3xl shadow-xl" loading="lazy">
            <img src="/images/projekte/planora-feature-07.png" alt="Planora Feature 07" class="w-full rounded-3xl shadow-xl" loading="lazy">
            <img src="/images/projekte/planora-feature-08.png" alt="Planora Feature 08" class="w-full rounded-3xl shadow-xl" loading="lazy">
            <img src="/images/projekte/planora-feature-09.png" alt="Planora Placeholder 09" class="w-full rounded-3xl shadow-xl" loading="lazy">
            <img src="/images/projekte/planora-feature-10.png" alt="Planora Placeholder 10" class="w-full rounded-3xl shadow-xl" loading="lazy">
            <img src="/images/projekte/planora-feature-11.png" alt="Planora Placeholder 11" class="w-full rounded-3xl shadow-xl" loading="lazy">
            <img src="/images/projekte/planora-feature-12.png" alt="Planora Placeholder 12" class="w-full rounded-3xl shadow-xl" loading="lazy">
          </div>
        </div>

        <!-- ...Live Preview und Ergebnistext entfernt... -->
      </div>
    </section>

    <script>
      // @ts-nocheck
      // Gleiche sanfte Reveal-Animation wie bei Challenge, Research und Process
      function initFinalReveal() {
        const reveals = /** @type {NodeListOf<HTMLElement>} */ (document.querySelectorAll('#final-design .reveal'));
        reveals.forEach((el, i) => {
          el.style.opacity = '0';
          el.style.transform = 'translateY(30px)';
          el.style.transition = 'all 1s cubic-bezier(0.25, 0.1, 0.25, 1)';

          const observer = new IntersectionObserver((entries) => {
            if (!entries[0].isIntersecting) return;
            setTimeout(() => {
              el.style.opacity = '1';
              el.style.transform = 'translateY(0)';
            }, i * 140);
            observer.disconnect();
          }, { threshold: 0.12, rootMargin: '0px 0px -10% 0px' });

          observer.observe(el);
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initFinalReveal, { once: true });
      } else {
        initFinalReveal();
      }
    </script>

    <!-- === RESULTS & LEARNINGS – final optimiert mit grünen Highlights === -->
    <section id="results" class="py-20 md:py-32 bg-background border-t border-border">
      <div class="max-w-7xl mx-auto px-6 md:px-12">

        <h2 class="text-h2 text-center mb-12 md:mb-20 reveal">
          Results & Learnings
        </h2>

        <p class="max-w-3xl mx-auto text-lg md:text-xl text-muted-foreground text-center mb-16 md:mb-20 reveal" style="transition-delay: 80ms">
          In nur 5 Tagen entstand eine mobile Reiseplaner-App im Anfangsstadium. Die Arbeit daran war unser <span class="text-primary font-medium">erstes Teamprojekt</span> im Bootcamp.
        </p>

        <!-- Drei Karten mit gezielten grünen Highlights -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8 mb-16" style="transition-delay: 160ms">
          <div class="bg-background border border-border p-8 md:p-10 rounded-3xl shadow-sm reveal">
            <div class="text-primary text-5xl font-semibold mb-6">01</div>
            <h3 class="text-2xl font-medium mb-4">Fokus durch Zeitdruck</h3>
            <p class="text-muted-foreground text-[15px] md:text-base leading-relaxed">
              Der enge 5-Tage-Sprint zwang uns, <span class="text-primary font-medium">radikal zu priorisieren</span> und uns ausschließlich auf das <span class="text-primary font-medium">MVP</span> zu konzentrieren.
            </p>
          </div>
          <div class="bg-background border border-border p-8 md:p-10 rounded-3xl shadow-sm reveal">
            <div class="text-primary text-5xl font-semibold mb-6">02</div>
            <h3 class="text-2xl font-medium mb-4">User Research als Wegweiser</h3>
            <p class="text-muted-foreground text-[15px] md:text-base leading-relaxed">
              Zum ersten Mal führten wir <span class="text-primary font-medium">eigene Nutzerforschung</span> durch. Trotz begrenzter Zeit und unerfahrener Herangehensweise lieferte sie <span class="text-primary font-medium">wertvolle erste Einblicke</span>.
            </p>
          </div>
          <div class="bg-background border border-border p-8 md:p-10 rounded-3xl shadow-sm reveal">
            <div class="text-primary text-5xl font-semibold mb-6">03</div>
            <h3 class="text-2xl font-medium mb-4">Klare Struktur im Prozess</h3>
            <p class="text-muted-foreground text-[15px] md:text-base leading-relaxed">
              Eine übersichtliche Prozessstruktur und <span class="text-primary font-medium">klare Kommunikation</span> im Team halfen uns, den Überblick zu behalten und <span class="text-primary font-medium">fokussiert zu arbeiten</span>.
            </p>
          </div>
        </div>

        <!-- Nächste Schritte -->
        <div class="max-w-2xl mx-auto mb-16 reveal" style="transition-delay: 240ms">
          <h3 class="uppercase tracking-widest text-sm text-muted-foreground mb-6 text-center">NÄCHSTE SCHRITTE</h3>
          <ul class="space-y-6 text-[15px] md:text-base text-muted-foreground">
            <li class="flex gap-4">→ Vertiefter User Research: Weitere Interviews und Surveys</li>
            <li class="flex gap-4">→ Erweiterung der Funktionen: Budget-Tracking und personalisierte Empfehlungen</li>
            <li class="flex gap-4">→ UI-Design & technische Umsetzung: Optimierung und Offline-Funktionalität</li>
          </ul>
        </div>

        <!-- Zurück-Button -->
        <div class="flex justify-center">
          <Button href="/projekte" variant="primary" size="lg" class="w-full sm:w-auto">Zurück zu allen Projekten →</Button>
        </div>

        <!-- Projekt-Navigation -->
        <div class="mt-14 md:mt-20 pt-8 md:pt-12 border-t border-border flex flex-col md:flex-row gap-4 md:gap-6 justify-between">
          <Button href="/projekte/omnomzen" variant="primary" size="lg" class="w-full md:w-auto">← Letztes Projekt</Button>
          <Button href="/projekte/naturkompass" variant="primary" size="lg" class="w-full md:w-auto">Nächstes Projekt →</Button>
        </div>

      </div>
    </section>

    <script>
      // @ts-nocheck
      // Sanfte Reveal-Animation (wie bei allen anderen Blöcken)
      function initResultsReveal() {
        const reveals = /** @type {NodeListOf<HTMLElement>} */ (document.querySelectorAll('#results .reveal'));
        reveals.forEach((el, i) => {
          el.style.opacity = '0';
          el.style.transform = 'translateY(30px)';
          el.style.transition = 'all 1s cubic-bezier(0.25, 0.1, 0.25, 1)';

          const observer = new IntersectionObserver((entries) => {
            if (!entries[0].isIntersecting) return;
            setTimeout(() => {
              el.style.opacity = '1';
              el.style.transform = 'translateY(0)';
            }, i * 140);
            observer.disconnect();
          }, { threshold: 0.12, rootMargin: '0px 0px -10% 0px' });

          observer.observe(el);
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initResultsReveal, { once: true });
      } else {
        initResultsReveal();
      }
    </script>

    <script>
      // @ts-nocheck
      function animateCounter(id, target, duration = 1600) {
        const counter = document.getElementById(id);
        if (!(counter instanceof HTMLElement)) return;
        const startTime = performance.now();

        function update(now) {
          const progress = Math.min((now - startTime) / duration, 1);
          counter.textContent = String(Math.floor(progress * target));
          if (progress < 1) requestAnimationFrame(update);
        }

        requestAnimationFrame(update);
      }

      function initSequentialReveals() {
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const groups = /** @type {NodeListOf<HTMLElement>} */ (document.querySelectorAll('[data-reveal-group]'));

        groups.forEach((group) => {
          const items = /** @type {NodeListOf<HTMLElement>} */ (group.querySelectorAll('.reveal-item'));
          if (!items.length) return;

          if (reduceMotion) {
            items.forEach((item) => {
              item.style.opacity = '1';
              item.style.transform = 'none';
            });
            if (group.id === 'research') {
              animateCounter('count-60', 60);
              animateCounter('count-88', 88);
              animateCounter('count-56', 56);
              animateCounter('count-42', 42);
            }
            return;
          }

          items.forEach((item) => {
            item.style.opacity = '0';
            item.style.transform = 'translateY(28px)';
            item.style.transition = 'all 1s cubic-bezier(0.25, 0.1, 0.25, 1)';
            item.style.willChange = 'opacity, transform';
          });

          const observer = new IntersectionObserver((entries) => {
            if (!entries[0].isIntersecting) return;

            items.forEach((item, index) => {
              setTimeout(() => {
                item.style.opacity = '1';
                item.style.transform = 'translateY(0)';

                if (group.id === 'research' && group.dataset.countAnimated !== 'true' && item.querySelector('#count-60')) {
                  animateCounter('count-60', 60);
                  animateCounter('count-88', 88);
                  animateCounter('count-56', 56);
                  animateCounter('count-42', 42);
                  group.dataset.countAnimated = 'true';
                }
              }, index * 160);
            });
            group.dataset.revealed = 'true';

            observer.disconnect();
          }, { threshold: 0.2, rootMargin: '0px 0px -8% 0px' });

          observer.observe(group);
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initSequentialReveals, { once: true });
      } else {
        initSequentialReveals();
      }
    </script>

  </div>

</Layout>
