
---
import Layout from '@/layouts/Layout.astro';
---

<Layout title="My Mind Studio – Anika Warncke">
  <!-- 1. HERO -->
  <section class="relative min-h-[100svh] flex items-center justify-center overflow-hidden" data-reveal-group>
    <img src="/images/projekte/my-mind-studio.jpg" alt="My Mind Studio" class="absolute inset-0 w-full h-full object-cover">
    <div class="absolute inset-0 bg-gradient-to-b from-black/40 via-black/20 to-black/70"></div>
    <div class="relative z-10 text-center text-white px-4 sm:px-6 max-w-4xl">
      <p class="reveal-item text-sm tracking-[4px] uppercase font-medium mb-4 opacity-90">Innenarchitektur • HEALTH CARE & GASTRONOMIE</p>
      <h1 class="reveal-item text-5xl sm:text-6xl md:text-7xl font-semibold tracking-tighter leading-none">My Mind Studio</h1>
      <p class="reveal-item mt-5 text-base sm:text-xl md:text-2xl max-w-lg mx-auto opacity-90">Meditations- und Yogastudio mit Café</p>
    </div>
  </section>

  <!-- Content Rail – alle weiteren Sections -->
  <div class="max-w-6xl mx-auto px-4 sm:px-6">

    <!-- === METADATA – Überschriften größer & fetter (nur My Mind Studio) === -->
    <section class="pt-12 pb-20 md:pb-28 bg-white" data-reveal-group>
      <div class="max-w-7xl mx-auto px-0 md:px-12">
        
        <!-- Metadata Zeile – Mobile: vertikal gestapelt -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-y-10 md:gap-y-0 gap-x-8 mb-16 text-sm">
          <div class="reveal-item">
            <p class="uppercase tracking-widest text-sm font-medium text-foreground mb-3">Rolle & Team</p>
            <p class="text-foreground">
              <span class="text-emerald-700 font-medium">Innenarchitektur M.A.</span> im 2-Personen-Team<br>mit Marco Smith
            </p>
          </div>
          <div class="reveal-item">
            <p class="uppercase tracking-widest text-sm font-medium text-foreground mb-3">Aufgabe</p>
              <p class="text-foreground">
                Umbau einer kleinen Ladenfläche zu einem Meditations- und Yogastudio mit Café<br>
                <span class="text-emerald-700 font-medium">Leistungsphasen 01 - 09</span>
              </p>
          </div>
          <div class="reveal-item">
            <p class="uppercase tracking-widest text-sm font-medium text-foreground mb-3">Zeitraum & Rahmen</p>
            <p class="text-foreground">
              <span class="text-emerald-700 font-medium">Juli 2022-2023:</span><br>
              Festanstellung bei <a href="https://www.formwaende.de" class="text-emerald-700 font-medium underline" target="_blank">FORMWÆNDE</a>, Lüneburg<br>
              Projektstandort: <span class="text-emerald-700 font-medium">Lüneburg</span>
            </p>
          </div>
          <div class="reveal-item">
            <p class="uppercase tracking-widest text-sm font-medium text-foreground mb-3">Tools</p>
            <p class="text-foreground">
              <span class="text-emerald-700 font-medium">Vectorworks</span>, Procreate, Adobe Creative Suite, Microsoft Office
            </p>
          </div>
        </div>

      </div>
    </section>

    <!-- The Challenge – optimiert -->
    <section class="py-16 md:py-28 bg-white" data-reveal-group>
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="reveal-item text-4xl sm:text-5xl md:text-6xl font-semibold tracking-tighter mb-8 md:mb-14">The Challenge</h2>

        <p class="reveal-item text-base sm:text-lg md:text-xl text-muted-foreground leading-relaxed">
          Naturbegeisterte stehen vor einer frustrierenden Wahl: Entweder nutzen sie überladene Apps –
          oder sie verzichten komplett auf wertvolle Informationen. Es fehlt ein
          <span class="text-emerald-700 font-medium">intuitives, offline-fähiges Tool</span>,
          das hilft, Flora und Fauna zu erkennen, ohne das echte Naturerlebnis zu stören.
        </p>
      </div>
    </section>

    <!-- === RESEARCH HIGHLIGHTS – final optimiert === -->
    <section id="research" class="py-20 md:py-32 bg-gray-50" data-reveal-group>
      <div class="max-w-7xl mx-auto px-6 md:px-12">

        <h2 class="reveal-item text-4xl sm:text-5xl md:text-6xl font-semibold tracking-tighter text-center mb-12 md:mb-16">
          Research Highlights
        </h2>

        <!-- Drei Insights -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-12 mb-16">
          <div class="text-center reveal-item">
            <div class="inline-flex h-14 w-14 items-center justify-center rounded-full border-2 border-emerald-700 text-3xl font-semibold text-emerald-700 mb-6">1</div>
            <p class="text-xl font-medium">Wunsch nach Wissen</p>
            <p class="text-muted-foreground mt-3">Natur nicht nur erleben, sondern auch <span class="text-emerald-700 font-medium">verstehen</span>.</p>
          </div>
          <div class="text-center reveal-item">
            <div class="inline-flex h-14 w-14 items-center justify-center rounded-full border-2 border-emerald-700 text-3xl font-semibold text-emerald-700 mb-6">2</div>
            <p class="text-xl font-medium">Weniger ist mehr</p>
            <p class="text-muted-foreground mt-3">Informationen auf Bedarf, aber <span class="text-emerald-700 font-medium">unaufdringlich</span>.</p>
          </div>
          <div class="text-center reveal-item">
            <div class="inline-flex h-14 w-14 items-center justify-center rounded-full border-2 border-emerald-700 text-3xl font-semibold text-emerald-700 mb-6">3</div>
            <p class="text-xl font-medium">Gamification-Balance</p>
            <p class="text-muted-foreground mt-3">Nicht für jeden.</p>
          </div>
        </div>

        <!-- Prozente -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8 md:gap-12 mb-16">
          <div class="text-center reveal-item"><div class="text-4xl sm:text-5xl md:text-6xl font-bold text-emerald-700"><span id="count-60">0</span>%</div><p class="text-xs sm:text-sm mt-2">TÄGLICH IN DER NATUR</p></div>
          <div class="text-center reveal-item"><div class="text-4xl sm:text-5xl md:text-6xl font-bold text-emerald-700"><span id="count-88">0</span>%</div><p class="text-xs sm:text-sm mt-2">ZUR ENTSPANNUNG</p></div>
          <div class="text-center reveal-item"><div class="text-4xl sm:text-5xl md:text-6xl font-bold text-emerald-700"><span id="count-56">0</span>%</div><p class="text-xs sm:text-sm mt-2">WOLLEN AKTIV ENTDECKEN</p></div>
          <div class="text-center reveal-item"><div class="text-4xl sm:text-5xl md:text-6xl font-bold text-emerald-700"><span id="count-42">0</span>%</div><p class="text-xs sm:text-sm mt-2">POLLENFLUG-INTERESSE</p></div>
        </div>

        <!-- Quotes + How might we -->
        <div class="reveal-item max-w-3xl mx-auto text-center">
          <div class="italic text-foreground text-xl md:text-2xl font-semibold mb-12">
            „Kleine Infotafeln, aber bitte nicht alles vollplastern.“<br>
            „Ich will wissen, was es genau ist – nicht 33 Vorschläge.“
          </div>

          <p class="text-2xl md:text-4xl font-semibold tracking-tight leading-tight text-foreground">
            Wie können wir Menschen die Natur neugierig und aufmerksam erleben lassen -
            mit einem <span class="text-emerald-700">ruhigen, offline-fähigen digitalen Begleiter</span>?
          </p>
        </div>
      </div>
    </section>

    <!-- === PROCESS – komplett mit UI-Foundation + Moodboard === -->
    <section id="process" class="py-24 md:py-32 bg-white">
      <div class="max-w-7xl mx-auto px-6 md:px-12">
        <h2 class="text-4xl sm:text-5xl md:text-6xl font-semibold tracking-tighter text-center mb-12 md:mb-16 reveal">
          Process
        </h2>
        <!-- Designprinzipien -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-10 mb-20" style="transition-delay: 160ms">
          <div class="bg-white border border-gray-100 p-8 md:p-10 rounded-3xl reveal">
            <div class="text-emerald-700 text-5xl font-semibold mb-6">01</div>
            <h3 class="text-2xl font-medium mb-4">Zurückhaltende Begleitung</h3>
            <p class="text-muted-foreground">
              Frosted Glass + minimale Elemente halten den Fokus auf dem <span class="text-emerald-700 font-medium">Naturerlebnis</span>.
            </p>
          </div>
          <div class="bg-white border border-gray-100 p-8 md:p-10 rounded-3xl reveal">
            <div class="text-emerald-700 text-5xl font-semibold mb-6">02</div>
            <h3 class="text-2xl font-medium mb-4">Zugängliche Gestaltung</h3>
            <p class="text-muted-foreground">
              Klare Navigation und hohe Lesbarkeit für <span class="text-emerald-700 font-medium">einfache Nutzung</span>.
            </p>
          </div>
          <div class="bg-white border border-gray-100 p-8 md:p-10 rounded-3xl reveal">
            <div class="text-emerald-700 text-5xl font-semibold mb-6">03</div>
            <h3 class="text-2xl font-medium mb-4">Inspirierende Wissensvermittlung</h3>
            <p class="text-muted-foreground">
              Wissen wird präzise und neugierig in kleinen Häppchen <span class="text-emerald-700 font-medium">vermittelt</span>.
            </p>
          </div>
        </div>
      </div>
    </section>

    <script>
      // Staggered Reveal (gleiche Animation wie Challenge + Research)
      function initProcessReveal() {
        const reveals = document.querySelectorAll<HTMLElement>('#process .reveal');
        reveals.forEach((el, i) => {
          el.style.opacity = '0';
          el.style.transform = 'translateY(30px)';
          el.style.transition = 'all 1s cubic-bezier(0.25, 0.1, 0.25, 1)';

          const observer = new IntersectionObserver((entries) => {
            if (!entries[0].isIntersecting) return;
            setTimeout(() => {
              el.style.opacity = '1';
              el.style.transform = 'translateY(0)';
            }, i * 140);
            observer.disconnect();
          }, { threshold: 0.12, rootMargin: '0px 0px -10% 0px' });

          observer.observe(el);
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initProcessReveal, { once: true });
      } else {
        initProcessReveal();
      }
    </script>

    <!-- === FINAL DESIGN – My Mind Studio (echte Buttons + mehr Abstand) === -->
    <section id="final-design" class="py-32 md:py-44 bg-white">
      <div class="max-w-7xl mx-auto px-6 md:px-12">
        
        <h2 class="text-5xl md:text-6xl font-semibold tracking-tighter text-center mb-20 reveal">
          Final Design
        </h2>

        <p class="max-w-3xl mx-auto text-center text-xl text-muted-foreground mb-28 reveal" style="transition-delay: 80ms">
          My Mind Studio – ein Ort der Auszeit in Lüneburg.<br>
          Umsetzung als Innenarchitektur M.A. im Team bei <span class="font-medium">FORMWÆNDE</span>.
        </p>

        <!-- 1. BDIA-Handbuch 2023/2024 -->
        <div class="mb-32 reveal" style="transition-delay: 120ms">
          <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-6 mb-10">
            <h3 class="text-2xl font-semibold">Veröffentlichung im BDIA-Handbuch 2023/2024</h3>
            <a
              href="https://bdia.de/wp-content/uploads/2024/05/my-mind-studio.pdf"
              target="_blank"
              class="w-full sm:w-auto bg-emerald-700 hover:bg-emerald-600 text-white text-base sm:text-lg font-medium px-6 sm:px-10 py-4 sm:py-6 rounded-btn text-center transition-all"
            >
              → zur Veröffentlichung
            </a>
          </div>
          <div class="space-y-12">
            <img src="/images/projekte/CAL_bdia24-25_my_mind.jpg" alt="BDIA Bild 1" class="w-full rounded-3xl shadow-2xl">
            <img src="/images/projekte/CAL_bdia24-25_my_mind2.jpg" alt="BDIA Bild 2" class="w-full rounded-3xl shadow-2xl">
          </div>
        </div>

        <!-- 2. AIT 06.2024 -->
        <div class="mb-32 reveal" style="transition-delay: 200ms">
          <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-6 mb-10">
            <h3 class="text-2xl font-semibold">Veröffentlichung in der AIT 06.2024</h3>
            <a
              href="https://ait-xia-dialog.de/ait-magazine/ausgabe-5-2024/"
              target="_blank"
              class="w-full sm:w-auto bg-emerald-700 hover:bg-emerald-600 text-white text-base sm:text-lg font-medium px-6 sm:px-10 py-4 sm:py-6 rounded-btn text-center transition-all"
            >
              → zur Veröffentlichung
            </a>
          </div>
          <img src="/images/projekte/20240507_AIT_202405_Artikel.jpg" alt="AIT 06.2024" class="w-full rounded-3xl shadow-2xl">
        </div>

        <!-- 3. db 07/2024 -->
        <div class="reveal" style="transition-delay: 280ms">
          <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-6 mb-10">
            <h3 class="text-2xl font-semibold">Veröffentlichung in der db 07/2024</h3>
            <a
              href="https://www.dds-online.de/gestaltung/kaleidoskop-der-innenraeume/?utm_source=chatgpt.com#slider-intro-20"
              target="_blank"
              class="w-full sm:w-auto bg-emerald-700 hover:bg-emerald-600 text-white text-base sm:text-lg font-medium px-6 sm:px-10 py-4 sm:py-6 rounded-btn text-center transition-all"
            >
              → zur Veröffentlichung
            </a>
          </div>
          <img src="/images/projekte/Formaaende_dds_09-2024.jpg" alt="db 07.2024" class="w-full rounded-3xl shadow-2xl">
        </div>

        <!-- Hinweis Formwaende -->
        <p class="text-center text-sm text-muted-foreground mt-32 reveal" style="transition-delay: 360ms">
          Mitarbeit als Innenarchitektur M.A. bei <span class="font-medium">FORMWÆNDE</span>, Lüneburg
        </p>
      </div>
    </section>

    <script>
      // Gleiche sanfte Reveal-Animation wie bei Challenge, Research und Process
      function initFinalReveal() {
        const reveals = document.querySelectorAll<HTMLElement>('#final-design .reveal');
        reveals.forEach((el, i) => {
          el.style.opacity = '0';
          el.style.transform = 'translateY(30px)';
          el.style.transition = 'all 1s cubic-bezier(0.25, 0.1, 0.25, 1)';

          const observer = new IntersectionObserver((entries) => {
            if (!entries[0].isIntersecting) return;
            setTimeout(() => {
              el.style.opacity = '1';
              el.style.transform = 'translateY(0)';
            }, i * 140);
            observer.disconnect();
          }, { threshold: 0.12, rootMargin: '0px 0px -10% 0px' });

          observer.observe(el);
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initFinalReveal, { once: true });
      } else {
        initFinalReveal();
      }
    </script>

    <!-- === RESULTS & LEARNINGS – final optimiert mit grünen Highlights === -->
    <section id="results" class="py-20 md:py-32 bg-white">
      <div class="max-w-7xl mx-auto px-6 md:px-12">

        <h2 class="text-4xl sm:text-5xl md:text-6xl font-semibold tracking-tighter text-center mb-12 md:mb-20 reveal">
          Results & Learnings
        </h2>

        <p class="max-w-3xl mx-auto text-lg md:text-xl text-muted-foreground text-center mb-16 md:mb-20 reveal" style="transition-delay: 80ms">
          In nur 4 Wochen entstand eine ruhige, intuitive und offline-fähige App.
          Die Nutzer:innen beschreiben sie als „<span class="text-emerald-700 font-medium">entspannend und hilfreich</span>“.
        </p>

        <!-- Drei Karten mit gezielten grünen Highlights -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8 mb-16" style="transition-delay: 160ms">

          <div class="bg-white border border-gray-100 p-8 md:p-10 rounded-3xl shadow-sm reveal">
            <div class="text-emerald-700 text-5xl font-semibold mb-6">01</div>
            <h3 class="text-2xl font-medium mb-4">Weniger ist mehr</h3>
            <p class="text-muted-foreground text-[15px] md:text-base leading-relaxed">
              Die größte Herausforderung war nicht, Features hinzuzufügen, sondern bewusst
              <span class="text-emerald-700 font-medium">wegzulassen</span> – damit die Freude am Entdecken im Vordergrund bleibt.
            </p>
          </div>

          <div class="bg-white border border-gray-100 p-8 md:p-10 rounded-3xl shadow-sm reveal">
            <div class="text-emerald-700 text-5xl font-semibold mb-6">02</div>
            <h3 class="text-2xl font-medium mb-4">Forschung als Fundament</h3>
            <p class="text-muted-foreground text-[15px] md:text-base leading-relaxed">
              Tiefgehende Nutzerforschung und kontinuierliche Iteration sind der schnellste Weg
              zu einem wirklich <span class="text-emerald-700 font-medium">intuitiven Design</span>.
            </p>
          </div>

          <div class="bg-white border border-gray-100 p-8 md:p-10 rounded-3xl shadow-sm reveal">
            <div class="text-emerald-700 text-5xl font-semibold mb-6">03</div>
            <h3 class="text-2xl font-medium mb-4">Agency schafft Bindung</h3>
            <p class="text-muted-foreground text-[15px] md:text-base leading-relaxed">
              Funktionen wie der Müllmelder geben Nutzern echtes Mitwirkungsgefühl und
              <span class="text-emerald-700 font-medium">steigern die langfristige Bindung</span>.
            </p>
          </div>
        </div>

        <!-- Nächste Schritte -->

        <!-- Zurück-Button -->
        <div class="flex justify-center">
          <a href="/projekte"
             class="w-full sm:w-auto bg-emerald-700 hover:bg-emerald-600 text-white text-base sm:text-lg font-medium px-6 sm:px-10 py-4 sm:py-6 rounded-btn text-center transition-all">
            Zurück zu allen Projekten →
          </a>
        </div>

        <!-- Projekt-Navigation -->
        <div class="mt-14 md:mt-20 pt-8 md:pt-12 border-t border-gray-100 flex flex-col md:flex-row gap-4 md:gap-6 justify-between">
          <a href="/projekte/[previous-project]"
             class="w-full md:w-auto bg-emerald-700 hover:bg-emerald-600 text-white text-base sm:text-lg font-medium px-6 sm:px-10 py-4 sm:py-6 rounded-btn text-center transition-all">
            ← Letztes Projekt
          </a>
          <a href="/projekte/[next-project]"
             class="w-full md:w-auto bg-emerald-700 hover:bg-emerald-600 text-white text-base sm:text-lg font-medium px-6 sm:px-10 py-4 sm:py-6 rounded-btn text-center transition-all">
            Nächstes Projekt →
          </a>
        </div>

      </div>
    </section>

    <script>
      // Sanfte Reveal-Animation (wie bei allen anderen Blöcken)
      function initResultsReveal() {
        const reveals = document.querySelectorAll<HTMLElement>('#results .reveal');
        reveals.forEach((el, i) => {
          el.style.opacity = '0';
          el.style.transform = 'translateY(30px)';
          el.style.transition = 'all 1s cubic-bezier(0.25, 0.1, 0.25, 1)';

          const observer = new IntersectionObserver((entries) => {
            if (!entries[0].isIntersecting) return;
            setTimeout(() => {
              el.style.opacity = '1';
              el.style.transform = 'translateY(0)';
            }, i * 140);
            observer.disconnect();
          }, { threshold: 0.12, rootMargin: '0px 0px -10% 0px' });

          observer.observe(el);
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initResultsReveal, { once: true });
      } else {
        initResultsReveal();
      }
    </script>

    <script>
      function animateCounter(id: string, target: number, duration = 1600) {
        const el = document.getElementById(id);
        if (!el) return;
        const startTime = performance.now();

        function update(now: number) {
          const progress = Math.min((now - startTime) / duration, 1);
          el!.textContent = String(Math.floor(progress * target));
          if (progress < 1) requestAnimationFrame(update);
        }

        requestAnimationFrame(update);
      }

      function initSequentialReveals() {
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const groups = document.querySelectorAll<HTMLElement>('[data-reveal-group]');

        groups.forEach((group) => {
          const items = group.querySelectorAll<HTMLElement>('.reveal-item');
          if (!items.length) return;

          if (reduceMotion) {
            items.forEach((item) => {
              item.style.opacity = '1';
              item.style.transform = 'none';
            });
            if (group.id === 'research') {
              animateCounter('count-60', 60);
              animateCounter('count-88', 88);
              animateCounter('count-56', 56);
              animateCounter('count-42', 42);
            }
            return;
          }

          items.forEach((item) => {
            item.style.opacity = '0';
            item.style.transform = 'translateY(28px)';
            item.style.transition = 'all 1s cubic-bezier(0.25, 0.1, 0.25, 1)';
            item.style.willChange = 'opacity, transform';
          });

          const observer = new IntersectionObserver((entries) => {
            if (!entries[0].isIntersecting) return;

            items.forEach((item, index) => {
              setTimeout(() => {
                item.style.opacity = '1';
                item.style.transform = 'translateY(0)';

                if (group.id === 'research' && group.dataset.countAnimated !== 'true' && item.querySelector('#count-60')) {
                  animateCounter('count-60', 60);
                  animateCounter('count-88', 88);
                  animateCounter('count-56', 56);
                  animateCounter('count-42', 42);
                  group.dataset.countAnimated = 'true';
                }
              }, index * 160);
            });
            group.dataset.revealed = 'true';

            observer.disconnect();
          }, { threshold: 0.2, rootMargin: '0px 0px -8% 0px' });

          observer.observe(group);
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initSequentialReveals, { once: true });
      } else {
        initSequentialReveals();
      }
    </script>

  </div>

</Layout>
