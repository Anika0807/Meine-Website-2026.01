
---
import Layout from '@/layouts/Layout.astro';
import Button from '@/components/ui/astro-button.astro';
---

<Layout title="My Mind Studio – Anika Warncke">
  <!-- 1. HERO -->
  <section class="relative min-h-[100svh] flex items-center justify-center overflow-hidden" data-reveal-group>
    <img src="/images/projekte/my-mind-studio.jpg" alt="My Mind Studio" class="absolute inset-0 w-full h-full object-cover" loading="eager" fetchpriority="high">
    <div class="absolute inset-0 bg-gradient-to-b from-black/40 via-black/20 to-black/70"></div>
    <div class="relative z-10 text-center text-white px-4 sm:px-6 max-w-4xl">
      <p class="reveal-item text-base md:text-lg font-semibold tracking-[0.16em] uppercase mb-3 opacity-95">Innenarchitektur • HEALTH CARE & GASTRONOMIE</p>
      <h1 class="reveal-item text-[2.9rem] md:text-[4.1rem] max-w-[16ch] mx-auto font-semibold tracking-tight leading-[0.92]">My Mind Studio</h1>
      <p class="reveal-item mt-4 text-lg md:text-xl max-w-lg mx-auto opacity-90">Meditations- und Yogastudio mit Café</p>
    </div>
  </section>

  <!-- Content Rail – alle weiteren Sections -->
  <div class="max-w-6xl mx-auto px-4 sm:px-6">

    <!-- === METADATA – Überschriften größer & fetter (nur My Mind Studio) === -->
    <section class="pt-12 pb-20 md:pb-28 bg-background border-t border-border" data-reveal-group>
      <div class="max-w-7xl mx-auto px-0 md:px-12">
        
        <!-- Metadata Zeile – Mobile: vertikal gestapelt -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-y-10 md:gap-y-0 gap-x-8 mb-16 text-sm">
          <div class="reveal-item">
            <p class="uppercase tracking-widest text-sm font-medium text-foreground mb-3">Rolle & Team</p>
            <p class="text-foreground">
              <span class="text-primary font-medium">Innenarchitektur M.A.</span> im 2-Personen-Team<br>mit Marco Smith
            </p>
          </div>
          <div class="reveal-item">
            <p class="uppercase tracking-widest text-sm font-medium text-foreground mb-3">Aufgabe</p>
              <p class="text-foreground">
                Umbau einer kleinen Ladenfläche zu einem Meditations- und Yogastudio mit Café<br>
                <span class="text-primary font-medium">Leistungsphasen 01 - 09</span>
              </p>
          </div>
          <div class="reveal-item">
            <p class="uppercase tracking-widest text-sm font-medium text-foreground mb-3">Zeitraum & Rahmen</p>
            <p class="text-foreground">
              <span class="text-primary font-medium">Juli 2022-2023:</span><br>
              Festanstellung bei <a href="https://www.formwaende.de" class="text-primary font-medium underline" target="_blank">FORMWÆNDE</a>, Lüneburg<br>
              Projektstandort: <span class="text-primary font-medium">Lüneburg</span>
            </p>
          </div>
          <div class="reveal-item">
            <p class="uppercase tracking-widest text-sm font-medium text-foreground mb-3">Tools</p>
            <p class="text-foreground">
              <span class="text-primary font-medium">Vectorworks</span>, Procreate, Adobe Creative Suite, Microsoft Office
            </p>
          </div>
        </div>

      </div>
    </section>

    <!-- === THE CHALLENGE – My Mind Studio === -->
    <section id="challenge" class="py-28 md:py-36 bg-background border-t border-border">
      <div class="max-w-4xl mx-auto px-6 md:px-12">
        
        <h2 class="text-h2 text-center mb-16 reveal">
          Herausforderung
        </h2>

        <div class="prose prose-lg mx-auto text-center text-muted-foreground leading-relaxed reveal" style="transition-delay: 80ms">
          <p class="text-body-lg">
            In der Lüneburger Innenstadt sollte eine kleine, langgestreckte und schlecht belichtete Ladenfläche, die in den letzten Jahren mehrfach den Betreiber wechseln musste, in einen langfristigen <span class="text-primary font-medium">Ort der Auszeit</span> verwandelt werden: <span class="text-primary font-medium">ein Meditations- und Yogastudio mit integriertem Café</span>.
          </p>
        </div>
      </div>
    </section>

    <script>
      // @ts-nocheck
      // Staggered Reveal – The Challenge
      function initChallengeReveal() {
        const reveals = /** @type {NodeListOf<HTMLElement>} */ (document.querySelectorAll('#challenge .reveal'));
        reveals.forEach((el, i) => {
          el.style.opacity = '0';
          el.style.transform = 'translateY(30px)';
          el.style.transition = 'all 1s cubic-bezier(0.25, 0.1, 0.25, 1)';

          const observer = new IntersectionObserver((entries) => {
            if (!entries[0].isIntersecting) return;
            setTimeout(() => {
              el.style.opacity = '1';
              el.style.transform = 'translateY(0)';
            }, i * 140);
            observer.disconnect();
          }, { threshold: 0.12, rootMargin: '0px 0px -10% 0px' });

          observer.observe(el);
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initChallengeReveal, { once: true });
      } else {
        initChallengeReveal();
      }
    </script>

    <!-- === KONZEPT – My Mind Studio (finale Version mit deinen Änderungen) === -->
    <section id="konzept" class="py-28 md:py-36 bg-background border-t border-border">
      <div class="max-w-5xl mx-auto px-6 md:px-12">
        
        <h2 class="text-h2 text-center mb-16 reveal">
          Konzept
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          
          <!-- 01 Raumgliederung -->
          <div class="bg-card border border-border rounded-3xl p-8 reveal">
            <div class="text-primary text-5xl font-semibold mb-4">01</div>
            <h3 class="text-h4 mb-3">Raumgliederung</h3>
            <p class="text-body text-muted-foreground">Durch eine vollständige Umstrukturierung des <span class="text-primary font-medium">dunklen, langgestreckten Grundrisses</span> entstand eine <span class="text-primary font-medium">klare, flexible Raumordnung mit mehreren Räumen</span>, die bei Bedarf in zwei Einheiten teilbar ist.</p>
          </div>

          <!-- 02 Inszenierte Wegeführung -->
          <div class="bg-card border border-border rounded-3xl p-8 reveal">
            <div class="text-primary text-5xl font-semibold mb-4">02</div>
            <h3 class="text-h4 mb-3">Inszenierte Wegeführung</h3>
            <p class="text-body text-muted-foreground">Gäste werden von der belebten Fußgängerzone durch einen <span class="text-primary font-medium">hellen, mystisch anmutenden Tunnel</span> schrittweise in den <span class="text-primary font-medium">stillen und intimen Kursraum</span> geführt.</p>
          </div>

          <!-- 03 Funktionale Einbindung -->
          <div class="bg-card border border-border rounded-3xl p-8 reveal">
            <div class="text-primary text-5xl font-semibold mb-4">03</div>
            <h3 class="text-h4 mb-3">Funktionale Einbindung</h3>
            <p class="text-body text-muted-foreground">Alle notwendigen Funktionen sind <span class="text-primary font-medium">unaufdringlich in die Gestaltung integriert</span> und unterstützen eine <span class="text-primary font-medium">ruhige, konzentrierte Nutzung</span>.</p>
          </div>

          <!-- 04 Sinnliche Materialität -->
          <div class="bg-card border border-border rounded-3xl p-8 reveal">
            <div class="text-primary text-5xl font-semibold mb-4">04</div>
            <h3 class="text-h4 mb-3">Sinnliche Materialität</h3>
            <p class="text-body text-muted-foreground"><span class="text-primary font-medium">Material- und Farbpalette wird schrittweise reduziert</span> – von heller Eiche, Stein und Linoleum über Eichenparkett und Himmelblau bis hin zu einer <span class="text-primary font-medium">einheitlich warmen, weichen Natürlichkeit</span>.</p>
          </div>
        </div>
      </div>
    </section>

    <script>
      // @ts-nocheck
      // Staggered Reveal – Konzept-Karten
      function initKonzeptReveal() {
        const reveals = /** @type {NodeListOf<HTMLElement>} */ (document.querySelectorAll('#konzept .reveal'));
        reveals.forEach((el, i) => {
          el.style.opacity = '0';
          el.style.transform = 'translateY(30px)';
          el.style.transition = 'all 1s cubic-bezier(0.25, 0.1, 0.25, 1)';

          const observer = new IntersectionObserver((entries) => {
            if (!entries[0].isIntersecting) return;
            setTimeout(() => {
              el.style.opacity = '1';
              el.style.transform = 'translateY(0)';
            }, i * 140);
            observer.disconnect();
          }, { threshold: 0.12, rootMargin: '0px 0px -10% 0px' });

          observer.observe(el);
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initKonzeptReveal, { once: true });
      } else {
        initKonzeptReveal();
      }
    </script>

    <!-- === FINAL DESIGN – My Mind Studio (echte Buttons + mehr Abstand) === -->
    <section id="final-design" class="py-32 md:py-44 bg-background border-t border-border">
      <div class="max-w-7xl mx-auto px-6 md:px-12">
        
        <h2 class="text-h2 text-center mb-20 reveal">
          Realisierung
        </h2>

        <p class="max-w-3xl mx-auto text-center text-body-lg text-muted-foreground mb-28 reveal" style="transition-delay: 80ms">
          My Mind Studio – ein Ort der Auszeit in Lüneburg.<br>
          Umsetzung als Innenarchitektur M.A. im Team bei <span class="font-medium">FORMWÆNDE</span>.
        </p>

        <!-- 1. BDIA-Handbuch 2023/2024 -->
        <div class="mb-32 reveal" style="transition-delay: 120ms">
          <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-6 mb-10">
            <h3 class="text-2xl font-semibold">Veröffentlichung im BDIA-Handbuch 2023/2024</h3>
            <Button href="https://bdia.de/wp-content/uploads/2024/05/my-mind-studio.pdf" target="_blank" variant="primary" size="lg" class="w-full sm:w-auto text-base sm:text-lg">→ zur Veröffentlichung</Button>
          </div>
          <div class="space-y-12">
            <img src="/images/projekte/CAL_bdia24-25_my_mind.jpg" alt="BDIA Bild 1" class="w-full rounded-3xl shadow-2xl" loading="lazy">
            <img src="/images/projekte/CAL_bdia24-25_my_mind2.jpg" alt="BDIA Bild 2" class="w-full rounded-3xl shadow-2xl" loading="lazy">
          </div>
        </div>

        <!-- 2. AIT 06.2024 -->
        <div class="mb-32 reveal" style="transition-delay: 200ms">
          <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-6 mb-10">
            <h3 class="text-2xl font-semibold">Veröffentlichung in der AIT 06.2024</h3>
            <Button href="https://ait-xia-dialog.de/ait-magazine/ausgabe-5-2024/" target="_blank" variant="primary" size="lg" class="w-full sm:w-auto text-base sm:text-lg">→ zur Veröffentlichung</Button>
          </div>
          <img src="/images/projekte/20240507_AIT_202405_Artikel.jpg" alt="AIT 06.2024" class="w-full rounded-3xl shadow-2xl" loading="lazy">
        </div>

        <!-- 3. db 07/2024 -->
        <div class="reveal" style="transition-delay: 280ms">
          <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-6 mb-10">
            <h3 class="text-2xl font-semibold">Veröffentlichung in der db 07/2024</h3>
            <Button href="https://www.dds-online.de/gestaltung/kaleidoskop-der-innenraeume/?utm_source=chatgpt.com#slider-intro-20" target="_blank" variant="primary" size="lg" class="w-full sm:w-auto text-base sm:text-lg">→ zur Veröffentlichung</Button>
          </div>
          <img src="/images/projekte/Formaaende_dds_09-2024.jpg" alt="db 07.2024" class="w-full rounded-3xl shadow-2xl" loading="lazy">
        </div>

        <!-- Hinweis Formwaende mit dezentem Link -->
        <p class="text-center text-sm text-muted-foreground mt-24 reveal" style="transition-delay: 360ms">
          Mitarbeit als Innenarchitektur M.A. bei <span class="font-medium">FORMWÆNDE</span>, Lüneburg<br><br>
          <a href="https://www.formwaende.de/projekte/mymindstudio/" 
             target="_blank" 
             class="text-primary hover:text-primary/90 underline decoration-current underline-offset-4 transition-colors">
            Mehr Projektinhalte unter FORMWÆNDE →
          </a>
        </p>
      </div>
    </section>

    <script>
      // @ts-nocheck
      // Gleiche sanfte Reveal-Animation wie bei Challenge, Research und Process
      function initFinalReveal() {
        const reveals = /** @type {NodeListOf<HTMLElement>} */ (document.querySelectorAll('#final-design .reveal'));
        reveals.forEach((el, i) => {
          el.style.opacity = '0';
          el.style.transform = 'translateY(30px)';
          el.style.transition = 'all 1s cubic-bezier(0.25, 0.1, 0.25, 1)';

          const observer = new IntersectionObserver((entries) => {
            if (!entries[0].isIntersecting) return;
            setTimeout(() => {
              el.style.opacity = '1';
              el.style.transform = 'translateY(0)';
            }, i * 140);
            observer.disconnect();
          }, { threshold: 0.12, rootMargin: '0px 0px -10% 0px' });

          observer.observe(el);
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initFinalReveal, { once: true });
      } else {
        initFinalReveal();
      }
    </script>

    <!-- === ERGEBNISSE & ERKENNTNISSE – My Mind Studio (optimierte Version) === -->
    <section id="ergebnisse" class="py-28 md:py-36 bg-background border-t border-border">
      <div class="max-w-5xl mx-auto px-6 md:px-12">
        
        <h2 class="text-h2 text-center mb-16 reveal">
          Ergebnisse & Erkenntnisse
        </h2>

        <div class="max-w-3xl mx-auto text-center text-body-lg text-muted-foreground mb-20 reveal" style="transition-delay: 80ms">
          Aus einer dunklen, langgestreckten Ladenfläche, die jahrelang den Betreiber wechseln musste, ist ein echter Ort der Auszeit entstanden.
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          
          <div class="bg-card border border-border rounded-3xl p-8 transition-all duration-300 hover:-translate-y-1 hover:shadow-lg reveal">
            <div class="text-primary text-5xl font-semibold mb-4">01</div>
            <h3 class="text-h4 mb-3">Der Fokuswechsel funktioniert</h3>
            <p class="text-body text-muted-foreground">Gäste werden von der belebten Fußgängerzone <span class="text-primary font-medium">schrittweise Übergang vom Außen ins Innere</span> <span class="text-primary font-medium">sanft in eine ruhige, intime Atmosphäre</span> durch ein Café und einen mystisch anmutenden Tunnel in den stillen, intimen Kursraum geführt – der Übergang vom Außen ins Innere ist spürbar.</p>
          </div>

          <div class="bg-card border border-border rounded-3xl p-8 transition-all duration-300 hover:-translate-y-1 hover:shadow-lg reveal">
            <div class="text-primary text-5xl font-semibold mb-4">02</div>
            <h3 class="text-h4 mb-3">Reduktion schafft Atmosphäre</h3>
            <p class="text-body text-muted-foreground">Die schrittweise Reduktion der Material- und Farbpalette von heller Eiche und Linoleum bis hin zu <span class="text-primary font-medium">warme, weiche und sinnliche Atmosphäre</span> erzeugt eine ruhige, sinnliche und konzentrierte Stimmung.</p>
          </div>

          <div class="bg-card border border-border rounded-3xl p-8 transition-all duration-300 hover:-translate-y-1 hover:shadow-lg reveal">
            <div class="text-primary text-5xl font-semibold mb-4">03</div>
            <h3 class="text-h4 mb-3">Langfristige Nutzung gesichert</h3>
            <p class="text-body text-muted-foreground">Durch die klare Raumgliederung und flexible Teilbarkeit entstand eine <span class="text-primary font-medium">zukunftsfähige Immobilie</span> – nach jahrelangem Betreiberwechsel hat der Eigentümer endlich Stabilität gewonnen.</p>
          </div>

          <div class="bg-card border border-border rounded-3xl p-8 transition-all duration-300 hover:-translate-y-1 hover:shadow-lg reveal">
            <div class="text-primary text-5xl font-semibold mb-4">04</div>
            <h3 class="text-h4 mb-3">Historische Qualität fortgesetzt</h3>
            <p class="text-body text-muted-foreground">Die gestalterische Qualität der historischen Fassade wurde <span class="text-primary font-medium">respektvoll ins Innere übertragen</span> – ein <span class="text-primary font-medium">zeitgemäßer und gleichzeitig respektvoller Ausbau</span>, der die mittelalterliche Bausubstanz würdigt.</p>
          </div>
        </div>

        <p class="text-center text-lg text-muted-foreground mt-16 max-w-2xl mx-auto reveal" style="transition-delay: 320ms">
          My Mind Studio beweist: <span class="text-primary font-medium">Weniger kann mehr sein</span> – ein reduzierter Raum, der den Alltag ausblendet und die Sinne öffnet.
        </p>

        <!-- Zurück-Button -->
        <div class="flex justify-center mt-12">
          <Button href="/projekte" variant="primary" size="lg" class="w-full sm:w-auto">Zurück zu allen Projekten →</Button>
        </div>

        <!-- Projekt-Navigation -->
        <div class="mt-14 md:mt-20 pt-8 md:pt-12 border-t border-border flex flex-col md:flex-row gap-4 md:gap-6 justify-between">
          <Button href="/projekte/weserkoje" variant="primary" size="lg" class="w-full md:w-auto">← Letztes Projekt</Button>
          <Button href="/projekte/festsaal-im-klostergasthof" variant="primary" size="lg" class="w-full md:w-auto">Nächstes Projekt →</Button>
        </div>
      </div>
    </section>

    <script>
      // @ts-nocheck
      // Sanfte Reveal-Animation (wie bei allen anderen Blöcken)
      function initResultsReveal() {
        const reveals = /** @type {NodeListOf<HTMLElement>} */ (document.querySelectorAll('#ergebnisse .reveal'));
        reveals.forEach((el, i) => {
          el.style.opacity = '0';
          el.style.transform = 'translateY(30px)';
          el.style.transition = 'all 1s cubic-bezier(0.25, 0.1, 0.25, 1)';

          const observer = new IntersectionObserver((entries) => {
            if (!entries[0].isIntersecting) return;
            setTimeout(() => {
              el.style.opacity = '1';
              el.style.transform = 'translateY(0)';
            }, i * 140);
            observer.disconnect();
          }, { threshold: 0.12, rootMargin: '0px 0px -10% 0px' });

          observer.observe(el);
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initResultsReveal, { once: true });
      } else {
        initResultsReveal();
      }
    </script>

    <script>
      // @ts-nocheck
      function animateCounter(id, target, duration = 1600) {
        const counter = document.getElementById(id);
        if (!(counter instanceof HTMLElement)) return;
        const startTime = performance.now();

        function update(now) {
          const progress = Math.min((now - startTime) / duration, 1);
          counter.textContent = String(Math.floor(progress * target));
          if (progress < 1) requestAnimationFrame(update);
        }

        requestAnimationFrame(update);
      }

      function initSequentialReveals() {
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const groups = /** @type {NodeListOf<HTMLElement>} */ (document.querySelectorAll('[data-reveal-group]'));

        groups.forEach((group) => {
          const items = /** @type {NodeListOf<HTMLElement>} */ (group.querySelectorAll('.reveal-item'));
          if (!items.length) return;

          if (reduceMotion) {
            items.forEach((item) => {
              item.style.opacity = '1';
              item.style.transform = 'none';
            });
            if (group.id === 'research') {
              animateCounter('count-60', 60);
              animateCounter('count-88', 88);
              animateCounter('count-56', 56);
              animateCounter('count-42', 42);
            }
            return;
          }

          items.forEach((item) => {
            item.style.opacity = '0';
            item.style.transform = 'translateY(28px)';
            item.style.transition = 'all 1s cubic-bezier(0.25, 0.1, 0.25, 1)';
            item.style.willChange = 'opacity, transform';
          });

          const observer = new IntersectionObserver((entries) => {
            if (!entries[0].isIntersecting) return;

            items.forEach((item, index) => {
              setTimeout(() => {
                item.style.opacity = '1';
                item.style.transform = 'translateY(0)';

                if (group.id === 'research' && group.dataset.countAnimated !== 'true' && item.querySelector('#count-60')) {
                  animateCounter('count-60', 60);
                  animateCounter('count-88', 88);
                  animateCounter('count-56', 56);
                  animateCounter('count-42', 42);
                  group.dataset.countAnimated = 'true';
                }
              }, index * 160);
            });
            group.dataset.revealed = 'true';

            observer.disconnect();
          }, { threshold: 0.2, rootMargin: '0px 0px -8% 0px' });

          observer.observe(group);
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initSequentialReveals, { once: true });
      } else {
        initSequentialReveals();
      }
    </script>

  </div>

</Layout>
