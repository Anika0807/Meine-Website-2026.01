---
import Layout from '@/layouts/Layout.astro';
---

<Layout title="Weserkoje – Anika Warncke">
  <!-- 1. HERO -->
  <section class="relative min-h-[100svh] flex items-center justify-center overflow-hidden" data-reveal-group>
    <img src="/images/projekte/weserkoje-hero.jpg" alt="Weserkoje" class="absolute inset-0 w-full h-full object-cover" loading="eager" fetchpriority="high">
    <div class="absolute inset-0 bg-gradient-to-b from-black/40 via-black/20 to-black/70"></div>
    <div class="relative z-10 text-center text-white px-4 sm:px-6 max-w-4xl">
      <p class="reveal-item text-sm tracking-[4px] uppercase font-medium mb-4 opacity-90">INNENARCHITEKTUR • HOSPITALITY</p>
      <h1 class="reveal-item text-5xl sm:text-6xl md:text-7xl font-semibold tracking-tighter leading-none">Weserkoje</h1>
      <p class="reveal-item mt-5 text-base sm:text-xl md:text-2xl max-w-lg mx-auto opacity-90">Multifunktionale Herberge mit integriertem Tagungszentrum</p>
    </div>
  </section>

  <!-- Content Rail – alle weiteren Sections -->
  <div class="max-w-6xl mx-auto px-4 sm:px-6">

    <!-- === METADATA – Überschriften größer & fetter (nur WESERKOJE) === -->
    <section class="pt-12 pb-20 md:pb-28 bg-background" data-reveal-group>
      <div class="max-w-7xl mx-auto px-0 md:px-12">
        
        <!-- Metadata Zeile – Mobile: vertikal gestapelt -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-y-10 md:gap-y-0 gap-x-8 mb-16 text-sm">
          <div class="reveal-item">
            <p class="uppercase tracking-widest text-sm font-medium text-foreground mb-3">Rolle</p>
            <p class="text-foreground">
              <span class="text-primary font-medium">Innenarchitektur B.A.</span>
            </p>
          </div>
          <div class="reveal-item">
            <p class="uppercase tracking-widest text-sm font-medium text-foreground mb-3">Aufgabe</p>
              <p class="text-foreground">
                Grundlagenermittlung bis zur Ausführungsreife<br>
                <span class="text-primary font-medium">Leistungsphasen 01 - 03, anteilig 05</span>
              </p>
          </div>
          <div class="reveal-item">
            <p class="uppercase tracking-widest text-sm font-medium text-foreground mb-3">Zeitraum & Rahmen</p>
            <p class="text-foreground">
              03 - 07 2017:<br>
              <span class="text-primary font-medium"></span><a href="https://projekte.g.hawk.de/projekt/5df0c5b8174c8" class="text-primary font-medium underline" target="_blank">Bachelorarbeit</a>, an der HAWK - Hochschule für angewandte Künste in Hildesheim
            </p>
          </div>
          <div class="reveal-item">
            <p class="uppercase tracking-widest text-sm font-medium text-foreground mb-3">Tools</p>
            <p class="text-foreground">
              <span class="text-primary font-medium">Vectorworks</span>, Adobe Creative Suite
            </p>
          </div>
        </div>

      </div>
    </section>

    <!-- === THE CHALLENGE – Weserkoje === -->
    <section id="challenge" class="py-28 md:py-36 bg-background border-t border-border">
      <div class="max-w-4xl mx-auto px-6 md:px-12">
        
        <h2 class="text-h2 text-center mb-16 reveal">
          Herausforderung
        </h2>

        <div class="prose prose-lg mx-auto text-center text-muted-foreground leading-relaxed reveal" style="transition-delay: 80ms">
          <p class="text-body-lg">
            Der drohende Leerstand der ehemaligen Augenklinik und Urologie in Bremen stellte eine <span class="text-primary font-medium">doppelte Herausforderung</span> dar: Den Verfall <span class="text-primary font-medium">wertvoller historischer Bausubstanz</span> in zentraler Lage zu verhindern und das Quartier <span class="text-primary font-medium">sozial und wirtschaftlich zu stärken</span>. Gesucht wurde ein architektonisch anspruchsvolles und wirtschaftlich tragfähiges Nachnutzungskonzept, das einen spürbaren Mehrwert für die Gemeinschaft generiert.
          </p>
        </div>

        <img src="/images/projekte/weserkoje-herausforderung-01.png" alt="Herausforderung Visualisierung" class="w-full h-52 sm:h-72 md:h-[440px] rounded-3xl border border-border bg-muted/40 shadow-sm object-cover object-center mt-16 reveal" style="transition-delay: 120ms" loading="lazy">
      </div>
    </section>

    <script>
      // Staggered Reveal – The Challenge
      function initChallengeReveal() {
        const reveals = document.querySelectorAll<HTMLElement>('#challenge .reveal');
        reveals.forEach((el, i) => {
          el.style.opacity = '0';
          el.style.transform = 'translateY(30px)';
          el.style.transition = 'all 1s cubic-bezier(0.25, 0.1, 0.25, 1)';

          const observer = new IntersectionObserver((entries) => {
            if (!entries[0].isIntersecting) return;
            setTimeout(() => {
              el.style.opacity = '1';
              el.style.transform = 'translateY(0)';
            }, i * 140);
            observer.disconnect();
          }, { threshold: 0.12, rootMargin: '0px 0px -10% 0px' });

          observer.observe(el);
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initChallengeReveal, { once: true });
      } else {
        initChallengeReveal();
      }
    </script>

    <!-- === KONZEPT – My Mind Studio (finale Version mit deinen Änderungen) === -->
    <section id="konzept" class="py-28 md:py-36 bg-background border-t border-border">
      <div class="max-w-5xl mx-auto px-6 md:px-12">
        
        <h2 class="text-h2 text-center mb-16 reveal">
          Konzept
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          
          <!-- 01 Horizontale Erlebniswelten -->
          <div class="bg-card border border-border rounded-3xl p-8 reveal">
            <div class="text-primary text-5xl font-semibold mb-4">01</div>
            <h3 class="text-h4 mb-3">Horizontale Erlebniswelten</h3>
            <p class="text-body text-muted-foreground">Die innere Organisation folgt einer klaren <span class="text-primary font-medium">horizontalen Zonierung</span>. Das Gebäude wird in drei <span class="text-primary font-medium">atmosphärische Ebenen</span> gegliedert: das pulsierende öffentliche Herz im Untergeschoss, den fokussierten Tagungsbereich im Erdgeschoss und den privaten Rückzugsort in den Obergeschossen.</p>
          </div>

          <!-- 02 Pulsierendes Herz -->
          <div class="bg-card border border-border rounded-3xl p-8 reveal">
            <div class="text-primary text-5xl font-semibold mb-4">02</div>
            <h3 class="text-h4 mb-3">Pulsierendes Herz</h3>
            <p class="text-body text-muted-foreground">Im <span class="text-primary font-medium">Souterrain</span> schlägt das <span class="text-primary font-medium">öffentliche Leben</span> der Weserkoje. Lobby, Restaurant und Bar bilden einen fließenden Raum, der Hotelgäste und externe Besucher einlädt und die Grenzen zwischen Rucksacktouristen, Geschäftsreisenden und Bremern bewusst auflöst.</p>
          </div>

          <!-- 03 Fokus & Kollaboration -->
          <div class="bg-card border border-border rounded-3xl p-8 reveal">
            <div class="text-primary text-5xl font-semibold mb-4">03</div>
            <h3 class="text-h4 mb-3">Fokus & Kollaboration</h3>
            <p class="text-body text-muted-foreground">Das <span class="text-primary font-medium">Erdgeschoss</span> dient als professioneller <span class="text-primary font-medium">Tagungs- und Seminarbereich</span>. Flexible, hochmodern ausgestattete Räume schaffen eine konzentrierte Arbeitsatmosphäre, während die zentrale Lobby als repräsentatives Entrée fungiert.</p>
          </div>

          <!-- 04 Privater Rückzugsort -->
          <div class="bg-card border border-border rounded-3xl p-8 reveal">
            <div class="text-primary text-5xl font-semibold mb-4">04</div>
            <h3 class="text-h4 mb-3">Privater Rückzugsort</h3>
            <p class="text-body text-muted-foreground">Die <span class="text-primary font-medium">oberen Etagen</span> sind dem <span class="text-primary font-medium">Wohnen und der Entspannung</span> gewidmet. Komfortable Doppelzimmer bieten Ruhe für Geschäftsreisende, während praktische Mehrbettzimmer den kommunikativen Geist von Backpackern aufgreifen.</p>
          </div>
        </div>

        <img src="/images/projekte/weserkoje-konzept-01.png" alt="Konzept Visualisierung" class="w-full h-auto rounded-3xl border border-border bg-muted/40 shadow-sm object-contain mt-12 reveal" style="transition-delay: 180ms" loading="lazy">
      </div>
    </section>

    <script>
      // Staggered Reveal – Konzept-Karten
      function initKonzeptReveal() {
        const reveals = document.querySelectorAll<HTMLElement>('#konzept .reveal');
        reveals.forEach((el, i) => {
          el.style.opacity = '0';
          el.style.transform = 'translateY(30px)';
          el.style.transition = 'all 1s cubic-bezier(0.25, 0.1, 0.25, 1)';

          const observer = new IntersectionObserver((entries) => {
            if (!entries[0].isIntersecting) return;
            setTimeout(() => {
              el.style.opacity = '1';
              el.style.transform = 'translateY(0)';
            }, i * 140);
            observer.disconnect();
          }, { threshold: 0.12, rootMargin: '0px 0px -10% 0px' });

          observer.observe(el);
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initKonzeptReveal, { once: true });
      } else {
        initKonzeptReveal();
      }
    </script>

    <!-- === FINAL DESIGN – My Mind Studio (echte Buttons + mehr Abstand) === -->
    <section id="final-design" class="py-32 md:py-44 bg-background border-t border-border">
      <div class="max-w-7xl mx-auto px-6 md:px-12">
        
        <h2 class="text-h2 text-center mb-16 reveal">
          Entwurf & Visualisierung
        </h2>

        <p class="max-w-3xl mx-auto text-center text-body-lg text-muted-foreground">
          Das zentrale Designthema <span class="text-primary font-medium">„Schwingung“</span> ist inspiriert vom Flusslauf der Weser. Die finalen Renderings zeigen, wie die Lobby als <span class="text-primary font-medium">fließender Raum</span> inszeniert wird: Ein schwungvoller, goldener Empfangstresen, eine plastisch geformte Wellenstruktur an der Rückwand und ein <span class="text-primary font-medium">vielschichtiges Lichtkonzept</span> schaffen eine einladende, skulpturale Atmosphäre.
        </p>

        <div class="mt-16 space-y-8">
          <img src="/images/projekte/weserkoje-entwurf-01.png" alt="Entwurf und Visualisierung 01" class="w-full h-auto rounded-3xl border border-border bg-muted/40 shadow-sm object-contain reveal" style="transition-delay: 120ms" loading="lazy">
          <img src="/images/projekte/weserkoje-entwurf-02.png" alt="Entwurf und Visualisierung 02" class="w-full h-auto rounded-3xl border border-border bg-muted/40 shadow-sm object-contain reveal" style="transition-delay: 180ms" loading="lazy">
          <img src="/images/projekte/weserkoje-entwurf-03.png" alt="Entwurf und Visualisierung 03" class="w-full h-auto rounded-3xl border border-border bg-muted/40 shadow-sm object-contain reveal" style="transition-delay: 240ms" loading="lazy">
        </div>
      </div>
    </section>

    <script>
      // Gleiche sanfte Reveal-Animation wie bei Challenge, Research und Process
      function initFinalReveal() {
        const reveals = document.querySelectorAll<HTMLElement>('#final-design .reveal');
        reveals.forEach((el, i) => {
          el.style.opacity = '0';
          el.style.transform = 'translateY(30px)';
          el.style.transition = 'all 1s cubic-bezier(0.25, 0.1, 0.25, 1)';

          const observer = new IntersectionObserver((entries) => {
            if (!entries[0].isIntersecting) return;
            setTimeout(() => {
              el.style.opacity = '1';
              el.style.transform = 'translateY(0)';
            }, i * 140);
            observer.disconnect();
          }, { threshold: 0.12, rootMargin: '0px 0px -10% 0px' });

          observer.observe(el);
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initFinalReveal, { once: true });
      } else {
        initFinalReveal();
      }
    </script>

    <!-- === ERGEBNISSE & ERKENNTNISSE – Weserkoje === -->
    <section id="ergebnisse" class="py-28 md:py-36 bg-background border-t border-border">
      <div class="max-w-5xl mx-auto px-6 md:px-12">
        
        <h2 class="text-h2 text-center mb-16 reveal">
          Ergebnisse & Erkenntnisse
        </h2>

        <div class="max-w-3xl mx-auto text-center text-body-lg text-muted-foreground mb-20 reveal" style="transition-delay: 80ms">
          Die „Weserkoje“ ist mehr als eine Herberge – sie ist ein <span class="text-primary font-medium">lebendiges, durchdachtes innenarchitektonisches Ökosystem</span>, das <span class="text-primary font-medium">Respekt vor dem historischen Bestand</span> mit einer zukunftsorientierten Vision für gemeinschaftliches Leben und Arbeiten verbindet.
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 reveal" style="transition-delay: 160ms">
          <div class="bg-background border border-border rounded-3xl p-8">
            <div class="text-primary text-5xl font-semibold mb-4">01</div>
            <h3 class="text-h4 mb-3">Neuer lebendiger Treffpunkt</h3>
            <p class="text-body text-muted-foreground">Ein <span class="text-primary font-medium">offener, fließender Raum</span>, der Rucksacktouristen, Geschäftsreisende und Bremer zusammenbringt und das Quartier <span class="text-primary font-medium">sozial belebt</span>.</p>
          </div>

          <div class="bg-background border border-border rounded-3xl p-8">
            <div class="text-primary text-5xl font-semibold mb-4">02</div>
            <h3 class="text-h4 mb-3">Respektvolle Transformation</h3>
            <p class="text-body text-muted-foreground">Die <span class="text-primary font-medium">historische Bausubstanz</span> wurde bewahrt und sensibel mit modernen Elementen verbunden – ein gelungener <span class="text-primary font-medium">Dialog zwischen Vergangenheit und Gegenwart</span>.</p>
          </div>

          <div class="bg-background border border-border rounded-3xl p-8">
            <div class="text-primary text-5xl font-semibold mb-4">03</div>
            <h3 class="text-h4 mb-3">Nachhaltiger Mehrwert</h3>
            <p class="text-body text-muted-foreground">Das <span class="text-primary font-medium">duale Konzept aus Herberge und Tagungszentrum</span> sichert langfristige wirtschaftliche Tragfähigkeit und schafft einen spürbaren <span class="text-primary font-medium">sozialen und wirtschaftlichen Nutzen</span> für das gesamte Quartier.</p>
          </div>
        </div>

        <p class="text-center text-lg text-muted-foreground mt-16 max-w-2xl mx-auto reveal" style="transition-delay: 320ms">
          Die Weserkoje beweist: Mit <span class="text-primary font-medium">sensibler Innenarchitektur</span> kann man aus einem drohenden Leerstand einen lebendigen, zukunftsweisenden Ort schaffen – der nicht nur funktioniert, sondern die <span class="text-primary font-medium">Gemeinschaft bereichert</span>.
        </p>

        <!-- Zurück-Button -->
        <div class="flex justify-center mt-12">
          <a href="/projekte"
             class="w-full sm:w-auto bg-primary hover:bg-primary/90 text-primary-foreground text-base sm:text-lg font-medium px-6 sm:px-10 py-4 sm:py-6 rounded-btn text-center transition-all">
            Zurück zu allen Projekten →
          </a>
        </div>

        <!-- Projekt-Navigation -->
        <div class="mt-14 md:mt-20 pt-8 md:pt-12 border-t border-border flex flex-col md:flex-row gap-4 md:gap-6 justify-between">
          <a href="/projekte/[previous-project]"
             class="w-full md:w-auto bg-primary hover:bg-primary/90 text-primary-foreground text-base sm:text-lg font-medium px-6 sm:px-10 py-4 sm:py-6 rounded-btn text-center transition-all">
            ← Letztes Projekt
          </a>
          <a href="/projekte/[next-project]"
             class="w-full md:w-auto bg-primary hover:bg-primary/90 text-primary-foreground text-base sm:text-lg font-medium px-6 sm:px-10 py-4 sm:py-6 rounded-btn text-center transition-all">
            Nächstes Projekt →
          </a>
        </div>
      </div>
    </section>

    <script>
      // Sanfte Reveal-Animation (wie bei allen anderen Blöcken)
      function initResultsReveal() {
        const reveals = document.querySelectorAll<HTMLElement>('#ergebnisse .reveal');
        reveals.forEach((el, i) => {
          el.style.opacity = '0';
          el.style.transform = 'translateY(30px)';
          el.style.transition = 'all 1s cubic-bezier(0.25, 0.1, 0.25, 1)';

          const observer = new IntersectionObserver((entries) => {
            if (!entries[0].isIntersecting) return;
            setTimeout(() => {
              el.style.opacity = '1';
              el.style.transform = 'translateY(0)';
            }, i * 140);
            observer.disconnect();
          }, { threshold: 0.12, rootMargin: '0px 0px -10% 0px' });

          observer.observe(el);
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initResultsReveal, { once: true });
      } else {
        initResultsReveal();
      }
    </script>

    <script>
      function animateCounter(id: string, target: number, duration = 1600) {
        const el = document.getElementById(id);
        if (!el) return;
        const startTime = performance.now();

        function update(now: number) {
          const progress = Math.min((now - startTime) / duration, 1);
          el!.textContent = String(Math.floor(progress * target));
          if (progress < 1) requestAnimationFrame(update);
        }

        requestAnimationFrame(update);
      }

      function initSequentialReveals() {
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const groups = document.querySelectorAll<HTMLElement>('[data-reveal-group]');

        groups.forEach((group) => {
          const items = group.querySelectorAll<HTMLElement>('.reveal-item');
          if (!items.length) return;

          if (reduceMotion) {
            items.forEach((item) => {
              item.style.opacity = '1';
              item.style.transform = 'none';
            });
            if (group.id === 'research') {
              animateCounter('count-60', 60);
              animateCounter('count-88', 88);
              animateCounter('count-56', 56);
              animateCounter('count-42', 42);
            }
            return;
          }

          items.forEach((item) => {
            item.style.opacity = '0';
            item.style.transform = 'translateY(28px)';
            item.style.transition = 'all 1s cubic-bezier(0.25, 0.1, 0.25, 1)';
            item.style.willChange = 'opacity, transform';
          });

          const observer = new IntersectionObserver((entries) => {
            if (!entries[0].isIntersecting) return;

            items.forEach((item, index) => {
              setTimeout(() => {
                item.style.opacity = '1';
                item.style.transform = 'translateY(0)';

                if (group.id === 'research' && group.dataset.countAnimated !== 'true' && item.querySelector('#count-60')) {
                  animateCounter('count-60', 60);
                  animateCounter('count-88', 88);
                  animateCounter('count-56', 56);
                  animateCounter('count-42', 42);
                  group.dataset.countAnimated = 'true';
                }
              }, index * 160);
            });
            group.dataset.revealed = 'true';

            observer.disconnect();
          }, { threshold: 0.2, rootMargin: '0px 0px -8% 0px' });

          observer.observe(group);
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initSequentialReveals, { once: true });
      } else {
        initSequentialReveals();
      }
    </script>

  </div>

</Layout>
