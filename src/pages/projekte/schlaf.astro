---
import Layout from '@/layouts/Layout.astro';
---

<Layout title="SCHLAF – Anika Warncke">
  <!-- 1. HERO -->
  <section class="relative min-h-[100svh] flex items-center justify-center overflow-hidden" data-reveal-group>
    <img src="/images/projekte/schlaf-hero.jpg" alt="SCHLAF" class="absolute inset-0 w-full h-full object-cover" loading="eager" fetchpriority="high">
    <div class="absolute inset-0 bg-gradient-to-b from-black/40 via-black/20 to-black/70"></div>
    <div class="relative z-10 text-center text-white px-4 sm:px-6 max-w-4xl">
      <p class="reveal-item text-sm tracking-[4px] uppercase font-medium mb-4 opacity-90">INNENARCHITEKTUR • AUSSTELLUNGSDESIGN</p>
      <h1 class="reveal-item text-5xl sm:text-6xl md:text-7xl font-semibold tracking-tighter leading-none">SCHLAF</h1>
      <p class="reveal-item mt-5 text-base sm:text-xl md:text-2xl max-w-lg mx-auto opacity-90">Eine Erlebnisausstellung in die Tiefen des Schlafes</p>
    </div>
  </section>

  <!-- Content Rail – alle weiteren Sections -->
  <div class="max-w-6xl mx-auto px-4 sm:px-6">

    <!-- === METADATA – Überschriften größer & fetter (nur SCHLAF) === -->
    <section class="pt-12 pb-20 md:pb-28 bg-background border-t border-border" data-reveal-group>
      <div class="max-w-7xl mx-auto px-0 md:px-12">
        
        <!-- Metadata Zeile – Mobile: vertikal gestapelt -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-y-10 md:gap-y-0 gap-x-8 mb-16 text-sm">
          <div class="reveal-item">
            <p class="uppercase tracking-widest text-sm font-medium text-foreground mb-3">Rolle</p>
            <p class="text-foreground">
              <span class="text-primary font-medium">Innenarchitektur M.A.</span>
            </p>
          </div>
          <div class="reveal-item">
            <p class="uppercase tracking-widest text-sm font-medium text-foreground mb-3">Aufgabe</p>
              <p class="text-foreground">
                Erarbeitung einer Erlebnisausstellung in die Tiefen des Schlafes<br>
                <span class="text-primary font-medium">Leistungsphasen 01 - 03, anteilig 05</span>
              </p>
          </div>
          <div class="reveal-item">
            <p class="uppercase tracking-widest text-sm font-medium text-foreground mb-3">Zeitraum & Rahmen</p>
            <p class="text-foreground">
              03 - 07 2020:<br>
              <span class="text-primary font-medium"></span><a href="https://projekte.g.hawk.de/projekt/5f2d054b1bef1" class="text-primary font-medium underline" target="_blank">Masterarbeit</a>, an der HAWK - Hochschule für angewandte Künste in Hildesheim
            </p>
          </div>
          <div class="reveal-item">
            <p class="uppercase tracking-widest text-sm font-medium text-foreground mb-3">Tools</p>
            <p class="text-foreground">
              <span class="text-primary font-medium">Vectorworks</span>, Adobe Creative Suite
            </p>
          </div>
        </div>

      </div>
    </section>

    <div class="pb-10 md:pb-16" data-reveal-group>
      <img
        src="/images/projekte/schlaf-herausforderung-placeholder.png"
        alt="Platzhalterbild vor dem Bereich Herausforderung"
        class="reveal-item w-full h-auto rounded-3xl border border-border bg-muted/40 shadow-sm object-contain" loading="lazy">
    </div>

    <!-- === THE CHALLENGE – Schlaf === -->
    <section id="challenge" class="py-28 md:py-36 bg-background border-t border-border">
      <div class="max-w-4xl mx-auto px-6 md:px-12">
        
        <h2 class="text-h2 text-center mb-16 reveal">
          Herausforderung
        </h2>

        <div class="prose prose-lg mx-auto text-center text-muted-foreground leading-relaxed reveal" style="transition-delay: 80ms">
            <p class="text-body-lg">
              Der <span class="text-primary font-medium">ständige gesellschaftliche Leistungsdruck</span> lässt Millionen Deutsche nicht mehr zur Ruhe kommen. Obwohl Schlaf ein Drittel unseres Lebens ausmacht und für die Regeneration entscheidend ist, leiden viele unter Schlafproblemen – mit <span class="text-primary font-medium">gravierenden Folgen</span> wie schweren Unfällen und langfristigen Gesundheitsschäden. Gesucht wurde daher eine <span class="text-primary font-medium">präventive, erlebbare Lösung</span>, die Wissen mit Emotion verbindet.
            </p>
        </div>

        <div class="mt-10 md:mt-12 reveal" style="transition-delay: 140ms">
          <img
            src="/images/projekte/schlaf-herausforderung-detail-placeholder.png"
            alt="Platzhalterbild unter dem Fließtext der Herausforderung"
            class="w-full h-auto rounded-3xl border border-border bg-muted/40 shadow-sm object-contain" loading="lazy">
        </div>
      </div>
    </section>

    <script>
      // Staggered Reveal – The Challenge
      function initChallengeReveal() {
        const reveals = document.querySelectorAll<HTMLElement>('#challenge .reveal');
        reveals.forEach((el, i) => {
          el.style.opacity = '0';
          el.style.transform = 'translateY(30px)';
          el.style.transition = 'all 1s cubic-bezier(0.25, 0.1, 0.25, 1)';

          const observer = new IntersectionObserver((entries) => {
            if (!entries[0].isIntersecting) return;
            setTimeout(() => {
              el.style.opacity = '1';
              el.style.transform = 'translateY(0)';
            }, i * 140);
            observer.disconnect();
          }, { threshold: 0.12, rootMargin: '0px 0px -10% 0px' });

          observer.observe(el);
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initChallengeReveal, { once: true });
      } else {
        initChallengeReveal();
      }
    </script>

    <!-- === KONZEPT – My Mind Studio (finale Version mit deinen Änderungen) === -->
    <section id="konzept" class="py-28 md:py-36 bg-background border-t border-border">
      <div class="max-w-5xl mx-auto px-6 md:px-12">
        
        <h2 class="text-h2 text-center mb-16 reveal">
          Konzept
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <!-- 01 Horizontale Erlebniswelten -->
          <div class="bg-card border border-border rounded-3xl p-8 reveal">
            <div class="text-primary text-5xl font-semibold mb-4">01</div>
            <h3 class="text-h4 mb-3">Horizontale Erlebniswelten</h3>
            <p class="text-body text-muted-foreground">Die Ausstellung folgt einer <span class="text-primary font-medium">klaren horizontalen Zonierung</span> von hell zu dunkel. Neun thematische Bereiche führen den Besucher auf einer <span class="text-primary font-medium">intuitiven Reise</span> durch die <span class="text-primary font-medium">Tiefen des Schlafes</span> – von der sanften Einführung bis zum motivierenden Abschied.</p>
          </div>

          <!-- 02 Multisensuale Entdeckertour -->
          <div class="bg-card border border-border rounded-3xl p-8 reveal">
            <div class="text-primary text-5xl font-semibold mb-4">02</div>
            <h3 class="text-h4 mb-3">Multisensuale Entdeckertour</h3>
            <p class="text-body text-muted-foreground">Wissen aus Somnologie, Psychologie, Geschichte und Medizin wird mit interaktiven, <span class="text-primary font-medium">multisensorischen Erlebnissen</span> verknüpft. Besucher <span class="text-primary font-medium">hören, fühlen, riechen</span> und erleben den Schlaf aktiv – nicht nur theoretisch, sondern <span class="text-primary font-medium">körperlich spürbar</span>.</p>
          </div>

          <!-- 03 Vom Wissen zum Erleben -->
          <div class="bg-card border border-border rounded-3xl p-8 reveal">
            <div class="text-primary text-5xl font-semibold mb-4">03</div>
            <h3 class="text-h4 mb-3">Vom Wissen zum Erleben</h3>
            <p class="text-body text-muted-foreground">Der Besucher wird <span class="text-primary font-medium">selbst zum Protagonisten</span>: Er analysiert seinen eigenen Schlaf, erkundet historische Schlafkulturen, testet seine innere Uhr und taucht in Traumwelten ein. So wird <span class="text-primary font-medium">komplexes Wissen greifbar</span> und <span class="text-primary font-medium">persönlich relevant</span>.</p>
          </div>

          <!-- 04 Prävention mit Unterhaltung -->
          <div class="bg-card border border-border rounded-3xl p-8 reveal">
            <div class="text-primary text-5xl font-semibold mb-4">04</div>
            <h3 class="text-h4 mb-3">Prävention mit Unterhaltung</h3>
            <p class="text-body text-muted-foreground">Die Ausstellung macht <span class="text-primary font-medium">Schlafhygiene unterhaltsam</span> und motivierend. Am Ende geht jeder Besucher als <span class="text-primary font-medium">Experte seines eigenen Schlafes</span> nach Hause – mit <span class="text-primary font-medium">praktischen Tools</span> und dem Wunsch, seinen Alltag schlaffreundlicher zu gestalten.</p>
          </div>
        </div>

        <div class="mt-8 md:mt-10 reveal">
          <img
            src="/images/projekte/schlaf-konzept-placeholder.png"
            alt="Platzhalterbild unter dem Bereich Konzept"
            class="w-full h-auto rounded-3xl border border-border bg-muted/40 shadow-sm object-contain" loading="lazy">
        </div>
      </div>
    </section>

    <script>
      // Staggered Reveal – Konzept-Karten
      function initKonzeptReveal() {
        const reveals = document.querySelectorAll<HTMLElement>('#konzept .reveal');
        reveals.forEach((el, i) => {
          el.style.opacity = '0';
          el.style.transform = 'translateY(30px)';
          el.style.transition = 'all 1s cubic-bezier(0.25, 0.1, 0.25, 1)';

          const observer = new IntersectionObserver((entries) => {
            if (!entries[0].isIntersecting) return;
            setTimeout(() => {
              el.style.opacity = '1';
              el.style.transform = 'translateY(0)';
            }, i * 140);
            observer.disconnect();
          }, { threshold: 0.12, rootMargin: '0px 0px -10% 0px' });

          observer.observe(el);
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initKonzeptReveal, { once: true });
      } else {
        initKonzeptReveal();
      }
    </script>

    <!-- === FINAL DESIGN – Schlaf === -->
    <section id="final-design" class="py-32 md:py-44 bg-background border-t border-border">
      <div class="max-w-7xl mx-auto px-6 md:px-12">
        
        <h2 class="text-h2 text-center mb-16 reveal">
          Entwurf & Visualisierung
        </h2>

          <p class="max-w-3xl mx-auto text-center text-body-lg text-muted-foreground">
            Die Gestaltung verwandelt die <span class="text-primary font-medium">700 m² große Ausstellungsfläche</span> in eine atmosphärisch wohlige und entspannende Umgebung. Mit zunehmender Raumtiefe nimmt die Dunkelheit zu – ein Leitmotiv, das den Weg in die <span class="text-primary font-medium">Tiefen des Schlafes</span> symbolisiert. Jeder der <span class="text-primary font-medium">neun Bereiche</span> hat eine eigene charakteristische Inszenierung: von der sanften „Gute Nacht"-Einführung über den dunklen Irrgarten der Schlafprobleme bis hin zum hellen „Guten Morgen"-Abschluss mit Lichtsimulation und Duft von Kaffee und Tee. Die finalen Renderings zeigen die <span class="text-primary font-medium">immersive Kraft der Ausstellung</span>: fließende Formen, interaktive Exponate wie überdimensionale Schlafmützen, der gläserne Mensch und die große Waage der Schlafhygiene.
        </p>

        <div class="mt-10 md:mt-12 space-y-10 md:space-y-12">
          <figure class="reveal" style="transition-delay: 80ms">
            <img
              src="/images/projekte/schlaf-herausforderung-placeholder.png"
              alt="Platzhalterbild im Bereich Entwurf und Visualisierung"
              class="w-full h-auto rounded-3xl border border-border bg-muted/40 shadow-sm object-contain" loading="lazy">
            <figcaption class="mt-3 text-sm md:text-base text-muted-foreground text-center">
              I. Zeit zum Abtauchen - Gute Nacht
            </figcaption>
          </figure>

          <figure class="reveal" style="transition-delay: 120ms">
            <img src="/images/projekte/schlaf-entwurf-01.png" alt="Platzhalterbild Entwurf und Visualisierung 01" class="w-full h-auto rounded-3xl border border-border bg-muted/40 shadow-sm object-contain" loading="lazy">
            <figcaption class="mt-3 text-sm md:text-base text-muted-foreground text-center">II. Wie schläfst du?</figcaption>
          </figure>

          <figure class="reveal" style="transition-delay: 160ms">
            <img src="/images/projekte/schlaf-entwurf-02.png" alt="Platzhalterbild Entwurf und Visualisierung 02" class="w-full h-auto rounded-3xl border border-border bg-muted/40 shadow-sm object-contain" loading="lazy">
            <figcaption class="mt-3 text-sm md:text-base text-muted-foreground text-center">III. Dem Schlaf auf der Spur</figcaption>
          </figure>

          <figure class="reveal" style="transition-delay: 200ms">
            <img src="/images/projekte/schlaf-entwurf-03.png" alt="Platzhalterbild Entwurf und Visualisierung 03" class="w-full h-auto rounded-3xl border border-border bg-muted/40 shadow-sm object-contain" loading="lazy">
            <figcaption class="mt-3 text-sm md:text-base text-muted-foreground text-center">IV. Wie(so) schlafen wir?</figcaption>
          </figure>

          <figure class="reveal" style="transition-delay: 240ms">
            <img src="/images/projekte/schlaf-entwurf-04.png" alt="Platzhalterbild Entwurf und Visualisierung 04" class="w-full h-auto rounded-3xl border border-border bg-muted/40 shadow-sm object-contain" loading="lazy">
            <figcaption class="mt-3 text-sm md:text-base text-muted-foreground text-center">V. Wie tickst du?</figcaption>
          </figure>

          <figure class="reveal" style="transition-delay: 280ms">
            <img src="/images/projekte/schlaf-entwurf-05.png" alt="Platzhalterbild Entwurf und Visualisierung 05" class="w-full h-auto rounded-3xl border border-border bg-muted/40 shadow-sm object-contain" loading="lazy">
            <figcaption class="mt-3 text-sm md:text-base text-muted-foreground text-center">VI. [T]RAUM 01</figcaption>
          </figure>

          <figure class="reveal" style="transition-delay: 320ms">
            <img src="/images/projekte/schlaf-entwurf-06.png" alt="Platzhalterbild Entwurf und Visualisierung 06" class="w-full h-auto rounded-3xl border border-border bg-muted/40 shadow-sm object-contain" loading="lazy">
            <figcaption class="mt-3 text-sm md:text-base text-muted-foreground text-center">VI. [T]RAUM 02</figcaption>
          </figure>

          <figure class="reveal" style="transition-delay: 360ms">
            <img src="/images/projekte/schlaf-entwurf-07.png" alt="Platzhalterbild Entwurf und Visualisierung 07" class="w-full h-auto rounded-3xl border border-border bg-muted/40 shadow-sm object-contain" loading="lazy">
            <figcaption class="mt-3 text-sm md:text-base text-muted-foreground text-center">VII. Irrwege 01</figcaption>
          </figure>

          <figure class="reveal" style="transition-delay: 400ms">
            <img src="/images/projekte/schlaf-entwurf-08.png" alt="Platzhalterbild Entwurf und Visualisierung 08" class="w-full h-auto rounded-3xl border border-border bg-muted/40 shadow-sm object-contain" loading="lazy">
            <figcaption class="mt-3 text-sm md:text-base text-muted-foreground text-center">VII. Irrwege 02</figcaption>
          </figure>

          <figure class="reveal" style="transition-delay: 440ms">
            <img src="/images/projekte/schlaf-entwurf-09.png" alt="Platzhalterbild Entwurf und Visualisierung 09" class="w-full h-auto rounded-3xl border border-border bg-muted/40 shadow-sm object-contain" loading="lazy">
            <figcaption class="mt-3 text-sm md:text-base text-muted-foreground text-center">VIII. Die Waage der Schlafhygiene</figcaption>
          </figure>

          <figure class="reveal" style="transition-delay: 480ms">
            <img src="/images/projekte/schlaf-entwurf-10.png" alt="Platzhalterbild Entwurf und Visualisierung 10" class="w-full h-auto rounded-3xl border border-border bg-muted/40 shadow-sm object-contain" loading="lazy">
            <figcaption class="mt-3 text-sm md:text-base text-muted-foreground text-center">IX. Guten Morgen - Zeit zum Auftauchen</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <script>
      // Gleiche sanfte Reveal-Animation wie bei Challenge, Research und Process
      function initFinalReveal() {
        const reveals = document.querySelectorAll<HTMLElement>('#final-design .reveal');
        reveals.forEach((el, i) => {
          el.style.opacity = '0';
          el.style.transform = 'translateY(30px)';
          el.style.transition = 'all 1s cubic-bezier(0.25, 0.1, 0.25, 1)';

          const observer = new IntersectionObserver((entries) => {
            if (!entries[0].isIntersecting) return;
            setTimeout(() => {
              el.style.opacity = '1';
              el.style.transform = 'translateY(0)';
            }, i * 140);
            observer.disconnect();
          }, { threshold: 0.12, rootMargin: '0px 0px -10% 0px' });

          observer.observe(el);
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initFinalReveal, { once: true });
      } else {
        initFinalReveal();
      }
    </script>

    <!-- === ERGEBNISSE & ERKENNTNISSE – My Mind Studio (optimierte Version) === -->
    <section id="ergebnisse" class="py-28 md:py-36 bg-background border-t border-border">
      <div class="max-w-5xl mx-auto px-6 md:px-12">
        <h2 class="text-h2 text-center mb-16 reveal">
          Ergebnisse & Erkenntnisse
        </h2>

        <div class="max-w-3xl mx-auto text-center text-body-lg text-muted-foreground mb-20 reveal" style="transition-delay: 80ms">
          Aus einem gesellschaftlichen Problem, das Millionen Deutsche nicht mehr zur Ruhe kommen lässt, ist eine <span class="text-primary font-medium">inspirierende, multisensorische Erlebnisausstellung</span> entstanden – ein Ort, der den <span class="text-primary font-medium">Schlaf endlich greifbar</span> macht und Menschen zu einem gesünderen Leben motiviert.
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 reveal" style="transition-delay: 160ms">
          <div class="bg-card border border-border rounded-3xl p-8">
            <div class="text-primary text-5xl font-semibold mb-4">01</div>
            <h3 class="text-h4 mb-3">Neuer lebendiger Treffpunkt</h3>
            <p class="text-body text-muted-foreground">Die Ausstellung schafft einen Ort, an dem Menschen aller Altersgruppen und Lebensstile zusammenkommen und gemeinsam über Schlaf sprechen – ein sozialer Raum, der <span class="text-primary font-medium">Isolation durchbricht</span> und <span class="text-primary font-medium">Bewusstsein weckt</span>.</p>
          </div>

          <div class="bg-card border border-border rounded-3xl p-8">
            <div class="text-primary text-5xl font-semibold mb-4">02</div>
            <h3 class="text-h4 mb-3">Respektvolle Transformation</h3>
            <p class="text-body text-muted-foreground">Aus einer reinen Informationsvermittlung wurde eine emotionale Erlebnisreise. Die historische Bausubstanz des Gebäudes wird sensibel genutzt und mit moderner Gestaltung verbunden – ein <span class="text-primary font-medium">gelungener Dialog</span> zwischen <span class="text-primary font-medium">Vergangenheit und Gegenwart</span>.</p>
          </div>

          <div class="bg-card border border-border rounded-3xl p-8">
            <div class="text-primary text-5xl font-semibold mb-4">03</div>
            <h3 class="text-h4 mb-3">Nachhaltiger Mehrwert</h3>
            <p class="text-body text-muted-foreground">Besucher verlassen die Ausstellung nicht nur informiert, sondern <span class="text-primary font-medium">verändert</span>. Sie nehmen praktische Tools, neue Routinen und ein besseres Verständnis für ihren eigenen Schlaf mit – ein spürbarer Beitrag zur <span class="text-primary font-medium">gesellschaftlichen Gesundheitsprävention</span>.</p>
          </div>
        </div>

        <div class="mt-12 md:mt-16 reveal" style="transition-delay: 240ms">
          <img
            src="/images/projekte/schlaf-ergebnisse-placeholder.png"
            alt="Platzhalterbild vor dem Abschlusssatz im Bereich Ergebnisse und Erkenntnisse"
            class="w-full h-auto rounded-3xl border border-border bg-muted/40 shadow-sm object-contain" loading="lazy">
        </div>

        <p class="text-center text-lg text-muted-foreground mt-16 max-w-2xl mx-auto reveal" style="transition-delay: 320ms">
          Die Ausstellung „Schlaf“ beweist: Mit <span class="text-primary font-medium">sensibler Innenarchitektur</span> kann man aus einem gesellschaftlichen Problem einen <span class="text-primary font-medium">inspirierenden, lebendigen Ort</span> schaffen – der nicht nur Wissen vermittelt, sondern <span class="text-primary font-medium">Gemeinschaft bereichert</span> und Menschen zu einem gesünderen Leben motiviert.
        </p>

        <!-- Zurück-Button -->
        <div class="flex justify-center mt-12">
          <a href="/projekte"
             class="w-full sm:w-auto bg-primary hover:bg-primary/90 text-primary-foreground text-base sm:text-lg font-medium px-6 sm:px-10 py-4 sm:py-6 rounded-btn text-center transition-all">
            Zurück zu allen Projekten →
          </a>
        </div>

        <!-- Projekt-Navigation -->
        <div class="mt-14 md:mt-20 pt-8 md:pt-12 border-t border-border flex flex-col md:flex-row gap-4 md:gap-6 justify-between">
          <a href="/projekte/[previous-project]"
             class="w-full md:w-auto bg-primary hover:bg-primary/90 text-primary-foreground text-base sm:text-lg font-medium px-6 sm:px-10 py-4 sm:py-6 rounded-btn text-center transition-all">
            ← Letztes Projekt
          </a>
          <a href="/projekte/[next-project]"
             class="w-full md:w-auto bg-primary hover:bg-primary/90 text-primary-foreground text-base sm:text-lg font-medium px-6 sm:px-10 py-4 sm:py-6 rounded-btn text-center transition-all">
            Nächstes Projekt →
          </a>
        </div>
      </div>
    </section>

    <script>
      // Sanfte Reveal-Animation (wie bei allen anderen Blöcken)
      function initResultsReveal() {
        const reveals = document.querySelectorAll<HTMLElement>('#ergebnisse .reveal');
        reveals.forEach((el, i) => {
          el.style.opacity = '0';
          el.style.transform = 'translateY(30px)';
          el.style.transition = 'all 1s cubic-bezier(0.25, 0.1, 0.25, 1)';

          const observer = new IntersectionObserver((entries) => {
            if (!entries[0].isIntersecting) return;
            setTimeout(() => {
              el.style.opacity = '1';
              el.style.transform = 'translateY(0)';
            }, i * 140);
            observer.disconnect();
          }, { threshold: 0.12, rootMargin: '0px 0px -10% 0px' });

          observer.observe(el);
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initResultsReveal, { once: true });
      } else {
        initResultsReveal();
      }
    </script>

    <script>
      function animateCounter(id: string, target: number, duration = 1600) {
        const el = document.getElementById(id);
        if (!el) return;
        const startTime = performance.now();

        function update(now: number) {
          const progress = Math.min((now - startTime) / duration, 1);
          el!.textContent = String(Math.floor(progress * target));
          if (progress < 1) requestAnimationFrame(update);
        }

        requestAnimationFrame(update);
      }

      function initSequentialReveals() {
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const groups = document.querySelectorAll<HTMLElement>('[data-reveal-group]');

        groups.forEach((group) => {
          const items = group.querySelectorAll<HTMLElement>('.reveal-item');
          if (!items.length) return;

          if (reduceMotion) {
            items.forEach((item) => {
              item.style.opacity = '1';
              item.style.transform = 'none';
            });
            if (group.id === 'research') {
              animateCounter('count-60', 60);
              animateCounter('count-88', 88);
              animateCounter('count-56', 56);
              animateCounter('count-42', 42);
            }
            return;
          }

          items.forEach((item) => {
            item.style.opacity = '0';
            item.style.transform = 'translateY(28px)';
            item.style.transition = 'all 1s cubic-bezier(0.25, 0.1, 0.25, 1)';
            item.style.willChange = 'opacity, transform';
          });

          const observer = new IntersectionObserver((entries) => {
            if (!entries[0].isIntersecting) return;

            items.forEach((item, index) => {
              setTimeout(() => {
                item.style.opacity = '1';
                item.style.transform = 'translateY(0)';

                if (group.id === 'research' && group.dataset.countAnimated !== 'true' && item.querySelector('#count-60')) {
                  animateCounter('count-60', 60);
                  animateCounter('count-88', 88);
                  animateCounter('count-56', 56);
                  animateCounter('count-42', 42);
                  group.dataset.countAnimated = 'true';
                }
              }, index * 160);
            });
            group.dataset.revealed = 'true';

            observer.disconnect();
          }, { threshold: 0.2, rootMargin: '0px 0px -8% 0px' });

          observer.observe(group);
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initSequentialReveals, { once: true });
      } else {
        initSequentialReveals();
      }
    </script>

  </div>

</Layout>
