---
import Layout from '@/layouts/Layout.astro';
import Button from '@/components/ui/astro-button.astro';
---

<Layout title="Festsaal im Klostergasthof – Anika Warncke">
  <!-- 1. HERO -->
  <section class="relative min-h-[100svh] flex items-center justify-center overflow-hidden" data-reveal-group>
    <img src="/images/projekte/festsaal-hero.jpg" alt="Festsaal im Klostergasthof" class="absolute inset-0 w-full h-full object-cover" loading="eager" fetchpriority="high">
    <div class="absolute inset-0 bg-gradient-to-b from-black/40 via-black/20 to-black/70"></div>
    <div class="relative z-10 text-center text-white px-4 sm:px-6 max-w-4xl">
      <p class="reveal-item text-base md:text-lg font-semibold tracking-[0.16em] uppercase mb-3 opacity-95">Innenarchitektur • GASTRONOMIE</p>
      <h1 class="reveal-item text-[clamp(2.05rem,9.6vw,2.9rem)] md:text-[3.45rem] lg:text-[4.1rem] max-w-[18ch] mx-auto font-semibold tracking-tight leading-[0.92]">Festsaal im Klostergasthof</h1>
      <p class="reveal-item mt-4 text-lg md:text-xl max-w-lg mx-auto opacity-90">Veranstaltungsgastronomie für Hochzeiten und Events</p>
    </div>
  </section>

  <!-- Content Rail – alle weiteren Sections -->
  <div class="max-w-6xl mx-auto px-4 sm:px-6">

    <!-- === METADATA – Überschriften größer & fetter (nur My Mind Studio) === -->
    <section class="pt-12 pb-20 md:pb-28 bg-background border-t border-border" data-reveal-group>
      <div class="max-w-7xl mx-auto px-0 md:px-12">
        
        <!-- Metadata Zeile – Mobile: vertikal gestapelt -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-y-10 md:gap-y-0 gap-x-8 mb-16 text-sm">
          <div class="reveal-item">
            <p class="uppercase tracking-widest text-sm font-medium text-foreground mb-3">Rolle & Team</p>
            <p class="text-foreground">
              <span class="text-primary font-medium">Innenarchitektur M.A., Projektleitung</span> im 2-Personen-Team<br>mit Marco Smith
            </p>
          </div>
          <div class="reveal-item">
            <p class="uppercase tracking-widest text-sm font-medium text-foreground mb-3">Aufgabe</p>
              <p class="text-foreground">
                Redesign des Festsaals im Klostergasthof <br>
                Leistungsphasen 01 - 09, <span class="text-primary font-medium">Mitarbeit 03 - 09</span>
              </p>
          </div>
          <div class="reveal-item">
            <p class="uppercase tracking-widest text-sm font-medium text-foreground mb-3">Zeitraum & Rahmen</p>
            <p class="text-foreground">
              <span class="text-primary font-medium">01 | 2023 - 03 | 2024:</span><br>
              Festanstellung bei <a href="https://www.formwaende.de" class="text-primary font-medium underline" target="_blank" rel="noopener noreferrer">FORMWÆNDE</a>, Lüneburg<br>
              Projektstandort: <span class="text-primary font-medium">Augsburg</span>
            </p>
          </div>
          <div class="reveal-item">
            <p class="uppercase tracking-widest text-sm font-medium text-foreground mb-3">Tools</p>
            <p class="text-foreground">
              <span class="text-primary font-medium">Vectorworks</span>, Adobe Creative Suite, Microsoft Office
            </p>
          </div>
        </div>

      </div>
    </section>

    <!-- === THE CHALLENGE – FESTSAAL IM KLOSTERGASTHOF === -->
    <section id="challenge" class="py-28 md:py-36 bg-background border-t border-border">
      <div class="max-w-4xl mx-auto px-6 md:px-12">
        
        <h2 class="text-h2 text-center mb-16 reveal">
          Herausforderung
        </h2>

        <div class="prose prose-lg mx-auto text-left md:text-center text-muted-foreground leading-relaxed reveal" style="transition-delay: 80ms">
          <p class="text-body-lg">
            Im ehemaligen Reitstall des Klosters Holzen mit seinen <span class="text-primary font-medium">monumentalen Säulen</span> und <span class="text-primary font-medium">historischen Gewölben</span> sollte die bestehende Gastronomie neu gestaltet werden. Der bereits 2011 umgenutzte Raum sollte seine starke <span class="text-primary font-medium">historische Identität</span> bewahren und zugleich ein <span class="text-primary font-medium">modernes, elegantes und einladendes Ambiente</span> für <span class="text-primary font-medium">Gastronomie und Events</span> erhalten.
          </p>
        </div>
      </div>
    </section>

    <script>
      // @ts-nocheck
      // Staggered Reveal – The Challenge
      function initChallengeReveal() {
        const reveals = /** @type {NodeListOf<HTMLElement>} */ (document.querySelectorAll('#challenge .reveal'));
        reveals.forEach((el, i) => {
          el.style.opacity = '0';
          el.style.transform = 'translateY(30px)';
          el.style.transition = 'all 1s cubic-bezier(0.25, 0.1, 0.25, 1)';

          const observer = new IntersectionObserver((entries) => {
            if (!entries[0].isIntersecting) return;
            setTimeout(() => {
              el.style.opacity = '1';
              el.style.transform = 'translateY(0)';
            }, i * 140);
            observer.disconnect();
          }, { threshold: 0.12, rootMargin: '0px 0px -10% 0px' });

          observer.observe(el);
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initChallengeReveal, { once: true });
      } else {
        initChallengeReveal();
      }
    </script>


    <!-- === REALISIERUNG – Festsaal im Klostergasthof === -->
    <section id="realisierung" class="py-28 md:py-36 bg-background border-t border-border">
      <div class="max-w-5xl mx-auto px-6 md:px-12">
        <h2 class="text-h2 text-center mb-16 reveal">
          Konzept & Realisierung
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 reveal" style="transition-delay: 80ms">
          <div class="bg-background border border-border rounded-3xl p-8">
            <div class="text-primary text-5xl font-semibold mb-4">01</div>
            <h3 class="text-h4 mb-3">Historische Substanz bewahrt</h3>
            <p class="text-body text-muted-foreground">
              Die <span class="text-primary font-medium">monumentalen Säulen und historischen Gewölbe</span> blieben in ihrer <span class="text-primary font-medium">ursprünglichen Substanz vollständig erhalten</span> und bilden weiterhin die <span class="text-primary font-medium">tragende Seele des Raumes</span>.
            </p>
          </div>

          <div class="bg-background border border-border rounded-3xl p-8">
            <div class="text-primary text-5xl font-semibold mb-4">02</div>
            <h3 class="text-h4 mb-3">Präzise Maßanfertigung</h3>
            <p class="text-body text-muted-foreground">
              Jede Säule wurde <span class="text-primary font-medium">individuell vermessen</span> und mit <span class="text-primary font-medium">maßgefertigten Ummantelungen veredelt</span> – eine <span class="text-primary font-medium">technische Meisterleistung</span>, die historische Substanz und moderne Funktionalität verbindet.
            </p>
          </div>

          <div class="bg-background border border-border rounded-3xl p-8">
            <div class="text-primary text-5xl font-semibold mb-4">03</div>
            <h3 class="text-h4 mb-3">Restaurierung & Einbauten</h3>
            <p class="text-body text-muted-foreground">
              <span class="text-primary font-medium">Aufwendige Instandsetzungs- und Restaurationsarbeiten</span> an der Bausubstanz und den Bestandseinbauten wurden durchgeführt. <span class="text-primary font-medium">Hochwertige Einbaumöbel</span>, in denen das Buffet verstaut ist, sowie die Überarbeitung des Barbereichs mit <span class="text-primary font-medium">wunderschönem Rückbuffet</span> integrieren sich harmonisch in die historische Architektur.
            </p>
          </div>

          <div class="bg-background border border-border rounded-3xl p-8">
            <div class="text-primary text-5xl font-semibold mb-4">04</div>
            <h3 class="text-h4 mb-3">Flexible Möblierung & Einbauten</h3>
            <p class="text-body text-muted-foreground">
              <span class="text-primary font-medium">Lose, flexible Möblierung</span> und Ausstattung kombiniert mit <span class="text-primary font-medium">hochwertigen Einbauten</span> machen den Saal für Bankette, Hochzeiten und Alltagsgastronomie gleichermaßen geeignet, <span class="text-primary font-medium">langlebig, komfortabel und unaufdringlich</span>.
            </p>
          </div>
        </div>

        <!-- Mitarbeit-Hinweis + Link -->
        <p class="text-center text-sm text-muted-foreground mt-20 reveal" style="transition-delay: 360ms">
          Mitarbeit als Innenarchitektur M.A. bei <span class="font-medium">FORMWÆNDE</span>, Lüneburg
          <span class="block mt-4"></span>
          <a href="https://www.formwaende.de/projekte/festsaal-im-klostergasthof/" 
             target="_blank" rel="noopener noreferrer"
             class="text-primary hover:text-primary/90 transition-colors font-medium underline decoration-current underline-offset-2">
            Mehr Projektinhalte unter FORMWÆNDE →
          </a>
        </p>
      </div>
      </div>
    </section>

    <script>
      // @ts-nocheck
      // Gleiche sanfte Reveal-Animation wie bei Challenge, Research und Process
      function initRealisierungReveal() {
        const reveals = /** @type {NodeListOf<HTMLElement>} */ (document.querySelectorAll('#realisierung .reveal'));
        reveals.forEach((el, i) => {
          el.style.opacity = '0';
          el.style.transform = 'translateY(30px)';
          el.style.transition = 'all 1s cubic-bezier(0.25, 0.1, 0.25, 1)';

          const observer = new IntersectionObserver((entries) => {
            if (!entries[0].isIntersecting) return;
            setTimeout(() => {
              el.style.opacity = '1';
              el.style.transform = 'translateY(0)';
            }, i * 140);
            observer.disconnect();
          }, { threshold: 0.12, rootMargin: '0px 0px -10% 0px' });

          observer.observe(el);
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initRealisierungReveal, { once: true });
      } else {
        initRealisierungReveal();
      }
    </script>

    <!-- === ERGEBNISSE & ERKENNTNISSE – My Mind Studio (optimierte Version) === -->
    <section id="ergebnisse" class="py-28 md:py-36 bg-background border-t border-border">
      <div class="max-w-5xl mx-auto px-6 md:px-12">
        <h2 class="text-h2 text-center mb-16 reveal">
          Ergebnisse & Erkenntnisse
        </h2>

        <div class="max-w-3xl mx-auto text-left md:text-center text-body-lg text-muted-foreground mb-20 reveal" style="transition-delay: 80ms">
          Aus einem ehemaligen Reitstall mit <span class="text-primary font-medium">monumentalen Säulen und historischen Gewölben</span> ist ein <span class="text-primary font-medium">eleganter, vielseitiger Veranstaltungs- und Gastronomieraum</span> entstanden.
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 reveal" style="transition-delay: 160ms">
          <div class="bg-background border border-border rounded-3xl p-8">
            <div class="text-primary text-5xl font-semibold mb-4">01</div>
            <h3 class="text-h4 mb-3">Historische Seele lebt weiter</h3>
            <p class="text-body text-muted-foreground">
              Die <span class="text-primary font-medium">monumentalen Säulen und Gewölbe</span> <span class="text-primary font-medium">strahlen nach der Restaurierung noch stärker</span> und bilden die <span class="text-primary font-medium">unverwechselbare, geschichtsträchtige Identität</span> des Raumes.
            </p>
          </div>

          <div class="bg-background border border-border rounded-3xl p-8">
            <div class="text-primary text-5xl font-semibold mb-4">02</div>
            <h3 class="text-h4 mb-3">Elegante & stimmige Atmosphäre</h3>
            <p class="text-body text-muted-foreground">
              Durch die <span class="text-primary font-medium">reduzierte Materialität</span>, das <span class="text-primary font-medium">warme Lichtkonzept</span> und die <span class="text-primary font-medium">hervorragende Überarbeitung des Barbereichs mit Rückbuffet</span> entstand eine einladende, festliche und gleichzeitig ruhige Stimmung.
            </p>
          </div>

          <div class="bg-background border border-border rounded-3xl p-8">
            <div class="text-primary text-5xl font-semibold mb-4">03</div>
            <h3 class="text-h4 mb-3">Vielseitige Nutzbarkeit</h3>
            <p class="text-body text-muted-foreground">
              Die Kombination aus <span class="text-primary font-medium">hochwertigen Einbaumöbeln (inkl. Buffet-Stauraum)</span> und <span class="text-primary font-medium">flexibler Möblierung</span> macht den Saal gleichermaßen geeignet für Hochzeiten, Bankette, Tagungen und gehobene Gastronomie – <span class="text-primary font-medium">langlebig und komfortabel</span>.
            </p>
          </div>
        </div>

        <p class="text-left md:text-center text-lg text-muted-foreground mt-16 max-w-2xl mx-auto reveal" style="transition-delay: 320ms">
          Der Festsaal im Klostergasthof beweist: Mit Respekt vor der historischen Substanz und präziser, zeitgenössischer Gestaltung kann ein Raum <span class="text-primary font-medium">seine Seele bewahren und gleichzeitig neue, moderne Geschichten erzählen.</span>
        </p>

        <!-- Zurück-Button -->
        <div class="flex justify-center mt-12">
          <Button href="/projekte" variant="primary" size="lg" class="w-full sm:w-auto">Zurück zu allen Projekten →</Button>
        </div>

        <!-- Projekt-Navigation -->
        <div class="mt-14 md:mt-20 pt-8 md:pt-12 border-t border-border flex flex-col md:flex-row gap-4 md:gap-6 justify-between">
          <Button href="/projekte/my-mind-studio" variant="primary" size="lg" class="w-full md:w-auto">← Letztes Projekt</Button>
          <Button href="/projekte/schlaf" variant="primary" size="lg" class="w-full md:w-auto">Nächstes Projekt →</Button>
        </div>
    </section>

    <script>
      // @ts-nocheck
      // Sanfte Reveal-Animation (wie bei allen anderen Blöcken)
      function initResultsReveal() {
        const reveals = /** @type {NodeListOf<HTMLElement>} */ (document.querySelectorAll('#ergebnisse .reveal'));
        reveals.forEach((el, i) => {
          el.style.opacity = '0';
          el.style.transform = 'translateY(30px)';
          el.style.transition = 'all 1s cubic-bezier(0.25, 0.1, 0.25, 1)';

          const observer = new IntersectionObserver((entries) => {
            if (!entries[0].isIntersecting) return;
            setTimeout(() => {
              el.style.opacity = '1';
              el.style.transform = 'translateY(0)';
            }, i * 140);
            observer.disconnect();
          }, { threshold: 0.12, rootMargin: '0px 0px -10% 0px' });

          observer.observe(el);
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initResultsReveal, { once: true });
      } else {
        initResultsReveal();
      }
    </script>

    <script>
      // @ts-nocheck
      function animateCounter(id, target, duration = 1600) {
        const counter = document.getElementById(id);
        if (!(counter instanceof HTMLElement)) return;
        const startTime = performance.now();

        function update(now) {
          const progress = Math.min((now - startTime) / duration, 1);
          counter.textContent = String(Math.floor(progress * target));
          if (progress < 1) requestAnimationFrame(update);
        }

        requestAnimationFrame(update);
      }

      function initSequentialReveals() {
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const groups = /** @type {NodeListOf<HTMLElement>} */ (document.querySelectorAll('[data-reveal-group]'));

        groups.forEach((group) => {
          const items = /** @type {NodeListOf<HTMLElement>} */ (group.querySelectorAll('.reveal-item'));
          if (!items.length) return;

          if (reduceMotion) {
            items.forEach((item) => {
              item.style.opacity = '1';
              item.style.transform = 'none';
            });
            if (group.id === 'research') {
              animateCounter('count-60', 60);
              animateCounter('count-88', 88);
              animateCounter('count-56', 56);
              animateCounter('count-42', 42);
            }
            return;
          }

          items.forEach((item) => {
            item.style.opacity = '0';
            item.style.transform = 'translateY(28px)';
            item.style.transition = 'all 1s cubic-bezier(0.25, 0.1, 0.25, 1)';
            item.style.willChange = 'opacity, transform';
          });

          const observer = new IntersectionObserver((entries) => {
            if (!entries[0].isIntersecting) return;

            items.forEach((item, index) => {
              setTimeout(() => {
                item.style.opacity = '1';
                item.style.transform = 'translateY(0)';

                if (group.id === 'research' && group.dataset.countAnimated !== 'true' && item.querySelector('#count-60')) {
                  animateCounter('count-60', 60);
                  animateCounter('count-88', 88);
                  animateCounter('count-56', 56);
                  animateCounter('count-42', 42);
                  group.dataset.countAnimated = 'true';
                }
              }, index * 160);
            });
            group.dataset.revealed = 'true';

            observer.disconnect();
          }, { threshold: 0.2, rootMargin: '0px 0px -8% 0px' });

          observer.observe(group);
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initSequentialReveals, { once: true });
      } else {
        initSequentialReveals();
      }
    </script>

  </div>

</Layout>

