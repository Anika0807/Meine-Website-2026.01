          <img src="/images/projekt1.jpg" class="w-full h-auto object-cover rounded-xl" />
          <h3 class="text-h3 mt-4">Projekt 1</h3>
          <p class="text-body-sm">Vorher / Nachher-Beschreibung...</p>
        </div>
        <!-- Weitere Cards -->
      </div>
    </div>
  </section>
</Layout>
