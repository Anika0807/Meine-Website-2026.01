---
import Layout from '@/layouts/Layout.astro';
---

<Layout
  title="Projekte - Anika Warncke"
  description="Ausgewaehlte Projekte von Anika Warncke aus Innenarchitektur und UX/UI Design."
  ogTitle="Projekte - Anika Warncke"
  ogImage="/images/projekt-detail-hero.jpg"
  schemaType="CollectionPage"
>
  <!-- === PROJEKTE CONTENT (nur diesen Block) === -->
  <section class="py-20 md:py-32 bg-background">
    <div class="w-full px-6">

      <!-- AUSGEWÄHLTE PROJEKTE – full-bleed sticky stack wie Landingpage -->
      <div class="mb-40">
        <div class="relative z-50 bg-background pb-6">
          <h2 class="text-h2 mb-12 text-center">Ausgewählte Projekte</h2>
        </div>

        <div class="w-screen relative left-1/2 right-1/2 -mx-[50vw]">
          <!-- 1. My Mind Studio -->
          <div class="project-card group relative overflow-hidden h-[88svh] sm:h-[92svh] md:h-screen w-full sticky top-0 z-10 md:cursor-none cursor-pointer" data-no-reveal role="link" aria-label="Projekt My Mind Studio ansehen" tabindex="0" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();this.click();}" onclick="window.location='/projekte/my-mind-studio'">
            <img src="/images/my-mind-studio.jpg" alt="My Mind Studio" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" loading="lazy" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/50 to-transparent md:from-black/65"></div>
            <div class="absolute inset-0 flex flex-col items-center justify-center text-center text-white px-6">
              <p class="text-base md:text-lg font-semibold tracking-[0.16em] uppercase text-white/95 mb-3">Innenarchitektur</p>
              <h3 class="text-[2.9rem] md:text-[4.1rem] font-semibold tracking-tight leading-[0.92] text-white">My Mind Studio</h3>
              <p class="text-lg md:text-xl mt-4 opacity-90 max-w-[32ch] md:max-w-[34ch] mx-auto">Meditations- und Yogastudio mit Café</p>
            </div>
          </div>

          <!-- 2. NaturKompass -->
          <div class="project-card group relative overflow-hidden h-[88svh] sm:h-[92svh] md:h-screen w-full sticky top-0 z-20 mt-[-3svh] md:mt-0 md:cursor-none cursor-pointer"
            data-no-reveal role="link" aria-label="Projekt NaturKompass ansehen" tabindex="0" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();this.click();}" onclick="window.location=(window.location.pathname.startsWith('/en') ? '/en/projects/naturkompass' : '/projekte/naturkompass')">
            <img src="/images/naturkompass.jpg" alt="NaturKompass" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" loading="lazy" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/50 to-transparent md:from-black/65"></div>
            <div class="absolute inset-0 flex flex-col items-center justify-center text-center text-white px-6">
              <p class="text-base md:text-lg font-semibold tracking-[0.16em] uppercase text-white/95 mb-3">UX/UI Design</p>
              <h3 class="text-[2.9rem] md:text-[4.1rem] font-semibold tracking-tight leading-[0.92] text-white">NaturKompass</h3>
              <p class="text-lg md:text-xl mt-4 opacity-90 max-w-[32ch] md:max-w-[34ch] mx-auto">Ihr digitaler Begleiter zur Identifikation von Flora &amp; Fauna</p>
            </div>
          </div>

          <!-- 3. Festsaal im Klostergasthof -->
          <div class="project-card group relative overflow-hidden h-[88svh] sm:h-[92svh] md:h-screen w-full sticky top-0 z-30 mt-[-3svh] md:mt-0 md:cursor-none cursor-pointer" data-no-reveal role="link" aria-label="Projekt Festsaal im Klostergasthof ansehen" tabindex="0" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();this.click();}" onclick="window.location='/projekte/festsaal-im-klostergasthof'">
            <img src="/images/festsaal.jpg" alt="Festsaal im Klostergasthof" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" loading="lazy" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/50 to-transparent md:from-black/65"></div>
            <div class="absolute inset-0 flex flex-col items-center justify-center text-center text-white px-6">
              <p class="text-base md:text-lg font-semibold tracking-[0.16em] uppercase text-white/95 mb-3">Innenarchitektur</p>
              <h3 class="text-[2.9rem] md:text-[3.45rem] lg:text-[4.1rem] md:max-w-[18ch] lg:max-w-none mx-auto font-semibold tracking-tight leading-[0.92] text-white">Festsaal im Klostergasthof</h3>
              <p class="text-lg md:text-xl mt-4 opacity-90 max-w-[32ch] md:max-w-[34ch] mx-auto">Veranstaltungsgastronomie für Hochzeiten und Events</p>
            </div>
          </div>

          <!-- 4. FlavorFusion -->
          <div class="project-card group relative overflow-hidden h-[100svh] md:h-screen w-full z-40 mt-0 md:cursor-none cursor-pointer" data-no-reveal role="link" aria-label="Projekt FlavorFusion ansehen" tabindex="0" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();this.click();}" onclick="window.location='/projekte/flavorfusion'">
            <img src="/images/flavorfusion.jpg" alt="FlavorFusion" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" loading="lazy" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/50 to-transparent md:from-black/65"></div>
            <div class="absolute inset-0 flex flex-col items-center justify-center text-center text-white px-6">
              <p class="text-base md:text-lg font-semibold tracking-[0.16em] uppercase text-white/95 mb-3">UX/UI Design</p>
              <h3 class="text-[2.9rem] md:text-[4.1rem] font-semibold tracking-tight leading-[0.92] text-white">FlavorFusion</h3>
              <p class="text-lg md:text-xl mt-4 opacity-90 max-w-[32ch] md:max-w-[34ch] mx-auto">Landing Page für eine mobile Rezepte App</p>
            </div>
          </div>
        </div>
      </div>

    </div>

    <div class="max-w-6xl mx-auto px-6">
      <!-- WEITERE PROJEKTE – 2 Spalten (2×2) -->
      <div>
        <h2 class="text-h2 mb-16 md:mb-20 text-center">Weitere Projekte</h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-16" id="projects-grid">

          <!-- 5. SCHLAF -->
          <div class="project-card group md:cursor-none cursor-pointer" role="link" aria-label="Projekt SCHLAF ansehen" tabindex="0" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();this.click();}" onclick="window.location='/projekte/schlaf'">
            <div class="relative overflow-hidden rounded-3xl h-[420px] sm:h-[500px]">
              <img src="/images/schlaf.jpg" alt="SCHLAF" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" loading="lazy">
              <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/50 to-transparent md:from-black/65"></div>
              <div class="absolute bottom-10 left-10 right-10 text-white">
                <p class="text-base md:text-lg font-semibold tracking-[0.16em] uppercase text-white/95 mb-2">Innenarchitektur</p>
                <h3 class="text-[2rem] md:text-[2.5rem] font-semibold tracking-tight leading-[0.95] text-white">SCHLAF</h3>
                <p class="text-base md:text-lg mt-3 opacity-90 max-w-[28ch]">Eine Erlebnisausstellung in die Tiefen des Schlafes</p>
              </div>
            </div>
          </div>

          <!-- 6. OmNomZen -->
          <div class="project-card group md:cursor-none cursor-pointer" role="link" aria-label="Projekt OmNomZen ansehen" tabindex="0" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();this.click();}" onclick="window.location='/projekte/omnomzen'">
            <div class="relative overflow-hidden rounded-3xl h-[420px] sm:h-[500px]">
              <img src="/images/omnomzen.jpg" alt="OmNomZen" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" loading="lazy">
              <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/50 to-transparent md:from-black/65"></div>
              <div class="absolute bottom-10 left-10 right-10 text-white">
                <p class="text-base md:text-lg font-semibold tracking-[0.16em] uppercase text-white/95 mb-2">UX/UI Design</p>
                <h3 class="text-[2rem] md:text-[2.5rem] font-semibold tracking-tight leading-[0.95] text-white">OmNomZen</h3>
                <p class="text-base md:text-lg mt-3 opacity-90 max-w-[28ch]">Stressabbau mit Bio-Ashwagandha-Gummibärchen</p>
              </div>
            </div>
          </div>

          <!-- 7. weserkoje -->
          <div class="project-card group md:cursor-none cursor-pointer" role="link" aria-label="Projekt weserkoje ansehen" tabindex="0" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();this.click();}" onclick="window.location='/projekte/weserkoje'">
            <div class="relative overflow-hidden rounded-3xl h-[420px] sm:h-[500px]">
              <img src="/images/weserkoje.jpg" alt="weserkoje" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" loading="lazy">
              <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/50 to-transparent md:from-black/65"></div>
              <div class="absolute bottom-10 left-10 right-10 text-white">
                <p class="text-base md:text-lg font-semibold tracking-[0.16em] uppercase text-white/95 mb-2">Innenarchitektur</p>
                <h3 class="text-[2rem] md:text-[2.5rem] font-semibold tracking-tight leading-[0.95] text-white">weserkoje</h3>
                <p class="text-base md:text-lg mt-3 opacity-90 max-w-[28ch]">Multifunktionale Herberge mit integriertem Tagungszentrum</p>
              </div>
            </div>
          </div>

          <!-- 8. Planora -->
          <div class="project-card group md:cursor-none cursor-pointer" role="link" aria-label="Projekt Planora ansehen" tabindex="0" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();this.click();}" onclick="window.location='/projekte/planora'">
            <div class="relative overflow-hidden rounded-3xl h-[420px] sm:h-[500px]">
              <img src="/images/planora.jpg" alt="Planora" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" loading="lazy">
              <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/50 to-transparent md:from-black/65"></div>
              <div class="absolute bottom-10 left-10 right-10 text-white">
                <p class="text-base md:text-lg font-semibold tracking-[0.16em] uppercase text-white/95 mb-2">UX/UI Design</p>
                <h3 class="text-[2rem] md:text-[2.5rem] font-semibold tracking-tight leading-[0.95] text-white">Planora</h3>
                <p class="text-base md:text-lg mt-3 opacity-90 max-w-[28ch]">Reiseplanung, die sich dir anpasst</p>
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>
  </section>

  <div id="custom-cursor" class="fixed pointer-events-none hidden w-40 h-40 rounded-full bg-white/40 backdrop-blur-2xl flex flex-col items-center justify-center text-zinc-900 text-sm font-medium z-[9999] shadow-2xl gap-px">
    <span class="text-caption tracking-[0.16em] uppercase">PROJEKT</span>
    <span class="text-body-sm font-semibold">ansehen</span>
  </div>

  <script>
    const cursor = document.getElementById('custom-cursor');
    const projectCards = document.querySelectorAll('.project-card');
    const desktopMedia = window.matchMedia('(min-width: 768px)');

    if (cursor instanceof HTMLElement) {
      const hideCursor = () => {
        cursor.classList.add('hidden');
      };

      projectCards.forEach(card => {
        card.addEventListener('mousemove', (e) => {
          if (!desktopMedia.matches) {
            hideCursor();
            return;
          }

          if (!(e instanceof MouseEvent)) return;
          const mouseEvent = e;
          cursor.style.left = `${mouseEvent.clientX - 80}px`;
          cursor.style.top = `${mouseEvent.clientY - 80}px`;
          cursor.classList.remove('hidden');
        });

        card.addEventListener('mouseleave', hideCursor);
      });

      desktopMedia.addEventListener('change', hideCursor);
      window.addEventListener('blur', hideCursor);
    }
  </script>
</Layout>
