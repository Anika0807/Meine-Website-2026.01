---
import Layout from '@/layouts/Layout.astro';
---

<Layout title="FlavorFusion - Anika Warncke">
  <!-- 1. HERO -->
  <section class="relative min-h-[100svh] flex items-center justify-center overflow-hidden" data-reveal-group>
    <img src="/images/projekte/flavorfusion-hero.jpg" alt="FlavorFusion Hero" class="absolute inset-0 w-full h-full object-cover">
    <div class="absolute inset-0 bg-gradient-to-b from-black/40 via-black/20 to-black/70"></div>
    <div class="relative z-10 text-center text-white px-4 sm:px-6 max-w-4xl">
      <p class="reveal-item text-sm tracking-[4px] uppercase font-medium mb-4 opacity-90">UX/UI DESIGN • LANDING PAGE</p>
      <h1 class="reveal-item text-5xl sm:text-6xl md:text-7xl font-semibold tracking-tighter leading-none">FlavorFusion</h1>
      <p class="reveal-item mt-5 text-base sm:text-xl md:text-2xl max-w-lg mx-auto opacity-90">Landing Page fur eine mobile Rezepte App</p>
    </div>
  </section>

  <!-- Content Rail – alle weiteren Sections -->
  <div class="max-w-6xl mx-auto px-4 sm:px-6">

    <!-- === METADATA – Überschriften größer & fetter (nur FlavorFusion) === -->
    <section class="pt-12 pb-20 md:pb-28 bg-white" data-reveal-group>
      <div class="max-w-7xl mx-auto px-0 md:px-12">
        
        <!-- Metadata Zeile – Mobile: vertikal gestapelt -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-y-10 md:gap-y-0 gap-x-8 mb-16 text-sm">
          <div class="reveal-item">
            <p class="uppercase tracking-widest text-sm font-medium text-foreground mb-3">Rolle & Team</p>
            <p class="text-foreground">
              <span class="text-emerald-700 font-medium">UX/UI-Designer</span>
            </p>
          </div>
          <div class="reveal-item">
            <p class="uppercase tracking-widest text-sm font-medium text-foreground mb-3">Aufgabe</p>
            <p class="text-foreground">
              <span class="text-emerald-700 font-medium">End-to-End</span> Designprozess:<br>vom Problem bis zum High-Fidelity-Prototypen einer Landingpage (UX-Research, UI-Design, Prototyping)
            </p>
          </div>
          <div class="reveal-item">
            <p class="uppercase tracking-widest text-sm font-medium text-foreground mb-3">Zeitraum & Rahmen</p>
            <p class="text-foreground">
              Juni 2025<br>
              <span class="text-emerald-700 font-medium">20-stündiger Design-Sprint</span> mit aktivem Einsatz von generativer KI im UX/UI-Bootcamp bei neuefische
            </p>
          </div>
          <div class="reveal-item">
            <p class="uppercase tracking-widest text-sm font-medium text-foreground mb-3">Tools</p>
            <p class="text-foreground">
              <span class="text-emerald-700 font-medium">Figma</span>, FigJam, Notion,<br>ChatGPT, Gemini
            </p>
          </div>
        </div>

      </div>
    </section>

    <!-- The Challenge – optimiert -->
    <section class="py-16 md:py-28 bg-white" data-reveal-group>
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="reveal-item text-4xl sm:text-5xl md:text-6xl font-semibold tracking-tighter mb-8 md:mb-14">The Challenge</h2>

          <p class="reveal-item text-base sm:text-lg md:text-xl text-muted-foreground leading-relaxed">
            Ambitionierte Hobbyköch:innen stehen vor einer frustrierenden Wahl: Entweder kämpfen sie sich durch überladene Rezepte-Apps – oder sie verzichten komplett auf echte Inspiration.
            Es fehlt eine <span class="text-emerald-700 font-semibold">intuitive und emotionale Landing Page</span>, die persönlich abholt, <span class="text-emerald-700 font-semibold">Vertrauen</span> schafft und den <span class="text-emerald-700 font-semibold">Download der FlavorFusion App</span> zum einzig logischen nächsten Schritt macht – damit sie endlich eine wirklich gute Rezepte-App nutzen können.
          </p>
      </div>
    </section>

    <!-- === RESEARCH HIGHLIGHTS – final optimiert === -->
    <section id="research" class="py-20 md:py-32 bg-gray-50" data-reveal-group>
      <div class="max-w-7xl mx-auto px-6 md:px-12">

        <h2 class="reveal-item text-4xl sm:text-5xl md:text-6xl font-semibold tracking-tighter text-center mb-12 md:mb-16">
          Research Highlights
        </h2>

        <!-- Drei Insights -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-12 mb-16">
          <div class="text-center reveal-item">
            <div class="inline-flex h-14 w-14 items-center justify-center rounded-full border-2 border-emerald-700 text-3xl font-semibold text-emerald-700 mb-6">1</div>
            <p class="text-xl font-medium">Nutzer fühlen sich überfordert</p>
            <p class="text-muted-foreground mt-3">Unklare Call-to-Actions und überladene Infos führen zum <span class="text-emerald-700 font-semibold">schnellen Abbruch.</span></p>
          </div>
          <div class="text-center reveal-item">
            <div class="inline-flex h-14 w-14 items-center justify-center rounded-full border-2 border-emerald-700 text-3xl font-semibold text-emerald-700 mb-6">2</div>
            <p class="text-xl font-medium">Emotion schafft Verbindung</p>
            <p class="text-muted-foreground mt-3">Nutzer wollen keine reine Rezept-Liste, sondern <span class="text-emerald-700 font-semibold">emotionale Geschichten und Inspiration.</span></p>
          </div>
          <div class="text-center reveal-item">
            <div class="inline-flex h-14 w-14 items-center justify-center rounded-full border-2 border-emerald-700 text-3xl font-semibold text-emerald-700 mb-6">3</div>
            <p class="text-xl font-medium">Vertrauen durch Vorschau</p>
            <p class="text-muted-foreground mt-3">Nutzer suchen Bewertungen und Vorschauen, um <span class="text-emerald-700 font-semibold">Vertrauen aufzubauen.</span></p>
          </div>
        </div>

        <!-- Prozente -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8 md:gap-12 mb-16">
          <div class="text-center reveal-item"><div class="text-4xl sm:text-5xl md:text-6xl font-bold text-emerald-700"><span id="count-72">0</span>%</div><p class="text-xs sm:text-sm mt-2">KOCHEN 3-5x PRO WOCHE</p></div>
          <div class="text-center reveal-item"><div class="text-4xl sm:text-5xl md:text-6xl font-bold text-emerald-700"><span id="count-81-apps">0</span>%</div><p class="text-xs sm:text-sm mt-2">NUTZEN APPS STATT GOOGLE</p></div>
          <div class="text-center reveal-item"><div class="text-4xl sm:text-5xl md:text-6xl font-bold text-emerald-700"><span id="count-70">0</span>%</div><p class="text-xs sm:text-sm mt-2">WOLLEN KLARE SCHRITT-FÜR-SCHRITT-ANLEITUNG</p></div>
          <div class="text-center reveal-item"><div class="text-4xl sm:text-5xl md:text-6xl font-bold text-emerald-700"><span id="count-81-photos">0</span>%</div><p class="text-xs sm:text-sm mt-2">SUCHEN SCHÖNE FOTOS & INSPIRATIONEN</p></div>
        </div>

        <!-- Quotes + How might we -->
        <div class="reveal-item max-w-3xl mx-auto text-center">
          <div class="italic text-foreground text-xl md:text-2xl font-semibold mb-12">
            „Ich brauche klare Schritt-für-Schritt-Anleitungen, sonst gebe ich auf.“<br>
            „Die Rezepte sollen schön aussehen und mich inspirieren – nicht nur funktionieren.“
          </div>

          <p class="text-2xl md:text-4xl font-semibold tracking-tight leading-tight text-foreground">
            Wie werden Nutzer:innen auf der Landing Page <span class="text-emerald-700 font-semibold">klar, schön und inspirierend</span> begleitet, dass sie <span class="text-emerald-700 font-semibold">sofort Vertrauen fassen</span> und der Download der App für sie der <span class="text-emerald-700 font-semibold">natürlichste und freudigste nächste Schritt</span> wird?
          </p>
        </div>
      </div>
    </section>

    <!-- === PROCESS – komplett mit UI-Foundation + Moodboard === -->
    <section id="process" class="py-24 md:py-32 bg-white">
      <div class="max-w-7xl mx-auto px-6 md:px-12">

        <h2 class="text-4xl sm:text-5xl md:text-6xl font-semibold tracking-tighter text-center mb-12 md:mb-16 reveal">
          Process
        </h2>

        <!-- User Flow -->
        <div class="mb-20 reveal" style="transition-delay: 80ms">
          <img src="/images/projekte/flavorfusion-user-flow.png"
            alt="FlavorFusion User Flow"
               class="w-full rounded-3xl shadow-2xl">
        </div>

        <!-- Designprinzipien -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-10 mb-20" style="transition-delay: 160ms">
          <div class="bg-white border border-gray-100 p-8 md:p-10 rounded-3xl reveal">
            <div class="text-emerald-700 text-5xl font-semibold mb-6">01</div>
            <h3 class="text-2xl font-medium mb-4">Natürlichkeit</h3>
            <p class="text-muted-foreground">
              Die Landing Page fühlt sich an wie ein guter Küchentipp von einer Freundin - <span class="text-emerald-700 font-medium">warm, authentisch und lebensnah</span>.
            </p>
          </div>
          <div class="bg-white border border-gray-100 p-8 md:p-10 rounded-3xl reveal">
            <div class="text-emerald-700 text-5xl font-semibold mb-6">02</div>
            <h3 class="text-2xl font-medium mb-4">Klarheit</h3>
            <p class="text-muted-foreground">
              Wie ein gutes Rezept: ein <span class="text-emerald-700 font-medium">klarer Fahrplan</span> mit müheloser Orientierung und <span class="text-emerald-700 font-medium">intuitiver Führung</span>.
            </p>
          </div>
          <div class="bg-white border border-gray-100 p-8 md:p-10 rounded-3xl reveal">
            <div class="text-emerald-700 text-5xl font-semibold mb-6">03</div>
            <h3 class="text-2xl font-medium mb-4">Leidenschaft</h3>
            <p class="text-muted-foreground">
              Essen ist emotional - die Landing Page weckt <span class="text-emerald-700 font-medium">pure Freude am Kochen</span> durch inspirierende Inhalte und liebevolle Details.
            </p>
          </div>
        </div>

        <!-- UI-Foundation -->
        <div class="max-w-4xl mx-auto" style="transition-delay: 240ms">
          <div class="reveal">
            <h4 class="uppercase tracking-widest text-sm text-muted-foreground mb-6">UI-Foundation</h4>
            <img src="/images/projekte/flavorfusion-ui-foundation.png" alt="FlavorFusion UI Foundation" class="w-full rounded-3xl shadow-xl">
          </div>
        </div>
      </div>
    </section>

    <script>
      // Staggered Reveal (gleiche Animation wie Challenge + Research)
      function initProcessReveal() {
        const reveals = document.querySelectorAll<HTMLElement>('#process .reveal');
        reveals.forEach((el, i) => {
          el.style.opacity = '0';
          el.style.transform = 'translateY(30px)';
          el.style.transition = 'all 1s cubic-bezier(0.25, 0.1, 0.25, 1)';

          const observer = new IntersectionObserver((entries) => {
            if (!entries[0].isIntersecting) return;
            setTimeout(() => {
              el.style.opacity = '1';
              el.style.transform = 'translateY(0)';
            }, i * 140);
            observer.disconnect();
          }, { threshold: 0.12, rootMargin: '0px 0px -10% 0px' });

          observer.observe(el);
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initProcessReveal, { once: true });
      } else {
        initProcessReveal();
      }
    </script>

    <section id="final-design" class="py-20 md:py-32 bg-white">
      <div class="max-w-7xl mx-auto px-6 md:px-12">
        <h2 class="text-5xl md:text-6xl font-semibold tracking-tighter text-center mb-8 reveal">
          Final Design
        </h2>

        <p class="max-w-2xl mx-auto text-center text-lg md:text-xl text-muted-foreground mb-16 reveal" style="transition-delay: 80ms">
          Die fertige Landing Page in Aktion – warm, <span class="text-emerald-700 font-medium">einladend</span> und intuitiv gestaltet.<br>
          Mit klarer Navigation, schönen Rezeptfotos und dem Gefühl, dass man <span class="text-emerald-700 font-medium">sofort losbacken</span> möchte.
        </p>

        <div class="reveal mx-auto max-w-4xl rounded-3xl overflow-hidden shadow-2xl border border-gray-100" style="transition-delay: 160ms">
          <div class="aspect-video bg-black">
            <iframe
              width="100%"
              height="100%"
              src="https://www.youtube.com/embed/TtaknL6y0sc"
              title="FlavorFusion Landing Page – Live Experience"
              frameborder="0"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen>
            </iframe>
          </div>
        </div>

        <p class="text-center text-sm text-muted-foreground mt-8 reveal" style="transition-delay: 240ms">
          Das Video zeigt die komplette Nutzererfahrung: von der ersten Begegnung mit der Landing Page bis zum <span class="text-emerald-700 font-medium">emotionalen Rezept-Erlebnis</span> und dem App-Download.
        </p>
      </div>
    </section>

    <script>
      // Gleiche sanfte Reveal-Animation wie bei Challenge, Research und Process
      function initFinalReveal() {
        const reveals = document.querySelectorAll<HTMLElement>('#final-design .reveal');
        reveals.forEach((el, i) => {
          el.style.opacity = '0';
          el.style.transform = 'translateY(30px)';
          el.style.transition = 'all 1s cubic-bezier(0.25, 0.1, 0.25, 1)';

          const observer = new IntersectionObserver((entries) => {
            if (!entries[0].isIntersecting) return;
            setTimeout(() => {
              el.style.opacity = '1';
              el.style.transform = 'translateY(0)';
            }, i * 140);
            observer.disconnect();
          }, { threshold: 0.12, rootMargin: '0px 0px -10% 0px' });

          observer.observe(el);
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initFinalReveal, { once: true });
      } else {
        initFinalReveal();
      }
    </script>

    <!-- === RESULTS & LEARNINGS – final optimiert mit grünen Highlights === -->
    <section id="results" class="py-20 md:py-32 bg-white">
      <div class="max-w-7xl mx-auto px-6 md:px-12">

        <h2 class="text-4xl sm:text-5xl md:text-6xl font-semibold tracking-tighter text-center mb-12 md:mb-20 reveal">
          Results & Learnings
        </h2>

        <p class="max-w-3xl mx-auto text-lg md:text-xl text-muted-foreground text-center mb-16 md:mb-20 reveal" style="transition-delay: 80ms">
          In nur 20 Stunden entstand ein <span class="text-emerald-700 font-medium">strategisches Minimum Viable Product</span>.
          Die Landing Page ist <span class="text-emerald-700 font-medium">klar, emotional ansprechend</span> und führt gezielt zur Conversion.
        </p>

        <!-- Drei Karten mit gezielten grünen Highlights -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8 mb-16" style="transition-delay: 160ms">

          <div class="bg-white border border-gray-100 p-8 md:p-10 rounded-3xl shadow-sm reveal">
            <div class="text-emerald-700 text-5xl font-semibold mb-6">01</div>
            <h3 class="text-2xl font-medium mb-4">Radikale Priorisierung</h3>
            <p class="text-muted-foreground text-[15px] md:text-base leading-relaxed">
              Der 20-stündige Designsprint diente als Katalysator für eine <span class="text-emerald-700 font-medium">radikale Fokussierung</span> auf die Kernbotschaft und die zentrale Aktion der Landing Page.
            </p>
          </div>

          <div class="bg-white border border-gray-100 p-8 md:p-10 rounded-3xl shadow-sm reveal">
            <div class="text-emerald-700 text-5xl font-semibold mb-6">02</div>
            <h3 class="text-2xl font-medium mb-4">Forschung als Fundament</h3>
            <p class="text-muted-foreground text-[15px] md:text-base leading-relaxed">
              Der Einsatz von KI kann einen <span class="text-emerald-700 font-medium">grundlegenden und fundierten User Research</span> vereinfachen und beschleunigen, aber nicht komplett ersetzen.
            </p>
          </div>

          <div class="bg-white border border-gray-100 p-8 md:p-10 rounded-3xl shadow-sm reveal">
            <div class="text-emerald-700 text-5xl font-semibold mb-6">03</div>
            <h3 class="text-2xl font-medium mb-4">Mut zur Entscheidung</h3>
            <p class="text-muted-foreground text-[15px] md:text-base leading-relaxed">
              Der enge Zeitrahmen hat gezeigt, wie entscheidend der <span class="text-emerald-700 font-medium">Mut zur schnellen Entscheidung</span> ist – ohne die <span class="text-emerald-700 font-medium">empathische Perspektive</span> zu verlieren.
            </p>
          </div>
        </div>

        <!-- Nächste Schritte -->
        <div class="max-w-2xl mx-auto mb-16 reveal" style="transition-delay: 240ms">
          <h3 class="uppercase tracking-widest text-sm text-muted-foreground mb-6 text-center">NÄCHSTE SCHRITTE</h3>
          <ul class="space-y-6 text-[15px] md:text-base text-muted-foreground">
            <li class="flex gap-4">→ Testen: Prototyp mit echten Nutzer:innen validieren</li>
            <li class="flex gap-4">→ Iterieren: Feedback zur gezielten Verbesserung nutzen</li>
            <li class="flex gap-4">→ Umsetzen & Optimieren: Finale Seite bauen und mittels A/B-Tests die Conversion steigern</li>
          </ul>
        </div>

        <!-- Zurück-Button -->
        <div class="flex justify-center">
          <a href="/projekte"
             class="w-full sm:w-auto bg-emerald-700 hover:bg-emerald-600 text-white text-base sm:text-lg font-medium px-6 sm:px-10 py-4 sm:py-6 rounded-btn text-center transition-all">
            Zurück zu allen Projekten →
          </a>
        </div>

        <!-- Projekt-Navigation -->
        <div class="mt-14 md:mt-20 pt-8 md:pt-12 border-t border-gray-100 flex flex-col md:flex-row gap-4 md:gap-6 justify-between">
          <a href="/projekte/[previous-project]"
             class="w-full md:w-auto bg-emerald-700 hover:bg-emerald-600 text-white text-base sm:text-lg font-medium px-6 sm:px-10 py-4 sm:py-6 rounded-btn text-center transition-all">
            ← Letztes Projekt
          </a>
          <a href="/projekte/[next-project]"
             class="w-full md:w-auto bg-emerald-700 hover:bg-emerald-600 text-white text-base sm:text-lg font-medium px-6 sm:px-10 py-4 sm:py-6 rounded-btn text-center transition-all">
            Nächstes Projekt →
          </a>
        </div>

      </div>
    </section>

    <script>
      // Sanfte Reveal-Animation (wie bei allen anderen Blöcken)
      function initResultsReveal() {
        const reveals = document.querySelectorAll<HTMLElement>('#results .reveal');
        reveals.forEach((el, i) => {
          el.style.opacity = '0';
          el.style.transform = 'translateY(30px)';
          el.style.transition = 'all 1s cubic-bezier(0.25, 0.1, 0.25, 1)';

          const observer = new IntersectionObserver((entries) => {
            if (!entries[0].isIntersecting) return;
            setTimeout(() => {
              el.style.opacity = '1';
              el.style.transform = 'translateY(0)';
            }, i * 140);
            observer.disconnect();
          }, { threshold: 0.12, rootMargin: '0px 0px -10% 0px' });

          observer.observe(el);
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initResultsReveal, { once: true });
      } else {
        initResultsReveal();
      }
    </script>

    <script>
      function animateCounter(id: string, target: number, duration = 1600) {
        const el = document.getElementById(id);
        if (!el) return;
        const startTime = performance.now();

        function update(now: number) {
          const progress = Math.min((now - startTime) / duration, 1);
          el!.textContent = String(Math.floor(progress * target));
          if (progress < 1) requestAnimationFrame(update);
        }

        requestAnimationFrame(update);
      }

      function animateResearchCounters() {
        animateCounter('count-72', 72);
        animateCounter('count-81-apps', 81);
        animateCounter('count-70', 70);
        animateCounter('count-81-photos', 81);
      }

      function initSequentialReveals() {
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const groups = document.querySelectorAll<HTMLElement>('[data-reveal-group]');

        groups.forEach((group) => {
          const items = group.querySelectorAll<HTMLElement>('.reveal-item');
          if (!items.length) return;

          if (reduceMotion) {
            items.forEach((item) => {
              item.style.opacity = '1';
              item.style.transform = 'none';
            });
            if (group.id === 'research') {
              animateResearchCounters();
            }
            return;
          }

          items.forEach((item) => {
            item.style.opacity = '0';
            item.style.transform = 'translateY(28px)';
            item.style.transition = 'all 1s cubic-bezier(0.25, 0.1, 0.25, 1)';
            item.style.willChange = 'opacity, transform';
          });

          const observer = new IntersectionObserver((entries) => {
            if (!entries[0].isIntersecting) return;

            if (group.id === 'research' && group.dataset.countAnimated !== 'true') {
              animateResearchCounters();
              group.dataset.countAnimated = 'true';
            }

            items.forEach((item, index) => {
              setTimeout(() => {
                item.style.opacity = '1';
                item.style.transform = 'translateY(0)';
              }, index * 160);
            });
            group.dataset.revealed = 'true';

            observer.disconnect();
          }, { threshold: 0.2, rootMargin: '0px 0px -8% 0px' });

          observer.observe(group);
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initSequentialReveals, { once: true });
      } else {
        initSequentialReveals();
      }
    </script>

  </div>

</Layout>
