---
import Layout from '@/layouts/Layout.astro';
import Button from '@/components/ui/astro-button.astro';
import { not_found_title, not_found_heading, not_found_message, not_found_back_home } from '@/paraglide/messages.js';
const ssrLocale = Astro.url.pathname.startsWith('/en') ? 'en' : 'de';
const loc = { locale: ssrLocale } as const;
---

<Layout title={not_found_title({}, loc)} noindex={true} schemaType="WebPage">
  <div class="min-h-screen flex flex-col items-center justify-center px-6 text-center bg-background">
    <h1 class="text-8xl md:text-[12rem] font-black text-primary/80 mb-6 tracking-tighter">
      404
    </h1>
    
    <h2 class="text-4xl md:text-5xl font-medium mb-8 text-foreground">
      {not_found_heading({}, loc)}
    </h2>
    
    <p class="text-lg md:text-xl text-muted-foreground max-w-md mb-12">
      {not_found_message({}, loc)}
    </p>

    <Button href={ssrLocale === 'en' ? '/en/' : '/'} size="lg">
      {not_found_back_home({}, loc)}
    </Button>
  </div>
</Layout>
