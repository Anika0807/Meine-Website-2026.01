<style>
.quote-reveal {
  opacity: 0;
  transform: translateY(18px) scale(0.995);
  filter: blur(3px);
  animation: quote-reveal-in 900ms cubic-bezier(0.22, 1, 0.36, 1) forwards;
  will-change: opacity, transform, filter;
}

.quote-reveal-author {
  display: inline-block;
  opacity: 0;
  transform: translateY(10px);
  animation: quote-reveal-in 700ms cubic-bezier(0.22, 1, 0.36, 1) forwards;
  animation-delay: 1080ms;
}

@keyframes quote-reveal-in {
  0% {
    opacity: 0;
    transform: translateY(18px) scale(0.995);
    filter: blur(3px);
  }
  100% {
    opacity: 1;
    transform: translateY(0) scale(1);
    filter: blur(0);
  }
}
</style>

<!-- CUSTOM CURSOR -->
<div id="custom-cursor" class="fixed pointer-events-none hidden w-40 h-40 rounded-full bg-white/40 backdrop-blur-2xl flex flex-col items-center justify-center text-zinc-900 text-sm font-medium z-[9999] shadow-2xl gap-px">
<span class="tracking-widest text-[14px]">VIEW</span>
<span class="text-[18px]">PROJECT</span>
</div>

<script>
const cursor = document.getElementById('custom-cursor');
const projects = document.querySelectorAll('.project-card');
const desktopMedia = window.matchMedia('(min-width: 768px)');
if (cursor instanceof HTMLElement) {
  const hideCursor = () => {
    cursor.classList.add('hidden');
  };

  projects.forEach(project => {
    project.addEventListener('mousemove', (e) => {
      if (!desktopMedia.matches) {
        hideCursor();
        return;
      }

      if (!(e instanceof MouseEvent)) return;
      const mouseEvent = e;
      cursor.style.left = `${mouseEvent.clientX - 80}px`;
      cursor.style.top = `${mouseEvent.clientY - 80}px`;
      cursor.classList.remove('hidden');
    });

    project.addEventListener('mouseleave', hideCursor);
  });

  desktopMedia.addEventListener('change', hideCursor);
  window.addEventListener('blur', hideCursor);
}
</script>
</Layout>