---
import Layout from '@/layouts/Layout.astro';
import SimpleTest from '@/components/SimpleTest';
import { hero_title, hero_subtitle } from '@/paraglide/messages.js';

const locale = 'en';
---

<Layout title={hero_title({}, { locale })} locale={locale}>
  <div class="max-w-4xl mx-auto px-6 py-16 text-center">
    <h1 class="text-5xl font-bold tracking-tight mb-6">
      {hero_title({}, { locale })}
    </h1>
    <p class="text-xl text-muted-foreground mb-12">
      {hero_subtitle({}, { locale })}
    </p>
    <SimpleTest locale={locale} client:load />
  </div>
</Layout>
