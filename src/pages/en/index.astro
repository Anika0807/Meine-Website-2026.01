---
import Layout from '@/layouts/Layout.astro';
import Button from '@/components/ui/astro-button.astro';
import { Heading2 } from '@/components/design-system/headings';
import { heroImageHover, heroPanelClass } from '@/components/design-system/hero-image-hover';
import { Image } from 'astro:assets';
import anikaPortraitWarm from '@/assets/anika-portrait-warm.jpg';
import heroInterior from '@/assets/hero-interior.jpg';
import heroUxui from '@/assets/hero-uxui.jpg';
import { t } from '@/lib/i18n';

const locale = 'en';
const getMessage = (key: Parameters<typeof t>[1]) => t(locale, key);
---

<Layout title={getMessage('hero.title')}>
  <!-- === HERO – NUR MOBILE === -->
  <div class="md:hidden">
    <section class="relative isolate z-20 h-[calc(100svh-5rem)] flex items-center justify-center overflow-hidden bg-black px-6">
      <!-- Mobile: zwei Bilder übereinander -->
      <div class="absolute inset-0 grid grid-rows-2">
        <div class="relative">
          <Image src={heroInterior} alt="Interior Architecture" class="w-full h-full object-cover" loading="eager" fetchpriority="high" format="webp" quality={85} densities={[1, 2]} />
        </div>
        <div class="relative">
          <Image src={heroUxui} alt="UX/UI Design" class="w-full h-full object-cover" loading="eager" fetchpriority="high" format="webp" quality={85} densities={[1, 2]} />
        </div>
      </div>

      <!-- Kasten – transparenter, mit Desktop-artigem Glas-Look -->
      <div class="relative z-10 bg-black/60 backdrop-blur-2xl rounded-card px-5 sm:px-8 py-5 sm:py-7 w-full mx-auto text-center shadow-2xl border border-white/10">
        <h1 class="text-3xl sm:text-4xl leading-tight font-semibold tracking-tight text-white mb-2 drop-shadow-2xl">
          {getMessage('hero.title')}
        </h1>
        <p class="text-[1.75rem] sm:text-[2.25rem] leading-[1.05] font-light text-white mb-5 drop-shadow-xl">
          {getMessage('hero.subtitle')}
        </p>
        <p class="text-sm sm:text-base text-white/95 mx-auto mb-5 drop-shadow-lg leading-relaxed">
          {getMessage('hero.description')}
        </p>

        <div class="flex flex-col gap-3">
          <Button href="/en/projects" variant="primary" size="lg" class="text-base">
            {getMessage('hero.button.projects')}
          </Button>
          <Button href="/en/contact" variant="outline" size="lg" class="border-2 border-white bg-transparent text-white text-base hover:bg-white/10 hover:text-white">
            {getMessage('hero.button.contact')}
          </Button>
        </div>
      </div>

      <!-- Scroll-Pfeil -->
      <div class="absolute bottom-6 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-white/70">
        <p class="text-xs tracking-[3px] font-medium">SCROLL</p>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="w-7 h-7 text-white drop-shadow-[0_3px_10px_rgba(0,0,0,0.7)] animate-bounce-slow"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2.5"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
        </svg>
      </div>
    </section>
  </div>

<!-- SPLIT HERO – Desktop -->
<section class="relative hidden md:flex h-screen overflow-hidden">
<!-- LINKS: Innenarchitektur -->
<div class={`${heroPanelClass} hero-left`}>
<Image src={heroInterior} alt="Interior Architecture" class={heroImageHover} loading="eager" fetchpriority="high" format="webp" quality={85} densities={[1, 2]} />
<div class="absolute inset-0 bg-gradient-to-r from-black/60 to-transparent"></div>
</div>
<!-- RECHTS: UX/UI -->
<div class={`${heroPanelClass} hero-right`}>
<Image src={heroUxui} alt="UX/UI Design" class={heroImageHover} loading="eager" fetchpriority="high" format="webp" quality={85} densities={[1, 2]} />
<div class="absolute inset-0 bg-gradient-to-l from-black/60 to-transparent"></div>
</div>
<!-- Text-Overlay – zentriert -->
<div class="pointer-events-none absolute inset-0 flex flex-col items-center justify-center px-6 z-10">
<div class="pointer-events-auto bg-black/65 backdrop-blur-sm text-white rounded-2xl p-8 md:p-12 max-w-lg md:max-w-3xl w-full text-center border border-white/10 shadow-2xl">
<h1 class="text-[4.1rem] md:text-[5.4rem] leading-none font-light tracking-[-0.04em] text-white mb-6 drop-shadow-2xl">
  {getMessage('hero.title')}
</h1>
<p class="text-[2.25rem] md:text-[2.55rem] leading-[1.05] font-light text-white mb-12 drop-shadow-xl">
  {getMessage('hero.subtitle')}
</p>
<p class="hero-long-text text-body-lg text-white/95 max-w-2xl md:max-w-3xl mx-auto mb-12 drop-shadow-lg">
  {getMessage('hero.description')}
</p>
<div class="flex flex-col sm:flex-row gap-4 justify-center">
<Button href="/en/projects" variant="primary" size="lg" class="text-lg">
  {getMessage('hero.button.projects')}
</Button>
<Button href="/en/contact" variant="outline" size="lg" class="border-2 border-white bg-transparent text-white text-lg hover:bg-white/10 hover:text-white">
  {getMessage('hero.button.contact')}
</Button>
</div>
</div>
<!-- Scroll-Indikator -->
<div class="pointer-events-none mt-12 flex flex-col items-center gap-3 text-white">
<span class="text-xs tracking-[3px] font-medium opacity-70">SCROLL</span>
<svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-white drop-shadow-[0_3px_10px_rgba(0,0,0,0.7)] animate-bounce-slow" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
<path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
</svg>
</div>
</div>
</section>

<!-- PERSÖNLICHE AUSSAGE -->
<section class="py-28 bg-background">
<div class="container mx-auto max-w-3xl md:max-w-5xl px-6 text-center">
<p class="quote-reveal text-[2.1rem] md:text-[2.55rem] leading-tight text-foreground font-light max-w-3xl mx-auto" style="animation-delay: 120ms;">
