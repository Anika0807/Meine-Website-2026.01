---
import Layout from '@/layouts/Layout.astro';
import Button from '@/components/ui/astro-button.astro';
---

<Layout title="FlavorFusion - Anika Warncke">
  <!-- 1. HERO -->
  <section class="relative min-h-[100svh] flex items-center justify-center overflow-hidden" data-reveal-group>
    <img src="/images/projekte/flavorfusion-hero.jpg" alt="FlavorFusion Hero" class="absolute inset-0 w-full h-full object-cover" loading="eager" fetchpriority="high">
    <div class="absolute inset-0 bg-gradient-to-b from-black/40 via-black/20 to-black/70"></div>
    <div class="relative z-10 text-center text-white px-4 sm:px-6 max-w-4xl">
      <p class="reveal-item text-sm tracking-[4px] uppercase font-medium mb-4 opacity-90">UX/UI DESIGN • LANDING PAGE</p>
      <h1 class="reveal-item text-5xl sm:text-6xl md:text-7xl font-semibold tracking-tighter leading-none">FlavorFusion</h1>
      <p class="reveal-item mt-5 text-base sm:text-xl md:text-2xl max-w-lg mx-auto opacity-90">Landing Page for a Mobile Recipe App</p>
    </div>
  </section>

  <!-- Content Rail -->
  <div class="max-w-6xl mx-auto px-4 sm:px-6">

    <!-- METADATA -->
    <section class="pt-12 pb-20 md:pb-28 bg-background border-t border-border" data-reveal-group>
      <div class="max-w-7xl mx-auto px-0 md:px-12">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-y-10 md:gap-y-0 gap-x-8 mb-16 text-sm">
          <div class="reveal-item">
            <p class="uppercase tracking-widest text-sm font-medium text-foreground mb-3">Role & Team</p>
            <p class="text-foreground">
              <span class="text-primary font-medium">UX/UI Designer</span>
            </p>
          </div>
          <div class="reveal-item">
            <p class="uppercase tracking-widest text-sm font-medium text-foreground mb-3">Task</p>
            <p class="text-foreground">
              <span class="text-primary font-medium">End-to-End</span> design process:<br>from problem to high-fidelity prototype of a landing page (UX Research, UI Design, Prototyping)
            </p>
          </div>
          <div class="reveal-item">
            <p class="uppercase tracking-widest text-sm font-medium text-foreground mb-3">Timeline & Context</p>
            <p class="text-foreground">
              June 2025<br>
              <span class="text-primary font-medium">20-hour Design Sprint</span> supported by generative AI in the UX/UI Bootcamp at neuefische
            </p>
          </div>
          <div class="reveal-item">
            <p class="uppercase tracking-widest text-sm font-medium text-foreground mb-3">Tools</p>
            <p class="text-foreground">
              <span class="text-primary font-medium">Figma</span>, FigJam, Notion,<br>ChatGPT, Gemini
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- The Challenge -->
    <section class="py-16 md:py-28 bg-background border-t border-border" data-reveal-group>
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="reveal-item text-h2 mb-8 md:mb-14">The Challenge</h2>
        <p class="reveal-item text-base sm:text-lg md:text-xl text-muted-foreground leading-relaxed">
          Ambitious home cooks face a frustrating choice: either they fight their way through overloaded recipe apps – or they give up on real inspiration entirely.
          What's missing is an <span class="text-primary font-semibold">intuitive, emotionally engaging landing page</span> that creates a personal connection, builds <span class="text-primary font-semibold">trust</span>, and makes <span class="text-primary font-semibold">downloading the FlavorFusion app</span> feel like the obvious next step – so they can finally use a truly great recipe app.
        </p>
      </div>
    </section>

    <!-- RESEARCH HIGHLIGHTS -->
    <section id="research" class="py-20 md:py-32 bg-muted/40 border-t border-border" data-reveal-group>
      <div class="max-w-7xl mx-auto px-6 md:px-12">

        <h2 class="reveal-item text-h2 text-center mb-12 md:mb-16">
          Research Highlights
        </h2>

        <!-- Three Insights -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-12 mb-16">
          <div class="text-center reveal-item">
            <div class="inline-flex h-14 w-14 items-center justify-center rounded-full border-2 border-emerald-700 text-3xl font-semibold text-primary mb-6">1</div>
            <p class="text-xl font-medium">Users Feel Overwhelmed</p>
            <p class="text-muted-foreground mt-3">Unclear call-to-actions and overloaded information cause users to <span class="text-primary font-semibold">drop off quickly.</span></p>
          </div>
          <div class="text-center reveal-item">
            <div class="inline-flex h-14 w-14 items-center justify-center rounded-full border-2 border-emerald-700 text-3xl font-semibold text-primary mb-6">2</div>
            <p class="text-xl font-medium">Emotion Creates Connection</p>
            <p class="text-muted-foreground mt-3">Users don't want a plain recipe list – they want <span class="text-primary font-semibold">emotional stories and inspiration.</span></p>
          </div>
          <div class="text-center reveal-item">
            <div class="inline-flex h-14 w-14 items-center justify-center rounded-full border-2 border-emerald-700 text-3xl font-semibold text-primary mb-6">3</div>
            <p class="text-xl font-medium">Trust Through Preview</p>
            <p class="text-muted-foreground mt-3">Users look for ratings and previews to <span class="text-primary font-semibold">build trust.</span></p>
          </div>
        </div>

        <!-- Stats -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8 md:gap-12 mb-16">
          <div class="text-center reveal-item"><div class="text-4xl sm:text-5xl md:text-6xl font-bold text-primary"><span id="en-flavorfusion-count-72">0</span>%</div><p class="text-xs sm:text-sm mt-2">COOK 3–5x PER WEEK</p></div>
          <div class="text-center reveal-item"><div class="text-4xl sm:text-5xl md:text-6xl font-bold text-primary"><span id="en-flavorfusion-count-81-apps">0</span>%</div><p class="text-xs sm:text-sm mt-2">USE APPS INSTEAD OF GOOGLE</p></div>
          <div class="text-center reveal-item"><div class="text-4xl sm:text-5xl md:text-6xl font-bold text-primary"><span id="en-flavorfusion-count-70">0</span>%</div><p class="text-xs sm:text-sm mt-2">WANT CLEAR STEP-BY-STEP GUIDES</p></div>
          <div class="text-center reveal-item"><div class="text-4xl sm:text-5xl md:text-6xl font-bold text-primary"><span id="en-flavorfusion-count-81-photos">0</span>%</div><p class="text-xs sm:text-sm mt-2">LOOK FOR BEAUTIFUL PHOTOS & INSPIRATION</p></div>
        </div>

        <!-- Quotes + How might we -->
        <div class="reveal-item max-w-3xl mx-auto text-center">
          <div class="italic text-foreground text-xl md:text-2xl font-semibold mb-12">
            "I need clear step-by-step instructions, otherwise I give up."<br>
            "Recipes should look beautiful and inspire me – not just work."
          </div>

          <p class="text-2xl md:text-4xl font-semibold tracking-tight leading-tight text-foreground">
            How might users be guided through the landing page in a way that feels <span class="text-primary font-semibold">clear, beautiful and inspiring</span>, so they <span class="text-primary font-semibold">immediately build trust</span> and downloading the app becomes the <span class="text-primary font-semibold">most natural and joyful next step</span>?
          </p>
        </div>
      </div>
    </section>

    <!-- PROCESS -->
    <section id="process" class="py-24 md:py-32 bg-background border-t border-border">
      <div class="max-w-7xl mx-auto px-6 md:px-12">

        <h2 class="text-h2 text-center mb-12 md:mb-16 reveal">
          Process
        </h2>

        <!-- User Flow -->
        <div class="mb-20 reveal" style="transition-delay: 80ms">
          <img src="/images/projekte/flavorfusion-user-flow.png"
               alt="FlavorFusion User Flow"
               class="w-full rounded-3xl shadow-2xl" loading="lazy">
        </div>

        <!-- Design Principles -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-10 mb-20" style="transition-delay: 160ms">
          <div class="bg-background border border-border p-8 md:p-10 rounded-3xl reveal">
            <div class="text-primary text-5xl font-semibold mb-6">01</div>
            <h3 class="text-2xl font-medium mb-4">Authenticity</h3>
            <p class="text-body text-muted-foreground">
              The landing page feels like a great kitchen tip from a friend – <span class="text-primary font-medium">warm, authentic and real</span>.
            </p>
          </div>
          <div class="bg-background border border-border p-8 md:p-10 rounded-3xl reveal">
            <div class="text-primary text-5xl font-semibold mb-6">02</div>
            <h3 class="text-2xl font-medium mb-4">Clarity</h3>
            <p class="text-body text-muted-foreground">
              Like a great recipe: a <span class="text-primary font-medium">clear roadmap</span> with effortless orientation and <span class="text-primary font-medium">intuitive guidance</span>.
            </p>
          </div>
          <div class="bg-background border border-border p-8 md:p-10 rounded-3xl reveal">
            <div class="text-primary text-5xl font-semibold mb-6">03</div>
            <h3 class="text-2xl font-medium mb-4">Passion</h3>
            <p class="text-body text-muted-foreground">
              Food is emotional – the landing page sparks <span class="text-primary font-medium">pure joy of cooking</span> through inspiring content and thoughtful details.
            </p>
          </div>
        </div>

        <!-- UI Foundation -->
        <div class="max-w-4xl mx-auto" style="transition-delay: 240ms">
          <div class="reveal">
            <h4 class="uppercase tracking-widest text-sm text-muted-foreground mb-6">UI Foundation</h4>
            <img src="/images/projekte/flavorfusion-ui-foundation.png" alt="FlavorFusion UI Foundation" class="w-full rounded-3xl shadow-xl" loading="lazy">
          </div>
        </div>
      </div>
    </section>

    <script>
      // @ts-nocheck
      function initProcessReveal() {
        const reveals = /** @type {NodeListOf<HTMLElement>} */ (document.querySelectorAll('#process .reveal'));
        reveals.forEach((el, i) => {
          el.style.opacity = '0';
          el.style.transform = 'translateY(30px)';
          el.style.transition = 'all 1s cubic-bezier(0.25, 0.1, 0.25, 1)';

          const observer = new IntersectionObserver((entries) => {
            if (!entries[0].isIntersecting) return;
            setTimeout(() => {
              el.style.opacity = '1';
              el.style.transform = 'translateY(0)';
            }, i * 140);
            observer.disconnect();
          }, { threshold: 0.12, rootMargin: '0px 0px -10% 0px' });

          observer.observe(el);
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initProcessReveal, { once: true });
      } else {
        initProcessReveal();
      }
    </script>

    <!-- FINAL DESIGN -->
    <section id="final-design" class="py-20 md:py-32 bg-background border-t border-border">
      <div class="max-w-7xl mx-auto px-6 md:px-12">
        <h2 class="text-h2 text-center mb-8 reveal">
          Final Design
        </h2>

        <p class="max-w-2xl mx-auto text-center text-lg md:text-xl text-muted-foreground mb-16 reveal" style="transition-delay: 80ms">
          The finished landing page in action – warm, <span class="text-primary font-medium">inviting</span> and intuitively designed. With clear navigation, beautiful recipe photos and the feeling that you want to <span class="text-primary font-medium">start cooking right away</span>.
        </p>

        <div class="reveal mx-auto max-w-4xl rounded-3xl overflow-hidden shadow-2xl border border-border" style="transition-delay: 160ms">
          <div class="aspect-video bg-black">
            <iframe
              width="100%"
              height="100%"
              src="https://www.youtube.com/embed/TtaknL6y0sc"
              title="FlavorFusion Landing Page – Live Experience"
              frameborder="0"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen>
            </iframe>
          </div>
        </div>

        <p class="text-center text-sm text-muted-foreground mt-8 reveal" style="transition-delay: 240ms">
          The video shows the <span class="text-primary font-medium">complete scroll experience</span> of the landing page:<br>
          from the first encounter with the hero all the way to the end – with all its inspiring details and the <span class="text-primary font-medium">emotional recipe world</span>.
        </p>
      </div>
    </section>

    <script>
      // @ts-nocheck
      function initFinalReveal() {
        const reveals = /** @type {NodeListOf<HTMLElement>} */ (document.querySelectorAll('#final-design .reveal'));
        reveals.forEach((el, i) => {
          el.style.opacity = '0';
          el.style.transform = 'translateY(30px)';
          el.style.transition = 'all 1s cubic-bezier(0.25, 0.1, 0.25, 1)';

          const observer = new IntersectionObserver((entries) => {
            if (!entries[0].isIntersecting) return;
            setTimeout(() => {
              el.style.opacity = '1';
              el.style.transform = 'translateY(0)';
            }, i * 140);
            observer.disconnect();
          }, { threshold: 0.12, rootMargin: '0px 0px -10% 0px' });

          observer.observe(el);
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initFinalReveal, { once: true });
      } else {
        initFinalReveal();
      }
    </script>

    <!-- RESULTS & LEARNINGS -->
    <section id="results" class="py-20 md:py-32 bg-background border-t border-border">
      <div class="max-w-7xl mx-auto px-6 md:px-12">

        <h2 class="text-h2 text-center mb-12 md:mb-20 reveal">
          Results & Learnings
        </h2>

        <p class="max-w-3xl mx-auto text-lg md:text-xl text-muted-foreground text-center mb-16 md:mb-20 reveal" style="transition-delay: 80ms">
          In just 20 hours, a <span class="text-primary font-medium">strategic Minimum Viable Product</span> was created.
          The landing page is <span class="text-primary font-medium">clear, emotionally engaging</span> and drives users straight to conversion.
        </p>

        <!-- Three Cards -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8 mb-16" style="transition-delay: 160ms">

          <div class="bg-background border border-border p-8 md:p-10 rounded-3xl shadow-sm reveal">
            <div class="text-primary text-5xl font-semibold mb-6">01</div>
            <h3 class="text-2xl font-medium mb-4">Radical Prioritisation</h3>
            <p class="text-muted-foreground text-[15px] md:text-base leading-relaxed">
              The 20-hour design sprint served as a catalyst for a <span class="text-primary font-medium">radical focus</span> on the core message and the central action of the landing page.
            </p>
          </div>

          <div class="bg-background border border-border p-8 md:p-10 rounded-3xl shadow-sm reveal">
            <div class="text-primary text-5xl font-semibold mb-6">02</div>
            <h3 class="text-2xl font-medium mb-4">Research as Foundation</h3>
            <p class="text-muted-foreground text-[15px] md:text-base leading-relaxed">
              AI can simplify and accelerate a <span class="text-primary font-medium">thorough and well-founded user research</span> process – but it can't replace it entirely.
            </p>
          </div>

          <div class="bg-background border border-border p-8 md:p-10 rounded-3xl shadow-sm reveal">
            <div class="text-primary text-5xl font-semibold mb-6">03</div>
            <h3 class="text-2xl font-medium mb-4">Courage to Decide</h3>
            <p class="text-muted-foreground text-[15px] md:text-base leading-relaxed">
              The tight timeline showed how crucial <span class="text-primary font-medium">the courage to make quick decisions</span> is – without losing the <span class="text-primary font-medium">empathetic perspective</span>.
            </p>
          </div>
        </div>

        <!-- Next Steps -->
        <div class="max-w-2xl mx-auto mb-16 reveal" style="transition-delay: 240ms">
          <h3 class="uppercase tracking-widest text-sm text-muted-foreground mb-6 text-center">NEXT STEPS</h3>
          <ul class="space-y-6 text-[15px] md:text-base text-muted-foreground">
            <li class="flex gap-4">→ Test: Validate the prototype with real users</li>
            <li class="flex gap-4">→ Iterate: Use feedback to make targeted improvements</li>
            <li class="flex gap-4">→ Build & Optimise: Launch the final page and increase conversion through A/B testing</li>
          </ul>
        </div>

        <!-- Back Button -->
        <div class="flex justify-center">
          <Button href="/en/projects" variant="primary" size="lg" class="w-full sm:w-auto">Back to all Projects →</Button>
        </div>

        <!-- Project Navigation -->
        <div class="mt-14 md:mt-20 pt-8 md:pt-12 border-t border-border flex flex-col md:flex-row gap-4 md:gap-6 justify-between">
          <Button href="/projekte/en/[previous-project]" variant="primary" size="lg" class="w-full md:w-auto">← Previous Project</Button>
          <Button href="/projekte/en/[next-project]" variant="primary" size="lg" class="w-full md:w-auto">Next Project →</Button>
        </div>

      </div>
    </section>

    <script>
      // @ts-nocheck
      function initResultsReveal() {
        const reveals = /** @type {NodeListOf<HTMLElement>} */ (document.querySelectorAll('#results .reveal'));
        reveals.forEach((el, i) => {
          el.style.opacity = '0';
          el.style.transform = 'translateY(30px)';
          el.style.transition = 'all 1s cubic-bezier(0.25, 0.1, 0.25, 1)';

          const observer = new IntersectionObserver((entries) => {
            if (!entries[0].isIntersecting) return;
            setTimeout(() => {
              el.style.opacity = '1';
              el.style.transform = 'translateY(0)';
            }, i * 140);
            observer.disconnect();
          }, { threshold: 0.12, rootMargin: '0px 0px -10% 0px' });

          observer.observe(el);
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initResultsReveal, { once: true });
      } else {
        initResultsReveal();
      }
    </script>

    <script>
      // @ts-nocheck
      function animateCounter(id, target, duration = 1600) {
        const counter = document.getElementById(id);
        if (!(counter instanceof HTMLElement)) return;
        const startTime = performance.now();

        function update(now) {
          const progress = Math.min((now - startTime) / duration, 1);
          counter.textContent = String(Math.floor(progress * target));
          if (progress < 1) requestAnimationFrame(update);
        }

        requestAnimationFrame(update);
      }

      function animateResearchCounters() {
        animateCounter('en-flavorfusion-count-72', 72);
        animateCounter('en-flavorfusion-count-81-apps', 81);
        animateCounter('en-flavorfusion-count-70', 70);
        animateCounter('en-flavorfusion-count-81-photos', 81);
      }

      function initSequentialReveals() {
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const groups = /** @type {NodeListOf<HTMLElement>} */ (document.querySelectorAll('[data-reveal-group]'));

        groups.forEach((group) => {
          const items = /** @type {NodeListOf<HTMLElement>} */ (group.querySelectorAll('.reveal-item'));
          if (!items.length) return;

          if (reduceMotion) {
            items.forEach((item) => {
              item.style.opacity = '1';
              item.style.transform = 'none';
            });
            if (group.id === 'research') {
              animateResearchCounters();
            }
            return;
          }

          items.forEach((item) => {
            item.style.opacity = '0';
            item.style.transform = 'translateY(28px)';
            item.style.transition = 'all 1s cubic-bezier(0.25, 0.1, 0.25, 1)';
            item.style.willChange = 'opacity, transform';
          });

          const observer = new IntersectionObserver((entries) => {
            if (!entries[0].isIntersecting) return;

            if (group.id === 'research' && group.dataset.countAnimated !== 'true') {
              animateResearchCounters();
              group.dataset.countAnimated = 'true';
            }

            items.forEach((item, index) => {
              setTimeout(() => {
                item.style.opacity = '1';
                item.style.transform = 'translateY(0)';
              }, index * 160);
            });
            group.dataset.revealed = 'true';

            observer.disconnect();
          }, { threshold: 0.2, rootMargin: '0px 0px -8% 0px' });

          observer.observe(group);
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initSequentialReveals, { once: true });
      } else {
        initSequentialReveals();
      }
    </script>

  </div>

</Layout>
