---
import Layout from '@/layouts/Layout.astro';
import Button from '@/components/ui/astro-button.astro';
---

<Layout title="OmNomZen - Anika Warncke">
  <!-- 1. HERO -->
  <section class="relative min-h-[100svh] flex items-center justify-center overflow-hidden" data-reveal-group>
    <img src="/images/projekte/omnomzen-hero.webp" alt="OmNomZen Hero" class="absolute inset-0 w-full h-full object-cover" loading="eager" fetchpriority="high">
    <div class="absolute inset-0 bg-gradient-to-b from-black/40 via-black/20 to-black/70"></div>
    <div class="relative z-10 text-center text-white px-6 max-w-4xl">
      <p class="reveal-item text-base md:text-lg font-semibold tracking-[0.16em] uppercase mb-3 opacity-95">UX/UI DESIGN • MOBILE APP</p>
      <h1 class="reveal-item text-[clamp(2.05rem,9.6vw,2.9rem)] md:text-[4.1rem] max-w-[16ch] mx-auto font-semibold tracking-tight leading-[0.92]">OmNomZen</h1>
      <p class="reveal-item mt-4 text-lg md:text-xl max-w-lg mx-auto opacity-90">Stress relief with organic ashwagandha gummies</p>
    </div>
  </section>

  <!-- Content Rail -->
  <div class="max-w-6xl mx-auto px-6">

    <!-- METADATA -->
    <section class="pt-12 pb-20 md:pb-28 bg-background" data-reveal-group>
      <div class="max-w-7xl mx-auto px-0 md:px-12">
        
        <!-- Metadata Row -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-y-10 md:gap-y-0 gap-x-8 mb-16 text-sm">
          <div class="reveal-item">
            <p class="uppercase tracking-widest text-sm font-medium text-foreground mb-3">Role & Team</p>
            <p class="text-foreground">
              <span class="text-primary font-medium">UX/UI Designer</span> in a three-person team with Sten Ruedrich and Michael Jakob
            </p>
          </div>
          <div class="reveal-item">
            <p class="uppercase tracking-widest text-sm font-medium text-foreground mb-3">Task</p>
            <p class="text-foreground">
              <span class="text-primary font-medium">End-to-End Design</span> of a mobile <span class="text-primary font-medium">e-commerce app</span> for stress relief with organic gummies, with a focus on UI design and prototyping
            </p>
          </div>
          <div class="reveal-item">
            <p class="uppercase tracking-widest text-sm font-medium text-foreground mb-3">Timeline & Context</p>
            <p class="text-foreground">
              May 2025<br>
              <span class="text-primary font-medium">2-week design sprint</span> in the UX/UI bootcamp at neuefische
            </p>
          </div>
          <div class="reveal-item">
            <p class="uppercase tracking-widest text-sm font-medium text-foreground mb-3">Tools</p>
            <p class="text-foreground">
              <span class="text-primary font-medium">Figma</span>, FigJam, Notion,<br>ChatGPT, Gemini
            </p>
          </div>
        </div>

      </div>
    </section>

    <!-- The Challenge -->
    <section class="py-16 md:py-28 bg-background" data-reveal-group>
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="reveal-item text-h2 mb-8 md:mb-14">The Challenge</h2>

          <p class="reveal-item text-base sm:text-lg md:text-xl text-muted-foreground leading-relaxed">
            Many people who want to <span class="text-primary font-medium">reduce stress and live more mindfully</span> feel <span class="text-primary font-medium">overwhelmed</span> by the sheer variety of products online.
            They are looking for natural solutions like ashwagandha, but often end up in functional storefronts that feel impersonal and offer little <span class="text-primary font-medium">emotional connection or real guidance</span>.
          </p>
      </div>
    </section>

    <!-- RESEARCH HIGHLIGHTS -->
    <section id="research" class="py-20 md:py-32 bg-muted/40" data-reveal-group>
      <div class="max-w-7xl mx-auto px-6 md:px-12">

        <h2 class="reveal-item text-h2 text-center mb-12 md:mb-16">
          Research Highlights
        </h2>

        <!-- Three Insights -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-12 mb-16">
          <div class="text-center reveal-item">
            <div class="inline-flex h-14 w-14 items-center justify-center rounded-full border-2 border-emerald-700 text-3xl font-semibold text-primary mb-6">01</div>
            <p class="text-xl font-medium">Natural Orientation</p>
            <p class="text-muted-foreground mt-3">People looking for stress-relief products primarily look for <span class="text-primary font-medium">clear, natural ingredients</span> and <span class="text-primary font-medium">a noticeable effect.</span></p>
          </div>
          <div class="text-center reveal-item">
            <div class="inline-flex h-14 w-14 items-center justify-center rounded-full border-2 border-emerald-700 text-3xl font-semibold text-primary mb-6">02</div>
            <p class="text-xl font-medium">Playful Motivation</p>
            <p class="text-muted-foreground mt-3">They want a <span class="text-primary font-medium">light, motivating experience</span> that makes relaxation feel less like an obligation and more like something <span class="text-primary font-medium">enjoyable</span>.</p>
          </div>
          <div class="text-center reveal-item">
            <div class="inline-flex h-14 w-14 items-center justify-center rounded-full border-2 border-emerald-700 text-3xl font-semibold text-primary mb-6">03</div>
            <p class="text-xl font-medium">Sustainable Responsibility</p>
            <p class="text-muted-foreground mt-3">Trust grows through <span class="text-primary font-medium">transparent sourcing</span> and <span class="text-primary font-medium">fair production.</span> People want to know that their choice is good for both themselves and the environment.</p>
          </div>
        </div>

        <!-- Quotes + How might we -->
        <div class="reveal-item max-w-3xl mx-auto text-center">
          <div class="italic text-foreground text-xl md:text-2xl font-semibold mb-12">
            "I want to know exactly what's inside and that it was produced fairly and sustainably."<br>
            "It should be fun and genuinely motivate me."
          </div>

          <p class="text-2xl md:text-4xl font-semibold tracking-tight leading-tight text-foreground">
            How might <span class="text-primary font-medium">stressed people</span> quickly and <span class="text-primary font-medium">easily</span> discover a <span class="text-primary font-medium">trustworthy</span> and <span class="text-primary font-medium">playful</span> way to <span class="text-primary font-medium">reduce stress</span> while still feeling <span class="text-primary font-medium">well informed</span>?
          </p>
        </div>
      </div>
    </section>

    <!-- PROCESS -->
    <section id="process" class="py-24 md:py-32 bg-background">
      <div class="max-w-7xl mx-auto px-6 md:px-12">

        <h2 class="text-h2 text-center mb-12 md:mb-16 reveal">
          Process
        </h2>

        <!-- User Flow -->
        <div class="mb-20 reveal" style="transition-delay: 80ms">
          <img src="/images/projekte/omnomzen-user-flow.webp"
            alt="OmNomZen User Flow"
               class="w-full rounded-3xl shadow-2xl" loading="lazy">
        </div>

        <!-- Design Principles -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-10 mb-20" style="transition-delay: 160ms">
          <div class="bg-background border border-border p-8 md:p-10 rounded-3xl reveal">
            <div class="text-primary text-5xl font-semibold mb-6">01</div>
            <h3 class="text-2xl font-medium mb-4">Natural</h3>
            <p class="text-body text-muted-foreground">
              Our organic ashwagandha gummies come from nature and support <span class="text-primary font-medium">everyday well-being</span>.
            </p>
          </div>
          <div class="bg-background border border-border p-8 md:p-10 rounded-3xl reveal">
            <div class="text-primary text-5xl font-semibold mb-6">02</div>
            <h3 class="text-2xl font-medium mb-4">Playful</h3>
            <p class="text-body text-muted-foreground">
              Turning the concept into colorful gummies with a points system makes relaxation feel <span class="text-primary font-medium">easy and enjoyable</span>.
            </p>
          </div>
          <div class="bg-background border border-border p-8 md:p-10 rounded-3xl reveal">
            <div class="text-primary text-5xl font-semibold mb-6">03</div>
            <h3 class="text-2xl font-medium mb-4">Sustainable</h3>
            <p class="text-body text-muted-foreground">
              Transparent, fair production and delivery reflect our <span class="text-primary font-medium">responsibility toward people and the environment</span>.
            </p>
          </div>
        </div>

        <!-- UI Foundation -->
        <div class="grid grid-cols-1 md:grid-cols-1 gap-8 md:gap-12" style="transition-delay: 240ms">
          <div class="reveal">
            <h4 class="uppercase tracking-widest text-sm text-muted-foreground mb-6">UI Foundation</h4>
            <img src="/images/projekte/omnomzen-ui-foundation.webp" alt="OmNomZen UI Foundation" class="w-full rounded-3xl shadow-xl" loading="lazy">
          </div>
        </div>
      </div>
    </section>

    <script>
      // @ts-nocheck
      // Staggered reveal matching the other sections
      function initProcessReveal() {
        const reveals = /** @type {NodeListOf<HTMLElement>} */ (document.querySelectorAll('#process .reveal'));
        reveals.forEach((el, i) => {
          el.style.opacity = '0';
          el.style.transform = 'translateY(30px)';
          el.style.transition = 'all 1s cubic-bezier(0.25, 0.1, 0.25, 1)';

          const observer = new IntersectionObserver((entries) => {
            if (!entries[0].isIntersecting) return;
            setTimeout(() => {
              el.style.opacity = '1';
              el.style.transform = 'translateY(0)';
            }, i * 140);
            observer.disconnect();
          }, { threshold: 0.12, rootMargin: '0px 0px -10% 0px' });

          observer.observe(el);
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initProcessReveal, { once: true });
      } else {
        initProcessReveal();
      }
    </script>

    <section id="final-design" class="py-24 md:py-32 bg-muted/40">
      <div class="max-w-7xl mx-auto px-6 md:px-12">
        <h2 class="reveal text-h2 text-center mb-12 md:mb-16">Final Design</h2>

        <!-- App Insights -->
        <div class="reveal mb-20" style="transition-delay: 220ms">
          <h3 class="uppercase tracking-widest text-sm text-muted-foreground mb-8 text-center">APP INSIGHTS</h3>
          <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-8">
            <img src="/images/projekte/omnomzen-feature-01.webp" alt="OmNomZen feature screen 01" class="w-full rounded-3xl shadow-xl" loading="lazy">
            <img src="/images/projekte/omnomzen-feature-02.webp" alt="OmNomZen feature screen 02" class="w-full rounded-3xl shadow-xl" loading="lazy">
            <img src="/images/projekte/omnomzen-feature-03.webp" alt="OmNomZen feature screen 03" class="w-full rounded-3xl shadow-xl" loading="lazy">
            <img src="/images/projekte/omnomzen-feature-04.webp" alt="OmNomZen feature screen 04" class="w-full rounded-3xl shadow-xl" loading="lazy">
          </div>
        </div>

        <!-- Live Preview -->
        <div class="reveal text-center" style="transition-delay: 360ms">
          <h3 class="uppercase tracking-widest text-sm text-muted-foreground mb-8">LIVE PREVIEW</h3>
          <div class="max-w-2xl mx-auto rounded-3xl overflow-hidden shadow-2xl bg-black aspect-video">
            <iframe class="w-full h-full"
                    src="https://www.youtube.com/embed/pWxjAKkdBLk"
                    title="OmNomZen Live Preview"
                    frameborder="0"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                    allowfullscreen></iframe>
          </div>
          <p class="mt-8 text-muted-foreground max-w-md mx-auto text-sm md:text-base">
            The result is a calm, <span class="text-primary font-medium">intuitive and playful</span> app
            that supports <span class="text-primary font-medium">well-being</span> <span class="text-primary font-medium">without feeling overwhelming.</span>
          </p>
        </div>
      </div>
    </section>

    <script>
      // @ts-nocheck
      // Matching reveal animation for the final design section
      function initFinalReveal() {
        const reveals = /** @type {NodeListOf<HTMLElement>} */ (document.querySelectorAll('#final-design .reveal'));
        reveals.forEach((el, i) => {
          el.style.opacity = '0';
          el.style.transform = 'translateY(30px)';
          el.style.transition = 'all 1s cubic-bezier(0.25, 0.1, 0.25, 1)';

          const observer = new IntersectionObserver((entries) => {
            if (!entries[0].isIntersecting) return;
            setTimeout(() => {
              el.style.opacity = '1';
              el.style.transform = 'translateY(0)';
            }, i * 140);
            observer.disconnect();
          }, { threshold: 0.12, rootMargin: '0px 0px -10% 0px' });

          observer.observe(el);
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initFinalReveal, { once: true });
      } else {
        initFinalReveal();
      }
    </script>

    <!-- RESULTS & LEARNINGS -->
    <section id="results" class="py-20 md:py-32 bg-background">
      <div class="max-w-7xl mx-auto px-6 md:px-12">

        <h2 class="text-h2 text-center mb-12 md:mb-20 reveal">
          Results & Learnings
        </h2>

        <p class="max-w-3xl mx-auto text-lg md:text-xl text-muted-foreground text-center mb-16 md:mb-20 reveal" style="transition-delay: 80ms">
             OmNomZen is a prototype for an intuitive mobile e-commerce platform for organic ashwagandha gummies.
             Working on it was a rewarding experience: designing a <span class="text-primary font-medium">meaningful product</span> that helps people experience <span class="text-primary font-medium">greater well-being and less stress</span>.
        </p>

        <!-- Three Cards -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8 mb-16" style="transition-delay: 160ms">

          <div class="bg-background border border-border p-8 md:p-10 rounded-3xl shadow-sm reveal">
            <div class="text-primary text-5xl font-semibold mb-6">01</div>
            <h3 class="text-2xl font-medium mb-4">Communication as a Problem Solver</h3>
            <p class="text-muted-foreground text-base md:text-base leading-relaxed">
              Communication and collaboration in a shared file can be challenging in a dynamic creative team. <span class="text-primary font-medium">Clear and fluid communication</span> is the key to solving problems quickly and finding the right solutions.
            </p>
          </div>

          <div class="bg-background border border-border p-8 md:p-10 rounded-3xl shadow-sm reveal">
            <div class="text-primary text-5xl font-semibold mb-6">02</div>
            <h3 class="text-2xl font-medium mb-4">The Power of Early Iteration</h3>
            <p class="text-muted-foreground text-base md:text-base leading-relaxed">
              <span class="text-primary font-medium">Early and extensive testing</span> raises product quality to another level and leads to truly intuitive design. <span class="text-primary font-medium">User feedback</span> is the most important benchmark throughout the process.
            </p>
          </div>

          <div class="bg-background border border-border p-8 md:p-10 rounded-3xl shadow-sm reveal">
            <div class="text-primary text-5xl font-semibold mb-6">03</div>
            <h3 class="text-2xl font-medium mb-4">Courage to Decide</h3>
            <p class="text-muted-foreground text-base md:text-base leading-relaxed">
              The tight timeframe showed how important the <span class="text-primary font-medium">courage to make quick decisions</span> really is. Instead of waiting for perfect data, it is often more effective to move forward quickly based on solid hypotheses.
            </p>
          </div>
        </div>

        <!-- Next Steps -->
        <div class="max-w-2xl mx-auto mb-16 reveal" style="transition-delay: 240ms">
          <h3 class="uppercase tracking-widest text-sm text-muted-foreground mb-6 text-center">NEXT STEPS</h3>
          <ul class="space-y-6 text-base md:text-base text-muted-foreground">
              <li class="flex gap-4">→ Expanding gamification: detailed concepts for point systems and rewards</li>
              <li class="flex gap-4">→ Social media: development of a content strategy for Instagram and TikTok</li>
              <li class="flex gap-4">→ Product expansion: evaluation of new flavors and merchandise</li>
              <li class="flex gap-4">→ Usability testing: additional tests with a broader user base</li>
          </ul>
        </div>

        <!-- Back Button -->
        <div class="flex justify-center">
          <Button href="/en/projects" variant="primary" size="lg" class="w-full sm:w-auto text-base sm:text-lg">Back to All Projects →</Button>
        </div>

        <!-- Project Navigation -->
        <div class="mt-14 md:mt-20 pt-8 md:pt-12 border-t border-border flex flex-col md:flex-row gap-4 md:gap-6 justify-between">
          <Button href="/en/projects/flavorfusion" variant="primary" size="lg" class="w-full md:w-auto text-base sm:text-lg">← Previous Project</Button>
          <Button href="/en/projects/planora" variant="primary" size="lg" class="w-full md:w-auto text-base sm:text-lg">Next Project →</Button>
        </div>

      </div>
    </section>

    <script>
      // @ts-nocheck
      // Matching reveal animation for results and learnings
      function initResultsReveal() {
        const reveals = /** @type {NodeListOf<HTMLElement>} */ (document.querySelectorAll('#results .reveal'));
        reveals.forEach((el, i) => {
          el.style.opacity = '0';
          el.style.transform = 'translateY(30px)';
          el.style.transition = 'all 1s cubic-bezier(0.25, 0.1, 0.25, 1)';

          const observer = new IntersectionObserver((entries) => {
            if (!entries[0].isIntersecting) return;
            setTimeout(() => {
              el.style.opacity = '1';
              el.style.transform = 'translateY(0)';
            }, i * 140);
            observer.disconnect();
          }, { threshold: 0.12, rootMargin: '0px 0px -10% 0px' });

          observer.observe(el);
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initResultsReveal, { once: true });
      } else {
        initResultsReveal();
      }
    </script>

    <script>
      // @ts-nocheck
      function initSequentialReveals() {
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const groups = /** @type {NodeListOf<HTMLElement>} */ (document.querySelectorAll('[data-reveal-group]'));

        groups.forEach((group) => {
          const items = /** @type {NodeListOf<HTMLElement>} */ (group.querySelectorAll('.reveal-item'));
          if (!items.length) return;

          if (reduceMotion) {
            items.forEach((item) => {
              item.style.opacity = '1';
              item.style.transform = 'none';
            });
            return;
          }

          items.forEach((item) => {
            item.style.opacity = '0';
            item.style.transform = 'translateY(28px)';
            item.style.transition = 'all 1s cubic-bezier(0.25, 0.1, 0.25, 1)';
            item.style.willChange = 'opacity, transform';
          });

          const observer = new IntersectionObserver((entries) => {
            if (!entries[0].isIntersecting) return;

            items.forEach((item, index) => {
              setTimeout(() => {
                item.style.opacity = '1';
                item.style.transform = 'translateY(0)';
              }, index * 160);
            });
            group.dataset.revealed = 'true';

            observer.disconnect();
          }, { threshold: 0.2, rootMargin: '0px 0px -8% 0px' });

          observer.observe(group);
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initSequentialReveals, { once: true });
      } else {
        initSequentialReveals();
      }
    </script>

  </div>

</Layout>
