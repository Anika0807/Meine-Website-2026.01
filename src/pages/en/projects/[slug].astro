---
import Layout from '@/layouts/Layout.astro';
import NaturkompassPage from './naturkompass.astro';

const projects = {
  'my-mind-studio': {
    title: 'My Mind Studio',
    category: 'Interior Architecture',
    subtitle: 'Meditation & Yoga Studio with Café',
    image: '/images/my-mind-studio.jpg',
  },
  naturkompass: {
    title: 'NaturKompass',
    category: 'UX/UI Design',
    subtitle: 'Your Digital Companion for Flora & Fauna Identification',
    image: '/images/naturkompass.jpg',
  },
  'festsaal-im-klostergasthof': {
    title: 'Festsaal im Klostergasthof',
    category: 'Interior Architecture',
    subtitle: 'Event Gastronomy for Weddings & Celebrations',
    image: '/images/festsaal.jpg',
  },
  flavorfusion: {
    title: 'FlavorFusion',
    category: 'UX/UI Design',
    subtitle: 'Landing Page for a Mobile Recipe App',
    image: '/images/flavorfusion.jpg',
  },
  schlaf: {
    title: 'SCHLAF',
    category: 'Interior Architecture',
    subtitle: 'An Immersive Exhibition Exploring the Depths of Sleep',
    image: '/images/schlaf.jpg',
  },
  omnomzen: {
    title: 'OmNomZen',
    category: 'UX/UI Design',
    subtitle: 'Stress Relief with Organic Ashwagandha Gummies',
    image: '/images/omnomzen.jpg',
  },
  weserkoje: {
    title: 'weserkoje',
    category: 'Interior Architecture',
    subtitle: 'Multifunctional Hostel with Integrated Conference Center',
    image: '/images/weserkoje.jpg',
  },
  planora: {
    title: 'Planora',
    category: 'UX/UI Design',
    subtitle: 'Travel Planning That Adapts to You',
    image: '/images/planora.jpg',
  },
} as const;

export function getStaticPaths() {
  return [
    { params: { slug: 'my-mind-studio' } },
    { params: { slug: 'festsaal-im-klostergasthof' } },
    { params: { slug: 'flavorfusion' } },
    { params: { slug: 'schlaf' } },
    { params: { slug: 'omnomzen' } },
    { params: { slug: 'weserkoje' } },
    { params: { slug: 'planora' } },
  ];
}

const { slug } = Astro.params;
const project = projects[slug as keyof typeof projects];
const isNaturkompass = slug === 'naturkompass';

if (!project && !isNaturkompass) {
  return Astro.redirect('/en/projects');
}
---

{isNaturkompass ? (
  <NaturkompassPage />
) : (
<Layout title={`${project!.title} | Projects`}>
  <section class="relative h-[70svh] min-h-[520px] w-full overflow-hidden">
    <img src={project!.image} alt={project!.title} class="absolute inset-0 h-full w-full object-cover" />
    <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/45 to-black/20"></div>

    <div class="absolute inset-0 flex items-end">
      <div class="mx-auto w-full max-w-6xl px-6 pb-16 text-white">
        <p class="mb-3 text-xs uppercase tracking-[0.2em] text-white/80">{project!.category}</p>
        <h1 class="text-4xl font-semibold tracking-tight md:text-6xl">{project!.title}</h1>
        <p class="mt-4 max-w-2xl text-base text-white/90 md:text-lg">{project!.subtitle}</p>
      </div>
    </div>
  </section>

  <section class="bg-background py-20">
    <div class="mx-auto max-w-3xl px-6 text-center">
      <h2 class="text-3xl font-semibold tracking-tight md:text-4xl">Project Overview</h2>
      <p class="mt-6 text-base text-muted-foreground md:text-lg">
        This subpage is the detail view for {project!.title}. Content such as process, goals, and outcomes
        can be expanded here at any time.
      </p>
      <a href="/en/projects" class="mt-10 inline-block rounded-btn bg-primary px-8 py-4 text-primary-foreground transition-colors hover:bg-accent">
        Back to Projects
      </a>
    </div>
  </section>
</Layout>
)}
