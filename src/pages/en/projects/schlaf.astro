---
import Layout from '@/layouts/Layout.astro';
import Button from '@/components/ui/astro-button.astro';
---

<Layout title="SCHLAF – Anika Warncke">
  <!-- 1. HERO -->
  <section class="relative min-h-[100svh] flex items-center justify-center overflow-hidden" data-reveal-group>
    <img src="/images/projekte/schlaf-hero.jpg" alt="SCHLAF" class="absolute inset-0 w-full h-full object-cover" loading="eager" fetchpriority="high">
    <div class="absolute inset-0 bg-gradient-to-b from-black/40 via-black/20 to-black/70"></div>
    <div class="relative z-10 text-center text-white px-4 sm:px-6 max-w-4xl">
      <p class="reveal-item text-base md:text-lg font-semibold tracking-[0.16em] uppercase mb-3 opacity-95">INTERIOR ARCHITECTURE • EXHIBITION DESIGN</p>
      <h1 class="reveal-item text-[clamp(2.05rem,9.6vw,2.9rem)] md:text-[4.1rem] max-w-[16ch] mx-auto font-semibold tracking-tight leading-[0.92]">SCHLAF</h1>
      <p class="reveal-item mt-4 text-lg md:text-xl max-w-lg mx-auto opacity-90">An Immersive Exhibition Exploring the Depths of Sleep</p>
    </div>
  </section>

  <!-- Content Rail – all further sections -->
  <div class="max-w-6xl mx-auto px-4 sm:px-6">

    <!-- === METADATA === -->
    <section class="pt-12 pb-20 md:pb-28 bg-background border-t border-border" data-reveal-group>
      <div class="max-w-7xl mx-auto px-0 md:px-12">

        <div class="grid grid-cols-1 md:grid-cols-4 gap-y-10 md:gap-y-0 gap-x-8 mb-16 text-sm">
          <div class="reveal-item">
            <p class="uppercase tracking-widest text-sm font-medium text-foreground mb-3">Role</p>
            <p class="text-foreground">
              <span class="text-primary font-medium">Interior Architecture M.A.</span>
            </p>
          </div>
          <div class="reveal-item">
            <p class="uppercase tracking-widest text-sm font-medium text-foreground mb-3">Task</p>
            <p class="text-foreground">
              Development of an immersive exhibition exploring the depths of sleep<br>
              <span class="text-primary font-medium">Service phases 01–03, partial phase 05</span>
            </p>
          </div>
          <div class="reveal-item">
            <p class="uppercase tracking-widest text-sm font-medium text-foreground mb-3">Timeline & Scope</p>
            <p class="text-foreground">
              03–07 2020:<br>
              <a href="https://projekte.g.hawk.de/projekt/5f2d054b1bef1" class="text-primary font-medium underline" target="_blank" rel="noopener noreferrer">Master's Thesis</a>, at HAWK University of Applied Sciences and Arts, Hildesheim
            </p>
          </div>
          <div class="reveal-item">
            <p class="uppercase tracking-widest text-sm font-medium text-foreground mb-3">Tools</p>
            <p class="text-foreground">
              <span class="text-primary font-medium">Vectorworks</span>, Adobe Creative Suite
            </p>
          </div>
        </div>

      </div>
    </section>

    <div class="pb-10 md:pb-16" data-reveal-group>
      <img
        src="/images/projekte/schlaf-herausforderung-placeholder.png"
        alt="Placeholder image before the Challenge section"
        class="reveal-item w-full h-auto rounded-3xl border border-border bg-muted/40 shadow-sm object-contain" loading="lazy">
    </div>

    <!-- === THE CHALLENGE === -->
    <section id="challenge" class="py-28 md:py-36 bg-background border-t border-border">
      <div class="max-w-4xl mx-auto px-6 md:px-12">

        <h2 class="text-h2 text-center mb-16 reveal">
          Challenge
        </h2>

        <div class="prose prose-lg mx-auto text-left md:text-center text-muted-foreground leading-relaxed reveal" style="transition-delay: 80ms">
          <p class="text-body-lg">
            The <span class="text-primary font-medium">relentless societal pressure to perform</span> leaves millions of Germans unable to find rest. Although sleep makes up a third of our lives and is essential for recovery, many suffer from sleep disorders – with <span class="text-primary font-medium">serious consequences</span> such as severe accidents and long-term health damage. This called for a <span class="text-primary font-medium">preventive, experiential solution</span> that bridges knowledge and emotion.
          </p>
        </div>

        <div class="mt-10 md:mt-12 reveal" style="transition-delay: 140ms">
          <img
            src="/images/projekte/schlaf-herausforderung-detail-placeholder.png"
            alt="Placeholder image below the Challenge text"
            class="w-full h-auto rounded-3xl border border-border bg-muted/40 shadow-sm object-contain" loading="lazy">
        </div>
      </div>
    </section>

    <script>
      // @ts-nocheck
      function initChallengeReveal() {
        const reveals = /** @type {NodeListOf<HTMLElement>} */ (document.querySelectorAll('#challenge .reveal'));
        reveals.forEach((el, i) => {
          el.style.opacity = '0';
          el.style.transform = 'translateY(30px)';
          el.style.transition = 'all 1s cubic-bezier(0.25, 0.1, 0.25, 1)';

          const observer = new IntersectionObserver((entries) => {
            if (!entries[0].isIntersecting) return;
            setTimeout(() => {
              el.style.opacity = '1';
              el.style.transform = 'translateY(0)';
            }, i * 140);
            observer.disconnect();
          }, { threshold: 0.12, rootMargin: '0px 0px -10% 0px' });

          observer.observe(el);
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initChallengeReveal, { once: true });
      } else {
        initChallengeReveal();
      }
    </script>

    <!-- === CONCEPT === -->
    <section id="concept" class="py-28 md:py-36 bg-background border-t border-border">
      <div class="max-w-5xl mx-auto px-6 md:px-12">

        <h2 class="text-h2 text-center mb-16 reveal">
          Concept
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <!-- 01 Horizontal Experience Layers -->
          <div class="bg-card border border-border rounded-3xl p-8 reveal">
            <div class="text-primary text-5xl font-semibold mb-4">01</div>
            <h3 class="text-h4 mb-3">Horizontal Experience Layers</h3>
            <p class="text-body text-muted-foreground">The exhibition follows a <span class="text-primary font-medium">clear horizontal zoning</span> from light to dark. Nine thematic zones guide visitors on an <span class="text-primary font-medium">intuitive journey</span> through the <span class="text-primary font-medium">depths of sleep</span> – from a gentle introduction to an uplifting farewell.</p>
          </div>

          <!-- 02 Multi-sensory Discovery Tour -->
          <div class="bg-card border border-border rounded-3xl p-8 reveal">
            <div class="text-primary text-5xl font-semibold mb-4">02</div>
            <h3 class="text-h4 mb-3">Multi-sensory Discovery Tour</h3>
            <p class="text-body text-muted-foreground">Knowledge from somnology, psychology, history, and medicine is woven together with interactive, <span class="text-primary font-medium">multi-sensory experiences</span>. Visitors <span class="text-primary font-medium">hear, feel, smell</span> and actively encounter sleep – not just theoretically, but in a <span class="text-primary font-medium">direct, embodied way</span>.</p>
          </div>

          <!-- 03 From Knowledge to Experience -->
          <div class="bg-card border border-border rounded-3xl p-8 reveal">
            <div class="text-primary text-5xl font-semibold mb-4">03</div>
            <h3 class="text-h4 mb-3">From Knowledge to Experience</h3>
            <p class="text-body text-muted-foreground">The visitor becomes <span class="text-primary font-medium">the protagonist</span>: analysing their own sleep, exploring historical sleep cultures, testing their inner clock, and diving into dream worlds. <span class="text-primary font-medium">Complex knowledge</span> becomes tangible and <span class="text-primary font-medium">personally relevant</span>.</p>
          </div>

          <!-- 04 Prevention through Entertainment -->
          <div class="bg-card border border-border rounded-3xl p-8 reveal">
            <div class="text-primary text-5xl font-semibold mb-4">04</div>
            <h3 class="text-h4 mb-3">Prevention through Entertainment</h3>
            <p class="text-body text-muted-foreground">The exhibition makes <span class="text-primary font-medium">sleep hygiene entertaining</span> and motivating. Every visitor leaves as an <span class="text-primary font-medium">expert on their own sleep</span> – equipped with <span class="text-primary font-medium">practical tools</span> and the desire to make daily life more sleep-friendly.</p>
          </div>
        </div>

        <div class="mt-8 md:mt-10 reveal">
          <img
            src="/images/projekte/schlaf-konzept-placeholder.png"
            alt="Placeholder image below the Concept section"
            class="w-full h-auto rounded-3xl border border-border bg-muted/40 shadow-sm object-contain" loading="lazy">
        </div>
      </div>
    </section>

    <script>
      // @ts-nocheck
      function initConceptReveal() {
        const reveals = /** @type {NodeListOf<HTMLElement>} */ (document.querySelectorAll('#concept .reveal'));
        reveals.forEach((el, i) => {
          el.style.opacity = '0';
          el.style.transform = 'translateY(30px)';
          el.style.transition = 'all 1s cubic-bezier(0.25, 0.1, 0.25, 1)';

          const observer = new IntersectionObserver((entries) => {
            if (!entries[0].isIntersecting) return;
            setTimeout(() => {
              el.style.opacity = '1';
              el.style.transform = 'translateY(0)';
            }, i * 140);
            observer.disconnect();
          }, { threshold: 0.12, rootMargin: '0px 0px -10% 0px' });

          observer.observe(el);
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initConceptReveal, { once: true });
      } else {
        initConceptReveal();
      }
    </script>

    <!-- === DESIGN & VISUALIZATION === -->
    <section id="final-design" class="py-32 md:py-44 bg-background border-t border-border">
      <div class="max-w-7xl mx-auto px-6 md:px-12">

        <h2 class="text-h2 text-center mb-16 reveal">
          Design & Visualization
        </h2>

        <p class="max-w-3xl mx-auto text-left md:text-center text-body-lg text-muted-foreground">
          The design transforms the <span class="text-primary font-medium">700 m² exhibition space</span> into an atmospherically warm and deeply calming environment. As visitors move further into the space, darkness gradually deepens – a leitmotif symbolising the journey into the <span class="text-primary font-medium">depths of sleep</span>. Each of the <span class="text-primary font-medium">nine zones</span> has its own distinctive staging: from the gentle "Good Night" introduction through the darkened maze of sleep disorders to the luminous "Good Morning" finale with light simulation and the scent of coffee and tea. The final renderings reveal the <span class="text-primary font-medium">immersive power of the exhibition</span>: flowing forms, interactive exhibits such as oversized nightcaps, the transparent human figure, and the great balance of sleep hygiene.
        </p>

        <div class="mt-10 md:mt-12 space-y-10 md:space-y-12">
          <figure class="reveal" style="transition-delay: 80ms">
            <img
              src="/images/projekte/schlaf-herausforderung-placeholder.png"
              alt="Placeholder image – Design and Visualization"
              class="w-full h-auto rounded-3xl border border-border bg-muted/40 shadow-sm object-contain" loading="lazy">
            <figcaption class="mt-3 text-sm md:text-base text-muted-foreground text-center">
              I. Time to Dive In – Good Night
            </figcaption>
          </figure>

          <figure class="reveal" style="transition-delay: 120ms">
            <img src="/images/projekte/schlaf-entwurf-01.png" alt="Design and Visualization 01" class="w-full h-auto rounded-3xl border border-border bg-muted/40 shadow-sm object-contain" loading="lazy">
            <figcaption class="mt-3 text-sm md:text-base text-muted-foreground text-center">II. How Do You Sleep?</figcaption>
          </figure>

          <figure class="reveal" style="transition-delay: 160ms">
            <img src="/images/projekte/schlaf-entwurf-02.png" alt="Design and Visualization 02" class="w-full h-auto rounded-3xl border border-border bg-muted/40 shadow-sm object-contain" loading="lazy">
            <figcaption class="mt-3 text-sm md:text-base text-muted-foreground text-center">III. On the Trail of Sleep</figcaption>
          </figure>

          <figure class="reveal" style="transition-delay: 200ms">
            <img src="/images/projekte/schlaf-entwurf-03.png" alt="Design and Visualization 03" class="w-full h-auto rounded-3xl border border-border bg-muted/40 shadow-sm object-contain" loading="lazy">
            <figcaption class="mt-3 text-sm md:text-base text-muted-foreground text-center">IV. How (and Why) Do We Sleep?</figcaption>
          </figure>

          <figure class="reveal" style="transition-delay: 240ms">
            <img src="/images/projekte/schlaf-entwurf-04.png" alt="Design and Visualization 04" class="w-full h-auto rounded-3xl border border-border bg-muted/40 shadow-sm object-contain" loading="lazy">
            <figcaption class="mt-3 text-sm md:text-base text-muted-foreground text-center">V. What Makes You Tick?</figcaption>
          </figure>

          <figure class="reveal" style="transition-delay: 280ms">
            <img src="/images/projekte/schlaf-entwurf-05.png" alt="Design and Visualization 05" class="w-full h-auto rounded-3xl border border-border bg-muted/40 shadow-sm object-contain" loading="lazy">
            <figcaption class="mt-3 text-sm md:text-base text-muted-foreground text-center">VI. [D]REAM 01</figcaption>
          </figure>

          <figure class="reveal" style="transition-delay: 320ms">
            <img src="/images/projekte/schlaf-entwurf-06.png" alt="Design and Visualization 06" class="w-full h-auto rounded-3xl border border-border bg-muted/40 shadow-sm object-contain" loading="lazy">
            <figcaption class="mt-3 text-sm md:text-base text-muted-foreground text-center">VI. [D]REAM 02</figcaption>
          </figure>

          <figure class="reveal" style="transition-delay: 360ms">
            <img src="/images/projekte/schlaf-entwurf-07.png" alt="Design and Visualization 07" class="w-full h-auto rounded-3xl border border-border bg-muted/40 shadow-sm object-contain" loading="lazy">
            <figcaption class="mt-3 text-sm md:text-base text-muted-foreground text-center">VII. Lost Paths 01</figcaption>
          </figure>

          <figure class="reveal" style="transition-delay: 400ms">
            <img src="/images/projekte/schlaf-entwurf-08.png" alt="Design and Visualization 08" class="w-full h-auto rounded-3xl border border-border bg-muted/40 shadow-sm object-contain" loading="lazy">
            <figcaption class="mt-3 text-sm md:text-base text-muted-foreground text-center">VII. Lost Paths 02</figcaption>
          </figure>

          <figure class="reveal" style="transition-delay: 440ms">
            <img src="/images/projekte/schlaf-entwurf-09.png" alt="Design and Visualization 09" class="w-full h-auto rounded-3xl border border-border bg-muted/40 shadow-sm object-contain" loading="lazy">
            <figcaption class="mt-3 text-sm md:text-base text-muted-foreground text-center">VIII. The Balance of Sleep Hygiene</figcaption>
          </figure>

          <figure class="reveal" style="transition-delay: 480ms">
            <img src="/images/projekte/schlaf-entwurf-10.png" alt="Design and Visualization 10" class="w-full h-auto rounded-3xl border border-border bg-muted/40 shadow-sm object-contain" loading="lazy">
            <figcaption class="mt-3 text-sm md:text-base text-muted-foreground text-center">IX. Good Morning – Time to Surface</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <script>
      // @ts-nocheck
      function initFinalReveal() {
        const reveals = /** @type {NodeListOf<HTMLElement>} */ (document.querySelectorAll('#final-design .reveal'));
        reveals.forEach((el, i) => {
          el.style.opacity = '0';
          el.style.transform = 'translateY(30px)';
          el.style.transition = 'all 1s cubic-bezier(0.25, 0.1, 0.25, 1)';

          const observer = new IntersectionObserver((entries) => {
            if (!entries[0].isIntersecting) return;
            setTimeout(() => {
              el.style.opacity = '1';
              el.style.transform = 'translateY(0)';
            }, i * 140);
            observer.disconnect();
          }, { threshold: 0.12, rootMargin: '0px 0px -10% 0px' });

          observer.observe(el);
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initFinalReveal, { once: true });
      } else {
        initFinalReveal();
      }
    </script>

    <!-- === RESULTS & INSIGHTS === -->
    <section id="results" class="py-28 md:py-36 bg-background border-t border-border">
      <div class="max-w-5xl mx-auto px-6 md:px-12">
        <h2 class="text-h2 text-center mb-16 reveal">
          Results & Insights
        </h2>

        <div class="max-w-3xl mx-auto text-left md:text-center text-body-lg text-muted-foreground mb-20 reveal" style="transition-delay: 80ms">
          From a societal problem that left millions of Germans unable to find rest, an <span class="text-primary font-medium">inspiring, multi-sensory immersive exhibition</span> was born – a place that finally makes <span class="text-primary font-medium">sleep tangible</span> and motivates people toward a healthier life.
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 reveal" style="transition-delay: 160ms">
          <div class="bg-card border border-border rounded-3xl p-8">
            <div class="text-primary text-5xl font-semibold mb-4">01</div>
            <h3 class="text-h4 mb-3">A Vibrant New Gathering Place</h3>
            <p class="text-body text-muted-foreground">The exhibition creates a place where people of all ages and backgrounds come together to talk about sleep – a social space that <span class="text-primary font-medium">reduces isolation</span> and <span class="text-primary font-medium">raises awareness</span>.</p>
          </div>

          <div class="bg-card border border-border rounded-3xl p-8">
            <div class="text-primary text-5xl font-semibold mb-4">02</div>
            <h3 class="text-h4 mb-3">Respectful Transformation</h3>
            <p class="text-body text-muted-foreground">What began as pure information-sharing became an emotional journey of experiences. The historic fabric of the building is used sensitively and combined with contemporary design – a <span class="text-primary font-medium">successful dialogue</span> between <span class="text-primary font-medium">past and present</span>.</p>
          </div>

          <div class="bg-card border border-border rounded-3xl p-8">
            <div class="text-primary text-5xl font-semibold mb-4">03</div>
            <h3 class="text-h4 mb-3">Lasting Value</h3>
            <p class="text-body text-muted-foreground">Visitors leave not only informed, but <span class="text-primary font-medium">changed</span>. They take with them practical tools, new routines, and a deeper understanding of their own sleep – a meaningful contribution to <span class="text-primary font-medium">societal health prevention</span>.</p>
          </div>
        </div>

        <div class="mt-12 md:mt-16 reveal" style="transition-delay: 240ms">
          <img
            src="/images/projekte/schlaf-ergebnisse-placeholder.png"
            alt="Placeholder image before the closing statement in Results & Insights"
            class="w-full h-auto rounded-3xl border border-border bg-muted/40 shadow-sm object-contain" loading="lazy">
        </div>

        <p class="text-left md:text-center text-lg text-muted-foreground mt-16 max-w-2xl mx-auto reveal" style="transition-delay: 320ms">
          The exhibition "Schlaf" proves: with <span class="text-primary font-medium">sensitive interior architecture</span>, a societal problem can become an <span class="text-primary font-medium">inspiring, vibrant place</span> – one that not only conveys knowledge, but <span class="text-primary font-medium">strengthens community</span> and motivates people toward a healthier life.
        </p>

        <!-- Back Button -->
        <div class="flex justify-center mt-12">
          <Button href="/en/projects" variant="primary" size="lg" class="w-full sm:w-auto">Back to all Projects →</Button>
        </div>

        <!-- Project Navigation -->
        <div class="mt-14 md:mt-20 pt-8 md:pt-12 border-t border-border flex flex-col md:flex-row gap-4 md:gap-6 justify-between">
          <Button href="/en/projects/festsaal-im-klostergasthof" variant="primary" size="lg" class="w-full md:w-auto">← Previous Project</Button>
          <Button href="/en/projects/weserkoje" variant="primary" size="lg" class="w-full md:w-auto">Next Project →</Button>
        </div>
      </div>
    </section>

    <script>
      // @ts-nocheck
      function initResultsReveal() {
        const reveals = /** @type {NodeListOf<HTMLElement>} */ (document.querySelectorAll('#results .reveal'));
        reveals.forEach((el, i) => {
          el.style.opacity = '0';
          el.style.transform = 'translateY(30px)';
          el.style.transition = 'all 1s cubic-bezier(0.25, 0.1, 0.25, 1)';

          const observer = new IntersectionObserver((entries) => {
            if (!entries[0].isIntersecting) return;
            setTimeout(() => {
              el.style.opacity = '1';
              el.style.transform = 'translateY(0)';
            }, i * 140);
            observer.disconnect();
          }, { threshold: 0.12, rootMargin: '0px 0px -10% 0px' });

          observer.observe(el);
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initResultsReveal, { once: true });
      } else {
        initResultsReveal();
      }
    </script>

    <script>
      // @ts-nocheck
      function animateCounter(id, target, duration = 1600) {
        const counter = document.getElementById(id);
        if (!(counter instanceof HTMLElement)) return;
        const startTime = performance.now();

        function update(now) {
          const progress = Math.min((now - startTime) / duration, 1);
          counter.textContent = String(Math.floor(progress * target));
          if (progress < 1) requestAnimationFrame(update);
        }

        requestAnimationFrame(update);
      }

      function initSequentialReveals() {
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const groups = /** @type {NodeListOf<HTMLElement>} */ (document.querySelectorAll('[data-reveal-group]'));

        groups.forEach((group) => {
          const items = /** @type {NodeListOf<HTMLElement>} */ (group.querySelectorAll('.reveal-item'));
          if (!items.length) return;

          if (reduceMotion) {
            items.forEach((item) => {
              item.style.opacity = '1';
              item.style.transform = 'none';
            });
            return;
          }

          items.forEach((item) => {
            item.style.opacity = '0';
            item.style.transform = 'translateY(28px)';
            item.style.transition = 'all 1s cubic-bezier(0.25, 0.1, 0.25, 1)';
            item.style.willChange = 'opacity, transform';
          });

          const observer = new IntersectionObserver((entries) => {
            if (!entries[0].isIntersecting) return;

            items.forEach((item, index) => {
              setTimeout(() => {
                item.style.opacity = '1';
                item.style.transform = 'translateY(0)';
              }, index * 160);
            });
            group.dataset.revealed = 'true';

            observer.disconnect();
          }, { threshold: 0.2, rootMargin: '0px 0px -8% 0px' });

          observer.observe(group);
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initSequentialReveals, { once: true });
      } else {
        initSequentialReveals();
      }
    </script>

  </div>

</Layout>
