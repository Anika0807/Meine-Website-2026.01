<Layout title="Imprint – Anika Warncke">
  <div class="container mx-auto max-w-3xl px-6 pt-36 md:pt-44 pb-20">
    <h1 class="text-h2 md:text-h1 mb-12">Imprint</h1>
    <p class="text-muted-foreground mb-10">
      I value a transparent and reliable presence. That's why you'll find all legally required information about this website here.
    </p>
    <div class="text-body leading-relaxed space-y-10">
      <div class="space-y-3">
        <p><strong>Imprint</strong></p>
        <p>Anika Warncke<br>
        Wallstraße 12<br>
        21335 Lüneburg</p>
      </div>
      <div class="space-y-3">
        <p><strong>Contact</strong><br>
