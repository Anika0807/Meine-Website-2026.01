---
import Button from '@/components/ui/astro-button.astro';
import Layout from '@/layouts/Layout.astro';
import { Image } from 'astro:assets';
import anikaPortrait from '@/assets/anika-portrait.jpg';
---

<Layout title="About Me – Anika Warncke">
  <!-- === HERO "ABOUT ME" === -->
  <section class="py-20 md:py-32 bg-background">
    <div class="max-w-6xl mx-auto px-6 text-center">
      <!-- Portrait -->
      <Image
        src={anikaPortrait}
        alt="Anika Warncke – Interior Architecture M.A. & UX/UI Designer"
        width={640}
        height={640}
        quality={95}
        format="webp"
        fit="cover"
        position="center"
        class="mx-auto w-80 h-80 rounded-full object-cover object-center shadow-2xl mb-8 md:mb-14"
      />

      <h1 class="text-5xl font-semibold tracking-tight mb-6">About Me</h1>

      <!-- Subheadline -->
      <p class="text-2xl text-primary font-medium mb-8">
        Interior Architecture M.A. & UX/UI Designer
      </p>

      <!-- Intro copy -->
      <p class="text-xl text-muted-foreground leading-relaxed max-w-3xl mx-auto">
        Hi, I'm <span class="text-primary font-semibold">Anika Warncke</span>. I design thoughtful spaces and digital experiences,
        <span class="text-primary font-semibold">always human-centered by design</span>.
        Whether physical or digital, I guide every project from the first idea to final delivery with a clear concept and consistent direction.
      </p>

      <!-- Buttons -->
      <div class="flex flex-wrap gap-4 justify-center mt-14">
        <Button href="/en/contact" variant="primary" size="lg" class="w-full sm:w-auto sm:min-w-[230px]">
          Let's talk
        </Button>
        <Button href="#designprozess" variant="outline" size="lg" class="w-full sm:w-auto sm:min-w-[230px]">
          My design process
        </Button>
      </div>
    </div>
  </section>

  <!-- === WHO I AM (text left, image right) === -->
  <section class="py-28 bg-background">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid md:grid-cols-12 gap-12 items-stretch">
        <!-- Text links -->
        <div class="md:col-span-8 order-2 md:order-1 flex flex-col justify-start h-full">
          <h2 class="text-4xl font-semibold tracking-tight mb-10 text-left">Who I Am</h2>
          <div class="text-left text-lg leading-relaxed text-muted-foreground">
            <p class="mb-8">
              My passion lies in <span class="text-primary font-semibold">concept development, design, and problem-solving</span>.
              Whether in physical spaces as an <span class="text-primary font-semibold">Interior Architect (M.A.)</span> or in digital products as a <span class="text-primary font-semibold">UX/UI designer</span>,
              I immerse myself deeply in every project.
            </p>
            <p class="mb-8">
              I am especially inspired by <span class="text-primary font-semibold">experiential exhibitions, hospitality, hotel, and healthcare projects</span>,
              as well as <span class="text-primary font-semibold">bespoke retail concepts</span> in interior architecture.
              In UX/UI design, I focus on <span class="text-primary font-semibold">mobile apps with social or health impact</span> and seamless user experiences
              that support well-being and create meaningful engagement.
            </p>
            <p>
              <span class="text-primary font-semibold">People are always at the center</span>, whether the context is physical or digital.
              I guide each project with a <span class="text-primary font-semibold">clear thread from the first idea to final implementation</span>.
            </p>
          </div>
        </div>
        <!-- Image right on desktop, top on mobile -->
        <div class="md:col-span-4 order-1 md:order-2 flex flex-col h-full">
          <div class="flex-1 flex">
            <img src="/images/anika-work.jpg" 
                 alt="Anika at work" 
                 class="w-full h-full rounded-3xl shadow-lg object-cover object-top mb-8 md:mb-0" loading="lazy">
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- === WHY PHYSICAL & DIGITAL ARE CONNECTED FOR ME === -->
  <section class="py-28 bg-background">
    <div class="max-w-6xl mx-auto px-6">
      <h2 class="text-4xl font-semibold tracking-tight mb-16 text-left">
        Physical or digital: both worlds speak the same language in my work
      </h2>

      <div class="grid md:grid-cols-3 gap-10">

        <!-- Interior Architecture -->
        <div class="bg-card border border-border rounded-3xl p-10 hover:shadow-xl transition-all group">
          <div class="w-16 h-16 bg-primary/10 text-primary rounded-2xl flex items-center justify-center mb-8 group-hover:scale-110 transition-transform">
            <!-- House icon -->
            <svg xmlns="http://www.w3.org/2000/svg" class="w-9 h-9" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10.5l9-7 9 7" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.25 9.75V20.25H18.75V9.75" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.5 20.25V14.25H13.5V20.25" />
            </svg>
          </div>
          <h3 class="text-2xl font-semibold mb-6">Interior Architecture</h3>
          <p class="text-muted-foreground">From the first conversation to final delivery, I design spaces that function perfectly and make people feel at ease.</p>
        </div>

        <!-- Core message -->
        <div class="bg-primary text-white border border-primary rounded-3xl p-10 flex flex-col justify-center items-start text-left">
          <h3 class="text-2xl font-semibold mb-6 text-white">Shared principles</h3>
          <ul class="space-y-4 text-sm w-full">
            <li class="flex items-start gap-3">
              <span class="shrink-0">•</span>
              <span>Human-centered</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="shrink-0">•</span>
              <span>Strategic and emotional</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="shrink-0">•</span>
              <span class="font-semibold">A clear thread from first idea to final implementation</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="shrink-0">•</span>
              <span>Carefully crafted down to the last detail</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="shrink-0">•</span>
              <span>Design as a shared language</span>
            </li>
          </ul>
        </div>

        <!-- UX/UI Design -->
        <div class="bg-card border border-border rounded-3xl p-10 hover:shadow-xl transition-all group">
          <div class="w-16 h-16 bg-primary/10 text-primary rounded-2xl flex items-center justify-center mb-8 group-hover:scale-110 transition-transform">
            <!-- Smartphone icon -->
            <svg xmlns="http://www.w3.org/2000/svg" class="w-9 h-9" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" />
            </svg>
          </div>
          <h3 class="text-2xl font-semibold mb-6">UX/UI Design</h3>
          <p class="text-muted-foreground">From first contact to a fully integrated product, I create digital experiences that feel intuitive, self-explanatory, and emotionally resonant.</p>
        </div>

      </div>
    </div>
  </section>

  <!-- === MY DESIGN PROCESS - SOFTER GREEN VARIANT (Design system aligned) === -->
  <section id="designprozess" class="py-28 bg-background">
    <div class="max-w-6xl mx-auto px-6">
      <h2 class="text-4xl font-semibold tracking-tight mb-16 text-center">
        My design process - a clear path from concept to implementation
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-12">

        <!-- Step 1 -->
        <div class="bg-card border border-border rounded-3xl p-12 hover:shadow-xl transition-all">
          <div class="w-12 h-12 bg-primary text-white rounded-full flex items-center justify-center text-2xl font-semibold mb-6">1</div>
          <h3 class="text-xl font-semibold mb-4">Listen &amp; Understand</h3>
          <p class="text-muted-foreground">I listen, ask the right questions, and understand the context of your project.</p>
          <p class="text-sm text-primary font-medium mt-8">It starts here - always human-centered by design.</p>
        </div>

        <!-- Step 2 -->
        <div class="bg-emerald-50 border border-emerald-100 rounded-3xl p-12 hover:shadow-xl transition-all">
          <div class="w-12 h-12 bg-primary text-white rounded-full flex items-center justify-center text-2xl font-semibold mb-6">2</div>
          <h3 class="text-xl font-semibold mb-4">Strategy &amp; Concept</h3>
          <p class="text-muted-foreground">Together, we shape a clear strategy and define concrete goals.</p>
          <p class="text-sm text-primary font-medium mt-8">The direction becomes clear - in both physical and digital contexts.</p>
        </div>

        <!-- Step 3 -->
        <div class="bg-card border border-border rounded-3xl p-12 hover:shadow-xl transition-all">
          <div class="w-12 h-12 bg-primary text-white rounded-full flex items-center justify-center text-2xl font-semibold mb-6">3</div>
          <h3 class="text-xl font-semibold mb-4">Ideas &amp; Sketches</h3>
          <p class="text-muted-foreground">Moodboards, hand sketches, and first concepts come to life.</p>
          <p class="text-sm text-primary font-medium mt-8">The concept takes shape - in spaces and interfaces alike.</p>
        </div>

        <!-- Step 4 -->
        <div class="bg-emerald-50 border border-emerald-100 rounded-3xl p-12 hover:shadow-xl transition-all">
          <div class="w-12 h-12 bg-primary text-white rounded-full flex items-center justify-center text-2xl font-semibold mb-6">4</div>
          <h3 class="text-xl font-semibold mb-4">Design &amp; Prototyping</h3>
          <p class="text-muted-foreground">Detailed designs, 3D models, or interactive prototypes.</p>
          <p class="text-sm text-primary font-medium mt-8">The concept becomes tangible - and always testable.</p>
        </div>

        <!-- Step 5 -->
        <div class="bg-card border border-border rounded-3xl p-12 hover:shadow-xl transition-all">
          <div class="w-12 h-12 bg-primary text-white rounded-full flex items-center justify-center text-2xl font-semibold mb-6">5</div>
          <h3 class="text-xl font-semibold mb-4">Execution</h3>
          <p class="text-muted-foreground">Coordination with craftspeople or developers through to final delivery.</p>
          <p class="text-sm text-primary font-medium mt-8">The concept becomes reality - in both worlds.</p>
        </div>

        <!-- Step 6 -->
        <div class="bg-emerald-50 border border-emerald-100 rounded-3xl p-12 hover:shadow-xl transition-all">
          <div class="w-12 h-12 bg-primary text-white rounded-full flex items-center justify-center text-2xl font-semibold mb-6">6</div>
          <h3 class="text-xl font-semibold mb-4">Aftercare &amp; Refinement</h3>
          <p class="text-muted-foreground">Feedback rounds, long-term support, and final refinements.</p>
          <p class="text-sm text-primary font-medium mt-8">The quality remains - even after launch and handover.</p>
        </div>

      </div>
    </div>
  </section>

  <!-- === SKILLS & TOOLS – FINAL 10/10 (Highlights + Primary Green) === -->
  <section class="py-28 bg-background">
    <div class="max-w-6xl mx-auto px-6">
      <h2 class="text-4xl font-semibold tracking-tight mb-16 text-center">Skills &amp; Tools</h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-12">

        <!-- Design & Planning (white) -->
        <div class="bg-card border border-border rounded-3xl p-12 hover:shadow-xl transition-all">
          <div class="w-12 h-12 bg-primary/10 text-primary rounded-2xl flex items-center justify-center mb-8">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.4">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 3.487a2.25 2.25 0 113.182 3.182L8.25 18.463 4.5 19.5l1.037-3.75L16.862 3.487z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M14.25 6.75l3 3" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold mb-6">Design &amp; Planning</h3>
          <ul class="space-y-3 text-sm text-muted-foreground">
            <li>✓ <span class="text-primary font-medium">Concept development &amp; moodboards</span></li>
            <li>✓ Technical drawings &amp; planning</li>
            <li>✓ Detail and execution planning</li>
            <li>✓ <span class="text-primary font-medium">UX/UI &amp; product design</span></li>
            <li>✓ Design systems &amp; documentation</li>
            <li>✓ Information architecture &amp; wireframing</li>
          </ul>
        </div>

        <!-- Tools & Software (white) -->
        <div class="bg-card border border-border rounded-3xl p-12 hover:shadow-xl transition-all">
          <div class="w-12 h-12 bg-primary/10 text-primary rounded-2xl flex items-center justify-center mb-8">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.4">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 6.75V5.25A2.25 2.25 0 0111.25 3h1.5A2.25 2.25 0 0115 5.25v1.5" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 8.25h16.5v9A2.25 2.25 0 0118 19.5H6A2.25 2.25 0 013.75 17.25v-9z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 12h16.5" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold mb-6">Tools &amp; Platforms</h3>
          <ul class="space-y-3 text-sm text-muted-foreground">
            <li>✓ <span class="text-primary font-medium">Vectorworks (2D/3D)</span></li>
            <li>✓ AutoCAD &amp; Cinema 4D</li>
            <li>✓ Adobe Creative Suite</li>
            <li>✓ <span class="text-primary font-medium">Figma &amp; FigJam</span></li>
            <li>✓ <span class="text-primary font-medium">Astro &amp; Tailwind CSS</span></li>
            <li>✓ Notion &amp; project management workflows</li>
          </ul>
        </div>

        <!-- Methods & Realization (white) -->
        <div class="bg-card border border-border rounded-3xl p-12 hover:shadow-xl transition-all">
          <div class="w-12 h-12 bg-primary/10 text-primary rounded-2xl flex items-center justify-center mb-8">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.4">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 4.5h6M9 8.25h6M6.75 3h10.5A2.25 2.25 0 0119.5 5.25v13.5A2.25 2.25 0 0117.25 21H6.75A2.25 2.25 0 014.5 18.75V5.25A2.25 2.25 0 016.75 3z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 12h7.5M8.25 15.75h5.25" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold mb-6">Methods &amp; Delivery</h3>
          <ul class="space-y-3 text-sm text-muted-foreground">
            <li>✓ <span class="text-primary font-medium">HOAI Leistungsphasen 1-9</span></li>
            <li>✓ Coordination of trades &amp; specialist consultants</li>
            <li>✓ Site supervision &amp; design quality control</li>
            <li>✓ <span class="text-primary font-medium">User research &amp; usability testing</span></li>
            <li>✓ Rapid prototyping (digital &amp; analog)</li>
            <li>✓ Iterative review cycles &amp; agile workflows</li>
          </ul>
        </div>

        <!-- Expertise & Values (primary green + white text) -->
        <div class="bg-primary text-white border border-primary rounded-3xl p-12 hover:shadow-xl transition-all">
          <div class="w-12 h-12 bg-white/20 text-white rounded-2xl flex items-center justify-center mb-8">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.4">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 3l7.5 3v6c0 4.5-3.2 7.9-7.5 9-4.3-1.1-7.5-4.5-7.5-9V6L12 3z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75l2 2 4-4" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold mb-6">Expertise &amp; Values</h3>
          <ul class="space-y-3 text-sm text-white/90">
            <li>✓ <span class="font-semibold text-white">Accessibility (DIN 18040 &amp; WCAG 2.2)</span></li>
            <li>✓ <span class="font-semibold text-white">Human-centered design</span></li>
            <li>✓ Sustainability &amp; material expertise</li>
            <li>✓ <span class="font-semibold text-white">Creativity &amp; strategic thinking</span></li>
            <li>✓ <span class="font-semibold text-white">Reliability &amp; solution-oriented mindset</span></li>
            <li>✓ Transparency &amp; close collaboration</li>
            <li>✓ Presentation &amp; stakeholder management</li>
            <li>✓ Remote &amp; hybrid collaboration</li>
          </ul>
        </div>

      </div>
    </div>
  </section>

  <!-- === INTERIOR ARCHITECTURE & UX/UI DESIGN === -->
  <section class="py-28 bg-background">
    <div class="max-w-6xl mx-auto px-6">
      <h2 class="text-4xl font-semibold tracking-tight mb-16 text-left">Interior Architecture &amp; UX/UI Design</h2>

      <div class="mb-16">
        <p class="text-xl text-muted-foreground">
          I love both worlds and bring the same level of passion to each.
          Whether physical space or digital experience: <span class="text-primary font-semibold">people always come first.</span>
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-12">

        <!-- Interior Architecture -->
        <div class="group bg-card border border-border rounded-3xl overflow-hidden hover:shadow-xl transition-all">
          <img src="/images/innenarchitektur-mood.jpg"
               alt="Interior architecture - inviting space with people"
               class="w-full h-64 object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy">
          <div class="p-10">
            <h3 class="text-2xl font-semibold mb-6">Interior Architecture</h3>
            <p class="text-muted-foreground mb-8">From the first idea to final implementation, I design spaces that move people.</p>
            <ul class="space-y-3 text-sm">
              <li class="flex items-start gap-3">✓ <span class="text-primary font-semibold">Spatial planning &amp; concept design</span></li>
              <li class="flex items-start gap-3">✓ <span class="text-primary font-semibold">Furniture &amp; lighting design</span></li>
              <li class="flex items-start gap-3">✓ <span class="text-primary font-semibold">Project leadership through completion</span></li>
            </ul>
          </div>
        </div>

        <!-- UX/UI Design -->
        <div class="group bg-card border border-border rounded-3xl overflow-hidden hover:shadow-xl transition-all">
          <img src="/images/ux-ui-mood.jpg"
               alt="UX/UI design - intuitive digital experiences"
               class="w-full h-64 object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy">
          <div class="p-10">
            <h3 class="text-2xl font-semibold mb-6">UX/UI Design</h3>
            <p class="text-muted-foreground mb-8">I design digital products that feel intuitive and emotionally engaging.</p>
            <ul class="space-y-3 text-sm">
              <li class="flex items-start gap-3">✓ <span class="text-primary font-semibold">User Research &amp; Wireframing</span></li>
              <li class="flex items-start gap-3">✓ <span class="text-primary font-semibold">Interactive prototypes</span></li>
              <li class="flex items-start gap-3">✓ <span class="text-primary font-semibold">Design systems &amp; micro-interactions</span></li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- === FAQ - 6 QUESTIONS === -->
  <section class="py-28 bg-background">
    <div class="max-w-6xl mx-auto px-6">
      <h2 class="text-4xl font-semibold tracking-tight mb-16 text-left">Frequently Asked Questions</h2>

      <div class="space-y-6">

        <!-- 1. Remote -->
        <details class="group bg-card rounded-3xl p-8 shadow-sm hover:shadow-xl transition-all">
          <summary class="flex items-center justify-between text-lg font-medium cursor-pointer list-none">
            Do you work remotely?
            <span class="text-primary text-2xl group-open:rotate-180 transition-transform">↓</span>
          </summary>
          <p class="text-muted-foreground mt-6 leading-relaxed">
            Yes, I work <span class="text-primary font-semibold">fully remote</span> and hybrid. I am flexible and, on request, can also be on-site in Lueneburg or Hamburg.
          </p>
        </details>

        <!-- 2. Projektdauer -->
        <details class="group bg-card rounded-3xl p-8 shadow-sm hover:shadow-xl transition-all">
          <summary class="flex items-center justify-between text-lg font-medium cursor-pointer list-none">
            How long does a project take?
            <span class="text-primary text-2xl group-open:rotate-180 transition-transform">↓</span>
          </summary>
          <p class="text-muted-foreground mt-6 leading-relaxed">
            It depends on the <span class="text-primary font-semibold">scope of your request</span>: from a website relaunch or a new UX/UI app to interior architecture consulting or a complete renovation from first briefing to final delivery, including support across service phases 1-9. I always provide a <span class="text-primary font-semibold">clear timeline</span> from the very beginning.
          </p>
        </details>

        <!-- 3. Teilzeit / Festanstellung -->
        <details class="group bg-card rounded-3xl p-8 shadow-sm hover:shadow-xl transition-all">
          <summary class="flex items-center justify-between text-lg font-medium cursor-pointer list-none">
            Do you also work part-time or in permanent roles?
            <span class="text-primary text-2xl group-open:rotate-180 transition-transform">↓</span>
          </summary>
          <p class="text-muted-foreground mt-6 leading-relaxed">
            Yes, both are possible. I am open to <span class="text-primary font-semibold">part-time roles, permanent positions, and freelance projects</span>. Let's discuss what fits your needs best.
          </p>
        </details>

        <!-- 4. Zusammenarbeit -->
        <details class="group bg-card rounded-3xl p-8 shadow-sm hover:shadow-xl transition-all">
          <summary class="flex items-center justify-between text-lg font-medium cursor-pointer list-none">
            How does collaboration work?
            <span class="text-primary text-2xl group-open:rotate-180 transition-transform">↓</span>
          </summary>
          <p class="text-muted-foreground mt-6 leading-relaxed">
            Every collaboration starts with a short initial call. From there, we shape a clear concept together, with regular updates, and I remain personally available throughout. <span class="text-primary font-semibold">Transparency and close alignment</span> are very important to me.
          </p>
        </details>

        <!-- 5. Hospitality / Hotels / Health Care -->
        <details class="group bg-card rounded-3xl p-8 shadow-sm hover:shadow-xl transition-all">
          <summary class="flex items-center justify-between text-lg font-medium cursor-pointer list-none">
            Do you also offer projects in hospitality, hotel, or health care sectors?
            <span class="text-primary text-2xl group-open:rotate-180 transition-transform">↓</span>
          </summary>
          <p class="text-muted-foreground mt-6 leading-relaxed">
            Yes. These are some of my <span class="text-primary font-semibold">core sectors</span>. I already have experience with restaurants, cafes, hotels, yoga studios, and healthcare projects in interior architecture, as well as pilot projects in UX/UI.
          </p>
        </details>

        <!-- 6. Workshops / Consulting -->
        <details class="group bg-card rounded-3xl p-8 shadow-sm hover:shadow-xl transition-all">
          <summary class="flex items-center justify-between text-lg font-medium cursor-pointer list-none">
            Do you also offer workshops or consulting?
            <span class="text-primary text-2xl group-open:rotate-180 transition-transform">↓</span>
          </summary>
          <p class="text-muted-foreground mt-6 leading-relaxed">
