---
import Layout from '@/layouts/Layout.astro';
---

<Layout title="Projects">
  <section class="py-20 md:py-32 bg-background">
    <div class="w-full px-6">

      <!-- FEATURED PROJECTS – full-bleed sticky stack -->
      <div class="mb-40">
        <div class="relative z-50 bg-background pb-6">
          <h2 class="text-h2 mb-12 text-center">Selected Projects</h2>
        </div>

        <div class="w-screen relative left-1/2 right-1/2 -mx-[50vw]">
          <!-- 1. My Mind Studio -->
          <a href="/en/projects/my-mind-studio" class="block project-card group relative overflow-hidden h-[88svh] sm:h-[92svh] md:h-screen w-full sticky top-0 z-10 md:cursor-none cursor-pointer focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-primary/40" aria-label="View project My Mind Studio">
            <img src="/images/my-mind-studio.jpg" alt="My Mind Studio" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" loading="lazy" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/50 to-transparent md:from-black/65"></div>
            <div class="absolute inset-0 flex flex-col items-center justify-center text-center text-white px-6">
              <p class="text-base md:text-lg font-semibold tracking-[0.16em] uppercase text-white/95 mb-3">Interior Architecture</p>
              <h3 class="text-[2.9rem] md:text-[4.1rem] font-semibold tracking-tight leading-[0.92] text-white">My Mind Studio</h3>
              <p class="text-lg md:text-xl mt-4 opacity-90 max-w-[32ch] md:max-w-[34ch] mx-auto">A retreat for meditation, yoga, and mindful connection</p>
            </div>
          </a>

          <!-- 2. NaturKompass -->
          <a href="/en/projects/naturkompass" class="block project-card group relative overflow-hidden h-[88svh] sm:h-[92svh] md:h-screen w-full sticky top-0 z-20 mt-[-3svh] md:mt-0 md:cursor-none cursor-pointer focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-primary/40" aria-label="View project NaturKompass">
            <img src="/images/naturkompass.jpg" alt="NaturKompass" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" loading="lazy" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/50 to-transparent md:from-black/65"></div>
            <div class="absolute inset-0 flex flex-col items-center justify-center text-center text-white px-6">
              <p class="text-base md:text-lg font-semibold tracking-[0.16em] uppercase text-white/95 mb-3">UX/UI Design</p>
              <h3 class="text-[2.9rem] md:text-[4.1rem] font-semibold tracking-tight leading-[0.92] text-white">NaturKompass</h3>
              <p class="text-lg md:text-xl mt-4 opacity-90 max-w-[32ch] md:max-w-[34ch] mx-auto">Mobile app for intuitive flora and fauna identification</p>
            </div>
          </a>

          <!-- 3. Festsaal im Klostergasthof -->
          <a href="/en/projects/festsaal-im-klostergasthof" class="block project-card group relative overflow-hidden h-[88svh] sm:h-[92svh] md:h-screen w-full sticky top-0 z-30 mt-[-3svh] md:mt-0 md:cursor-none cursor-pointer focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-primary/40" aria-label="View project Banquet Hall at the Monastery Inn">
            <img src="/images/festsaal.jpg" alt="Festsaal im Klostergasthof" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" loading="lazy" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/50 to-transparent md:from-black/65"></div>
            <div class="absolute inset-0 flex flex-col items-center justify-center text-center text-white px-6">
              <p class="text-base md:text-lg font-semibold tracking-[0.16em] uppercase text-white/95 mb-3">Interior Architecture</p>
              <h3 class="text-[2.6rem] md:text-[3.1rem] lg:text-h3 md:max-w-[18ch] lg:max-w-none mx-auto font-semibold tracking-tight leading-[0.92] text-white">Banquet Hall at the Monastery Inn</h3>
              <p class="text-lg md:text-xl mt-4 opacity-90 max-w-[32ch] md:max-w-[34ch] mx-auto">Historic banquet hall for weddings, celebrations, and special events</p>
            </div>
          </a>

          <!-- 4. FlavorFusion -->
          <a href="/en/projects/flavorfusion" class="block project-card group relative overflow-hidden h-[100svh] md:h-screen w-full z-40 mt-0 md:cursor-none cursor-pointer focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-primary/40" aria-label="View project FlavorFusion">
            <img src="/images/flavorfusion.jpg" alt="FlavorFusion" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" loading="lazy" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/50 to-transparent md:from-black/65"></div>
            <div class="absolute inset-0 flex flex-col items-center justify-center text-center text-white px-6">
              <p class="text-base md:text-lg font-semibold tracking-[0.16em] uppercase text-white/95 mb-3">UX/UI Design</p>
              <h3 class="text-[2.9rem] md:text-[4.1rem] font-semibold tracking-tight leading-[0.92] text-white">FlavorFusion</h3>
              <p class="text-lg md:text-xl mt-4 opacity-90 max-w-[32ch] md:max-w-[34ch] mx-auto">Landing page for a mobile recipe app with clear, intuitive guidance</p>
            </div>
          </a>
        </div>
      </div>

    </div>

    <div class="max-w-6xl mx-auto px-6">
      <!-- ALL PROJECTS – 2-column grid -->
      <div>
        <h2 class="text-h2 mb-16 md:mb-20 text-center">More Projects</h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-16" id="projects-grid">

          <!-- 5. SCHLAF -->
          <a href="/en/projects/schlaf" class="block project-card group md:cursor-none cursor-pointer focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-primary/40" aria-label="View project SCHLAF">
            <div class="relative overflow-hidden rounded-3xl h-[420px] sm:h-[500px]">
              <img src="/images/schlaf.jpg" alt="SCHLAF" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" loading="lazy">
              <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/50 to-transparent md:from-black/65"></div>
              <div class="absolute bottom-10 left-10 right-10 text-white">
                <p class="text-base md:text-lg font-semibold tracking-[0.16em] uppercase text-white/95 mb-2">Interior Architecture</p>
                <h3 class="text-[2rem] md:text-[2.5rem] font-semibold tracking-tight leading-[0.95] text-white">SCHLAF</h3>
                <p class="text-base md:text-lg mt-3 opacity-90 max-w-[28ch]">Interactive exhibition that makes sleep tangible through all senses</p>
              </div>
            </div>
          </a>

          <!-- 6. OmNomZen -->
          <a href="/en/projects/omnomzen" class="block project-card group md:cursor-none cursor-pointer focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-primary/40" aria-label="View project OmNomZen">
            <div class="relative overflow-hidden rounded-3xl h-[420px] sm:h-[500px]">
              <img src="/images/omnomzen.jpg" alt="OmNomZen" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" loading="lazy">
              <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/50 to-transparent md:from-black/65"></div>
              <div class="absolute bottom-10 left-10 right-10 text-white">
                <p class="text-base md:text-lg font-semibold tracking-[0.16em] uppercase text-white/95 mb-2">UX/UI Design</p>
                <h3 class="text-[2rem] md:text-[2.5rem] font-semibold tracking-tight leading-[0.95] text-white">OmNomZen</h3>
                <p class="text-base md:text-lg mt-3 opacity-90 max-w-[28ch]">App concept for stress-reducing routines that fit everyday life</p>
              </div>
            </div>
          </a>

          <!-- 7. weserkoje -->
          <a href="/en/projects/weserkoje" class="block project-card group md:cursor-none cursor-pointer focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-primary/40" aria-label="View project weserkoje">
            <div class="relative overflow-hidden rounded-3xl h-[420px] sm:h-[500px]">
              <img src="/images/weserkoje.jpg" alt="weserkoje" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" loading="lazy">
              <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/50 to-transparent md:from-black/65"></div>
              <div class="absolute bottom-10 left-10 right-10 text-white">
                <p class="text-base md:text-lg font-semibold tracking-[0.16em] uppercase text-white/95 mb-2">Interior Architecture</p>
                <h3 class="text-[2rem] md:text-[2.5rem] font-semibold tracking-tight leading-[0.95] text-white">weserkoje</h3>
                <p class="text-base md:text-lg mt-3 opacity-90 max-w-[28ch]">Multifunctional hostel with integrated conference facilities</p>
              </div>
            </div>
          </a>

          <!-- 8. Planora -->
          <a href="/en/projects/planora" class="block project-card group md:cursor-none cursor-pointer focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-primary/40" aria-label="View project Planora">
            <div class="relative overflow-hidden rounded-3xl h-[420px] sm:h-[500px]">
              <img src="/images/planora.jpg" alt="Planora" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" loading="lazy">
              <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/50 to-transparent md:from-black/65"></div>
              <div class="absolute bottom-10 left-10 right-10 text-white">
                <p class="text-base md:text-lg font-semibold tracking-[0.16em] uppercase text-white/95 mb-2">UX/UI Design</p>
                <h3 class="text-[2rem] md:text-[2.5rem] font-semibold tracking-tight leading-[0.95] text-white">Planora</h3>
                <p class="text-base md:text-lg mt-3 opacity-90 max-w-[28ch]">Travel planning that adapts flexibly to people and real situations</p>
              </div>
            </div>
          </a>

        </div>
      </div>
    </div>
  </section>

  <div id="custom-cursor" class="fixed pointer-events-none hidden w-40 h-40 rounded-full bg-white/40 backdrop-blur-2xl flex flex-col items-center justify-center text-zinc-900 text-sm font-medium z-[9999] shadow-2xl gap-px">
    <span class="text-caption tracking-[0.16em] uppercase">VIEW</span>
    <span class="text-body-sm font-semibold">PROJECT</span>
  </div>

  <script>
    const cursor = document.getElementById('custom-cursor');
    const projectCards = document.querySelectorAll('.project-card');
    const desktopMedia = window.matchMedia('(min-width: 768px)');

    if (cursor instanceof HTMLElement) {
      const hideCursor = () => {
        cursor.classList.add('hidden');
      };

      projectCards.forEach(card => {
        card.addEventListener('mousemove', (e) => {
          if (!desktopMedia.matches) {
            hideCursor();
            return;
          }

          if (!(e instanceof MouseEvent)) return;

          cursor.style.left = `${e.clientX - 80}px`;
          cursor.style.top = `${e.clientY - 80}px`;
          cursor.classList.remove('hidden');
        });

        card.addEventListener('mouseleave', hideCursor);
      });

      desktopMedia.addEventListener('change', hideCursor);
      window.addEventListener('blur', hideCursor);
    }
  </script>
</Layout>
