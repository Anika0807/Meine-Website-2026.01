---
import Button from '@/components/ui/astro-button.astro';
import Layout from '@/layouts/Layout.astro';
---

<Layout title="Contact">
  <section class="max-w-7xl mx-auto px-6 py-8 md:py-12">
    <div class="w-full grid md:grid-cols-2 gap-8 lg:gap-12 items-center">
      <div class="space-y-6 flex flex-col justify-center">
        <div class="space-y-4">
          <h1 class="text-h2 md:text-h1 font-bold leading-tight tracking-tight text-foreground reveal-heading">
            Let's<br />create<br />together!
          </h1>
          <p class="text-base sm:text-lg md:text-xl text-muted-foreground leading-relaxed max-w-xl">
            I'd love to hear about your project - whether it's interior architecture, UX/UI, or a blend of both. I'm looking forward to getting to know you and creating something meaningful together.
          </p>
        </div>

        <div class="rounded-2xl overflow-hidden shadow-xl border border-border aspect-[4/3] max-h-[280px] sm:max-h-[320px] md:max-h-[380px] mx-auto md:mx-0 w-full sm:max-w-[340px] md:max-w-none">
          <img
            src="/images/anika-moodboard.webp"
            alt="Anika at work or portrait"
            class="w-full h-full object-cover"
            loading="lazy"
          />
        </div>

        <div class="flex flex-wrap gap-5 sm:gap-6 text-sm justify-center md:justify-start">
          <a href="mailto:hallo@anika-warncke.de" class="font-medium text-foreground/90 transition hover:text-primary hover:underline underline-offset-4">
            hallo@anika-warncke.de
          </a>
          <a href="https://www.linkedin.com/in/anika-warncke" target="_blank" rel="noopener noreferrer" class="text-foreground/80 transition hover:text-primary hover:underline underline-offset-4">
            LinkedIn
          </a>
        </div>
      </div>

      <div class="bg-card p-6 sm:p-8 md:p-8 rounded-2xl shadow-lg border border-border flex flex-col justify-center relative overflow-hidden">
        <!-- Success Overlay -->
        <div id="success-overlay" class="form-success-overlay">
          <svg viewBox="0 0 52 52" class="w-16 h-16" fill="none">
            <circle class="checkmark-circle" cx="26" cy="26" r="25" stroke="hsl(var(--primary))" stroke-width="2" fill="none"/>
            <path class="checkmark-check" fill="none" stroke="hsl(var(--primary))" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" d="M14 27l8 8 16-16"/>
          </svg>
          <p class="text-lg font-semibold text-foreground">Thank you!</p>
          <p class="text-sm text-muted-foreground text-center max-w-[24ch]">I will get back to you as soon as possible.</p>
        </div>
        <form id="contact-form" action="https://formsubmit.co/ajax/hallo@anika-warncke.de" method="POST" class="space-y-5" novalidate>
          <input type="hidden" name="_subject" value="New contact request from anika-warncke.de" />
          <input type="hidden" name="_template" value="table" />
          <div class="space-y-1" data-field>
            <div class="relative">
              <input type="text" name="name" id="name" required autocomplete="name" placeholder=" " data-error-id="name-error" class="peer w-full px-4 pt-6 pb-2 bg-background border border-border rounded-xl transition-all text-base focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20" />
              <label for="name" class="absolute left-4 top-1/2 -translate-y-1/2 text-muted-foreground text-sm transition-all duration-200 pointer-events-none peer-focus:top-2 peer-focus:translate-y-0 peer-focus:text-xs peer-focus:text-primary peer-[&:not(:placeholder-shown)]:top-2 peer-[&:not(:placeholder-shown)]:translate-y-0 peer-[&:not(:placeholder-shown)]:text-xs peer-[&:not(:placeholder-shown)]:text-primary peer-[&:not(:placeholder-shown)]:font-medium">Your Name *</label>
            </div>
            <p id="name-error" class="hidden text-red-600 text-xs">Please enter your name.</p>
          </div>

          <div class="space-y-1" data-field>
            <div class="relative">
              <input type="email" name="email" id="email" required autocomplete="email" placeholder=" " data-error-id="email-error" class="peer w-full px-4 pt-6 pb-2 bg-background border border-border rounded-xl transition-all text-base focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20" />
              <label for="email" class="absolute left-4 top-1/2 -translate-y-1/2 text-muted-foreground text-sm transition-all duration-200 pointer-events-none peer-focus:top-2 peer-focus:translate-y-0 peer-focus:text-xs peer-focus:text-primary peer-[&:not(:placeholder-shown)]:top-2 peer-[&:not(:placeholder-shown)]:translate-y-0 peer-[&:not(:placeholder-shown)]:text-xs peer-[&:not(:placeholder-shown)]:text-primary peer-[&:not(:placeholder-shown)]:font-medium">Your Email *</label>
            </div>
            <p id="email-error" class="hidden text-red-600 text-xs">Please enter a valid email address.</p>
          </div>

          <div class="space-y-1" data-field>
            <div class="relative">
              <select name="projektart" id="projektart" required data-error-id="project-error" class="peer w-full px-4 pt-6 pb-2 bg-background border border-border rounded-xl transition-all appearance-none text-base focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20">
                <option value="" disabled selected hidden></option>
                <option value="interior-architecture">Interior Architecture</option>
                <option value="ux-ui">UX/UI Design</option>
                <option value="hybrid">Hybrid / Both</option>
                <option value="other">Other</option>
              </select>
              <label for="projektart" class="absolute left-4 top-1/2 -translate-y-1/2 text-muted-foreground text-sm transition-all duration-200 pointer-events-none peer-focus:top-2 peer-focus:translate-y-0 peer-focus:text-xs peer-focus:text-primary peer-valid:top-2 peer-valid:translate-y-0 peer-valid:text-xs peer-valid:text-primary peer-valid:font-medium">Project type *</label>
              <span class="absolute right-4 top-1/2 -translate-y-1/2 text-muted-foreground pointer-events-none text-xs">▼</span>
            </div>
            <p id="project-error" class="hidden text-red-600 text-xs">Please select a project type.</p>
          </div>

          <div class="space-y-1" data-field>
            <div class="relative">
              <textarea name="message" id="message" rows="3" required autocomplete="off" placeholder=" " data-error-id="message-error" class="peer w-full px-4 pt-6 pb-2 bg-background border border-border rounded-xl transition-all resize-none text-base focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20" style="min-height:96px"></textarea>
              <label for="message" class="absolute left-4 top-6 -translate-y-1/2 text-muted-foreground text-sm transition-all duration-200 pointer-events-none peer-focus:top-2 peer-focus:translate-y-0 peer-focus:text-xs peer-focus:text-primary peer-[&:not(:placeholder-shown)]:top-2 peer-[&:not(:placeholder-shown)]:translate-y-0 peer-[&:not(:placeholder-shown)]:text-xs peer-[&:not(:placeholder-shown)]:text-primary peer-[&:not(:placeholder-shown)]:font-medium">Your Message / Project *</label>
            </div>
            <p id="message-error" class="hidden text-red-600 text-xs">Please share a short message about your project.</p>
          </div>

          <Button id="submit-btn" type="submit" size="lg" class="w-full text-base sm:text-lg">
            Send message
          </Button>

          <p id="status-msg" class="text-center text-sm mt-2 min-h-[1.5rem]" aria-live="polite"></p>

          <p class="text-xs text-muted-foreground text-center">
            I treat your data with care and confidentiality.
          </p>
        </form>
      </div>
    </div>
  </section>

  <script is:inline>
    const form = document.getElementById('contact-form');
    const submitBtn = document.getElementById('submit-btn');
    const statusMsg = document.getElementById('status-msg');

    const setFieldError = (field, message) => {
      const errorId = field?.dataset?.errorId;
      const errorNode = errorId ? document.getElementById(errorId) : null;
      field.setAttribute('aria-invalid', 'true');
      if (errorId) field.setAttribute('aria-describedby', errorId);
      field.classList.add('border-red-500', 'focus:border-red-500', 'focus:ring-red-500/20');
      field.classList.remove('border-border', 'focus:border-primary', 'focus:ring-primary/20');
      if (errorNode) {
        errorNode.textContent = message;
        errorNode.classList.remove('hidden');
      }
    };
    const clearFieldError = (field) => {
      const errorId = field?.dataset?.errorId;
      const errorNode = errorId ? document.getElementById(errorId) : null;
      field.removeAttribute('aria-invalid');
      field.removeAttribute('aria-describedby');
      field.classList.remove('border-red-500', 'focus:border-red-500', 'focus:ring-red-500/20');
      field.classList.add('border-border', 'focus:border-primary', 'focus:ring-primary/20');
      if (errorNode) errorNode.classList.add('hidden');
    };

    const isValidEmail = (value) => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value);

    const validateField = (field) => {
      const value = (field.value || '').trim();

      if (field.id === 'name' && !value) {
        setFieldError(field, 'Please enter your name.');
        return false;
      }

      if (field.id === 'email' && (!value || !isValidEmail(value))) {
        setFieldError(field, 'Please enter a valid email address.');
        return false;
      }

      if (field.id === 'projektart' && !field.value) {
        setFieldError(field, 'Please select a project type.');
        return false;
      }

      if (field.id === 'message' && !value) {
        setFieldError(field, 'Please share a short message about your project.');
        return false;
      }

      clearFieldError(field);
      return true;
    };

    const fields = [
      document.getElementById('name'),
      document.getElementById('email'),
      document.getElementById('projektart'),
      document.getElementById('message'),
    ];

    fields.forEach((field) => {
      const eventName = field.tagName === 'SELECT' ? 'change' : 'input';
      field.addEventListener(eventName, () => {
        validateField(field);
      });
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      statusMsg.textContent = '';
      statusMsg.className = 'text-center text-sm mt-2 min-h-[1.5rem]';

      const valid = fields.map(validateField).every(Boolean);
      if (!valid) {
        statusMsg.textContent = 'Please complete all required fields correctly.';
        statusMsg.classList.add('text-red-600');
        return;
      }

      submitBtn.disabled = true;
      submitBtn.innerHTML = '<span class="btn-spinner"></span> Sending...';

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });

        if (!response.ok) {
          throw new Error('Request failed');
        }

        form.reset();
        fields.forEach(clearFieldError);
        const overlay = document.getElementById('success-overlay');
        if (overlay) overlay.classList.add('visible');
        statusMsg.textContent = '';
        setTimeout(() => {
          if (overlay) overlay.classList.remove('visible');
        }, 5000);
      } catch (error) {
        statusMsg.textContent = 'Something went wrong. Please try again or email hallo@anika-warncke.de directly.';
        statusMsg.classList.add('text-red-600');
      } finally {
        submitBtn.disabled = false;
        submitBtn.innerHTML = 'Send message';
      }
    });
  </script>
</Layout>
