---
import Button from '@/components/ui/astro-button.astro';
import Layout from '@/layouts/Layout.astro';
import { Image } from 'astro:assets';
import anikaPortrait from '@/assets/anika-portrait.jpg';
import anikaWork from '@/assets/anika-work.webp';
---

<Layout title="Über mich – Anika Warncke">
  <!-- === HERO „ÜBER MICH“ – FINAL 10/10 (mit mehr Wärme & Akzent) === -->
  <section class="py-20 md:py-32 bg-background">
    <div class="max-w-6xl mx-auto px-6 text-center">
      <!-- Portrait -->
      <Image
        src={anikaPortrait}
        alt="Anika Warncke – Innenarchitektur M.A. & UX/UI Designerin"
        width={640}
        height={640}
        quality={95}
        format="webp"
        fit="cover"
        position="center"
        class="mx-auto w-80 h-80 rounded-full object-cover object-center shadow-2xl mb-8 md:mb-14"
      />

      <h1 class="text-h2 md:text-h1 font-semibold tracking-tight mb-6 reveal-heading">Über mich</h1>

      <!-- Neuer Subheadline -->
      <p class="text-2xl text-primary font-medium mb-8">
        Innenarchitektur M.A. & UX/UI Designerin
      </p>

      <!-- Emotionaler Haupttext mit Highlight -->
      <p class="text-xl text-muted-foreground leading-relaxed max-w-3xl mx-auto">
        Hallo, ich bin <span class="text-primary font-semibold">Anika Warncke</span>. Mit Leidenschaft gestalte ich hochwertige Räume und intuitive digitale Erlebnisse –
        <span class="text-primary font-semibold">immer mit dem Menschen im Mittelpunkt</span>.
        Ob physisch oder digital: Ich begleite jedes Projekt mit einem klaren roten Faden von der ersten Idee bis nach der fertigen Umsetzung.
      </p>

      <!-- Buttons -->
      <div class="flex flex-wrap gap-4 justify-center mt-14">
        <Button href="/kontakt" variant="primary" size="lg" class="w-full sm:w-auto sm:min-w-[230px] mag-btn">
          Mit mir sprechen
        </Button>
        <Button href="#designprozess" variant="outline" size="lg" class="w-full sm:w-auto sm:min-w-[230px] mag-btn">
          Mein Designprozess
        </Button>
      </div>
    </div>
  </section>

  <!-- === WER ICH BIN – FINAL (Text links, Bild rechts) === -->
  <section class="py-16 md:py-28 bg-background rail-divider">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid md:grid-cols-12 gap-6 md:gap-12 items-stretch">
        <!-- Text links -->
        <div class="md:col-span-8 order-2 md:order-1 flex flex-col justify-start h-full">
          <h2 class="text-h3 md:text-h2 font-semibold tracking-tight mb-10 text-left reveal-heading">Wer ich bin</h2>
          <div class="text-left text-lg leading-relaxed text-muted-foreground">
            <p class="mb-8">
              Meine wahre Leidenschaft liegt im <span class="text-primary font-semibold">Konzipieren, Gestalten und Problemlösen</span>. 
              Ob im physischen Raum als <span class="text-primary font-semibold">Innenarchitektur M.A.</span> oder im digitalen Raum als <span class="text-primary font-semibold">UX/UI-Designerin</span> – 
              ich tauche mit Begeisterung in jedes Projekt ein.
            </p>
            <p class="mb-8">
              Besonders faszinieren mich <span class="text-primary font-semibold">Erlebnisausstellungen, Gastronomie-, Hotel- und Healthcareprojekte</span> sowie <span class="text-primary font-semibold">individuelle Shop-Konzepte</span> in der Innenarchitektur. 
              Im UX/UI-Design schlägt mein Herz für <span class="text-primary font-semibold">mobile Apps mit sozialem oder gesundheitlichem Mehrwert</span> und die Gestaltung nahtloser Benutzererlebnisse, die das Wohlbefinden fördern und Engagement wecken.
            </p>
            <p>
              <span class="text-primary font-semibold">Immer steht der Mensch im Mittelpunkt</span> – ob physisch oder digital. 
              Mit einem <span class="text-primary font-semibold">klaren Konzept von der ersten Idee bis zur fertigen Umsetzung</span> begleite ich jedes Projekt.
            </p>
          </div>
        </div>
        <!-- Bild rechts (auf Desktop), oben auf Mobil) -->
        <div class="md:col-span-4 order-1 md:order-2 flex flex-col h-full">
          <div class="flex-1 flex">
            <Image src={anikaWork} 
                 alt="Anika bei der Arbeit" 
                 class="w-full h-full rounded-3xl shadow-lg object-cover object-top mb-8 md:mb-0" loading="lazy" format="webp" quality={85} densities={[1, 2]} />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- === WARUM PHYSISCH & DIGITAL BEI MIR GLEICH SIND – FINAL 10/10 === -->
  <section class="py-16 md:py-28 bg-background rail-divider">
    <div class="max-w-6xl mx-auto px-6">
      <h2 class="text-h3 md:text-h2 font-semibold tracking-tight mb-16 text-left reveal-heading">
        Physisch oder digital: bei mir sprechen beide Welten dieselbe Sprache
      </h2>

      <div class="grid md:grid-cols-3 gap-6 md:gap-10">

        <!-- Innenarchitektur -->
        <div class="bg-card border border-border rounded-3xl p-10 hover:shadow-xl transition-all group">
          <div class="w-16 h-16 bg-primary/10 text-primary rounded-2xl flex items-center justify-center mb-8 group-hover:scale-110 transition-transform">
            <!-- Haus-Icon -->
            <svg xmlns="http://www.w3.org/2000/svg" class="w-9 h-9" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10.5l9-7 9 7" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.25 9.75V20.25H18.75V9.75" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.5 20.25V14.25H13.5V20.25" />
            </svg>
          </div>
          <h3 class="text-2xl font-semibold mb-6">Innenarchitektur</h3>
          <p class="text-muted-foreground">Vom ersten Gespräch bis zum fertigen Projekt gestalte ich Räume, die perfekt funktionieren und in denen Menschen sich einfach wohlfühlen.</p>
        </div>

        <!-- Kernbotschaft – Primary-Grün mit weißer Schrift + roter Faden -->
        <div class="bg-primary text-white border border-primary rounded-3xl p-10 flex flex-col justify-center items-start text-left">
          <h3 class="text-2xl font-semibold mb-6 text-white">Gemeinsamkeiten</h3>
          <ul class="space-y-4 text-sm w-full">
            <li class="flex items-start gap-3">
              <span class="shrink-0">•</span>
              <span>Menschzentriert</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="shrink-0">•</span>
              <span>Strategisch &amp; emotional</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="shrink-0">•</span>
              <span class="font-semibold">Mit einem roten Faden von der ersten Idee bis zur fertigen Umsetzung</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="shrink-0">•</span>
              <span>Durchdacht bis ins letzte Detail</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="shrink-0">•</span>
              <span>Design als gemeinsame Sprache</span>
            </li>
          </ul>
        </div>

        <!-- UX/UI Design -->
        <div class="bg-card border border-border rounded-3xl p-10 hover:shadow-xl transition-all group">
          <div class="w-16 h-16 bg-primary/10 text-primary rounded-2xl flex items-center justify-center mb-8 group-hover:scale-110 transition-transform">
            <!-- Smartphone-Icon -->
            <svg xmlns="http://www.w3.org/2000/svg" class="w-9 h-9" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" />
            </svg>
          </div>
          <h3 class="text-2xl font-semibold mb-6">UX/UI Design</h3>
          <p class="text-muted-foreground">Von der ersten Kontaktaufnahme bis zum fertig integrierten Produkt entwickle ich digitale Erlebnisse, die intuitiv funktionieren, sich selbst erklären und Menschen emotional berühren.</p>
        </div>

      </div>
    </div>
  </section>

  <!-- === MEIN DESIGNPROZESS – WEICHERE GRÜN-VARIANTE (Design System konform) === -->
  <section id="designprozess" class="py-16 md:py-28 bg-background rail-divider">
    <div class="max-w-6xl mx-auto px-6">
      <h2 class="text-h3 md:text-h2 font-semibold tracking-tight mb-16 text-center">
        Mein Designprozess – mit einem roten Faden von Anfang bis Ende
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-12">

        <!-- Schritt 1 -->
        <div class="bg-card border border-border rounded-3xl p-12 hover:shadow-xl transition-all">
          <div class="w-12 h-12 bg-primary text-white rounded-full flex items-center justify-center text-2xl font-semibold mb-6">1</div>
          <h3 class="text-xl font-semibold mb-4">Zuhören &amp; Verstehen</h3>
          <p class="text-muted-foreground">Ich höre zu, stelle die richtigen Fragen und verstehe den Kontext deines Projekts.</p>
          <p class="text-sm text-primary font-medium mt-8">Der Ausgangspunkt: Menschen verstehen.</p>
        </div>

        <!-- Schritt 2 -->
        <div class="bg-primary/5 border border-primary/15 rounded-3xl p-12 hover:shadow-xl transition-all">
          <div class="w-12 h-12 bg-primary text-white rounded-full flex items-center justify-center text-2xl font-semibold mb-6">2</div>
          <h3 class="text-xl font-semibold mb-4">Strategie &amp; Konzeption</h3>
          <p class="text-muted-foreground">Gemeinsam entwickeln wir eine klare Strategie und definieren Ziele.</p>
          <p class="text-sm text-primary font-medium mt-8">Die Richtung wird klar – physisch wie digital.</p>
        </div>

        <!-- Schritt 3 -->
        <div class="bg-card border border-border rounded-3xl p-12 hover:shadow-xl transition-all">
          <div class="w-12 h-12 bg-primary text-white rounded-full flex items-center justify-center text-2xl font-semibold mb-6">3</div>
          <h3 class="text-xl font-semibold mb-4">Ideen &amp; Skizzen</h3>
          <p class="text-muted-foreground">Moodboards, Handskizzen und erste Konzepte entstehen.</p>
          <p class="text-sm text-primary font-medium mt-8">Ideen werden sichtbar – in Räumen und Interfaces.</p>
        </div>

        <!-- Schritt 4 -->
        <div class="bg-primary/5 border border-primary/15 rounded-3xl p-12 hover:shadow-xl transition-all">
          <div class="w-12 h-12 bg-primary text-white rounded-full flex items-center justify-center text-2xl font-semibold mb-6">4</div>
          <h3 class="text-xl font-semibold mb-4">Design &amp; Prototyping</h3>
          <p class="text-muted-foreground">Detaillierte Designs, 3D-Modelle oder interaktive Prototypen.</p>
          <p class="text-sm text-primary font-medium mt-8">Lösungen werden greifbar – und testbar.</p>
        </div>

        <!-- Schritt 5 -->
        <div class="bg-card border border-border rounded-3xl p-12 hover:shadow-xl transition-all">
          <div class="w-12 h-12 bg-primary text-white rounded-full flex items-center justify-center text-2xl font-semibold mb-6">5</div>
          <h3 class="text-xl font-semibold mb-4">Umsetzung</h3>
          <p class="text-muted-foreground">Koordination mit Handwerkern oder Entwicklern bis zur fertigen Realisierung.</p>
          <p class="text-sm text-primary font-medium mt-8">Konzepte werden Wirklichkeit – in beiden Welten.</p>
        </div>

        <!-- Schritt 6 -->
        <div class="bg-primary/5 border border-primary/15 rounded-3xl p-12 hover:shadow-xl transition-all">
          <div class="w-12 h-12 bg-primary text-white rounded-full flex items-center justify-center text-2xl font-semibold mb-6">6</div>
          <h3 class="text-xl font-semibold mb-4">Nachbetreuung &amp; Feinschliff</h3>
          <p class="text-muted-foreground">Feedback-Runden, langfristige Begleitung und finaler Feinschliff.</p>
          <p class="text-sm text-primary font-medium mt-8">Qualität bleibt – auch nach der Fertigstellung.</p>
        </div>

      </div>
    </div>
  </section>

  <!-- === SKILLS & TOOLS – FINAL 10/10 (mit Highlight-Sätzen + Primary-Grün) === -->
  <section class="py-16 md:py-28 bg-background rail-divider">
    <div class="max-w-6xl mx-auto px-6">
      <h2 class="text-h3 md:text-h2 font-semibold tracking-tight mb-16 text-center reveal-heading">Skills &amp; Tools</h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-12">

        <!-- Design & Planung (weiß) -->
        <div class="bg-card border border-border rounded-3xl p-12 hover:shadow-xl transition-all">
          <div class="w-12 h-12 bg-primary/10 text-primary rounded-2xl flex items-center justify-center mb-8">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.4">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 3.487a2.25 2.25 0 113.182 3.182L8.25 18.463 4.5 19.5l1.037-3.75L16.862 3.487z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M14.25 6.75l3 3" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold mb-6">Design &amp; Planung</h3>
          <ul class="space-y-3 text-sm text-muted-foreground">
            <li>✓ <span class="text-primary font-medium">Konzeptentwicklung &amp; Moodboards</span></li>
            <li>✓ Zeichnungserstellung &amp; Planung</li>
            <li>✓ Detail- &amp; Ausführungsplanung</li>
            <li>✓ <span class="text-primary font-medium">UX/UI &amp; Product Design</span></li>
            <li>✓ Design Systems &amp; Dokumentation</li>
            <li>✓ Information Architecture &amp; Wireframing</li>
          </ul>
        </div>

        <!-- Tools & Software (weiß) -->
        <div class="bg-card border border-border rounded-3xl p-12 hover:shadow-xl transition-all">
          <div class="w-12 h-12 bg-primary/10 text-primary rounded-2xl flex items-center justify-center mb-8">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.4">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 6.75V5.25A2.25 2.25 0 0111.25 3h1.5A2.25 2.25 0 0115 5.25v1.5" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 8.25h16.5v9A2.25 2.25 0 0118 19.5H6A2.25 2.25 0 013.75 17.25v-9z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 12h16.5" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold mb-6">Tools &amp; Software</h3>
          <ul class="space-y-3 text-sm text-muted-foreground">
            <li>✓ <span class="text-primary font-medium">Vectorworks (2D/3D)</span></li>
            <li>✓ AutoCAD &amp; Cinema 4D</li>
            <li>✓ Adobe Creative Suite</li>
            <li>✓ <span class="text-primary font-medium">Figma &amp; FigJam</span></li>
            <li>✓ <span class="text-primary font-medium">Astro &amp; Tailwind CSS</span></li>
            <li>✓ Notion &amp; Projektmanagement</li>
          </ul>
        </div>

        <!-- Methoden & Realisierung (weiß) -->
        <div class="bg-card border border-border rounded-3xl p-12 hover:shadow-xl transition-all">
          <div class="w-12 h-12 bg-primary/10 text-primary rounded-2xl flex items-center justify-center mb-8">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.4">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 4.5h6M9 8.25h6M6.75 3h10.5A2.25 2.25 0 0119.5 5.25v13.5A2.25 2.25 0 0117.25 21H6.75A2.25 2.25 0 014.5 18.75V5.25A2.25 2.25 0 016.75 3z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 12h7.5M8.25 15.75h5.25" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold mb-6">Methoden &amp; Realisierung</h3>
          <ul class="space-y-3 text-sm text-muted-foreground">
            <li>✓ <span class="text-primary font-medium">Leistungsphasen 1–9 (HOAI)</span></li>
            <li>✓ Koordinierung der Gewerke &amp; Fachplaner</li>
            <li>✓ Baustellenbetreuung &amp; gestalterische Bauleitung</li>
            <li>✓ <span class="text-primary font-medium">User Research &amp; Usability Testing</span></li>
            <li>✓ Rapid Prototyping (Digital &amp; Analog)</li>
            <li>✓ Iterative Review-Zyklen &amp; Agiles Arbeiten</li>
          </ul>
        </div>

        <!-- Expertise & Werte (Primary-Grün + weiße Schrift) -->
        <div class="bg-primary text-white border border-primary rounded-3xl p-12 hover:shadow-xl transition-all">
          <div class="w-12 h-12 bg-white/20 text-white rounded-2xl flex items-center justify-center mb-8">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.4">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 3l7.5 3v6c0 4.5-3.2 7.9-7.5 9-4.3-1.1-7.5-4.5-7.5-9V6L12 3z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75l2 2 4-4" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold mb-6">Expertise &amp; Werte</h3>
          <ul class="space-y-3 text-sm text-white/90">
            <li>✓ <span class="font-semibold text-white">Barrierefreiheit (DIN 18040 &amp; WCAG 2.2)</span></li>
            <li>✓ <span class="font-semibold text-white">Mensch im Mittelpunkt (User-Centricity)</span></li>
            <li>✓ Nachhaltigkeit &amp; Materialkompetenz</li>
            <li>✓ <span class="font-semibold text-white">Kreativität &amp; strategisches Denken</span></li>
            <li>✓ <span class="font-semibold text-white">Zuverlässigkeit &amp; lösungsorientiert</span></li>
            <li>✓ Transparenz &amp; enge Abstimmung</li>
            <li>✓ Präsentation &amp; Stakeholder-Management</li>
            <li>✓ Remote- &amp; Hybrid-Kollaboration</li>
          </ul>
        </div>

      </div>
    </div>
  </section>

  <!-- === INNENARCHITEKTUR & UX/UI DESIGN – 10/10 FINAL === -->
  <section class="py-16 md:py-28 bg-background rail-divider">
    <div class="max-w-6xl mx-auto px-6">
      <h2 class="text-h3 md:text-h2 font-semibold tracking-tight mb-16 text-left reveal-heading">Innenarchitektur &amp; UX/UI Design</h2>

      <div class="mb-16">
        <p class="text-xl text-muted-foreground">
          Ich liebe beide Welten – und beherrsche sie mit der gleichen Leidenschaft.
          Ob physischer Raum oder digitales Erlebnis: <span class="text-primary font-semibold">Immer steht der Mensch im Mittelpunkt.</span>
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-6 md:gap-12">

        <!-- Innenarchitektur -->
        <div class="group bg-card border border-border rounded-3xl overflow-hidden hover:shadow-xl transition-all">
          <img src="/images/innenarchitektur-mood.webp"
               alt="Innenarchitektur – einladender Raum mit Menschen"
               class="w-full h-64 object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy">
          <div class="p-10">
            <h3 class="text-2xl font-semibold mb-6">Innenarchitektur</h3>
            <p class="text-muted-foreground mb-8">Von der ersten Idee bis zur fertigen Umsetzung gestalte ich Räume, die Menschen berühren.</p>
            <ul class="space-y-3 text-sm">
              <li class="flex items-start gap-3">✓ <span class="text-primary font-semibold">Raumplanung &amp; Konzeption</span></li>
              <li class="flex items-start gap-3">✓ <span class="text-primary font-semibold">Material-, Farbe- Licht- und Möblierungskonzept</span></li>
              <li class="flex items-start gap-3">✓ <span class="text-primary font-semibold">Projektleitung bis zur Fertigstellung</span></li>
            </ul>
          </div>
        </div>

        <!-- UX/UI Design -->
        <div class="group bg-card border border-border rounded-3xl overflow-hidden hover:shadow-xl transition-all">
          <img src="/images/ux-ui-mood.webp"
               alt="UX/UI Design – intuitive digitale Erlebnisse"
               class="w-full h-64 object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy">
          <div class="p-10">
            <h3 class="text-2xl font-semibold mb-6">UX/UI Design</h3>
            <p class="text-muted-foreground mb-8">Ich entwickle digitale Produkte, die intuitiv und emotional wirken.</p>
            <ul class="space-y-3 text-sm">
              <li class="flex items-start gap-3">✓ <span class="text-primary font-semibold">User Research &amp; Wireframing</span></li>
              <li class="flex items-start gap-3">✓ <span class="text-primary font-semibold">Interaktive Prototypen</span></li>
              <li class="flex items-start gap-3">✓ <span class="text-primary font-semibold">Design Systeme &amp; Micro-Interactions</span></li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- === FAQ – 6 FRAGEN (final, mit deinen exakten Wünschen) === -->
  <section class="py-16 md:py-28 bg-background rail-divider">
    <div class="max-w-6xl mx-auto px-6">
      <h2 class="text-h3 md:text-h2 font-semibold tracking-tight mb-16 text-left reveal-heading">Häufig gestellte Fragen</h2>

      <div class="space-y-6">

        <!-- 1. Remote -->
        <details class="group bg-card rounded-3xl p-8 shadow-sm hover:shadow-xl transition-all">
          <summary class="flex items-center justify-between text-lg font-medium cursor-pointer list-none">
            Arbeitest du remote?
            <span class="text-primary text-2xl group-open:rotate-180 transition-transform">↓</span>
          </summary>
          <p class="text-muted-foreground mt-6 leading-relaxed">
            Ja, ich arbeite <span class="text-primary font-semibold">voll remote</span> und hybrid. Ich bin flexibel und kann auf Anfrage auch gerne vor Ort in Lüneburg oder Hamburg sein.
          </p>
        </details>

        <!-- 2. Projektdauer -->
        <details class="group bg-card rounded-3xl p-8 shadow-sm hover:shadow-xl transition-all">
          <summary class="flex items-center justify-between text-lg font-medium cursor-pointer list-none">
            Wie lange dauert ein Projekt?
            <span class="text-primary text-2xl group-open:rotate-180 transition-transform">↓</span>
          </summary>
          <p class="text-muted-foreground mt-6 leading-relaxed">
