---
import Layout from '@/layouts/Layout.astro';
import { Image } from 'astro:assets';
import anikaPortrait from '@/assets/anika-portrait.jpg';
---

<Layout title="Über mich – Anika Warncke">
  <!-- === HERO „ÜBER MICH“ – FINAL 10/10 (mit mehr Wärme & Akzent) === -->
  <section class="py-32 bg-background">
    <div class="max-w-6xl mx-auto px-6 text-center">
      <!-- Portrait -->
      <Image
        src={anikaPortrait}
        alt="Anika Warncke – Innenarchitektur M.A. & UX/UI Designerin"
        width={640}
        height={640}
        quality={95}
        format="webp"
        fit="cover"
        position="center"
        class="mx-auto w-80 h-80 rounded-full object-cover object-center shadow-2xl mb-14"
      />

      <h1 class="text-5xl font-semibold tracking-tight mb-6">Über mich</h1>

      <!-- Neuer Subheadline -->
      <p class="text-2xl text-primary font-medium mb-8">
        Innenarchitektur M.A. & UX/UI Designerin
      </p>

      <!-- Emotionaler Haupttext mit Highlight -->
      <p class="text-xl text-muted-foreground leading-relaxed max-w-3xl mx-auto">
        Hallo! Ich bin Anika Warncke. Mit Leidenschaft gestalte ich durchdachte Räume und digitale Erlebnisse –
        <span class="text-primary font-semibold">immer mit dem Menschen im Mittelpunkt</span>.
        Ob physisch oder digital: Ich begleite jedes Projekt mit einem klaren roten Faden von der ersten Idee bis zur fertigen Umsetzung.
      </p>

      <!-- Buttons -->
      <div class="flex flex-wrap gap-4 justify-center mt-14">
        <a href="/kontakt"
           class="inline-flex items-center justify-center w-full sm:w-auto sm:min-w-[230px] px-8 py-4 bg-primary text-white rounded-btn font-medium hover:bg-accent transition-all">
          Mit mir sprechen
        </a>
        <a href="#designprozess"
           class="inline-flex items-center justify-center w-full sm:w-auto sm:min-w-[230px] px-8 py-4 border border-border rounded-btn font-medium hover:bg-accent hover:text-white transition-all">
          Mein Designprozess
        </a>
      </div>
    </div>
  </section>

  <!-- Wer ich bin -->
  <section class="py-28 bg-background">
    <div class="max-w-6xl mx-auto px-6">
      <h2 class="text-4xl font-semibold tracking-tight mb-12">Wer ich bin</h2>

      <div class="text-left text-lg leading-relaxed text-muted-foreground">
        <p class="mb-8">
          Meine wahre Leidenschaft liegt im Konzeptionieren, Gestalten und Problemlösen.
          Ob im physischen Raum als Innenarchitektur M.A. oder im digitalen Raum als UX/UI-Designerin –
          ich tauche mit Begeisterung in jedes Projekt ein.
        </p>

        <p class="mb-8">
          Besonders faszinieren mich Erlebnisausstellungen, Gastronomie-, Hotel- und Health-Care-Projekte sowie individuelle Shop-Konzepte in der Innenarchitektur. Im UX/UI-Design schlägt
          mein Herz für mobile Apps mit sozialem oder gesundheitlichem Mehrwert und die
          Gestaltung nahtloser Benutzererlebnisse, die das Wohlbefinden fördern und Engagement wecken.
        </p>

        <p>
          Immer steht der Mensch im Mittelpunkt – ob physisch oder digital.
          Mit einem klaren roten Faden begleite ich jedes Projekt von der ersten Idee
          bis zur fertigen Umsetzung.
        </p>
      </div>
    </div>
  </section>

  <!-- === WARUM PHYSISCH & DIGITAL BEI MIR GLEICH SIND – FINAL 10/10 === -->
  <section class="py-28 bg-background">
    <div class="max-w-6xl mx-auto px-6">
      <h2 class="text-4xl font-semibold tracking-tight mb-16 text-left">
        Physisch oder digital: bei mir sprechen beide Welten dieselbe Sprache
      </h2>

      <div class="grid md:grid-cols-3 gap-10">

        <!-- Innenarchitektur -->
        <div class="bg-white border border-border rounded-3xl p-10 hover:shadow-xl transition-all group">
          <div class="w-16 h-16 bg-primary/10 text-primary rounded-2xl flex items-center justify-center mb-8 group-hover:scale-110 transition-transform">
            <!-- Haus-Icon -->
            <svg xmlns="http://www.w3.org/2000/svg" class="w-9 h-9" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10.5l9-7 9 7" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.25 9.75V20.25H18.75V9.75" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.5 20.25V14.25H13.5V20.25" />
            </svg>
          </div>
          <h3 class="text-2xl font-semibold mb-6">Innenarchitektur</h3>
          <p class="text-muted-foreground">Vom ersten Gespräch bis zum fertigen Projekt gestalte ich Räume, die perfekt funktionieren und in denen Menschen sich einfach wohlfühlen.</p>
        </div>

        <!-- Kernbotschaft – Primary-Grün mit weißer Schrift + roter Faden -->
        <div class="bg-primary text-white border border-primary rounded-3xl p-10 flex flex-col justify-center items-start text-left">
          <h3 class="text-2xl font-semibold mb-6 text-white">Gemeinsamkeiten</h3>
          <ul class="space-y-4 text-sm w-full">
            <li class="flex items-start gap-3">
              <span class="shrink-0">•</span>
              <span>Menschzentriert</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="shrink-0">•</span>
              <span>Strategisch &amp; emotional</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="shrink-0">•</span>
              <span class="font-semibold">Mit einem roten Faden von der ersten Idee bis zur fertigen Umsetzung</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="shrink-0">•</span>
              <span>Durchdacht bis ins letzte Detail</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="shrink-0">•</span>
              <span>Design als gemeinsame Sprache</span>
            </li>
          </ul>
        </div>

        <!-- UX/UI Design -->
        <div class="bg-white border border-border rounded-3xl p-10 hover:shadow-xl transition-all group">
          <div class="w-16 h-16 bg-primary/10 text-primary rounded-2xl flex items-center justify-center mb-8 group-hover:scale-110 transition-transform">
            <!-- Smartphone-Icon -->
            <svg xmlns="http://www.w3.org/2000/svg" class="w-9 h-9" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" />
            </svg>
          </div>
          <h3 class="text-2xl font-semibold mb-6">UX/UI Design</h3>
          <p class="text-muted-foreground">Von der ersten Kontaktaufnahme bis zum fertig interierten Produkt entwickle ich digitale Erlebnisse, die intuitiv funktionieren, sich selbst erklären und Menschen emotional berühren.</p>
        </div>

      </div>
    </div>
  </section>

  <!-- === MEIN DESIGNPROZESS – FINAL 10/10 (mit rotem Faden + LPH-Integration) === -->
  <section id="designprozess" class="py-28 bg-background relative">
    <div class="max-w-6xl mx-auto px-6">
      <h2 class="text-4xl font-semibold tracking-tight mb-16 text-left">
        Mein Designprozess – mit einem roten Faden von Anfang bis Ende
      </h2>

      <!-- Visueller roter Faden (durchgehende Linie) -->
      <div class="absolute left-1/2 top-28 bottom-12 w-0.5 bg-primary/20 hidden lg:block z-0"></div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-12 relative z-10">

        <!-- Schritt 1 -->
        <div class="bg-white border border-border rounded-3xl p-10 hover:shadow-xl transition-all group">
          <div class="w-12 h-12 bg-primary text-white rounded-full flex items-center justify-center text-2xl font-semibold mb-6">1</div>
          <h3 class="text-xl font-semibold mb-4">Zuhören &amp; Verstehen</h3>
          <p class="text-muted-foreground mb-6">Ich höre zu, stelle die richtigen Fragen und verstehe den Kontext deines Projekts.</p>
          <p class="text-sm text-primary font-medium">Der rote Faden beginnt hier – immer mit dem Menschen im Mittelpunkt.</p>
        </div>

        <!-- Schritt 2 -->
        <div class="bg-white border border-border rounded-3xl p-10 hover:shadow-xl transition-all group">
          <div class="w-12 h-12 bg-primary text-white rounded-full flex items-center justify-center text-2xl font-semibold mb-6">2</div>
          <h3 class="text-xl font-semibold mb-4">Strategie &amp; Konzeption</h3>
          <p class="text-muted-foreground mb-6">Gemeinsam entwickeln wir eine klare Strategie und definieren Ziele.</p>
          <p class="text-sm text-primary font-medium">Der rote Faden wird stärker – physisch wie digital.</p>
        </div>

        <!-- Schritt 3 -->
        <div class="bg-white border border-border rounded-3xl p-10 hover:shadow-xl transition-all group">
          <div class="w-12 h-12 bg-primary text-white rounded-full flex items-center justify-center text-2xl font-semibold mb-6">3</div>
          <h3 class="text-xl font-semibold mb-4">Ideen &amp; Skizzen</h3>
          <p class="text-muted-foreground mb-6">Moodboards, Handskizzen und erste Konzepte entstehen.</p>
          <p class="text-sm text-primary font-medium">Der rote Faden wird sichtbar – in Räumen und Interfaces.</p>
        </div>

        <!-- Schritt 4 -->
        <div class="bg-white border border-border rounded-3xl p-10 hover:shadow-xl transition-all group">
          <div class="w-12 h-12 bg-primary text-white rounded-full flex items-center justify-center text-2xl font-semibold mb-6">4</div>
          <h3 class="text-xl font-semibold mb-4">Design &amp; Prototyping</h3>
          <p class="text-muted-foreground mb-6">Detaillierte Designs, 3D-Modelle oder interaktive Prototypen.</p>
          <p class="text-sm text-primary font-medium">Der rote Faden wird greifbar – immer testbar.</p>
        </div>

        <!-- Schritt 5 -->
        <div class="bg-white border border-border rounded-3xl p-10 hover:shadow-xl transition-all group">
          <div class="w-12 h-12 bg-primary text-white rounded-full flex items-center justify-center text-2xl font-semibold mb-6">5</div>
          <h3 class="text-xl font-semibold mb-4">Umsetzung</h3>
          <p class="text-muted-foreground mb-6">Koordination mit Handwerkern oder Entwicklern bis zur fertigen Realisierung.</p>
          <p class="text-sm text-primary font-medium">Der rote Faden wird Wirklichkeit – in beiden Welten.</p>
        </div>

        <!-- Schritt 6 -->
        <div class="bg-white border border-border rounded-3xl p-10 hover:shadow-xl transition-all group">
          <div class="w-12 h-12 bg-primary text-white rounded-full flex items-center justify-center text-2xl font-semibold mb-6">6</div>
          <h3 class="text-xl font-semibold mb-4">Nachbetreuung &amp; Feinschliff</h3>
          <p class="text-muted-foreground mb-6">Feedback-Runden, langfristige Begleitung und finaler Feinschliff.</p>
          <p class="text-sm text-primary font-medium">Der rote Faden bleibt bestehen – auch nach der Fertigstellung.</p>
        </div>

      </div>
    </div>
  </section>

  <!-- === SKILLS & TOOLS – FINAL BALANCED 10/10 === -->
  <section class="py-28 bg-background">
    <div class="max-w-6xl mx-auto px-6">
      <h2 class="text-4xl font-semibold tracking-tight mb-16 text-left">Skills &amp; Tools</h2>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10">

        <!-- DESIGN -->
        <div class="bg-white border border-border rounded-3xl p-10 hover:shadow-xl transition-all">
          <h3 class="text-xl font-semibold mb-8 text-primary">Design</h3>
          <ul class="space-y-4 text-sm text-muted-foreground">
            <li>✓ UX/UI · Interaction Design</li>
            <li>✓ Information Architecture &amp; Wireframing</li>
            <li>✓ Spatial Concept &amp; Raumplanung</li>
            <li>✓ User Research &amp; User Journey Maps</li>
            <li>✓ 3D-Modelle &amp; Moodboards</li>
          </ul>
        </div>

        <!-- TOOLS -->
        <div class="bg-white border border-border rounded-3xl p-10 hover:shadow-xl transition-all">
          <h3 class="text-xl font-semibold mb-8 text-primary">Tools</h3>
          <ul class="space-y-4 text-sm text-muted-foreground">
            <li>✓ Figma · FigJam · Adobe Creative Suite</li>
            <li>✓ Vectorworks · AutoCAD · Cinema 4D</li>
            <li>✓ Notion · 3D/CAD</li>
            <li>✓ Photoshop · InDesign · Illustrator</li>
          </ul>
        </div>

        <!-- METHODEN -->
        <div class="bg-white border border-border rounded-3xl p-10 hover:shadow-xl transition-all">
          <h3 class="text-xl font-semibold mb-8 text-primary">Methoden</h3>
          <ul class="space-y-4 text-sm text-muted-foreground">
            <li>✓ User Research &amp; Usability Testing</li>
            <li>✓ Prototyping (High-Fidelity)</li>
            <li>✓ Design Systeme &amp; Micro-Interactions</li>
            <li>✓ Projektleitung &amp; Koordination mit Handwerkern</li>
            <li>✓ Leistungsphasen 1-9 &amp; iterative Feinschliff</li>
            <li>✓ Baustellenbegleitung &amp; langfristige Realisierung</li>
          </ul>
        </div>

        <!-- WERTE -->
        <div class="bg-white border border-border rounded-3xl p-10 hover:shadow-xl transition-all">
          <h3 class="text-xl font-semibold mb-8 text-primary">Werte</h3>
          <ul class="space-y-4 text-sm text-muted-foreground">
            <li>✓ Klarheit · Ruhe · Intuitive Nutzung</li>
            <li>✓ Mensch im Mittelpunkt</li>
            <li>✓ Kreativität &amp; strategisches Denken</li>
            <li>✓ Zuverlässigkeit &amp; lösungsorientiert</li>
            <li>✓ Transparenz &amp; enge Abstimmung</li>
          </ul>
        </div>

      </div>
    </div>
  </section>

  <!-- === INNENARCHITEKTUR & UX/UI DESIGN – 10/10 FINAL === -->
  <section class="py-28 bg-background">
    <div class="max-w-6xl mx-auto px-6">
      <h2 class="text-4xl font-semibold tracking-tight mb-16 text-left">Innenarchitektur &amp; UX/UI Design</h2>

      <div class="mb-16">
        <p class="text-xl text-muted-foreground">
          Ich liebe beide Welten – und beherrsche sie mit der gleichen Leidenschaft.
          Ob physischer Raum oder digitales Erlebnis: <span class="text-primary font-semibold">Immer steht der Mensch im Mittelpunkt.</span>
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-12">

        <!-- Innenarchitektur -->
        <div class="group bg-white border border-border rounded-3xl overflow-hidden hover:shadow-xl transition-all">
          <img src="/images/innenarchitektur-mood.jpg"
               alt="Innenarchitektur – einladender Raum mit Menschen"
               class="w-full h-64 object-cover group-hover:scale-105 transition-transform duration-500">
          <div class="p-10">
            <h3 class="text-2xl font-semibold mb-6">Innenarchitektur</h3>
            <p class="text-muted-foreground mb-8">Von der ersten Idee bis zur fertigen Umsetzung gestalte ich Räume, die Menschen berühren.</p>
            <ul class="space-y-3 text-sm">
              <li class="flex items-start gap-3">✓ <span class="text-primary font-semibold">Raumplanung &amp; Konzeption</span></li>
              <li class="flex items-start gap-3">✓ <span class="text-primary font-semibold">Möbel- &amp; Lichtdesign</span></li>
              <li class="flex items-start gap-3">✓ <span class="text-primary font-semibold">Projektleitung bis zur Fertigstellung</span></li>
            </ul>
          </div>
        </div>

        <!-- UX/UI Design -->
        <div class="group bg-white border border-border rounded-3xl overflow-hidden hover:shadow-xl transition-all">
          <img src="/images/ux-ui-mood.jpg"
               alt="UX/UI Design – intuitive digitale Erlebnisse"
               class="w-full h-64 object-cover group-hover:scale-105 transition-transform duration-500">
          <div class="p-10">
            <h3 class="text-2xl font-semibold mb-6">UX/UI Design</h3>
            <p class="text-muted-foreground mb-8">Ich entwickle digitale Produkte, die intuitiv und emotional wirken.</p>
            <ul class="space-y-3 text-sm">
              <li class="flex items-start gap-3">✓ <span class="text-primary font-semibold">User Research &amp; Wireframing</span></li>
              <li class="flex items-start gap-3">✓ <span class="text-primary font-semibold">Interaktive Prototypen</span></li>
              <li class="flex items-start gap-3">✓ <span class="text-primary font-semibold">Design Systeme &amp; Micro-Interactions</span></li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- === FAQ – 6 FRAGEN (final, mit deinen exakten Wünschen) === -->
  <section class="py-28 bg-background">
    <div class="max-w-6xl mx-auto px-6">
      <h2 class="text-4xl font-semibold tracking-tight mb-16 text-left">Häufig gestellte Fragen</h2>

      <div class="space-y-6">

        <!-- 1. Remote -->
        <details class="group bg-white rounded-3xl p-8 shadow-sm hover:shadow-xl transition-all">
          <summary class="flex items-center justify-between text-lg font-medium cursor-pointer list-none">
            Arbeitest du remote?
            <span class="text-primary text-2xl group-open:rotate-180 transition-transform">↓</span>
          </summary>
          <p class="text-muted-foreground mt-6 leading-relaxed">
            Ja, ich arbeite <span class="text-primary font-semibold">voll remote</span> und hybrid. Ich bin flexibel und kann auf Anfrage auch gerne vor Ort in Lüneburg oder Hamburg sein.
          </p>
        </details>

        <!-- 2. Projektdauer -->
        <details class="group bg-white rounded-3xl p-8 shadow-sm hover:shadow-xl transition-all">
          <summary class="flex items-center justify-between text-lg font-medium cursor-pointer list-none">
            Wie lange dauert ein Projekt?
            <span class="text-primary text-2xl group-open:rotate-180 transition-transform">↓</span>
          </summary>
          <p class="text-muted-foreground mt-6 leading-relaxed">
            Das hängt vom <span class="text-primary font-semibold">Umfang der Anfrage</span> ab, ob es ein Relaunch einer bestehenden Website ist oder eine Neuerstellung einer App im UX/UI-Bereich, eine Beratung im Innenarchitektur-Bereich oder ein kompletter Umbau von der ersten Besprechung bis zur fertigen Umsetzung inklusiver Nachbetreuung in den LPH 1-9 ist. Ich gebe dir immer von Anfang an eine <span class="text-primary font-semibold">zeitliche Übersicht</span>.
          </p>
        </details>

        <!-- 3. Teilzeit / Festanstellung -->
        <details class="group bg-white rounded-3xl p-8 shadow-sm hover:shadow-xl transition-all">
          <summary class="flex items-center justify-between text-lg font-medium cursor-pointer list-none">
            Arbeitest du auch Teilzeit oder in Festanstellung?
            <span class="text-primary text-2xl group-open:rotate-180 transition-transform">↓</span>
          </summary>
          <p class="text-muted-foreground mt-6 leading-relaxed">
            Ja, beides ist möglich. Ich bin offen für <span class="text-primary font-semibold">Teilzeit, Festanstellung oder Freelance-Projekte</span>. Lass uns einfach sprechen, was am besten zu Dir passt.
          </p>
        </details>

        <!-- 4. Zusammenarbeit -->
        <details class="group bg-white rounded-3xl p-8 shadow-sm hover:shadow-xl transition-all">
          <summary class="flex items-center justify-between text-lg font-medium cursor-pointer list-none">
            Wie läuft die Zusammenarbeit ab?
            <span class="text-primary text-2xl group-open:rotate-180 transition-transform">↓</span>
          </summary>
          <p class="text-muted-foreground mt-6 leading-relaxed">
            Jede Zusammenarbeit startet mit einem kurzen Erstgespräch. Danach erarbeiten wir gemeinsam ein klares Konzept, es gibt regelmäßige Updates und ich bin immer persönlich für Dich erreichbar. <span class="text-primary font-semibold">Transparenz und enge Abstimmung</span> sind mir sehr wichtig.
          </p>
        </details>

        <!-- 5. Gastronomie / Hotellerie / Health Care -->
        <details class="group bg-white rounded-3xl p-8 shadow-sm hover:shadow-xl transition-all">
          <summary class="flex items-center justify-between text-lg font-medium cursor-pointer list-none">
            Bietest du auch Projekte im Bereich Gastronomie, Hotellerie oder Health Care an?
            <span class="text-primary text-2xl group-open:rotate-180 transition-transform">↓</span>
          </summary>
          <p class="text-muted-foreground mt-6 leading-relaxed">
            Ja! Das sind sogar meine <span class="text-primary font-semibold">Lieblingsbereiche</span>. Ich habe bereits Erfahrungen mit Restaurants, Cafés, Hotels, Yoga-Studios und Health-Projekten, sowohl in der Innenarchitektur als auch Testprojekte im UX/UI-Bereich.
          </p>
        </details>

        <!-- 6. Workshops / Beratung -->
        <details class="group bg-white rounded-3xl p-8 shadow-sm hover:shadow-xl transition-all">
          <summary class="flex items-center justify-between text-lg font-medium cursor-pointer list-none">
            Bietest du auch Workshops oder Beratung an?
            <span class="text-primary text-2xl group-open:rotate-180 transition-transform">↓</span>
          </summary>
          <p class="text-muted-foreground mt-6 leading-relaxed">
            Ja! Design-Workshops, Strategie-Sessions und Beratung gehören zum <span class="text-primary font-semibold">typischen Projektverlauf</span> dazu oder können auch <span class="text-primary font-semibold">extern angefragt</span> werden, besonders im Bereich Gastronomie, Hotellerie, Health Care und persönliche Weiterentwicklung.
          </p>
        </details>
      </div>
    </div>
  </section>

  <!-- === TESTIMONIALS – ALLE 6 ZITATE (mit einheitlicher Höhe + deutschem „) === -->
  <section class="py-28 bg-background">
    <div class="max-w-6xl mx-auto px-6">
      <h2 class="text-4xl font-semibold tracking-tight mb-16 text-left">Was andere über meine Arbeitsweise sagen</h2>

      <div class="grid md:grid-cols-3 gap-8">

        <!-- Zitat 1 -->
        <div class="bg-white rounded-3xl p-10 shadow-sm hover:shadow-xl transition-all flex flex-col min-h-[520px] group relative">
          <div class="absolute top-8 left-8 text-8xl text-primary/10 leading-none">„</div>
          <p class="text-lg text-muted-foreground leading-relaxed flex-1 mb-10 pt-12">
            „Frau Warncke überzeugt durch umfangreiche <span class="text-primary font-semibold">Fachkenntnisse</span> und <span class="text-primary font-semibold">kreativen Output</span>, die sie zur Erfüllung ihrer Aufgaben sehr erfolgreich einsetzt. [...] Dabei zeichnet sie sich unter anderem besonders durch ihre sehr guten Kenntnisse und ihr Wissen in den Bereichen der <span class="text-primary font-semibold">Grafik, Layout und Produktgestaltung</span> aus."
          </p>
          <div class="flex items-center gap-4 mt-auto">
            <div class="w-12 h-12 bg-primary text-white rounded-btn flex items-center justify-center font-semibold text-xs tracking-wide shadow-md">FK</div>
            <div>
              <p class="font-medium">Florian Kienast</p>
              <p class="text-sm text-muted-foreground">Geschäftsführer, FORMWÆNDE GmbH &amp; Co. KG</p>
            </div>
          </div>
        </div>

        <!-- Zitat 2 -->
        <div class="bg-white rounded-3xl p-10 shadow-sm hover:shadow-xl transition-all flex flex-col min-h-[520px] group relative">
          <div class="absolute top-8 left-8 text-8xl text-primary/10 leading-none">„</div>
