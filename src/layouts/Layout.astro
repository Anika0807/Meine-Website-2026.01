---
import '@/styles/global.css';
import Navigation from '@/components/Navigation';
import LanguageToggle from '@/components/LanguageToggle';
import ThemeToggle from '@/components/ThemeToggle';
import AccessibilityPanel from '@/components/AccessibilityPanel';
import CookieBanner from '@/components/CookieBanner';
import { mapLocalizedPath } from '@/lib/language';

type SeoSchemaType = 'WebSite' | 'WebPage' | 'ProfilePage' | 'CollectionPage' | 'ContactPage' | 'AboutPage';

const {
  title = 'Anika Warncke | Innenarchitektur & UX/UI Design',
  description: descriptionProp,
  ogTitle,
  ogDescription,
  ogImage: ogImageProp,
  noindex = false,
  schemaType: schemaTypeProp,
} = Astro.props;

const ssrLocale = Astro.url.pathname.startsWith('/en') ? 'en' : 'de';
const normalizePath = (path: string) => {
  if (path.length > 1 && path.endsWith('/')) return path.slice(0, -1);
  return path;
};
const currentPath = normalizePath(Astro.url.pathname);
const isNavActive = (targetPath: string) => {
  const normalizedTarget = normalizePath(targetPath);
  if (normalizedTarget === '/' || normalizedTarget === '/en') {
    return currentPath === normalizedTarget;
  }
  return currentPath === normalizedTarget || currentPath.startsWith(`${normalizedTarget}/`);
};
const navLinkClass = (targetPath: string) =>
  `nav-link transition-colors ${
    isNavActive(targetPath)
      ? 'font-semibold text-primary underline underline-offset-8 decoration-2 decoration-primary'
      : 'hover:text-primary'
  }`;

type SeoDefaults = {
  description: string;
  schemaType: SeoSchemaType;
  ogImage: string;
  ogTitle?: string;
};

const getSeoDefaults = (path: string, locale: 'de' | 'en'): SeoDefaults => {
  const exactPageSeo: Record<string, { description: string; schemaType: SeoSchemaType; ogImage: string; ogTitle: string }> = {
    '/projekte/my-mind-studio': {
      description: 'My Mind Studio: Innenarchitektur fuer ein Meditations- und Yogastudio mit Cafe.',
      schemaType: 'WebPage',
      ogImage: '.webp',
      ogTitle: 'My Mind Studio - Innenarchitektur Projekt | Anika Warncke',
    },
    '/projekte/naturkompass': {
      description: 'NaturKompass Case Study: UX/UI Design fuer eine mobile App zur Flora- und Fauna-Erkennung.',
      schemaType: 'WebPage',
      ogImage: '.webp',
      ogTitle: 'NaturKompass - UX/UI Case Study | Anika Warncke',
    },
    '/projekte/festsaal-im-klostergasthof': {
      description: 'Festsaal im Klostergasthof: Innenarchitektur fuer Veranstaltungsgastronomie und Events.',
      schemaType: 'WebPage',
      ogImage: '.webp',
      ogTitle: 'Festsaal im Klostergasthof - Innenarchitektur | Anika Warncke',
    },
    '/projekte/flavorfusion': {
      description: 'FlavorFusion Case Study: UX/UI Konzeption und Landing Page fuer eine mobile Rezepte-App.',
      schemaType: 'WebPage',
      ogImage: '.webp',
      ogTitle: 'FlavorFusion - UX/UI Case Study | Anika Warncke',
    },
    '/projekte/schlaf': {
      description: 'SCHLAF: Innenarchitektur und Raumkonzept fuer eine immersive Ausstellung zum Schlaf.',
      schemaType: 'WebPage',
      ogImage: '.webp',
      ogTitle: 'SCHLAF - Innenarchitektur Ausstellungskonzept | Anika Warncke',
    },
    '/projekte/omnomzen': {
      description: 'OmNomZen Case Study: UX/UI Design fuer eine Marke mit Fokus auf Stressabbau und Wohlbefinden.',
      schemaType: 'WebPage',
      ogImage: '.webp',
      ogTitle: 'OmNomZen - UX/UI Case Study | Anika Warncke',
    },
    '/projekte/weserkoje': {
      description: 'Weserkoje: Innenarchitektur fuer eine multifunktionale Herberge mit Tagungszentrum.',
      schemaType: 'WebPage',
      ogImage: '.webp',
      ogTitle: 'Weserkoje - Innenarchitektur Projekt | Anika Warncke',
    },
    '/projekte/planora': {
      description: 'Planora Case Study: UX/UI Design fuer eine flexible und nutzerzentrierte Reiseplanung.',
      schemaType: 'WebPage',
      ogImage: '.webp',
      ogTitle: 'Planora - UX/UI Case Study | Anika Warncke',
    },

    '/en/projects/my-mind-studio': {
      description: 'My Mind Studio: Interior architecture case study for a meditation and yoga studio with cafe.',
      schemaType: 'WebPage',
      ogImage: '.webp',
      ogTitle: 'My Mind Studio - Interior Architecture Case Study | Anika Warncke',
    },
    '/en/projects/naturkompass': {
      description: 'NaturKompass case study: UX/UI design for a mobile flora and fauna identification app.',
      schemaType: 'WebPage',
      ogImage: '.webp',
      ogTitle: 'NaturKompass - UX/UI Case Study | Anika Warncke',
    },
    '/en/projects/festsaal-im-klostergasthof': {
      description: 'Banquet Hall at the Monastery Inn: Interior architecture for hospitality events and celebrations.',
      schemaType: 'WebPage',
      ogImage: '.webp',
      ogTitle: 'Banquet Hall at the Monastery Inn - Interior Architecture | Anika Warncke',
    },
    '/en/projects/flavorfusion': {
      description: 'FlavorFusion case study: UX/UI concept and landing page design for a mobile recipe app.',
      schemaType: 'WebPage',
      ogImage: '.webp',
      ogTitle: 'FlavorFusion - UX/UI Case Study | Anika Warncke',
    },
    '/en/projects/schlaf': {
      description: 'SCHLAF: Interior architecture and spatial concept for an immersive exhibition about sleep.',
      schemaType: 'WebPage',
      ogImage: '.webp',
      ogTitle: 'SCHLAF - Interior Architecture Exhibition Concept | Anika Warncke',
    },
    '/en/projects/omnomzen': {
      description: 'OmNomZen case study: UX/UI design for a wellness-focused product and digital experience.',
      schemaType: 'WebPage',
      ogImage: '.webp',
      ogTitle: 'OmNomZen - UX/UI Case Study | Anika Warncke',
    },
    '/en/projects/weserkoje': {
      description: 'Weserkoje: Interior architecture for a multifunctional hostel with an integrated conference center.',
      schemaType: 'WebPage',
      ogImage: '.webp',
      ogTitle: 'Weserkoje - Interior Architecture Case Study | Anika Warncke',
    },
    '/en/projects/planora': {
      description: 'Planora case study: UX/UI design for adaptive and user-centered travel planning.',
      schemaType: 'WebPage',
      ogImage: '.webp',
      ogTitle: 'Planora - UX/UI Case Study | Anika Warncke',
    },
  };

  const exact = exactPageSeo[path];
  if (exact) return exact;

  if (path === '/' || path === '/en') {
    return {
      description:
        locale === 'en'
          ? 'Portfolio of Anika Warncke: Interior Architecture, UX/UI Design and selected projects.'
          : 'Portfolio von Anika Warncke: Innenarchitektur, UX/UI Design und ausgewählte Projekte.',
      schemaType: 'WebSite' as SeoSchemaType,
      ogImage: '.webp',
    };
  }

  if (path === '/projekte' || path === '/en/projects') {
    return {
      description:
        locale === 'en'
          ? 'Project overview by Anika Warncke: Interior Architecture and UX/UI case studies.'
          : 'Projektübersicht von Anika Warncke: Innenarchitektur- und UX/UI-Case-Studies.',
      schemaType: 'CollectionPage' as SeoSchemaType,
      ogImage: '.webp',
    };
  }

  if (path.startsWith('/projekte/') || path.startsWith('/en/projects/')) {
    return {
      description:
        locale === 'en'
          ? 'Case study by Anika Warncke with process, concept and visual results.'
          : 'Case Study von Anika Warncke mit Prozess, Konzept und visuellen Ergebnissen.',
      schemaType: 'WebPage' as SeoSchemaType,
      ogImage: '.webp',
    };
  }

  if (path === '/ueber-mich' || path === '/en/about') {
    return {
      description:
        locale === 'en'
          ? 'Learn more about Anika Warncke, her profile, values and design approach.'
          : 'Erfahre mehr über Anika Warncke, ihr Profil, ihre Werte und ihre Designhaltung.',
      schemaType: 'ProfilePage' as SeoSchemaType,
      ogImage: '.webp',
    };
  }

  if (path === '/kontakt' || path === '/en/contact') {
    return {
      description:
        locale === 'en'
          ? 'Contact Anika Warncke for Interior Architecture and UX/UI Design projects.'
          : 'Kontakt zu Anika Warncke für Projekte in Innenarchitektur und UX/UI Design.',
      schemaType: 'ContactPage' as SeoSchemaType,
      ogImage: '.webp',
    };
  }

  return {
    description:
      locale === 'en'
        ? 'Portfolio of Anika Warncke: Interior Architecture, UX/UI Design and projects.'
        : 'Portfolio von Anika Warncke: Innenarchitektur, UX/UI Design und Projekte.',
    schemaType: 'WebPage' as SeoSchemaType,
    ogImage: '.webp',
  };
};

const seoDefaults = getSeoDefaults(currentPath, ssrLocale as 'de' | 'en');
const description = descriptionProp ?? seoDefaults.description;
const schemaType = (schemaTypeProp as SeoSchemaType | undefined) ?? seoDefaults.schemaType;
const ogImage = ogImageProp ?? seoDefaults.ogImage;

const siteOrigin = Astro.site?.toString() ?? Astro.url.origin;
const base = new URL(siteOrigin);
const canonicalUrl = new URL(Astro.url.pathname + Astro.url.search, base).toString();
const absoluteOgImage = ogImage.startsWith('http') ? ogImage : new URL(ogImage, base).toString();
const effectiveOgTitle = ogTitle ?? seoDefaults.ogTitle ?? title;
const effectiveOgDescription = ogDescription ?? description;

const englishPath = mapLocalizedPath(currentPath, 'en');
const germanPath = mapLocalizedPath(currentPath, 'de');

const hreflangDe = new URL(germanPath, base).toString();
const hreflangEn = new URL(englishPath, base).toString();

const schemaData = {
  '@context': 'https://schema.org',
  '@type': schemaType,
  inLanguage: ssrLocale,
  url: canonicalUrl,
  name: title,
  description,
};
---

<html lang={ssrLocale} data-current-locale={ssrLocale} data-german-path={germanPath} data-english-path={englishPath}>
  <head>
    <!-- Google tag (gtag.js) - GA4 mit Consent Mode v2 -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-T3NYM3DF9X"></script>
    <script>
      (window as any).dataLayer = (window as any).dataLayer || [];
      function gtag(...args: any[]) { (window as any).dataLayer.push(args); }
      (window as any).gtag = gtag;

      // Default: Alles denied (DSGVO-konform)
      gtag('consent', 'default', {
        ad_storage: 'denied',
        analytics_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied'
      });

      gtag('js', new Date());
      gtag('config', 'G-T3NYM3DF9X', {
        cookie_flags: 'SameSite=None;Secure',
        anonymize_ip: true
      });
    </script>

    <meta charset="utf-8" />
    <link rel="preload" href="/fonts/Inter/inter-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/opendyslexic/opendyslexic-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/satoshi/satoshi-medium.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/satoshi/satoshi-bold.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/satoshi/satoshi-black.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="astro-view-transitions" content="true" />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    <meta property="og:locale" content={ssrLocale === 'en' ? 'en_US' : 'de_DE'} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={effectiveOgTitle} />
    <meta property="og:description" content={effectiveOgDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={absoluteOgImage} />
    <meta property="og:site_name" content="Anika Warncke" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={effectiveOgTitle} />
    <meta name="twitter:description" content={effectiveOgDescription} />
    <meta name="twitter:image" content={absoluteOgImage} />
    <link rel="icon" href="/Logo_AW_26.svg" type="image/svg+xml" />
    <link rel="alternate icon" href="/favicon.ico" sizes="any" />
    <link rel="preconnect" href="https://www.googletagmanager.com" />
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="de" href={hreflangDe} />
    <link rel="alternate" hreflang="en" href={hreflangEn} />
    <link rel="alternate" hreflang="x-default" href={hreflangDe} />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
    <script is:inline>
      (function() {
        var readCookie = function(name) {
          var escapedName = name.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
          var match = document.cookie.match(new RegExp('(?:^|; )' + escapedName + '=([^;]*)'));
          return match ? decodeURIComponent(match[1]) : null;
        };

        var normalizePath = function(path) {
          return path.length > 1 && path.endsWith('/') ? path.slice(0, -1) : path;
        };

        var root = document.documentElement;
        var currentLocale = root.dataset.currentLocale || 'de';
        var germanPath = normalizePath(root.dataset.germanPath || '/');
        var englishPath = normalizePath(root.dataset.englishPath || '/en');
        var userAgent = (navigator.userAgent || '').toLowerCase();
        var isCrawler = /bot|crawler|spider|crawling|googlebot|bingbot|slurp|duckduckbot|baiduspider|yandexbot|facebookexternalhit|facebot|twitterbot|linkedinbot|slackbot|whatsapp|telegrambot|discordbot/.test(userAgent);
        var savedLocale =
          readCookie('PARAGLIDE_LOCALE') ||
          readCookie('lang') ||
          localStorage.getItem('PARAGLIDE_LOCALE') ||
          localStorage.getItem('lang');
        var browserLocale = ((navigator.languages && navigator.languages[0]) || navigator.language || 'en').toLowerCase();
        var preferredLocale = savedLocale === 'de' || savedLocale === 'en'
          ? savedLocale
          : (browserLocale.startsWith('de') ? 'de' : 'en');
        var targetPath = preferredLocale === 'en' ? englishPath : germanPath;
        var currentPath = normalizePath(window.location.pathname);

        if (isCrawler) {
          return;
        }

        localStorage.setItem('PARAGLIDE_LOCALE', preferredLocale);
        localStorage.setItem('lang', preferredLocale);
        document.cookie = 'PARAGLIDE_LOCALE=' + preferredLocale + '; path=/; max-age=34560000; samesite=lax';
        document.cookie = 'lang=' + preferredLocale + '; path=/; max-age=34560000; samesite=lax';

        if (preferredLocale !== currentLocale && currentPath !== targetPath) {
          window.location.replace(targetPath);
        }
      })();
    </script>
    <!-- Theme-Script: verhindert Flackern beim Laden -->
    <script is:inline>
      (function() {
        var t = localStorage.getItem('theme') || 'system';
        var dark = t === 'dark' || (t === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
        if (dark) document.documentElement.classList.add('dark');
      })();
    </script>
  </head>

  <body class="bg-background text-foreground antialiased min-h-screen flex flex-col">
    <div id="scroll-progress" aria-hidden="true"></div>
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:rounded-md focus:bg-primary focus:px-4 focus:py-2 focus:text-primary-foreground focus:outline-none focus:ring-4 focus:ring-primary/40">
      {ssrLocale === 'en' ? 'Skip to main content' : 'Zum Hauptinhalt springen'}
    </a>
    <!-- MOBILE HEADER ONLY - Desktop bleibt 100% unveraendert -->
    <header class="md:hidden bg-white/60 dark:bg-black/45 backdrop-blur-xl sticky top-0 z-50 border-b-0 transition-all duration-300" data-scroll="up">
      <div class="px-6 py-6 flex items-center justify-between">
          <a href={ssrLocale === 'en' ? '/en/' : '/'} class="text-[20px] font-semibold tracking-[-0.015em] text-foreground focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-primary/40 rounded-md">
          Anika Warncke
        </a>

        <div class="flex items-center gap-x-5">
          <LanguageToggle client:only="react" />
          <Navigation client:only="react" />
        </div>
      </div>
    </header>

    <!-- Sticky Header Desktop -->
    <header class="hidden md:block bg-white/60 dark:bg-black/45 backdrop-blur-xl sticky top-0 z-50" data-scroll="up">
      <div class="max-w-7xl mx-auto px-8 py-9 flex items-center justify-between">
        <a href={ssrLocale === 'en' ? '/en/' : '/'} class="text-[28px] font-semibold tracking-[-0.025em] text-foreground focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-primary/40 rounded-md">Anika Warncke</a>

        <nav class="flex items-center gap-x-10 text-lg font-medium">
          <a href={ssrLocale === 'en' ? '/en' : '/'} class={navLinkClass(ssrLocale === 'en' ? '/en' : '/')}>{ssrLocale === 'en' ? 'Home' : 'Home'}</a>
          <a href={ssrLocale === 'en' ? '/en/projects' : '/projekte'} class={navLinkClass(ssrLocale === 'en' ? '/en/projects' : '/projekte')}>{ssrLocale === 'en' ? 'Projects' : 'Projekte'}</a>
          <a href={ssrLocale === 'en' ? '/en/about' : '/ueber-mich'} class={navLinkClass(ssrLocale === 'en' ? '/en/about' : '/ueber-mich')}>{ssrLocale === 'en' ? 'About me' : 'Über mich'}</a>
          <a href={ssrLocale === 'en' ? '/en/contact' : '/kontakt'} class={navLinkClass(ssrLocale === 'en' ? '/en/contact' : '/kontakt')}>{ssrLocale === 'en' ? 'Contact' : 'Kontakt'}</a>
        </nav>

        <div class="flex items-center gap-x-6">
          <LanguageToggle client:only="react" />
          <ThemeToggle client:only="react" />
        </div>
      </div>
    </header>

      <script is:inline>
        let lastScroll = 0;
        window.addEventListener('scroll', () => {
          const headers = document.querySelectorAll('header[data-scroll="up"]');
          const currentScroll = window.scrollY;

          headers.forEach((header) => {
            if (currentScroll > lastScroll && currentScroll > 100) {
              header.classList.add('translate-y-[-100%]');
            } else {
              header.classList.remove('translate-y-[-100%]');
            }
            header.classList.toggle('shadow-md', currentScroll > 10);
          });

          lastScroll = currentScroll;
        });

        function isProjectDetailPath(pathname) {
          const isGermanProjectDetail = pathname.startsWith('/projekte/') && pathname !== '/projekte/';
          const isEnglishProjectDetail = pathname.startsWith('/en/projects/') && pathname !== '/en/projects/';
          return isGermanProjectDetail || isEnglishProjectDetail;
        }

        function getProjectMeta() {
          const titleNode = document.querySelector('main h1');
          const projectName = titleNode?.textContent?.trim() || 'Unknown Project';

          const categoryCandidates = Array.from(document.querySelectorAll('main p'));
          const categoryNode = categoryCandidates.find((node) => {
            const txt = node.textContent?.trim() || '';
            return /Innenarchitektur|UX\/UI|Interior Architecture|UX\/UI Design/i.test(txt);
          });

          const projectCategory = categoryNode?.textContent?.trim() || 'Unknown';
          return { projectName, projectCategory };
        }

        function getCookieValue(name) {
          const escapedName = name.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
          const match = document.cookie.match(new RegExp('(?:^|; )' + escapedName + '=([^;]*)'));
          return match ? decodeURIComponent(match[1]) : null;
        }

        function syncAnalyticsConsentFromCookie() {
          const consentValue = getCookieValue('meineWebsiteConsent');
          if (consentValue === 'true') {
            window.gtag?.('consent', 'update', {
              analytics_storage: 'granted',
              ad_storage: 'denied',
              ad_user_data: 'denied',
              ad_personalization: 'denied',
            });
            return;
          }

          if (consentValue === 'false') {
            window.gtag?.('consent', 'update', {
              analytics_storage: 'denied',
              ad_storage: 'denied',
              ad_user_data: 'denied',
              ad_personalization: 'denied',
            });
          }
        }

        function resetCookieConsent() {
          window.gtag?.('consent', 'update', {
            analytics_storage: 'denied',
            ad_storage: 'denied',
            ad_user_data: 'denied',
            ad_personalization: 'denied',
          });

          document.cookie = 'meineWebsiteConsent=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/';
          window.location.reload();
        }

        function initPortfolioAnalytics() {
          const pathname = window.location.pathname;

          if (window.__portfolioAnalyticsCleanup) {
            window.__portfolioAnalyticsCleanup();
            window.__portfolioAnalyticsCleanup = null;
          }

          if (!isProjectDetailPath(pathname)) return;

          const meta = getProjectMeta();
          window.gtag?.('event', 'project_view', {
            project_name: meta.projectName,
            project_category: meta.projectCategory,
          });

          let scrollDepthTracked = false;
          const onScrollDepth = () => {
            if (scrollDepthTracked) return;
            const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
            if (maxScroll <= 0) return;
            const percentScrolled = Math.round((window.scrollY / maxScroll) * 100);

            if (percentScrolled >= 75) {
              scrollDepthTracked = true;
              window.gtag?.('event', 'scroll_depth', {
                percent_scrolled: 75,
                project_name: meta.projectName,
              });
              window.removeEventListener('scroll', onScrollDepth);
            }
          };

          window.addEventListener('scroll', onScrollDepth, { passive: true });

          const onButtonClick = (event) => {
            const target = event.target;
            if (!(target instanceof Element)) return;

            const clickable = target.closest('a, button, [role="button"], [data-slot="button"], [role="link"][tabindex]');
            if (!(clickable instanceof HTMLElement)) return;

            const buttonName =
              clickable.getAttribute('aria-label') ||
              clickable.textContent?.replace(/\s+/g, ' ').trim() ||
              'Unknown Button';

            window.gtag?.('event', 'button_click', {
              button_name: buttonName,
              project_name: meta.projectName,
            });
          };

          document.addEventListener('click', onButtonClick);

          window.__portfolioAnalyticsCleanup = () => {
            window.removeEventListener('scroll', onScrollDepth);
            document.removeEventListener('click', onButtonClick);
          };
        }

        function mountProjectHeroScrollIndicator() {
          const pathname = window.location.pathname;
          const isGermanProjectDetail = pathname.startsWith('/projekte/') && pathname !== '/projekte/';
          const isEnglishProjectDetail = pathname.startsWith('/en/projects/') && pathname !== '/en/projects/';
          const isProjectDetail = isGermanProjectDetail || isEnglishProjectDetail;

          const oldIndicator = document.getElementById('project-hero-scroll-indicator');
          if (oldIndicator) oldIndicator.remove();
          if (!isProjectDetail) return;

          const hero = document.querySelector('main > section.relative');
          if (!(hero instanceof HTMLElement)) return;

          // Mobile-Optimierung: Hero so komprimieren, dass Titel + Subtitle + Scroll-Hinweis
          // im ersten Viewport sichtbar bleiben (inkl. sticky Header).
          if (window.innerWidth < 768) {
            const mobileHeader = document.querySelector('header.md\\:hidden');
            const headerHeight = mobileHeader instanceof HTMLElement ? mobileHeader.offsetHeight : 88;
            hero.style.minHeight = `calc(100svh - ${Math.max(72, headerHeight)}px)`;
            hero.style.paddingTop = '0.75rem';
            hero.style.paddingBottom = '5.5rem';

            const heroTextWrap = hero.querySelector('div.relative.z-10.text-center');
            if (heroTextWrap instanceof HTMLElement) {
              heroTextWrap.style.maxWidth = '22rem';
              heroTextWrap.style.paddingLeft = '1rem';
              heroTextWrap.style.paddingRight = '1rem';

              const title = heroTextWrap.querySelector('h1');
              if (title instanceof HTMLElement) {
                title.style.fontSize = 'clamp(2.1rem, 11vw, 3rem)';
                title.style.lineHeight = '0.95';
              }

              const subtitle = heroTextWrap.querySelector('p.reveal-item.mt-5');
              if (subtitle instanceof HTMLElement) {
                subtitle.style.marginTop = '0.75rem';
                subtitle.style.fontSize = 'clamp(0.95rem, 4.3vw, 1.2rem)';
                subtitle.style.lineHeight = '1.3';
                subtitle.style.maxWidth = '19rem';
              }

              const category = heroTextWrap.querySelector('p.reveal-item.text-sm');
              if (category instanceof HTMLElement) {
                category.style.marginBottom = '0.55rem';
                category.style.fontSize = '0.72rem';
                category.style.letterSpacing = '0.2em';
              }
            }
          } else {
            hero.style.minHeight = '';
            hero.style.paddingTop = '';
            hero.style.paddingBottom = '';
          }

          const label = isEnglishProjectDetail ? 'SCROLL' : 'SCROLLEN';
          const isMobile = window.innerWidth < 768;
          const indicator = document.createElement('div');
          indicator.id = 'project-hero-scroll-indicator';
          indicator.setAttribute('aria-hidden', 'true');
          indicator.style.position = 'absolute';
          indicator.style.left = '50%';
          indicator.style.bottom = isMobile
            ? 'max(1.25rem, calc(env(safe-area-inset-bottom) + 0.75rem))'
            : 'clamp(8rem, 16vh, 11rem)';
          indicator.style.transform = 'translateX(-50%)';
          indicator.style.display = 'flex';
          indicator.style.flexDirection = 'column';
          indicator.style.alignItems = 'center';
          indicator.style.gap = isMobile ? '0.5rem' : '0.75rem';
          indicator.style.color = isMobile ? 'rgba(255,255,255,0.95)' : '#ffffff';
          indicator.style.zIndex = '60';
          indicator.style.pointerEvents = 'none';
          if (isMobile) {
            indicator.style.padding = '0.4rem 0.75rem 0.55rem';
            indicator.style.borderRadius = '9999px';
            indicator.style.background = 'rgba(0, 0, 0, 0.28)';
            indicator.style.backdropFilter = 'blur(6px)';
            indicator.style.boxShadow = '0 8px 20px rgba(0,0,0,0.35)';
          }

          const text = document.createElement('p');
          text.textContent = label;
          text.style.fontSize = isMobile ? '0.82rem' : '1rem';
          text.style.letterSpacing = '0.2em';
          text.style.fontWeight = isMobile ? '500' : '600';
          text.style.textTransform = 'uppercase';
          text.style.lineHeight = '1';
          text.style.margin = '0';
          text.style.opacity = isMobile ? '1' : '0.82';

          indicator.appendChild(text);
          {
            const arrow = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
            arrow.setAttribute('xmlns', 'http://www.w3.org/2000/svg');
            arrow.setAttribute('fill', 'none');
            arrow.setAttribute('viewBox', '0 0 24 24');
            arrow.setAttribute('stroke', 'currentColor');
            arrow.setAttribute('stroke-width', '2.5');
            arrow.setAttribute('class', 'w-8 h-8 text-white drop-shadow-[0_3px_10px_rgba(0,0,0,0.7)] animate-bounce-slow');
            if (isMobile) {
              arrow.style.width = '2rem';
              arrow.style.height = '2rem';
            }

            const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
            path.setAttribute('stroke-linecap', 'round');
            path.setAttribute('stroke-linejoin', 'round');
            path.setAttribute('d', 'M19 9l-7 7-7-7');
            arrow.appendChild(path);
            indicator.appendChild(arrow);
          }
          hero.appendChild(indicator);
        }

        function mountProjectHeroScrollIndicatorDeferred() {
          requestAnimationFrame(() => mountProjectHeroScrollIndicator());
        }

        function mountGlobalAutoReveal() {
          const main = document.querySelector('main');
          if (!(main instanceof HTMLElement)) return;

          const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          if (reduceMotion) return;

          const sections = main.querySelectorAll('section, article');
          if (!sections.length) return;

          const observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (!entry.isIntersecting) return;
                const target = entry.target;
                if (target instanceof HTMLElement) {
                  target.classList.add('auto-reveal-visible');
                  target.style.opacity = '1';
                  target.style.transform = 'translateY(0)';
                  target.style.filter = 'blur(0)';
                }
                observer.unobserve(entry.target);
              });
            },
            {
              threshold: 0.12,
              rootMargin: '0px 0px -8% 0px',
            }
          );

          sections.forEach((section) => {
            if (section.closest('[data-reveal-group]')) return;

            const candidates = section.querySelectorAll(
              'h1, h2, h3, h4, p, li, figure, figcaption, img:not([data-no-reveal]):not(.ds-hero-image), video, article, form, blockquote, .project-card, [data-slot="button"], a[href], button'
            );

            let visibleIndex = 0;

            candidates.forEach((el) => {
              if (el.classList.contains('reveal-item')) return;
              if (el.classList.contains('auto-reveal-item')) return;
              if (el.classList.contains('reveal-heading')) return;
              if (el.closest('[data-reveal-group]')) return;
              if (el.closest('header, nav, footer')) return;
              if (el.hasAttribute('data-no-reveal')) return;
              if (el.classList.contains('ds-hero-image')) return;
              if (el.closest('.ds-hero-panel')) return;
              if (el.closest('.project-card') && !el.classList.contains('project-card')) return;
              if (el.tagName === 'A' && el.closest('[data-slot="button"]')) return;

              const style = window.getComputedStyle(el);
              if (style.display === 'none' || style.visibility === 'hidden') return;

              el.classList.add('auto-reveal-item');
              el.style.setProperty('--auto-reveal-delay', `${Math.min(visibleIndex * 85, 680)}ms`);
              el.style.opacity = '0';
              el.style.transform = 'translateY(24px)';
              el.style.filter = 'blur(2px)';
              el.style.transition =
                'opacity 0.65s cubic-bezier(0.22, 1, 0.36, 1), transform 0.65s cubic-bezier(0.22, 1, 0.36, 1), filter 0.65s cubic-bezier(0.22, 1, 0.36, 1)';
              el.style.transitionDelay = `${Math.min(visibleIndex * 85, 680)}ms`;
              el.style.willChange = 'opacity, transform, filter';
              visibleIndex += 1;

              observer.observe(el);
            });
          });
        }

        window.addEventListener('load', mountProjectHeroScrollIndicatorDeferred);
        window.addEventListener('resize', mountProjectHeroScrollIndicatorDeferred);
        document.addEventListener('DOMContentLoaded', mountProjectHeroScrollIndicatorDeferred);
        document.addEventListener('astro:page-load', mountProjectHeroScrollIndicatorDeferred);

        window.addEventListener('load', mountGlobalAutoReveal);
        document.addEventListener('DOMContentLoaded', mountGlobalAutoReveal);
        document.addEventListener('astro:page-load', mountGlobalAutoReveal);

        // ── Scroll-Fortschrittsanzeige ───────────────────────────────────────
        var _scrollProgressHandler = null;
        function mountScrollProgress() {
          const bar = document.getElementById('scroll-progress');
          if (!bar) return;
          if (_scrollProgressHandler) {
            window.removeEventListener('scroll', _scrollProgressHandler);
          }
          _scrollProgressHandler = function () {
            const docH = document.documentElement.scrollHeight - window.innerHeight;
            bar.style.width = (docH > 0 ? (window.scrollY / docH) * 100 : 0) + '%';
          };
          window.addEventListener('scroll', _scrollProgressHandler, { passive: true });
          _scrollProgressHandler();
        }

        // ── Heading Word-by-Word Reveal ──────────────────────────────────────
        function mountHeadingWordReveal() {
          if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
          document.querySelectorAll('.reveal-heading').forEach((el) => {
            if (!(el instanceof HTMLElement)) return;
            if (el.dataset.wordRevealMounted) return;
            el.dataset.wordRevealMounted = '1';
            el.setAttribute('data-no-reveal', '');

            if (el.children.length > 0) {
              // Has child elements (e.g. <br>) – whole-element slide-up
              el.style.opacity = '0';
              el.style.transform = 'translateY(32px)';
              el.style.filter = 'blur(3px)';
              el.style.transition =
                'opacity 0.7s cubic-bezier(0.22,1,0.36,1), transform 0.7s cubic-bezier(0.22,1,0.36,1), filter 0.7s cubic-bezier(0.22,1,0.36,1)';
              const obs = new IntersectionObserver((entries) => {
                entries.forEach((e) => {
                  if (!e.isIntersecting) return;
                  el.style.opacity = '1';
                  el.style.transform = 'translateY(0)';
                  el.style.filter = 'blur(0)';
                  obs.unobserve(el);
                });
              }, { threshold: 0.2 });
              obs.observe(el);
              return;
            }

            const text = el.textContent?.trim() || '';
            const words = text.split(/\s+/).filter(Boolean);
            if (!words.length) return;

            el.innerHTML = words
              .map(
                (word, i) =>
                  `<span class="rh-word"><span class="rh-inner" style="transition-delay:${i * 55}ms">${word}</span></span>`
              )
              .join(' ');

            const obs = new IntersectionObserver(
              (entries) => {
                entries.forEach((e) => {
                  if (!e.isIntersecting) return;
                  el.classList.add('reveal-heading-active');
                  obs.unobserve(el);
                });
              },
              { threshold: 0.2, rootMargin: '0px 0px -5% 0px' }
            );
            obs.observe(el);
          });
        }

        window.addEventListener('load', mountScrollProgress);
        document.addEventListener('DOMContentLoaded', mountScrollProgress);
        document.addEventListener('astro:page-load', mountScrollProgress);

        window.addEventListener('load', mountHeadingWordReveal);
        document.addEventListener('DOMContentLoaded', mountHeadingWordReveal);
        document.addEventListener('astro:page-load', mountHeadingWordReveal);

        // ── Parallax Hero ────────────────────────────────────────────────────
        function mountHeroParallax() {
          if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
          if (window.innerWidth < 768) return;  // Desktop only

          const heroImgs = document.querySelectorAll('.ds-hero-image, .hero-parallax');
          if (!heroImgs.length) return;

          var ticking = false;
          function onScroll() {
            if (ticking) return;
            ticking = true;
            requestAnimationFrame(function () {
              const scrollY = window.scrollY;
              heroImgs.forEach(function (img) {
                const section = img.closest('section');
                if (!section) return;
                const rect = section.getBoundingClientRect();
                if (rect.bottom < 0 || rect.top > window.innerHeight) { ticking = false; return; }
                const progress = scrollY / (section.offsetHeight + window.innerHeight);
                img.style.transform = 'translateY(' + (progress * 60).toFixed(1) + 'px) scale(1.08)';
              });
              ticking = false;
            });
          }

          window.removeEventListener('scroll', window._heroParallaxHandler);
          window._heroParallaxHandler = onScroll;
          window.addEventListener('scroll', onScroll, { passive: true });
        }

        // ── Magnetische Buttons ──────────────────────────────────────────────
        function mountMagneticButtons() {
          if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
          if (window.matchMedia('(hover: none)').matches) return;  // No touch devices

          document.querySelectorAll('.mag-btn').forEach(function (btn) {
            if (btn._magMounted) return;
            btn._magMounted = true;

            btn.addEventListener('mousemove', function (e) {
              const rect = btn.getBoundingClientRect();
              const cx = rect.left + rect.width / 2;
              const cy = rect.top + rect.height / 2;
              const dx = (e.clientX - cx) * 0.35;
              const dy = (e.clientY - cy) * 0.35;
              btn.style.transform = 'translate(' + dx.toFixed(1) + 'px, ' + dy.toFixed(1) + 'px)';
            });

            btn.addEventListener('mouseleave', function () {
              btn.style.transform = '';
            });
          });
        }

        window.addEventListener('load', mountHeroParallax);
        document.addEventListener('DOMContentLoaded', mountHeroParallax);
        document.addEventListener('astro:page-load', mountHeroParallax);

        window.addEventListener('load', mountMagneticButtons);
        document.addEventListener('DOMContentLoaded', mountMagneticButtons);
        document.addEventListener('astro:page-load', mountMagneticButtons);

        document.addEventListener('click', (event) => {
          const target = event.target;
          if (!(target instanceof Element)) return;

          const trigger = target.closest('[data-cookie-settings-trigger]');
          if (!(trigger instanceof HTMLElement)) return;

          event.preventDefault();
          resetCookieConsent();
        });

        window.addEventListener('load', syncAnalyticsConsentFromCookie);
        document.addEventListener('DOMContentLoaded', syncAnalyticsConsentFromCookie);
        document.addEventListener('astro:page-load', syncAnalyticsConsentFromCookie);

        window.addEventListener('load', initPortfolioAnalytics);
        document.addEventListener('DOMContentLoaded', initPortfolioAnalytics);
        document.addEventListener('astro:page-load', initPortfolioAnalytics);
      </script>

