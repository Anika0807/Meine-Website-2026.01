---
import '@/styles/global.css';
import Navigation from '@/components/Navigation';
import AccessibilityPanel from '@/components/AccessibilityPanel';
import CookieBanner from '@/components/CookieBanner';
import { footer_name, footer_tagline, footer_impressum, footer_datenschutz } from '@/paraglide/messages.js';

const { title = 'Meine Website 2026' } = Astro.props;
const ssrLocale = Astro.url.pathname.startsWith('/en') ? 'en' : 'de';
const loc = { locale: ssrLocale } as const;
---

<html lang={ssrLocale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="astro-view-transitions" content="true" />
    <title>{title}</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/opendyslexic@1.0.0/css/opendyslexic.min.css" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=OpenDyslexic" />
    <link href="https://fonts.googleapis.com/css2?family=Satoshi:wght@500;700;900&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <!-- Theme-Script: verhindert Flackern beim Laden -->
    <script is:inline>
      (function() {
        var t = localStorage.getItem('theme') || 'system';
        var dark = t === 'dark' || (t === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
        if (dark) document.documentElement.classList.add('dark');
      })();
    </script>
  </head>

  <body class="bg-background text-foreground antialiased min-h-screen flex flex-col">
    <!-- Sticky Header -->
      <header class="sticky top-0 z-50 w-full border-b bg-background/95 backdrop-blur supports-[backdrop-filter]:bg-background/60 transition-all duration-300" data-scroll="up">
      <div class="container flex h-16 items-center justify-between px-6 mx-auto max-w-7xl">
        <a href={ssrLocale === 'en' ? '/en/' : '/'} class="text-xl font-bold tracking-tight">
          Anika Warncke
        </a>

        <Navigation client:only="react" />
      </div>
    </header>

      <script is:inline>
        let lastScroll = 0;
        window.addEventListener('scroll', () => {
          const header = document.querySelector('header');
          const currentScroll = window.scrollY;

          if (currentScroll > lastScroll && currentScroll > 100) {
            header.classList.add('translate-y-[-100%]');
          } else {
            header.classList.remove('translate-y-[-100%]');
          }
          header.classList.toggle('shadow-md', currentScroll > 10);

          lastScroll = currentScroll;
        });
      </script>

    <!-- Haupt-Content: w-full ensures mobile-first full bleed -->
    <main class="flex-1 w-full">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t bg-background py-6 mt-auto">
      <div class="container mx-auto max-w-7xl px-6 flex flex-col md:flex-row items-center justify-between gap-4 text-sm text-muted-foreground">
        <p>© {new Date().getFullYear()} {footer_name(loc)} – {footer_tagline(loc)}</p>
        <div class="flex gap-6">
          <a href={ssrLocale === 'en' ? '/en/impressum' : '/impressum'} class="hover:text-primary">{footer_impressum(loc)}</a>
          <a href={ssrLocale === 'en' ? '/en/datenschutz' : '/datenschutz'} class="hover:text-primary">{footer_datenschutz(loc)}</a>
        </div>
      </div>
    </footer>

    <AccessibilityPanel locale={ssrLocale} client:only="react" />
    <CookieBanner locale={ssrLocale} client:only="react" />

  </body>
</html>
